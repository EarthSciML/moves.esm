{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-project-avft",
    "description": "PLAN.md §7.3.78: `washtenaw-project-offnetwork` WITH A NON-DEFAULT avft -- the PROJECT database moves.rs builds from `characterization/county-inputs/washtenaw-project-offnetwork/setup-project-offnetwork.sql` and then `characterization/county-inputs/washtenaw-county-avft/setup-avft.sql`, for `project-avft`. It is one table over that catalogue, so it MOUNTS that catalogue and declares the one table itself (docs/esm-conventions.md §119), and the table is `inputs/washtenaw-county-avft.esm`'s file: the same SQL states the same 32 rows over the same AVFTTool projection.\n\nWHAT A PROJECT DATABASE ADDS. Beside AVFTControlStrategy's rewrite of sampleVehiclePopulation, which a project run reads as a county run does, ProjectTAG's hotellingHours multiply the off-network fleet by avft.fuelEngFraction READ DIRECTLY, summed over every avft row of source type 62 and the model year -- including a row sampleVehiclePopulation has no combination for, which the strategy ignores (`hot_avftTotal`). A combination this document does not state is the projection's row, which the model computes from the default sample-vehicle population (docs/esm-conventions.md §129).\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "domain",
      "project-domain",
      "control-strategy",
      "avft"
    ]
  },
  "data_sources": {
    "db_avft": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-avft/avft.parquet"
      },
      "extent": {
        "metaparameter": "n_avft"
      },
      "metadata": {
        "tags": [
          "cohorts",
          "domain"
        ],
        "note": "32 rows, `inputs/washtenaw-county-avft.esm`'s file (`setup-avft.sql`, written by `tools/build-scale-input-db.py`): the STATED combinations of source types 21, 32 and 62 at model years 2010, 2015, 2018 and 2020. Here ProjectTAG reads them too: at source type 62 the 2020 and 2015 rows restate the whole cohort, and 2018's four rows sum to 0.99999994 -- its gasoline share of 0.0017823, which sampleVehiclePopulation has no row for, and its electric share of 9e-7, which the strategy leaves at 0, count toward the cohort's hotelling hours although neither reaches the fleet. It shadows `onroad/default-database.esm`'s empty national table.",
        "esio_format": "parquet"
      }
    }
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsDays": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsHours": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputClassicalDay": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_aggregatesMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-project-offnetwork.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    }
  },
  "models": {
    "Onroad": {
      "ref": "./washtenaw-project-offnetwork.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale",
        "n_outputSumsDays": "n_outputSumsDays",
        "n_outputSumsMonths": "n_outputSumsMonths",
        "n_outputSumsHours": "n_outputSumsHours",
        "n_outputClassicalDay": "n_outputClassicalDay",
        "n_aggregatesMonths": "n_aggregatesMonths"
      }
    }
  }
}
