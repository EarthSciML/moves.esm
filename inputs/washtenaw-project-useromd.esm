{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-project-useromd",
    "description": "PLAN.md §7.3.58: the PROJECT-domain input database of `project-useromd` (runspecs/), over `onroad/default-database.esm` like `inputs/washtenaw-project.esm`, whose description says what a domain document declares and why only that.\n\nmoves.rs builds it from `characterization/county-inputs/washtenaw-project-useromd/setup-project-useromd.sql`: `washtenaw-project`'s SQL with a different network, which tools/build-scale-input-db.py writes to `inputs/washtenaw-project-useromd/` -- `link` and `linkSourceTypeHour` as `washtenaw-project-crankcase`'s (links 1 and 2 on road types 4 and 5, the off-network link 3), `offNetworkLink` likewise, and `opModeDistribution` stating link 1's distribution: running CO and Total Energy over thirteen modes for both source types, and the evaporative modes 150, 151 and 300 for THC permeation, venting and leaks.\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "onroad",
      "domain",
      "project-domain",
      "scale-input-database"
    ]
  },
  "data_sources": {
    "db_link": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/Link.parquet"
      },
      "extent": {
        "metaparameter": "n_link"
      },
      "metadata": {
        "tags": [
          "scope",
          "output",
          "domain"
        ],
        "note": "The project's Link: 3 rows in county 26161, zone 261610, grade 0 -- link 1 on road type 4 (1.0 mi, 1,000 veh/h, 30 mph; the user states its operating modes), link 2 on road type 5 (0.5 mi, 600 veh/h, 25 mph) and link 3, the off-network link, on road type 1.",
        "esio_format": "parquet"
      }
    },
    "db_linksourcetypehour": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/linkSourceTypeHour.parquet"
      },
      "extent": {
        "metaparameter": "n_linksourcetypehour"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "4 rows: link 1 is 80% source type 21 and 20% source type 62, link 2 60% and 40%.",
        "esio_format": "parquet"
      }
    },
    "db_offnetworklink": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/offNetworkLink.parquet"
      },
      "extent": {
        "metaparameter": "n_offnetworklink"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "2 rows in zone 261610: 1,000 passenger cars (start fraction 0.05, parked 0.5) and 50 long-haul trucks (start fraction 0.02, extended idle fraction 0.3, parked 0.6). ProjectTAG's Starts (`st_projectStarts`) and hotelling hours (`hot_projectHours`) start from it.",
        "esio_format": "parquet"
      }
    },
    "db_opmodedistribution": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/OpModeDistribution.parquet"
      },
      "extent": {
        "metaparameter": "n_opmodedistribution"
      },
      "metadata": {
        "tags": [
          "domain",
          "operating-mode"
        ],
        "note": "61 rows, all on link 1 at hourDayID 95: running CO (201) and Total Energy (9101) for source types 21 and 62 at modes 0 (0.05), 1 (0.10), 11 (0.10), 21 (0.15), 22-24 (0.10 each), 25 and 27-30 and 33 (0.05 each); and THC permeation, venting and leaks (111, 112, 113) for source type 21 at 150 (0.5), 151 (0.3) and 300 (0.2). LinkOperatingModeDistributionGenerator skips link 1 (`omd_linkRunningRows`), and the evaporative generator's INSERT IGNORE keeps the user's three modes (`evap_W`).",
        "esio_format": "parquet"
      }
    },
    "db_runspecdomain": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/runspecdomain.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecdomain"
      },
      "metadata": {
        "tags": [
          "scope",
          "domain"
        ],
        "note": "1 row, modelDomain PROJECT, read by tools/build-scale-input-db.py from project-useromd.xml.",
        "esio_format": "parquet"
      }
    },
    "db_input_zoneroadtype": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/ZoneRoadType.parquet"
      },
      "extent": {
        "metaparameter": "n_inputzoneroadtype"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "The project's ZoneRoadType: 4 rows, the default's at zone 261610 (tools/build-scale-input-db.py --copy), as in `washtenaw-project`.",
        "esio_format": "parquet"
      }
    },
    "db_input_hotellingactivitydistribution": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/hotellingActivityDistribution.parquet"
      },
      "extent": {
        "metaparameter": "n_inputhotellingactivitydistribution"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The project's hotellingActivityDistribution: 0 rows -- its copy selects zone 261610 from a default table whose rows are all at 990000. In PROJECT domain MOVES does not merge the default's at all (InputDataManager.java:2802-2805), which the model writes as `had_isMerged`.",
        "esio_format": "parquet"
      }
    },
    "db_hotellinghoursperday": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/hotellingHoursPerDay.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellinghoursperday"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The project's hotellingHoursPerDay: 0 rows, a copy of the default's empty table.",
        "esio_format": "parquet"
      }
    },
    "db_hotellinghourfraction": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/hotellingHourFraction.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellinghourfraction"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The project's hotellingHourFraction: 0 rows, a copy of the default's empty table.",
        "esio_format": "parquet"
      }
    },
    "db_hotellingagefraction": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/hotellingAgeFraction.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellingagefraction"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The project's hotellingAgeFraction: 0 rows, a copy of the default's empty table.",
        "esio_format": "parquet"
      }
    },
    "db_hotellingmonthadjust": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/hotellingMonthAdjust.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellingmonthadjust"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The project's hotellingMonthAdjust: 0 rows, a copy of the default's empty table.",
        "esio_format": "parquet"
      }
    },
    "db_startsperday": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/startsPerDay.parquet"
      },
      "extent": {
        "metaparameter": "n_startsperday"
      },
      "metadata": {
        "tags": [
          "domain",
          "starts"
        ],
        "note": "The project's startsPerDay: 0 rows, a copy of the default's empty table.",
        "esio_format": "parquet"
      }
    },
    "db_input_zone": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-useromd/Zone.parquet"
      },
      "extent": {
        "metaparameter": "n_inputzone"
      },
      "metadata": {
        "tags": [
          "domain",
          "starts"
        ],
        "note": "The project's Zone: 1 row, setup-project.sql's copy of the default's zone 261610 (tools/build-scale-input-db.py --copy). The input side of a row merge with the default's, so the merged value is the default's own.",
        "esio_format": "parquet"
      }
    }
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "How many (pollutant-process, cohort) PAIRS reach MOVESOutput, summed over the run's emitted blocks. Declared here as well as in the model it mounts for the reason the numbers around it are (docs/esm-conventions.md §49.1): this is the relay that lets a per-fixture document set it. It replaces `n_outputCohort` and `n_outputPolProcess`, which between them could describe only a rectangle. 375 is `process-tirewear`'s, three blocks of 125; a run with one emitted block of 125 needs 125, `expand-fueltype-diesel` 248, `expand-sourcetype` 430 and `expand-criteria` 372. `rateSurvivorCount` recomputes it, so it is a CHECKED declaration."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "How many source bins the widest cohort of the run holds. Declared here as well as in the model it mounts for the reason the two numbers above it are (docs/esm-conventions.md §49.1): this is the relay that lets a per-fixture document set it. 1 is right for a run whose cohorts are single-binned -- a passenger car's are, and so the bin relation is that run's cohort relation row for row -- and a run that selects a light commercial truck needs 2, a refuse truck 8. `run_sourceBinsDropped` recomputes whether the value is enough, so it is a CHECKED declaration."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "How many rows of `sourceusetypephysics` the run's source types select between them -- the width of the drive-cycle axis. Declared here as well as in the model it mounts for the reason the three numbers above it are (docs/esm-conventions.md §49.1): this is the relay that lets a per-fixture document set it. The vehicle a drive cycle is computed for is keyed by (sourceTypeID, regClassID, model-year range), so 1 is right for a motorcycle or a passenger car, a light commercial truck alone needs 3, source types 21 and 32 together 4, and the five of `expand-sourcetype` 40. `run_physicsRowsSelected` recomputes it and `run_physicsRowsDropped` says whether it is enough, so it is a CHECKED declaration."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "The RunSpec's `<modelscale>`: 1 at Rates scale, 0 (the default) at inventory scale. Relayed here as `n_outputRate` is (docs/esm-conventions.md §49.1), so a per-fixture document can bind it (PLAN.md §7.3.47)."
    }
  },
  "models": {
    "Onroad": {
      "ref": "../onroad/default-database.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale"
      }
    }
  }
}
