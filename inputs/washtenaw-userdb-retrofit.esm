{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-userdb-retrofit",
    "description": "PLAN.md §7.3.79: a USER INPUT DATABASE merged into a DEFAULT-domain run -- `washtenaw_cdb` as moves.rs `characterization/county-inputs/washtenaw-county-retrofit/setup-retrofit.sql` builds it ALONE for `rates-retrofit` and `userdb-retrofit-multiyear`, which name it in `<databaseselections>`. A county domain database may hold one calendar year only and a Rates run here is DEFAULT-domain, so a user database is how a retrofit table reaches those two runs. It holds the 13 onRoadRetrofit rows and the five hotelling tables, EMPTY: MOVESEngine.hasWrongHotellingTables refuses an input database that lacks them, and empty they merge nothing. So this document is the DEFAULT-domain catalogue `moves-onroad.esm` plus the one table, declared here and shadowing the default database's empty one (docs/esm-conventions.md §119.4); the parquet is the one `washtenaw-county-retrofit.esm` reads.\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "domain",
      "default-domain",
      "user-input-database",
      "control-strategy",
      "on-road-retrofit"
    ]
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsDays": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsHours": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputClassicalDay": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_aggregatesMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_statedEnergyProcesses": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    }
  },
  "data_sources": {
    "db_onroadretrofit": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-retrofit/onRoadRetrofit.parquet"
      },
      "extent": {
        "metaparameter": "n_onroadretrofit"
      },
      "metadata": {
        "tags": [
          "control-strategy",
          "domain"
        ],
        "note": "onRoadRetrofit as moves.rs `characterization/county-inputs/washtenaw-county-retrofit/setup-retrofit.sql` states it: 13 rows, thirteen On-Road Retrofit programs on diesel (fuel 2) source types 42, 52 and 62 -- a THC phase-in at 2012, 2015, 2018 and 2021 on 62, two CO rows at one year on 52, a negative NOx effectiveness on 42, programs on the PM2.5 total (62), on EC alone (52), on start THC (52) and on NMHC (52). Written by `tools/build-scale-input-db.py` from that SQL. The default database's table is empty, so the merge is these rows. MOVES copies them into the execution database cut to the RunSpec's pollutants, processes, source types and fuels (InputDataManager.java:3308); the model reads them uncut, and a row the run does not select matches no rate row.",
        "esio_format": "parquet"
      }
    }
  },
  "models": {
    "Onroad": {
      "ref": "../moves-onroad.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale",
        "n_outputSumsDays": "n_outputSumsDays",
        "n_outputSumsMonths": "n_outputSumsMonths",
        "n_outputSumsHours": "n_outputSumsHours",
        "n_outputClassicalDay": "n_outputClassicalDay",
        "n_aggregatesMonths": "n_aggregatesMonths",
        "n_statedEnergyProcesses": "n_statedEnergyProcesses"
      }
    }
  }
}
