        "note": "Created empty: 0 rows, as in `washtenaw-county`. totalIdleFraction is the default's, copied (`oni_defaultIdleFraction`).",
        "esio_format": "parquet"
      }
    },
    "db_idlemonthadjust": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-timeagg/idleMonthAdjust.parquet"
