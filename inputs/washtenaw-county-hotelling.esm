      },
      "metadata": {
        "tags": [
          "scope",
          "domain"
        ],
        "note": "1 row, modelDomain SINGLE, read by tools/build-scale-input-db.py from the RunSpec XML's `<modeldomain value=\"SINGLE\"/>` -- ModelDomain.java's SINGLE_COUNTY.",
        "esio_format": "parquet"
      }
    },
    "db_input_zoneroadtype": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-hotelling/ZoneRoadType.parquet"
      },
