          "domain",
          "activity"
        ],
        "note": "The county's ZoneRoadType: 4 rows at zone 261610, road types 2-5, each the default's SHOAllocFactor TRUNCATED to twelve decimal places (setup-hotelling.sql's literal INSERTs; up to 5.75e-10 relative). The input side of a row merge: these win over the default's rows at the same key.",
        "esio_format": "parquet"
      }
    },
    "db_input_hotellingactivitydistribution": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-hotelling/hotellingActivityDistribution.parquet"
      },
      "extent": {
