{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-county-lev",
    "description": "PLAN.md §7.3.82: `washtenaw-county` WITH a LEV user input database -- `washtenaw_cdb` as moves.rs `characterization/county-inputs/washtenaw-county/setup-county.sql` builds it, beside `washtenaw_lev`, which `washtenaw-userdb-lev/setup-lev-county.sql` builds as MOVES 5's LEV tool does (the same 48,657 emissionRateByAgeLEV rows as `inputs/washtenaw-userdb-lev.esm`), for `scale-county-lev`, which names it in `<databaseselections>`. MasterLoop merges the user database, then the county database, then the default database, each with INSERT IGNORE, and the county database holds no emissionRateByAge, so the LEV rows replace the default's at their keys exactly as in a DEFAULT-domain run. It is one table over that catalogue, so it MOUNTS that catalogue and declares the one table itself, shadowing the default database's empty input side (docs/esm-conventions.md §119.4, §133); the parquet is `washtenaw-userdb-lev`'s.\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "domain",
      "single-county",
      "user-input-database",
      "lev"
    ]
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsDays": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsHours": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputClassicalDay": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_aggregatesMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    }
  },
  "data_sources": {
    "db_input_emissionratebyage": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-lev/EmissionRateByAge.parquet"
      },
      "extent": {
        "metaparameter": "n_inputemissionratebyage"
      },
      "metadata": {
        "tags": [
          "domain",
          "rates",
          "user-input-database"
        ],
        "note": "The LEV database `washtenaw_lev`'s emissionRateByAge: setup-lev-county.sql is setup-lev.sql under another database name, so this is `washtenaw-userdb-lev`'s parquet, and equal, row for row, to the `db__washtenaw_lev__emissionratebyage` table the capture dumped. 48,657 rows, every key a default key.",
        "esio_format": "parquet"
      }
    }
  },
  "models": {
    "Onroad": {
      "ref": "./washtenaw-county.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale",
        "n_outputSumsDays": "n_outputSumsDays",
        "n_outputSumsMonths": "n_outputSumsMonths",
        "n_outputSumsHours": "n_outputSumsHours",
        "n_outputClassicalDay": "n_outputClassicalDay",
        "n_aggregatesMonths": "n_aggregatesMonths"
      }
    }
  }
}
