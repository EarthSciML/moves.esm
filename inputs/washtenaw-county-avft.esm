{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-county-avft",
    "description": "PLAN.md §7.3.78: `washtenaw-county-timeagg` WITH A NON-DEFAULT avft -- `washtenaw_cdb` as moves.rs `characterization/county-inputs/washtenaw-county-timeagg/setup-timeagg.sql` and then `characterization/county-inputs/washtenaw-county-avft/setup-avft.sql` build it for `scale-county-avft`. It is one table over that catalogue, so it MOUNTS that catalogue and declares the one table itself, as `washtenaw-county-timeagg-soak.esm` does (a mounting document's own data source wins a name clash with a mounted one's, docs/esm-conventions.md §119); everything else is `inputs/washtenaw-county-timeagg.esm`'s, unchanged.\n\nWHAT IS DECLARED IS THE STATED ROWS, AND THAT IS THE WHOLE TABLE FOR THE STRATEGY. setup-timeagg.sql fills avft with AVFTTool's default projection and setup-avft.sql deletes and restates 32 combinations; `tools/build-scale-input-db.py` writes those 32. Every other row of the database's avft is the projection, `sum(stmyFraction)` over regulatory class, which is applyNewFraction's own `old` -- so it takes the no-change branch, exactly as an absent row does (docs/esm-conventions.md §129). The execution database's avft holds 1,333 rows (the projection for source types 21, 32 and 62, InputDataManager filtering by source type, plus the restated rows); the strategy rewrote 37 sample-vehicle rows from them, every one of them at a stated combination (PLAN.md §7.3.78).\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "domain",
      "single-county-domain",
      "control-strategy",
      "avft"
    ]
  },
  "data_sources": {
    "db_avft": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-avft/avft.parquet"
      },
      "extent": {
        "metaparameter": "n_avft"
      },
      "metadata": {
        "tags": [
          "cohorts",
          "domain"
        ],
        "note": "32 rows, the county's STATED avft combinations (written by `tools/build-scale-input-db.py` from `setup-avft.sql`): source types 21, 32 and 62 at model years 2010, 2015, 2018 and 2020, chosen so that applyNewFraction takes its ADD branch (18 sample-vehicle rows, four of them filled from 0: diesel cars and electric trucks), its SUBTRACT branch (19, four emptied to 0), its no-change branch (eight restatements within 1e-6 of the default, and an electric long-haul share of 9e-7 that stays 0), and ignores a gasoline long-haul truck share that sampleVehiclePopulation has no row for. It shadows `onroad/default-database.esm`'s empty national table.",
        "esio_format": "parquet"
      }
    }
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsDays": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsHours": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputClassicalDay": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_aggregatesMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_statedEnergyProcesses": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    }
  },
  "models": {
    "Onroad": {
      "ref": "./washtenaw-county-timeagg.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale",
        "n_outputSumsDays": "n_outputSumsDays",
        "n_outputSumsMonths": "n_outputSumsMonths",
        "n_outputSumsHours": "n_outputSumsHours",
        "n_outputClassicalDay": "n_outputClassicalDay",
        "n_aggregatesMonths": "n_aggregatesMonths",
        "n_statedEnergyProcesses": "n_statedEnergyProcesses"
      }
    }
  }
