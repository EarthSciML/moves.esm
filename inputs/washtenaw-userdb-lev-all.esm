{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-userdb-lev-all",
    "description": "PLAN.md §7.3.82: a LEV input database keeping EVERY model-year group -- `washtenaw_cdb` as moves.rs `characterization/county-inputs/washtenaw-userdb-lev/setup-lev-all.sql` builds it for `userdb-lev-2025`, which names it in `<databaseselections>`. That SQL is MOVES5_MyLEVS_Template.sql with the LEV tool's two substitutions and no line deleted, so the database's one table, emissionRateByAge, is the default's whole emissionRateByAgeLEV (every row is at one of the template's ten pollutant-processes). It is `inputs/washtenaw-userdb-lev.esm` with a different table: the DEFAULT-domain catalogue `moves-onroad.esm` plus the one table, shadowing the default database's empty input side (docs/esm-conventions.md §119.4, §133).\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "domain",
      "default-domain",
      "user-input-database",
      "lev"
    ]
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsDays": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsHours": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputClassicalDay": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_aggregatesMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_statedEnergyProcesses": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `moves-onroad.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    }
  },
  "data_sources": {
    "db_input_emissionratebyage": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-lev-all/EmissionRateByAge.parquet"
      },
      "extent": {
        "metaparameter": "n_inputemissionratebyage"
      },
      "metadata": {
        "tags": [
          "domain",
          "rates",
          "user-input-database"
        ],
        "note": "The LEV database's emissionRateByAge as setup-lev-all.sql states it: all 92,274 rows of the default database's emissionRateByAgeLEV -- model-year groups 1994-2017 and 2025 (the table holds no 2018-2024 rows), gasoline, diesel and E85 at regulatory classes 20 and 30, THC, CO and NOx at running and start and, at group 45 (2025) ONLY, elemental carbon and non-EC PM at running and start (966 / 336 / 966 / 336 rows). Written by `tools/build-scale-input-db.py --copy emissionratebyage` from that SQL; equal, row for row and value for value, to the user database the capture dumped. Every key is a default key.",
        "esio_format": "parquet"
      }
    }
  },
  "models": {
    "Onroad": {
      "ref": "../moves-onroad.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale",
        "n_outputSumsDays": "n_outputSumsDays",
        "n_outputSumsMonths": "n_outputSumsMonths",
        "n_outputSumsHours": "n_outputSumsHours",
        "n_outputClassicalDay": "n_outputClassicalDay",
        "n_aggregatesMonths": "n_aggregatesMonths",
        "n_statedEnergyProcesses": "n_statedEnergyProcesses"
      }
    }
  }
}
