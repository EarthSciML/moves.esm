{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-county-retrofit",
    "description": "PLAN.md §7.3.79: `washtenaw-county` WITH thirteen On-Road Retrofit programs -- `washtenaw_cdb` as moves.rs `characterization/county-inputs/washtenaw-county/setup-county.sql` and then `washtenaw-county-retrofit/setup-retrofit.sql` build it for `scale-county-retrofit`. It is one table over that catalogue, so it MOUNTS that catalogue and declares the one table itself: a mounting document's own data source wins a name clash with a mounted one's (docs/esm-conventions.md §119.4) -- here the default database's empty onRoadRetrofit, which `onroad/default-database.esm` declares for every other catalogue.\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "domain",
      "single-county-domain",
      "control-strategy",
      "on-road-retrofit"
    ]
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsDays": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsHours": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputClassicalDay": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_aggregatesMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    }
  },
  "data_sources": {
    "db_onroadretrofit": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-retrofit/onRoadRetrofit.parquet"
      },
      "extent": {
        "metaparameter": "n_onroadretrofit"
      },
      "metadata": {
        "tags": [
          "control-strategy",
          "domain"
        ],
        "note": "onRoadRetrofit as moves.rs `characterization/county-inputs/washtenaw-county-retrofit/setup-retrofit.sql` states it: 13 rows, thirteen On-Road Retrofit programs on diesel (fuel 2) source types 42, 52 and 62 -- a THC phase-in at 2012, 2015, 2018 and 2021 on 62, two CO rows at one year on 52, a negative NOx effectiveness on 42, programs on the PM2.5 total (62), on EC alone (52), on start THC (52) and on NMHC (52). Written by `tools/build-scale-input-db.py` from that SQL. The default database's table is empty, so the merge is these rows. MOVES copies them into the execution database cut to the RunSpec's pollutants, processes, source types and fuels (InputDataManager.java:3308); the model reads them uncut, and a row the run does not select matches no rate row.",
        "esio_format": "parquet"
      }
    }
  },
  "models": {
    "Onroad": {
      "ref": "./washtenaw-county.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale",
        "n_outputSumsDays": "n_outputSumsDays",
        "n_outputSumsMonths": "n_outputSumsMonths",
        "n_outputSumsHours": "n_outputSumsHours",
        "n_outputClassicalDay": "n_outputClassicalDay",
        "n_aggregatesMonths": "n_aggregatesMonths"
      }
    }
  }
}
