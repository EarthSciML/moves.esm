{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-project-multilink",
    "description": "PLAN.md §7.3.60: the PROJECT-domain input database of `project-multilink` (runspecs/), over `onroad/default-database.esm` like `inputs/washtenaw-project.esm`, whose description says what a domain document declares and why only that.\n\nmoves.rs builds it from `characterization/county-inputs/washtenaw-project-multilink/setup-project-multilink.sql`: `washtenaw-project-links`' SQL with a network of TWO links on each on-network road type, which tools/build-scale-input-db.py writes to `inputs/washtenaw-project-multilink/` -- links 1 and 4 on road type 5, 2 and 5 on road type 4, the off-network link 3 -- `linkSourceTypeHour` with a different source-type split per link, `offNetworkLink` and the off-network link's start modes as `washtenaw-project-links` states them.\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "onroad",
      "domain",
      "project-domain",
      "scale-input-database"
    ]
  },
  "data_sources": {
    "db_link": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-multilink/Link.parquet"
      },
      "extent": {
        "metaparameter": "n_link"
      },
      "metadata": {
        "tags": [
          "scope",
          "output",
          "domain"
        ],
        "note": "The project's Link: 5 rows in county 26161, zone 261610, grade 0, out of road-type order -- link 1 on road type 5 (0.3 mi, 800 veh/h, 15 mph), link 2 on road type 4 (1.0 mi, 1,000 veh/h, 30 mph), link 3 off-network, link 4 on road type 5 (0.5 mi, 600 veh/h, 25 mph), link 5 on road type 4 (0.7 mi, 1,500 veh/h, 55 mph). Links 4 and 5 share a road type with an earlier link, so they are the locations after the run's three road types (`lnk_locationOrdinal`; `n_projectExtraLinks` 2).",
        "esio_format": "parquet"
      }
    },
    "db_linksourcetypehour": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-multilink/linkSourceTypeHour.parquet"
      },
      "extent": {
        "metaparameter": "n_linksourcetypehour"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "8 rows: links 1, 2, 4 and 5 are 70/30, 80/20, 60/40 and 90/10 percent source types 21 and 32.",
        "esio_format": "parquet"
      }
    },
    "db_offnetworklink": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-multilink/offNetworkLink.parquet"
      },
      "extent": {
        "metaparameter": "n_offnetworklink"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "2 rows in zone 261610: 1,000 passenger cars (start fraction 0.05, parked 0.5) and 400 light commercial trucks (0.08, 0.6), as `washtenaw-project-links`.",
        "esio_format": "parquet"
      }
    },
    "db_opmodedistribution": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-multilink/OpModeDistribution.parquet"
      },
      "extent": {
        "metaparameter": "n_opmodedistribution"
      },
      "metadata": {
        "tags": [
          "domain",
          "operating-mode"
        ],
        "note": "32 rows, all on the off-network link 3 at hourDayID 95: the start modes 101-108 for CO (202) and Total Energy (9102), per source type, as `washtenaw-project-links` states them. No on-network link has a row, so LinkOperatingModeDistributionGenerator computes all four.",
        "esio_format": "parquet"
      }
    },
    "db_runspecdomain": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-project-multilink/runspecdomain.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecdomain"
      },
      "metadata": {
        "tags": [
          "scope",
          "domain"
        ],
        "note": "1 row, modelDomain PROJECT, read by tools/build-scale-input-db.py from project-multilink.xml.",
        "esio_format": "parquet"
      }
    },
