{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-county-timeagg-soak",
    "description": "PLAN.md §7.3.67, step 7f: `washtenaw-county-timeagg` WITH A STATED soakActivityFraction -- `washtenaw_cdb` as moves.rs `characterization/county-inputs/washtenaw-county-timeagg/setup-timeagg.sql` and then `setup-soak-activity.sql` build it for `scale-county-timeagg-soak-day` and `-month`. It is one table over that catalogue, so it MOUNTS that catalogue and declares the one table itself: a mounting document's own data source wins a name clash with a mounted one's (EarthSciAST ref_loading.rs `hoist_subsystem_data_sources`, docs/esm-conventions.md §119), and everything else -- the stated startsPerDay and hotelling tables, the copied rows, the domain -- is `inputs/washtenaw-county-timeagg.esm`'s, unchanged.\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "domain",
      "single-county-domain",
      "time-aggregation",
      "evaporative"
    ]
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsDays": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputSumsHours": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_outputClassicalDay": {
      "type": "integer",
      "default": 1,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_aggregatesMonths": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    },
    "n_statedEnergyProcesses": {
      "type": "integer",
      "default": 0,
      "description": "Relayed to `inputs/washtenaw-county-timeagg.esm`, which says what it is (docs/esm-conventions.md §49.1)."
    }
  },
  "data_sources": {
    "db_soakactivityfraction": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-timeagg-soak/SoakActivityFraction.parquet"
      },
      "extent": {
        "metaparameter": "n_soakactivityfraction"
      },
      "metadata": {
        "tags": [
          "operating-mode",
          "domain"
        ],
        "note": "The county's STATED soakActivityFraction, 1,248 rows (written by `tools/build-scale-input-db.py` from `setup-soak-activity.sql`): every hour-day of the default HourDay at modes 150 and 151, hot soak `0.010 + 0.0015 x hourID + 0.004 x [dayID = 2] + 0.002 x [sourceTypeID = 32] + 0.0003 x monthID` and cold soak the rest of 1; source type 21 at every month, 32 at January only, so July's 32 is TTG-6's own (`evap_soakActivityInputCount`). It shadows `onroad/default-database.esm`'s national table, which has no rows and which MOVES merges under it. Under time aggregation PreAggDAY.sql and PreAggMONTH.sql collapse these rows before TankTemperatureGenerator keeps them (`evap_soakCellWeight`).",
        "esio_format": "parquet"
      }
    }
  },
  "models": {
    "Onroad": {
      "ref": "./washtenaw-county-timeagg.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale",
        "n_outputSumsDays": "n_outputSumsDays",
        "n_outputSumsMonths": "n_outputSumsMonths",
        "n_outputSumsHours": "n_outputSumsHours",
        "n_outputClassicalDay": "n_outputClassicalDay",
        "n_aggregatesMonths": "n_aggregatesMonths",
        "n_statedEnergyProcesses": "n_statedEnergyProcesses"
      }
    }
  }
}
