        ],
        "note": "1 row, modelDomain SINGLE, read by tools/build-scale-input-db.py from scale-county.xml's `<modeldomain value=\"SINGLE\"/>` -- ModelDomain.java's SINGLE_COUNTY.",
        "esio_format": "parquet"
      }
    },
    "db_input_zoneroadtype": {
