{
  "esm": "1.2.0",
  "metadata": {
    "name": "washtenaw-userdb-hotelling-multiyear",
    "description": "PLAN.md §7.3.61: a USER INPUT DATABASE merged into a DEFAULT-domain run -- `washtenaw_cdb` as moves.rs `characterization/county-inputs/washtenaw-userdb-hotelling-multiyear/setup-userdb-hotelling-multiyear.sql` builds it for `userdb-hotelling-multiyear`, which names it in `<databaseselections>`. A county domain database may hold one calendar year only (MOVES refuses two, ImporterManager.java:2311, even with domain validation skipped), so a user database is the way the idle and hotelling ADJUSTMENT tables reach a multi-year run. MOVES merges a user database exactly as it merges a scale input database -- input rows first, then the default's -- so this document is `washtenaw-county-idle-adjust.esm` with two differences: `runspecdomain` is DEFAULT, and `hotellingHoursPerDay` states both years (4 rows). Every other file is byte-identical to that document's (written by `tools/build-scale-input-db.py --copy Zone,ZoneRoadType,hotellingActivityDistribution`).\n\nIT DOES NOT LOAD ALONE: it names no runspec.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "onroad",
      "domain",
      "scale-input-database",
      "idle-adjustment",
      "hotelling-adjustment",
      "user-input-database",
      "multi-year"
    ]
  },
  "data_sources": {
    "db_link": {
      "kind": "static",
      "source": {
        "url_template": "../movesdb/Link.parquet"
      },
      "extent": {
        "metaparameter": "n_link"
      },
      "metadata": {
        "tags": [
          "scope",
          "output",
          "domain"
        ],
        "note": "Link, the default database's national table: MOVES merges it into every domain but PROJECT (InputDataManager.java:1432), so a SINGLE-county run reads the same 22,610 synthetic links a DEFAULT one does, and selects county 26161's on-network and off-network ones by its joins.",
        "esio_format": "parquet"
      }
    },
    "db_linksourcetypehour": {
      "kind": "static",
      "source": {
        "url_template": "../movesdb/linkSourceTypeHour.parquet"
      },
      "extent": {
        "metaparameter": "n_linksourcetypehour"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "linkSourceTypeHour, the default database's: 0 rows, and the user database has none. Only ProjectTAG reads it.",
        "esio_format": "parquet"
      }
    },
    "db_offnetworklink": {
      "kind": "static",
      "source": {
        "url_template": "../movesdb/offNetworkLink.parquet"
      },
      "extent": {
        "metaparameter": "n_offnetworklink"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "offNetworkLink, the default database's: 0 rows. Only ProjectTAG reads it (Starts, SHP, SourceHours and hotelling hours), so a run outside PROJECT domain carries it empty. The user database has none.",
        "esio_format": "parquet"
      }
    },
    "db_opmodedistribution": {
      "kind": "static",
      "source": {
        "url_template": "../movesdb/OpModeDistribution.parquet"
      },
      "extent": {
        "metaparameter": "n_opmodedistribution"
      },
      "metadata": {
        "tags": [
          "domain",
          "operating-mode"
        ],
        "note": "The INPUT opModeDistribution, the default database's: 0 rows. In PROJECT domain the user's start-mode rows are what StartOperatingModeDistributionGenerator reads (`sod_weight`); outside it nothing reads it. The user database has none.",
        "esio_format": "parquet"
      }
    },
    "db_runspecdomain": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/runspecdomain.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecdomain"
      },
      "metadata": {
        "tags": [
          "scope",
          "domain"
        ],
        "note": "1 row, modelDomain DEFAULT, read by tools/build-scale-input-db.py from userdb-hotelling-multiyear.xml's `<modeldomain value=\"DEFAULT\"/>`: the database is a `<databaseselection>`, not a scale input database.",
        "esio_format": "parquet"
      }
    },
    "db_input_zoneroadtype": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/ZoneRoadType.parquet"
      },
      "extent": {
        "metaparameter": "n_inputzoneroadtype"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "The user database's ZoneRoadType: 4 rows at zone 261610 (road types 2-5), `INSERT ... SELECT` copies of the default's, bit for bit (written by `--copy`); the input side of a shadowing row merge whose precedence returns the default's values.",
        "esio_format": "parquet"
      }
    },
    "db_input_hotellingactivitydistribution": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/hotellingActivityDistribution.parquet"
      },
      "extent": {
        "metaparameter": "n_inputhotellingactivitydistribution"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The default's rows at zone 261610, which are none: 0 rows. The default's 36 rows at 990000 merge untouched.",
        "esio_format": "parquet"
      }
    },
    "db_hotellinghoursperday": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/hotellingHoursPerDay.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellinghoursperday"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The user database's hotellingHoursPerDay: 4 rows at zone 261610 -- 2015: 1500 hours on a weekend day, 2900 on a weekday; 2020: 1700 and 2600 -- none the default's daily total. AdjustHotelling.sql's first block (`hot_dayAdjustment`), the one block keyed by year, times the run's two months.",
        "esio_format": "parquet"
      }
    },
    "db_hotellinghourfraction": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/hotellingHourFraction.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellinghourfraction"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The user database's hotellingHourFraction: 47 rows at zone 261610 -- the weekday's 24 hours (sum 0.935) and the weekend's 23 (sum 0.953; hour 8 has no row and keeps its default share). AdjustHotelling.sql's second block (`hot_hourShare`). MOVES cuts it to the run's hours in the execution database. MOVES merges it into the execution database cut to the RunSpec's hours -- 3 of the 47 rows here, both days' hour 7 and the weekday's hour 8 -- so only those hours are rescaled (`hot_hourFractionRows`).",
        "esio_format": "parquet"
      }
    },
    "db_hotellingagefraction": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/hotellingAgeFraction.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellingagefraction"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The user database's hotellingAgeFraction: 30 rows at zone 261610, ages 0-29 (sum 0.696643); ages 30-40 keep their default share. AdjustHotelling.sql's third block (`hot_ageAdjustment`).",
        "esio_format": "parquet"
      }
    },
    "db_hotellingmonthadjust": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/hotellingMonthAdjust.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellingmonthadjust"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The user database's hotellingMonthAdjust: 12 rows at zone 261610, a different adjustment each month (0.85-1.10). AdjustHotelling.sql's fourth block (`hot_monthAdjustment`), relative to the month's default share of the run's months.",
        "esio_format": "parquet"
      }
    },
    "db_idlemodelyeargrouping": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/idleModelYearGrouping.parquet"
      },
      "extent": {
        "metaparameter": "n_idlemodelyeargrouping"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "The user database's idleModelYearGrouping: 6 rows -- source type 21 at 0.30 / 0.26 / 0.22 for model years 1950-2005 / 2006-2014 / 2015-2060, 62 at 0.18 / 0.15 for 1950-2009 / 2010-2060, and 32 at 0.20, which the run does not select and the execution database drops. A row at a selected source type REPLACES totalIdleFraction for every source type (`run_idleGroupingRows`, `oni_groupedIdleFraction`).",
        "esio_format": "parquet"
      }
    },
    "db_idlemonthadjust": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/idleMonthAdjust.parquet"
      },
      "extent": {
        "metaparameter": "n_idlemonthadjust"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "The user database's idleMonthAdjust: 24 rows, source type 21's and 32's twelve months; none for 62, whose fraction is unscaled (`oni_monthAdjustRows`).",
        "esio_format": "parquet"
      }
    },
    "db_idledayadjust": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/idleDayAdjust.parquet"
      },
      "extent": {
        "metaparameter": "n_idledayadjust"
      },
      "metadata": {
        "tags": [
          "domain",
          "activity"
        ],
        "note": "The user database's idleDayAdjust: 3 rows -- source type 21 at 0.92 (weekend) and 1.06 (weekday), 62 at 1.12 on the weekday only (`oni_dayAdjustRows`).",
        "esio_format": "parquet"
      }
    },
    "db_startsperday": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/startsPerDay.parquet"
      },
      "extent": {
        "metaparameter": "n_startsperday"
      },
      "metadata": {
        "tags": [
          "domain",
          "starts"
        ],
        "note": "Created empty: 0 rows. Only one of Starts, StartsPerDay and StartsPerDayPerVehicle may be imported (StartsImporter.sql:334-351), and the database imports the one the default populates, StartsPerDayPerVehicle -- 26 copied rows, identical to the default's and so read from it.",
        "esio_format": "parquet"
      }
    },
    "db_input_zone": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-userdb-hotelling-multiyear/Zone.parquet"
      },
      "extent": {
        "metaparameter": "n_inputzone"
      },
      "metadata": {
        "tags": [
          "domain",
          "starts"
        ],
        "note": "The user database's Zone: 1 row, zone 261610, an `INSERT ... SELECT` copy of the default's, bit for bit (not setup-starts.sql's twelve-decimal truncation). startAllocFactor scales every start.",
        "esio_format": "parquet"
      }
    }
  },
  "metaparameters": {
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "How many (pollutant-process, cohort) PAIRS reach MOVESOutput, summed over the run's emitted blocks. Declared here as well as in the model it mounts for the reason the numbers around it are (docs/esm-conventions.md §49.1): this is the relay that lets a per-fixture document set it. It replaces `n_outputCohort` and `n_outputPolProcess`, which between them could describe only a rectangle. 375 is `process-tirewear`'s, three blocks of 125; a run with one emitted block of 125 needs 125, `expand-fueltype-diesel` 248, `expand-sourcetype` 430 and `expand-criteria` 372. `rateSurvivorCount` recomputes it, so it is a CHECKED declaration."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "How many source bins the widest cohort of the run holds. Declared here as well as in the model it mounts for the reason the two numbers above it are (docs/esm-conventions.md §49.1): this is the relay that lets a per-fixture document set it. 1 is right for a run whose cohorts are single-binned -- a passenger car's are, and so the bin relation is that run's cohort relation row for row -- and a run that selects a light commercial truck needs 2, a refuse truck 8. `run_sourceBinsDropped` recomputes whether the value is enough, so it is a CHECKED declaration."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "How many rows of `sourceusetypephysics` the run's source types select between them -- the width of the drive-cycle axis. Declared here as well as in the model it mounts for the reason the three numbers above it are (docs/esm-conventions.md §49.1): this is the relay that lets a per-fixture document set it. The vehicle a drive cycle is computed for is keyed by (sourceTypeID, regClassID, model-year range), so 1 is right for a motorcycle or a passenger car, a light commercial truck alone needs 3, source types 21 and 32 together 4, and the five of `expand-sourcetype` 40. `run_physicsRowsSelected` recomputes it and `run_physicsRowsDropped` says whether it is enough, so it is a CHECKED declaration."
    },
    "n_ratesScale": {
      "type": "integer",
      "default": 0,
      "description": "The RunSpec's `<modelscale>`: 1 at Rates scale, 0 (the default) at inventory scale. Relayed here as `n_outputRate` is (docs/esm-conventions.md §49.1), so a per-fixture document can bind it (PLAN.md §7.3.47)."
    }
  },
  "models": {
    "Onroad": {
      "ref": "../onroad/default-database.esm",
      "bindings": {
        "n_outputRate": "n_outputRate",
        "n_sourceBin": "n_sourceBin",
        "n_physicsRow": "n_physicsRow",
        "n_ratesScale": "n_ratesScale"
      }
    }
  }
}
