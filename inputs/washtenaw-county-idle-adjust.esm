      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-idle-adjust/hotellingAgeFraction.parquet"
      },
      "extent": {
        "metaparameter": "n_hotellingagefraction"
      },
      "metadata": {
        "tags": [
          "domain",
          "hotelling"
        ],
        "note": "The county's hotellingAgeFraction: 30 rows at zone 261610, ages 0-29 (sum 0.696643); ages 30-40 keep their default share. AdjustHotelling.sql's third block (`hot_ageAdjustment`).",
        "esio_format": "parquet"
      }
    },
    "db_hotellingmonthadjust": {
      "kind": "static",
      "source": {
        "url_template": "./washtenaw-county-idle-adjust/hotellingMonthAdjust.parquet"
