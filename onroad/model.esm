        "run_onNetworkRoadTypeCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many on-network road types the RunSpec selects. One on every RunSpec here: the activity relation carries no road-type axis, so an on-network process is computed on exactly one road type, and `run_selectionUnported` counts a second."
        },
        "run_offNetworkSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "1 when the RunSpec selects the off-network road type 1, where BaseRateGenerator writes the rates of start exhaust, extended idle and auxiliary power and their chained processes. The four `-single` RunSpecs select it beside road type 4."
        },
        "run_selectionUnported": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many things this run SELECTS that the model does not compute, beside its domain (`run_domainUnported`): 0, asserted by tools/check-runspec-shape.py. It counts a second on-network road type (the activity relation has no road-type axis); an on-road pollutant-process (`occursOnRealRoads` = Y) in a run that also selects road type 1, where MOVES writes off-network idle and evaporative SHP rows this model does not; and a hotelling process in a run that aggregates hours or day types, whose hotelling hours AdjustHotelling would rescale before the aggregation. None of these fails loudly -- each emits a plausible number or none. And a chained pollutant-process with parents on both an on-network road type and road type 1 (`run_mixedRoadChains`)."
        },
        "run_onRoadPollutantProcessCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many of the run's pollutant-processes occur on a real road. Read by `run_selectionUnported` only when the run also selects road type 1."
        },
        "zrt_inputRowCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zoneroadtype_rows"
          ],
          "description": "How many INPUT-database ZoneRoadType rows share this default row's key (zoneID, roadTypeID): 0 or 1. MOVES merges the input database first and copies the default's rows only where the key is not yet taken (MasterLoop.java:203-250, INSERT IGNORE by primary key), so a matching input row SHADOWS this one."
        },
        "zrt_inputSHOAllocFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zoneroadtype_rows"
          ],
          "description": "The shadowing input row's SHOAllocFactor, 0 where there is none."
        },
        "zrt_mergedSHOAllocFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zoneroadtype_rows"
          ],
          "description": "THE ROW MERGE, with its precedence written here and not in a file: the input row's value where one shares the key, the default's otherwise. Washtenaw's county database states the four allocation factors truncated to twelve decimal places, which is what its execution database holds; a DEFAULT-domain run has no input rows and reads every default value exactly. Computed on the DEFAULT side's axis because the input side's is mounted empty in most catalogues; an input row whose key the default lacks would be ADDED by the merge and is counted by `run_zoneRoadTypeRowsAdded` instead."
        },
        "run_zoneRoadTypeRowsAdded": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "Input ZoneRoadType rows whose key no default row has: rows the merge would ADD, which every relation computed on the default side's axis cannot see. The input rows less the ones that shadow a default row, keys being unique on both sides. 0 in every catalogue here, and counted by `run_domainUnported`."
        },
        "rspp_isHotelling": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecpollutantprocess_rows"
          ],
          "description": "Whether this pollutant-process is a HOTELLING one -- extended idle (90) or auxiliary power (91). Both take their activity from TotalActivityGenerator's hotelling hours rather than from SHO (BaseRateCalculator.sql's `activity=hotellingHours`), and their operating-mode weights from RatesOperatingModeDistributionGenerator steps 200 and 210 rather than from the speed bins."
        },
        "rt_isHotelling": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether the rate row's pollutant-process is a hotelling one."
        },
        "act_modelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "activity_rows"
          ],
          "description": "The activity row's model year: the analysis year less its age."
        },
        "hot_roadDayVMT": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "activity_rows",
            "runspecsourcetype_rows",
            "runspecmonth_rows",
            "roadtypedistribution_rows"
          ],
          "description": "TotalActivityGenerator's VMTByAgeRoadwayDay.VMT: one age's VMT on one road type on the activity row's day type, summed over the day's 24 hours -- the hourly VMT of S5-S7 (HPMS base-year VMT x road-type share x travel fraction x month share x day share x hour share / weeks per month) on EVERY road type the source type drives, not only the run's. Hotelling is computed from the restricted-access road types whatever the RunSpec selects (the -single runs select 1 and 4, and MOVES's VMTByAgeRoadwayHour for them carries road types 2 to 5)."
        },
        "hot_restrictedTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecyear_rows"
          ],
          "description": "The county's hotelling hours on the two RESTRICTED-ACCESS road types, summed over everything: the test TotalActivityGenerator.java:1846 applies before it decides which road types to keep."
        },
        "run_hotellingHoursPerDayRows": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "Rows in the domain's hotellingHoursPerDay, at any zone: the other half of the java:1846 test."
        },
        "hot_keepsAllRoadTypes": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecyear_rows"
          ],
          "description": "1 when TotalActivityGenerator keeps EVERY road type's VMT for hotelling rather than the restricted-access two: only when those two carry no hotelling at all AND the domain states hotellingHoursPerDay, so that AdjustHotelling has default hours to rescale. 0 on every run here."
        },
        "hot_dailyHours": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "activity_rows",
            "runspeccounty_rows",
            "runspecsourcetype_rows",
            "runspecmonth_rows"
          ],
          "description": "TAG step 180's VMTByAgeRoadwayDay.hotellingHours, summed over the kept road types: daily VMT x the zone's SHOAllocFactor x hotellingRate, for the combination long-haul truck alone (java:1817, `sourceTypeID=62`). The allocation factor is the ROW-MERGED one, so a county database's stated value is what scales it."
        },
        "hot_stmyTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "activity_rows",
            "runspecsourcetype_rows"
          ],
          "description": "sum(stmyFraction) over the sample-vehicle population of the row's source type and model year: what TAG step 190's split of hotelling hours by fuel type sums back to when BaseRateCalculator's `activity=hotellingHours` adds the fuel types up again. 1 for source type 62 at every model year, within 1.3e-16."
        },
        "hot_dayDistribution": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecday_rows",
            "runspecsourcetype_rows"
          ],
          "description": "sum(hotellingdist) over all 24 hours of the day type: the whole day, which AdjustHotelling's default daily total is taken over. 1 within the column's float storage."
        },
        "hot_hourDistribution": {
