        "cae_outputPollutantID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "co2aelink_rows"
          ],
          "description": "THE CO2AE EDGE LIST, pollutant side: what `CO2AERunningStartExtendedIdleCalculator` produces from what. CO2 from Total Energy; CO2 equivalent from CO2, methane and nitrous oxide. MOVES declares these in the calculator's Java `subscribeToMe` (the step-2 input set is the literal \"90,5,6\") and NOT in `pollutantprocessassoc.chainedTo1/2`, which are NULL on 9001 and 9801 -- so no `runspecchainedto` carries them, and they are declared here instead."
        },
        "cae_inputPollutantID": {
