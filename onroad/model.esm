          "lhs": "rspp_outputOrdinal",
          "rhs": {
            "op": "*",
            "args": [
              "rspp_isEmitted",
              "rspp_emittedPrefix"
            ]
          }
        },
        {
          "_comment": "Which of the two RatesOpModeDistribution generators wrote this pollutant-process's weights. Both the reference's constants are process ids and both are named here as enum members.",
          "lhs": "rspp_usesAvgSpeedModes",
