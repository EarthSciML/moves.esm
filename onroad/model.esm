        "stpp_isRegClassReqd": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypepolprocess_rows"
          ],
          "description": "sourceTypePolProcess.isRegClassReqd, Y/N text decoded by a `codes` map. 'N' on 169 of the 611 national rows, and those rows are pollutant-processes 111 (evaporative permeation) and the SO2, NO and NO2 ones at every exhaust process -- and the last three are chained and have no rate rows at all, so permeation is the only process where the flag reaches a number.",
          "update": {
            "kind": "data",
            "source": "db_sourcetypepolprocess",
            "from": {
              "file_variable": "isRegClassReqd",
              "codes": {
                "map": {
                  "Y": 1,
                  "N": 0
                },
                "case_insensitive": true
              }
            }
          }
        },
