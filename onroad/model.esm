          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fueltype_rows",
            "runspecyear_rows"
          ],
          "description": "TVV-8's adjustment of the operating insert's mode-300 rate: `tempAdj x rvpAdj` for a fuel type with an `averageTankGasoline` row, and 0 for one without, because the insert's join to that table is inner. No fuel type without one has a process-12 rate row nationally."
        },
        "rt_isVenting": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether the rate row is fuel vapour venting."
        },
        "rt_ventingAdjustment": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The operating adjustment at the row's fuel type."
        },
        "rff_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.fuelTypeID: 1, 2, 3, 5 and 9. The table's only key, which is why every quantity REFEC-1 and REFEC-2 compute is a property of the fuel and of the hour, and of nothing else.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "fuelTypeID"
            }
