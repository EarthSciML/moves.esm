                                        ]
                                      },
                                      {
                                        "op": "*",
                                        "args": [
                                          "rt_evFraction",
                                          "rt_evMultiplier"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      "rt_adjustmentCap"
                    ]
                  },
                  {
                    "op": "/",
                    "args": [
