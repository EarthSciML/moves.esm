          ],
          "description": "The schedule's operating-mode distribution for this vehicle, drivecycle.rs:330-337."
        },
        "asb_hasSlowerSchedule": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "avgspeedbin_rows",
            "runspecsourcetype_rows"
