          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "etohbin_rows"
          ],
          "description": "etohBin.etohThreshHigh, volume percent, EXCLUSIVE -- `etohThreshLow <= ETOHVolume < etohThreshHigh`.",
          "update": {
            "kind": "data",
            "source": "db_etohbin",
            "from": {
              "file_variable": "etohThreshHigh"
            }
          }
        },
        "run_gpaFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The county's GPA fraction."
        },
        "rt_isPermeation": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether the rate row is evaporative permeation, which `EvaporativePermeationCalculator` computes and not `BaseRateCalculator`: a different weight in S14 and none of S15's adjustments."
        },
        "rt_tankTemperatureGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "PC-6's gate: the tank-temperature group `sourceTypeModelYearGroup` maps this row's (source type, model-year group) to. It is what keeps source type 21's pre-1996 model years (group 5) apart from its later ones (group 3), and picking the other group is a wrong answer, not a missing row."
        },
        "rtDay_permeationTemperatureAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "PC-2a and PC-2b: `SUM(tempAdjustTermA x exp(tempAdjustTermB x averageTankTemperature) x opModeFraction)` over the evaporative operating modes, at the row's tank-temperature group. The operating-mode weights are the ones fuel leaks uses, and on an on-network link they are 0, 0 and 1, so it is mode 300's tank temperature -- TTG-4a's walk -- that reaches the number; modes 150 and 151 are computed and multiplied by exactly 0."
        },
        "rt_fuelMYGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The fuel model-year group of the row's (pollutant-process, model year), the second key of `hcPermeationCoeff`."
        },
        "rt_etohBinShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "etohbin_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The share of the row's fuel type's supply, in the county and month, whose ethanol volume falls in the bin, `etohThreshLow <= ETOHVolume < etohThreshHigh`. The volume is `ffx_ETOHVolume`, AFTER `FuelEffectsGenerator`'s high-ethanol substitution, because that is the `FuelFormulation` the calculator reads in MOVES's execution database: E85 formulation 27002 ships 74 and is read as 10. The national coefficients for bins 1 to 7 are identical, so reading 74 gave the same answer here -- an exact answer by luck, which this removes. The bins are disjoint and cover [0, 100)."
        },
        "rt_permeationFuelAdjustment": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "PC-3's `weightedFuelAdjustment`: `SUM(marketShare x (fuelAdjustment + GPAFract x (fuelAdjustmentGPA - fuelAdjustment)))` over the county's supply of the row's fuel type, through each formulation's ethanol bin (`rt_etohBinShare`), at the row's fuel model-year group. Both keys into `hcPermeationCoeff` are 1-D columns, so the join is a lookup and not a product over the 15,651 national `pollutantProcessModelYear` rows."
        },
        "rtDay_permeationWeight": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "What S14 multiplies a permeation rate by in place of an operating-mode fraction: the weighted temperature adjustment times the weighted fuel adjustment. PC-1b's join to `emissionRateByAge` does not constrain `opModeID`, so the rate is SUMMED over its modes rather than weighted -- every national 111 row is mode 300, so the sum is that one rate. PC-1b's regulatory-class weight does not appear: `RegClassSourceTypeFraction` is a share that sums to 1 over classes for every (source type, fuel, model year) with a positive fuel-usage-weighted sample, and where there is none the rebased activity fraction the rate is multiplied by is itself 0. It is the identity wherever it multiplies anything."
        },
        "ftp_subjectToEvapCalculations": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fueltype_rows"
          ],
          "description": "fuelType.subjectToEvapCalculations, Y/N text decoded by a `codes` map: Y for gasoline and E85 only. TankFuelGenerator's TFG-1a keeps only those fuel types' formulations.",
          "update": {
            "kind": "data",
            "source": "db_fueltype",
            "from": {
              "file_variable": "subjectToEvapCalculations",
              "codes": {
                "map": {
                  "Y": 1,
                  "N": 0
                },
                "case_insensitive": true
              }
            }
          }
        },
