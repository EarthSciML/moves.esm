        },
        {
          "_comment": "S3's denominator (J5): over every (source type, age) in the run's HPMS group. This is the join finding F11 used to force into a second relation over a second index set; it does not need one, because the two sides are different relations.",
          "lhs": "run_travelGroupTotal",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "s"
            ],
            "ranges": {
              "q": {
                "from": "sourcetypeage_rows"
              },
              "s": {
                "from": "runspecsourcetype_rows"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "sta_population",
                        "q"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "sta_relativeMAR",
                        "q"
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "sta_isInHpmsGroup",
                    "q",
                    "s"
                  ]
