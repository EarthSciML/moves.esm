    "n_emissionprocess": {
      "type": "integer",
      "default": 0,
      "description": "Rows in emissionprocess."
    },
    "n_outputRate": {
      "type": "integer",
      "default": 375,
      "description": "How many (pollutant-process, cohort) PAIRS reach MOVESOutput, summed over the run's emitted blocks. It replaces `n_outputCohort` and `n_outputPolProcess`, which between them could describe only a RECTANGLE -- every block the same width -- and a chained block is not the same width as its parent: `NONO2Ratio` and `CrankcaseEmissionRatio` carry no electricity row, so NO, NO2 and HONO emit 104 cohorts where total NOx emits 124 (PLAN.md §7.3.16). 375 is `process-tirewear`'s value, three blocks of 125, and it is the default for the same reason the numbers it replaces had theirs. `rateSurvivorCount` recomputes it from the chain, so it is a CHECKED declaration; `outputPolProcessCount` and `cohortSurvivorCount` still report the two factors separately, which is what says whether a run is ragged."
    },
    "n_sourceBin": {
      "type": "integer",
      "default": 1,
      "description": "THE THIRD DECLARED NUMBER IN THIS DOCUMENT: how many source bins the widest cohort of this run holds. A MOVES source bin is (sourceTypeID, fuelTypeID, modelYearID, regClassID, engTechID) and a cohort is only the first three of those, so one cohort can carry several bins -- `samplevehiclepopulation` gives a passenger car exactly one, a light commercial truck two (regulatory classes 30 and 41) and a refuse truck's diesel eight. The candidate grid needs a DENSE slot count and no table states this one, so it is declared and then CHECKED: `run_sourceBinsDropped` counts the bins a slot short of this would silently lose, and is asserted at 0. 1 is the value of every run that selects a source type whose cohorts are single-binned, which is every run in `runspecs/` before 7e."
    },
    "n_physicsRow": {
      "type": "integer",
      "default": 1,
      "description": "THE FOURTH DECLARED NUMBER IN THIS DOCUMENT: how many rows of `sourceusetypephysics` the run's source types select between them. The vehicle a drive cycle is computed for is keyed by (sourceTypeID, regClassID, model-year range) and NOT by source type -- the national table holds 178 rows over 13 source types, one apiece for a motorcycle and a passenger car, three for a light commercial truck (regulatory class 30, and 41 split at model year 2010 because its fixed mass factor changes from 2.05979 to 5.0), fifteen for a refuse truck and twenty for a combination long-haul truck. The drive cycle is this document's largest relational step -- 63,602 drive-schedule seconds binned into operating modes, once per vehicle -- so its axis is the run's SELECTED physics rows densely ranked, and not the padded product of source types and a slot count that `n_sourceBin` can afford at cohort scale. No table states the number, so it is declared and then CHECKED both ways: `run_physicsRowsSelected` recomputes it from the chain and `run_physicsRowsDropped` counts the selected rows that fall past it, which is asserted at 0. 1 is the value of every run in `runspecs/`, 4 for source types 21 and 32 together, 40 for the five of `expand-sourcetype`."
    },
    "n_runspecpollutantprocess": {
      "type": "integer",
      "default": 0,
      "description": "Rows in runspecpollutantprocess. The FIRST factor of both the rate relation and the output relation: three pollutant-processes here, and a run selecting one more would size both relations differently with no other edit."
    },
    "n_runspecchainedto": {
      "type": "integer",
      "default": 0,
      "description": "Rows in runspecchainedto."
    },
    "n_pm10emissionratio": {
      "type": "integer",
      "default": 0,
      "description": "Rows in pm10emissionratio."
    },
    "n_nono2ratio": {
      "type": "integer",
      "default": 0,
      "description": "Rows in nono2ratio."
    },
    "n_crankcaseemissionratio": {
      "type": "integer",
      "default": 0,
      "description": "Rows in crankcaseemissionratio."
    },
    "n_methanethcratio": {
      "type": "integer",
      "default": 0,
      "description": "Rows in methanethcratio."
    },
    "n_hcspeciation": {
      "type": "integer",
      "default": 0,
      "description": "Rows in hcspeciation."
    },
    "n_atbaseemissions": {
      "type": "integer",
      "default": 0,
      "description": "Rows in atbaseemissions."
    },
    "n_atrationongas": {
      "type": "integer",
      "default": 0,
      "description": "Rows in atrationongas."
    },
    "n_minorhapratio": {
      "type": "integer",
      "default": 0,
      "description": "Rows in minorhapratio."
    },
    "n_pahgasratio": {
      "type": "integer",
      "default": 0,
      "description": "Rows in pahgasratio."
    },
    "n_sulfateemissionrate": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sulfateemissionrate."
    },
    "n_pollutant": {
      "type": "integer",
      "default": 0,
      "description": "Rows in pollutant."
    },
    "n_integratedspeciesset": {
      "type": "integer",
      "default": 0,
      "description": "Rows in integratedspeciesset."
    },
    "n_sourceusetypephysics": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sourceUseTypePhysics."
    },
    "n_sulfatefractions": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sulfatefractions."
    },
    "n_pmspeciation": {
      "type": "integer",
      "default": 0,
      "description": "Rows in pmspeciation."
    },
    "n_soakactivityfraction": {
      "type": "integer",
      "default": 0,
      "description": "Rows in soakActivityFraction. ZERO in the national default database, and zero in every execution-database snapshot this document has been mounted against -- `TankTemperatureGenerator` writes the table and no run in the corpus reaches it. It is mounted anyway, because the difference between a table with no rows and a table that is not read is the whole of E2: the soak modes are ABSENT here, not zero, and an aggregate over an empty relation is the additive identity rather than an assumption this document made (docs/esm-conventions.md §80)."
    },
    "n_opmodepolprocassoc": {
      "type": "integer",
      "default": 0,
      "description": "Rows in opModePolProcAssoc: which operating modes a pollutant-process HAS. 407 nationally, 65 in the tire-wear snapshot. It is what names the evaporative mode set -- 150, 151 and 300 for `polProcessID` 113 -- so that no literal in this document has to."
    },
    "n_refuelingfactors": {
      "type": "integer",
      "default": 0,
      "description": "Rows in refuelingFactors: 5 nationally, one per fuel type MOVES has a refueling coefficient row for. The table is the whole of REFEC-1 and REFEC-2 -- six exponential terms, a temperature window, a tank-temperature ceiling, a vapour floor and a spillage rate."
    },
    "n_refuelingcontroltechnology": {
      "type": "integer",
      "default": 0,
      "description": "Rows in refuelingControlTechnology: 189,379 nationally against the 9,102 the execution-database copy held for one source type and one process. It carries fuel types 1 and 5 ONLY, which is why the displacement block is 64 cohorts where spillage is 104."
    },
    "n_sourcetypetechadjustment": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sourceTypeTechAdjustment: 1,443 nationally against 111 for source type 21. It is the SPILLAGE side's technology penetration, keyed by (process, source type, model year) where the displacement side's is keyed by six columns."
    },
    "n_countyyear": {
      "type": "integer",
      "default": 0,
      "description": "Rows in countyYear: 203,616 nationally against the 1 the execution-database copy held. It carries the two Stage II program reductions, and 7,375 of its rows have a nonzero vapour adjustment -- an arm no run in this corpus reaches, because county 26161's is 0."
    },
    "n_fueltype": {
      "type": "integer",
      "default": 0,
      "description": "Rows in fuelType: 6 nationally. Read for `fuelDensity`, grams per gallon, which with the supply's energy content converts the chained energy to fuel VOLUME. `process-evap-leaks` measured its `subjectToEvapCalculations` flag inert; this is the column that is not."
    },
    "n_spillagecountyyear": {
      "type": "integer",
      "default": 5,
      "description": "Rows in the fuel-type fan-out `RefuelingLossCalculator.sql` synthesises onto `RefuelingCountyYear`. FIVE, and DECLARED because it is not a table: the SQL ALTERs a fuelTypeID column into the county-year extract (existing rows default to gasoline), duplicates the gasoline row as E85, and inserts zero-adjustment rows for fuel types 2, 3 and 9. Most Stage II programs cover E85, and none covers diesel, CNG or electricity."
    },
    "n_sourcetypepolprocess": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sourceTypePolProcess: 611 nationally, one per (source type, pollutant-process) MOVES bins. Read for one column, `isRegClassReqd`, which is what decides whether a source bin keeps its regulatory class."
    },
    "n_samplevehicleday": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sampleVehicleDay: 15,837 nationally, one per sampled vehicle-day, with the vehicle's source type."
    },
    "n_samplevehicletrip": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sampleVehicleTrip: 37,216 nationally, of which 5,458 are MARKER rows (no key-on time and no predecessor) that `flagMarkerTrips` removes. This is the axis `TankTemperatureGenerator`'s recurrence runs along -- an extent the mount discovers, so no RunSpec declares a length for it and a run that selects no evaporative process masks every row rather than sizing the relation at 0 (finding F56)."
    },
    "n_tanktemperaturerise": {
      "type": "integer",
      "default": 0,
      "description": "Rows in tankTemperatureRise: 16, one per tank-temperature group, each with the two coefficients of TTG-4a's operating rise."
    },
    "n_sourcetypemodelyeargroup": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sourceTypeModelYearGroup: 481 nationally. It maps a (source type, model-year group) to a tank-temperature group, which is both TTG-4a's `TempVehAndTTG` cross and PC-6's gate."
    },
    "n_hcpermeationcoeff": {
      "type": "integer",
      "default": 0,
      "description": "Rows in hcPermeationCoeff: 120 nationally, all of them polProcess 111 -- PC-3's fuel adjustment per (ethanol bin, fuel model-year group)."
    },
    "n_etohbin": {
      "type": "integer",
      "default": 0,
      "description": "Rows in etohBin: 8 ethanol-volume brackets, the key hcPermeationCoeff is reached through."
    },
    "n_evaptemperatureadjustment": {
      "type": "integer",
      "default": 0,
      "description": "Rows in evapTemperatureAdjustment: 1 nationally, process 12's temperature cubic."
    },
    "n_evaprvptemperatureadjustment": {
      "type": "integer",
      "default": 0,
      "description": "Rows in evapRVPTemperatureAdjustment: 8 nationally, process 12's cubic at RVP knots 7, 8, 9 and 10 for fuel types 1 and 5."
    },
    "n_linksourcetypehour": {
      "type": "integer",
      "default": 0,
      "description": "Rows in linkSourceTypeHour: the run's DOMAIN's table, declared by the document that mounts the default database (moves-onroad.esm for a DEFAULT-domain run, where it is the default database's own and has 0 rows; a project database's in inputs/). Never a computed axis: it is 0 in every DEFAULT-domain catalogue, and a variable shaped over it would be F56."
    },
    "n_runspecdomain": {
      "type": "integer",
      "default": 0,
      "description": "Rows in runspecdomain: 1, the RunSpec's `<modeldomain>`. `run_domainUnported` asserts the 1."
    },
    "n_sourcetypehour": {
      "type": "integer",
      "default": 0,
      "description": "Rows in sourceTypeHour: 48 nationally, source type 62 alone, 24 hours x 2 day types. Its `hotellingdist` is how TotalActivityGenerator spreads a day's hotelling hours over the hours of that day."
    },
    "n_hotellingcalendaryear": {
      "type": "integer",
      "default": 0,
      "description": "Rows in hotellingCalendarYear: 63, one per calendar year."
    },
    "n_hotellingactivitydistribution": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the DEFAULT database's hotellingActivityDistribution: 36, all at the national placeholder zone 990000. The default side of a row merge."
    },
    "n_inputhotellingactivitydistribution": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the INPUT database's hotellingActivityDistribution: the other side of the row merge, declared by the run's DOMAIN document. Zero in a DEFAULT-domain run, which has no input database, and in `washtenaw-project`, whose copy selects zone 261610 from a default table that has no row there; 12 in the Washtenaw county database, all at zone 261610 and diesel. Every variable computed from it is computed on the DEFAULT side's axis or reduced to a run-level count: this axis is mounted EMPTY in most catalogues, and a relation materialised over an empty axis is F56 (docs/esm-conventions.md 92)."
    },
    "n_inputzoneroadtype": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the INPUT database's ZoneRoadType, declared by the run's domain document: zero in a DEFAULT-domain run, 4 in `washtenaw-project` (copies of the default's rows at zone 261610) and 4 in the Washtenaw county database (the default's values TRUNCATED to twelve decimal places, up to 5.75e-10 relative). The other side of a row merge whose precedence `zrt_mergedSHOAllocFactor` writes."
    },
    "n_hotellinghoursperday": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the domain's hotellingHoursPerDay. The default database's has none, so MOVES's row merge is the input database's table, and the domain document declares it whole: 0 in a DEFAULT-domain run and in `washtenaw-project`, 2 in the Washtenaw county hotelling database (weekend and weekday, zone 261610, 2020)."
    },
    "n_hotellinghourfraction": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the domain's hotellinghourfraction: empty in the default database, in `washtenaw-project` and in both Washtenaw county databases. AdjustHotelling.sql's three other user adjustments read it; none is ported, and `run_domainUnported` counts a row at a run's zone rather than ignoring it."
    },
    "n_hotellingagefraction": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the domain's hotellingagefraction: empty in the default database, in `washtenaw-project` and in both Washtenaw county databases. AdjustHotelling.sql's three other user adjustments read it; none is ported, and `run_domainUnported` counts a row at a run's zone rather than ignoring it."
    },
    "n_hotellingmonthadjust": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the domain's hotellingmonthadjust: empty in the default database, in `washtenaw-project` and in both Washtenaw county databases. AdjustHotelling.sql's three other user adjustments read it; none is ported, and `run_domainUnported` counts a row at a run's zone rather than ignoring it."
    },
    "n_startsopmodedistribution": {
      "type": "integer",
      "default": 0,
      "description": "Rows in startsOpModeDistribution: 204,672 nationally, every (day type, hour, source type, age) with its eight start modes 101-108. Its fractions do not vary with age in the default database, measured: 4,992 (day, hour, source type, mode) keys, one fraction each."
    },
    "n_startsperdaypervehicle": {
      "type": "integer",
      "default": 0,
      "description": "Rows in startsPerDayPerVehicle: starts per vehicle per day, by day type and source type."
    },
    "n_startsageadjustment": {
      "type": "integer",
      "default": 0,
      "description": "Rows in startsAgeAdjustment: the relative start rate of each age."
    },
    "n_startsmonthadjust": {
      "type": "integer",
      "default": 0,
      "description": "Rows in startsMonthAdjust."
    },
    "n_startshourfraction": {
      "type": "integer",
      "default": 0,
      "description": "Rows in startsHourFraction: the share of a day's starts in each hour."
    },
    "n_starttempadjustment": {
      "type": "integer",
      "default": 0,
      "description": "Rows in StartTempAdjustment: 9,952 nationally, a temperature term per (fuel type, pollutant-process, model-year group, start mode)."
    },
    "n_startsperday": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the domain's startsPerDay. The default database's is empty, so MOVES's row merge is the input database's table, declared whole by the domain document: 0 in every catalogue but the Washtenaw starts county database, whose 2 rows are source type 21's weekday and weekend totals."
    },
    "n_zone": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the default database's Zone: 3,232, one per county."
    },
    "n_inputzone": {
      "type": "integer",
      "default": 0,
      "description": "Rows in the INPUT database's Zone, declared by the domain: 0 in a DEFAULT-domain run, 1 in `washtenaw-project` (a copy of the default's row) and 1 in each Washtenaw county database, whose allocation factors are the default's truncated to twelve decimals (1.6e-10)."
    }
  },
