        "hcs_speciationConstant": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "hcspeciation_rows"
          ],
          "description": "hcspeciation.speciationConstant, the NMHC-to-species factor.",
          "update": {
            "kind": "data",
            "source": "db_hcspeciation",
            "from": {
