                      "op": "*",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "rt_tempAdjustTermB",
                            "b"
                          ]
                        },
                        {
                          "op": "const",
                          "args": [],
                          "value": 1.0,
                          "units": "degF^2"
                        }
