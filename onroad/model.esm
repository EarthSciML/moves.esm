              }
            },
            "join": [
              {
                "on": [
                  [
                    "rt_fuelTypeID",
                    "nha_fuelTypeID"
                  ],
                  [
                    "nha_humidityNOxEq",
                    "run_humidityEqCFR1065"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "apply_expression_template",
              "args": [],
