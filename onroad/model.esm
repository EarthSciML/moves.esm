            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "stta_modelYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypetechadjustment_rows"
          ],
          "description": "sourceTypeTechAdjustment.modelYearID, 1950-2060.",
          "update": {
            "kind": "data",
            "source": "db_sourcetypetechadjustment",
            "from": {
              "file_variable": "modelYearID"
            }
          }
        },
        "stta_refuelingTechAdjustment": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypetechadjustment_rows"
          ],
          "description": "sourceTypeTechAdjustment.refuelingTechAdjustment: 0 through 1995 and 0.5 from 1996 for source type 21. The spillage side's penetration, and it has no fuel type and no regulatory class -- a coarser key than the displacement side's, which is why the two adjustments cannot share a lookup.",
          "update": {
            "kind": "data",
            "source": "db_sourcetypetechadjustment",
            "from": {
              "file_variable": "refuelingTechAdjustment"
            }
          }
        },
        "cyr_countyID": {
