              "h": {
                "from": "aggregationhour_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_monthGroupID",
                    "mgh_monthGroupID"
                  ],
                  [
                    "ahr_hourID",
                    "mgh_hourID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "mgh_ACActivityTermC",
                    "x"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "met_cellShare",
                    "d",
                    "h"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "setup.rs:409 before the clamp, in Horner form as the canonical SQL writes it: A + h(B + Ch).",
          "lhs": "run_acActivityRaw",
          "rhs": {
            "op": "+",
            "args": [
              "run_acActivityTermA",
              {
                "op": "*",
                "args": [
                  "run_heatIndex",
                  {
                    "op": "+",
                    "args": [
                      "run_acActivityTermB",
                      {
                        "op": "*",
                        "args": [
                          "run_acActivityTermC",
                          "run_heatIndex"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": "run_acActivity",
          "rhs": {
            "op": "min",
            "args": [
              {
                "op": "max",
                "args": [
                  "run_acActivityRaw",
                  0.0
                ]
              },
              1.0
            ]
          }
        },
        {
          "lhs": "run_evTemperatureIsSuppressed",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "g",
              "s",
              "m"
            ],
            "ranges": {
              "g": {
                "from": "runspeccounty_rows"
              },
              "n": {
                "from": "run_rows"
              },
              "s": {
                "from": "runspecsourcetype_rows"
              },
              "m": {
                "from": "runspecmonth_rows"
              }
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "<",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "rst_sourceTypeID",
                            "n"
                          ]
                        },
                        "evTemperatureSourceTypeCeiling"
                      ]
                    },
                    {
                      "op": ">",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "run_heatIndex",
                            "g",
                            "m"
                          ]
                        },
                        "evTemperatureSuppressionHeatIndex"
                      ]
                    }
                  ]
                },
                1.0,
                0.0
              ]
            }
          }
        },
        {
          "_comment": "J28: the run's temperature is a CELL-WEIGHTED MEAN over its time cells, not a lookup at one hour. On the five runs that do not aggregate there is one cell, the share is 1, and this is the table's own value at the run's hour.",
          "lhs": "run_temperature",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "g",
              "m"
            ],
            "ranges": {
              "g": {
                "from": "runspeccounty_rows"
              },
              "m": {
                "from": "runspecmonth_rows"
              },
              "z": {
                "from": "zonemonthhour_rows"
              },
              "d": {
                "from": "rateday_rows"
              },
              "h": {
                "from": "aggregationhour_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_zoneID",
                    "zmh_zoneID"
                  ],
                  [
                    "run_monthID",
                    "zmh_monthID"
                  ],
                  [
                    "ahr_hourID",
                    "zmh_hourID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "zmh_temperature",
                    "z"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "met_cellShare",
                    "d",
                    "h"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "run_relHumidity",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "g",
              "m"
            ],
            "ranges": {
              "g": {
                "from": "runspeccounty_rows"
              },
              "m": {
                "from": "runspecmonth_rows"
              },
              "z": {
                "from": "zonemonthhour_rows"
              },
              "d": {
                "from": "rateday_rows"
              },
              "h": {
                "from": "aggregationhour_rows"
              }
            },
            "join": [
              {
                "on": [
