      "description": "Rows in evefficiency."
    },
    "n_emissionrateadjustment": {
      "type": "integer",
      "default": 0,
      "description": "Rows in emissionrateadjustment."
    },
    "n_regioncounty": {
      "type": "integer",
      "default": 0,
      "description": "Rows in regionCounty."
    },
    "n_fuelsupply": {
      "type": "integer",
      "default": 0,
