        "run_needsTankTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "Whether the run selects a process `TankTemperatureGenerator` subscribes to -- evaporative permeation (11), fuel vapour venting (12) or fuel leaks (13). MOVES does not run the generator otherwise, and this document then walks no trip at all: every row of the recurrence takes the not-walked sentinel, which is cheap, instead of the relation being sized at 0, which is fatal (F56)."
        },
        "run_firstHourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The hour TTG-1b's recurrence is anchored at, 1, as a one-row relation so that the anchor is selected by KEY (docs/esm-conventions.md 3), exactly as components/tank_temperature.esm does it."
        },
        "run_firstTimeStepID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The quarter-hour step of that anchor, and the step TTG-1c keeps, 1."
        },
        "hod_hourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "hourofday_rows"
          ],
          "description": "The 24 hours of the day, 1 to 24. The soak walks hours, not rows of any table, so this axis is the document's own."
        },
        "hod_nextHourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "hourofday_rows"
          ],
          "description": "next(24) = 1: TTG-1a interpolates toward the following hour and wraps at midnight."
        },
        "ttg_ambientTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "hourofday_rows"
          ],
          "description": "zoneMonthHour.temperature at the county's zone and the run's month, per hour of the day. The national table is complete -- 3,232 zones x 12 months x 24 hours is its 930,816 rows -- so no hour is missing, and TTG-1a's rule that an hour needs its successor's temperature too never bites."
        },
        "tqh_hourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "quarterhour_rows"
          ],
          "description": "The quarter-hour axis's hour, `floor((k - 1) / 4) + 1`."
        },
        "tqh_timeStepID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "quarterhour_rows"
          ],
          "description": "The quarter-hour axis's step within its hour, 1 to 4."
        },
        "tqh_nextHourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "quarterhour_rows"
          ],
          "description": "The hour TTG-1a interpolates toward."
        },
        "ttg_qhTemperatureAtHour": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "quarterhour_rows"
          ],
          "description": "J-TTG-1: the ambient temperature of the quarter-hour's own hour."
        },
        "ttg_qhTemperatureAtNextHour": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "quarterhour_rows"
          ],
          "description": "J-TTG-2: the ambient temperature of the hour after it."
        },
        "ttg_qhTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "quarterhour_rows"
          ],
          "description": "TTG-1a's `QuarterHourTemperature`, linear between the hour and the next."
        },
        "ttg_firstTankTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "`firstQHTankTemperature`, selected by key at hour 1 step 1."
        },
        "ttg_qhDeltaSum": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "quarterhour_rows"
          ],
          "description": "TTG-1b's `sumTempDelta`, the recurrence components/tank_temperature.esm checks against three captured MOVES intermediates with 64 assertions -- the same equation, now per county and month."
        },
        "ttg_qhTankTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "quarterhour_rows"
          ],
          "description": "TTG-1b's `QuarterHourTankTemperature`, read from the recurrence one cell behind."
        },
        "ttg_coldSoakTankTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "hourofday_rows"
          ],
          "description": "TTG-1c's `ColdSoakTankTemperature`: the parked tank's temperature at the top of each hour. It is operating mode 151's average tank temperature, the key-on temperature of every trip that starts cold, and three degrees below the point where a hot soak ends."
        },
        "trp_hasKeyOn": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether keyOnTime is present: a NaN is the one value not equal to itself."
        },
        "trp_hasPrior": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether priorTripID is present."
        },
        "trp_isMarker": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "`flagMarkerTrips`: a row with neither a key-on time nor a predecessor is a MARKER, 5,458 of the national 37,216. It is not a trip. The recurrence carries the state across it unchanged, which is what keeps every real trip's predecessor at lag 1."
        },
        "trp_keyOnTime": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "keyOnTime with the marker's NULL as 0, which no arithmetic reaches."
        },
        "trp_priorTripID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "priorTripID with NULL as 0."
        },
        "trp_priorIsMarker": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether the predecessor this row names is a marker row of the same vehicle-day."
        },
        "trp_effectivePriorTripID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The predecessor after `flagMarkerTrips`: 0 -- a FIRST trip of the day, which starts at the cold-soak temperature -- where there is none or where it is a marker."
        },
        "trp_previousTripID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The tripID of the nearest earlier non-marker row of the same vehicle-day, 0 if none. On the national file this IS the predecessor on all 26,193 chained trips (docs/evap-permeation.md 8.1), which is what makes the recurrence lag 1."
        },
        "trp_isChained": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether the row immediately before this one in the walk is this trip's predecessor. Where it is not -- the predecessor is absent from the table, 17 national trips -- MOVES's work queue never reaches the trip, and this document says so with the not-walked sentinel rather than by guessing a key-on temperature."
        },
        "trp_hasVehicleDay": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether the trip's vehicle-day is sampled at all."
        },
        "trp_sourceTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The trip's source type, from sampleVehicleDay."
        },
        "trp_isRunDay": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether the trip's day type is one the run selects."
        },
        "trp_isRunSourceType": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether the trip's source type is one the run selects."
        },
        "trp_isWalkable": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The execution database's narrowing, done here: a real trip of a vehicle-day of a selected source type on a selected day, in a run that runs the generator at all."
        },
        "trp_nextKeyOnTime": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "TTG-3's bound on the soak: the key-on time of the trip whose effective predecessor this is."
        },
        "trp_hasNextTrip": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether there is such a trip. Without one the soak runs to the end of the day."
        },
        "trp_firstEndOfHour": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "TTG-2's `endOfHour` for the first segment, `(floor(keyOn / 60) + 1) x 60`."
        },
        "trp_segmentCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "TTG-2's segment count: 1 if the trip ends in its first hour, else one more per hour it reaches. Up to 22 nationally."
        },
        "trp_lastHourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The hour of the trip's last segment, which is where its soak starts."
        },
        "trp_lastEndOfHour": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The `endOfHour` of the last segment."
        },
        "trp_soakSliceCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "TTG-3's slice count: 1 if the next trip starts in the same hour, else one more per hour until it does, and to hour 24 when there is none."
        },
        "trp_firstSegmentMinutes": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The first segment's duration: to key-off, or to the end of its hour."
        },
        "trp_lastSegmentMinutes": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The last segment's duration, from `endOfHour + 1` of the one before -- a minute is lost at every hour boundary, as the Java loses it."
        },
        "trp_runHourSegment": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Which of the trip's segments falls in the run's hour, counting from 1; beyond `trp_segmentCount` means none. A trip spans at most 22 hours, so at most one."
        },
        "trp_runHourSlice": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Which of the trip's soak slices falls in the run's hour."
        },
        "trp_coldSoakAtStart": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The cold-soak tank temperature of the trip's starting hour: its key-on temperature when it starts cold."
        },
        "tsl_slotID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "soakslice_rows"
          ],
          "description": "The soak's slices, 1 to 24, counted from the trip's last hour."
        },
        "tsk_hourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The hour a slice falls in, wrapping past midnight."
        },
        "tsk_isSlice": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "Whether the slot is one of the trip's `trp_soakSliceCount` slices."
        },
        "tsk_begin": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "TTG-3's `hotSoakBegin`: the key-off minute for the first slice, `endOfHour + 1` for every later one."
        },
        "tsk_end": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "TTG-3's `hotSoakEnd`: the next trip's key-on minute if it falls in the slice's hour, else the end of the hour."
        },
        "tsk_minutes": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The minutes TTG-4b walks in the slice, `max(0, end - begin)`. It is -1 before the clamp when the next trip starts exactly at the end of an hour, and MOVES's `for` loop then runs zero times -- the case that made the closed form disagree with the reference on 11 slices before it was written."
        },
        "tsk_minutesBefore": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The minutes walked in earlier slices of the same soak."
        },
        "tsk_entryDecay": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "How much of the key-off temperature survives to the slice's first minute: the retention to the power of `tsk_minutesBefore`. A slice's entry temperature is `tsk_entryDecay x keyOff + tsk_entryOffset`."
        },
        "tsk_isActive": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "A real slice with at least one minute. Only the first and the last slice of a soak can have none, and a zero-minute first slice is followed by others."
        },
        "tsk_laterActiveCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "How many active slices follow this one."
        },
        "tsk_isLastActive": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The last active slice, whose last minute is the temperature the soak ends at."
        },
        "tsk_ambientTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The slice's hour's ambient temperature, what the tank decays toward."
        },
        "tsk_coldSoakTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The slice's hour's cold-soak tank temperature. The soak ends at the first minute the tank is not above it plus `hot_soak_margin`."
        },
        "tsk_entryOffset": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The part of a slice's entry temperature that the ambient contributes: each earlier slice pulls the tank toward its own hour's ambient by one minus its retention, and every later slice's retention discounts that."
        },
        "tsk_stopThreshold": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The highest key-off temperature for which the soak stops IN this slice. Both ends of the slice are affine in the key-off temperature and the decay is monotone between them, so this one number is the whole of TTG-4b's early stop for the slice."
        },
        "tsk_stopThresholdBefore": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "samplevehicletrip_rows",
            "soakslice_rows"
          ],
          "description": "The same threshold over the EARLIER slices: a key-off temperature at or below it means the soak had already stopped and this slice records nothing. Minus infinity, the identity of `max_product`, when there are none."
        },
        "trp_soakStopThreshold": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The threshold over the whole soak: a key-off temperature at or below it ends the soak cold, and the next trip starts at the cold-soak temperature."
        },
        "trp_hasActiveSlice": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether the soak walks any minute at all."
        },
        "trp_soakEndSlope": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "The soak's end temperature is `slope x keyOff + offset` when it does not stop: the retention through the last active slice's last minute."
        },
        "trp_soakEndOffset": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The ambient's part of that end temperature."
        },
        "ttg_groupApplies": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "TTG-4a's `TempVehAndTTG`: every tank-temperature group of the trip's source type, whatever the vehicle's model year. Source type 21's vehicles are each walked twice, as group 3 and as group 5."
        },
        "ttg_riseSlope": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The trip's operating rise is AFFINE in its key-on temperature: this is its slope, the product of the segments' `segment_rise_slope`s."
        },
        "ttg_riseIntercept": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "And its intercept, the uncapped rise from 0 degF. The key-off temperature is `min(140, slope x keyOn + intercept)`; the cap is applied once because it is absorbing."
        },
        "ttg_tripState": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "THE RECURRENCE (esm-spec 4.3.1.1): the tank temperature a trip's soak ends at, or a sentinel. Its body reads `index(ttg_tripState, g, n, u, i - 1)` -- itself, one row earlier along the trip axis, the other three axes identity -- and that one read is TTG-4a's work queue. A marker row carries the state through; a real trip computes its key-on temperature from its predecessor's state (`trip_key_on_temperature`), rises through its segments to its key-off temperature (`trip_temperature_after`), and soaks (`soak_end_temperature`). Probed at 37,216 rows by 16 groups on the ingest path: 2.2 s."
        },
        "ttg_keyOnTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The trip's key-on temperature, read from the recurrence one row behind with the same template the recurrence uses."
        },
        "ttg_isWalked": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "Whether MOVES's work queue reaches the trip for this group -- `OperatingTemperature` has its segments."
        },
        "ttg_keyOffTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The trip's key-off temperature, after all its segments."
        },
        "ttg_runHourKeyOn": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The key-on temperature of the trip's segment in the run's hour."
        },
        "ttg_runHourKeyOff": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The key-off temperature of that segment."
        },
        "trp_hasRunHourSegment": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "Whether the trip has a segment in the run's hour."
        },
        "trp_runHourSegmentMinutes": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "samplevehicletrip_rows"
          ],
          "description": "That segment's duration, TTG-5's weight."
        },
        "ttg_hotSoakMinutes": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The minutes of the trip's soak TTG-4b records in the run's hour: all of the slice's, or up to the minute it stops, or none if it had already stopped."
        },
        "ttg_hotSoakTemperatureSum": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "tanktemperaturerise_rows",
            "samplevehicletrip_rows"
          ],
          "description": "The sum of those minutes' soak tank temperatures, a geometric series."
        },
        "ttg_runningMinutes": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecday_rows",
            "tanktemperaturerise_rows"
          ],
          "description": "TTG-5's denominator for operating mode 300: segment minutes in the run's hour-day."
        },
        "ttg_runningTemperatureMinutes": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecday_rows",
            "tanktemperaturerise_rows"
          ],
          "description": "Its numerator, `SUM(minutes x (keyOnTemp + keyOffTemp) / 2)`."
        },
        "ttg_hotSoakMinuteCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecday_rows",
            "tanktemperaturerise_rows"
          ],
          "description": "TTG-5's count of recorded hot-soak minutes in the hour-day. Group 5's is 1,058 on process-evap-permeation, the number MOVES's stored soakActivityFraction implies (PLAN.md 7.3.27)."
        },
        "ttg_hotSoakTemperatureTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecday_rows",
            "tanktemperaturerise_rows"
          ],
          "description": "Their summed temperature."
        },
        "ttg_coldSoakAtRunHour": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The cold-soak tank temperature at the run's hour."
        },
        "ttg_averageTankTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecday_rows",
            "tanktemperaturerise_rows",
            "operating_mode_rows"
          ],
          "description": "TTG-5's `AverageTankTemperature` at the run's hour-day: mode 300 the minute-weighted mean over operating segments, mode 150 the mean over recorded hot-soak minutes, mode 151 the cold-soak tank temperature. EMPTY in the default database, as all four of the generator's outputs are, and computed here."
        },
        "ttg_hasAverageTankTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecday_rows",
            "tanktemperaturerise_rows",
            "operating_mode_rows"
          ],
          "description": "Whether TTG-5 writes the row: modes 300 and 151 where the group has an operating segment in the hour-day, mode 150 where it has a recorded hot-soak minute."
        },
        "ppmy_fuelMYGroupID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "pollutantprocessmodelyear_rows"
          ],
          "description": "pollutantprocessmodelyear.fuelMYGroupID: the fuel model-year group PC-3 reaches `hcPermeationCoeff` through. With an empty `modelYearMapping` -- it is empty nationally -- `PollutantProcessMappedModelYear` is this table unchanged, which is why it is not mounted separately.",
