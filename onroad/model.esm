        {
          "_comment": "`fuelMYGroupID` encodes its own range: `19972000` is 1997 to 2000. Canonical reads a leading 0 as 1950; no group in this table is below 10000, so that arm is carried and never taken -- written down rather than dropped, because the next database is not this one.",
          "lhs": "cmx_sulfurGroupFirstYear",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "<",
                "args": [
                  {
                    "op": "floor",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          "smc_fuelMYGroupID",
                          10000.0
                        ]
                      }
                    ]
                  },
                  0.5
                ]
              },
              1950.0,
              {
                "op": "floor",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      "smc_fuelMYGroupID",
                      10000.0
                    ]
                  }
                ]
              }
            ]
          }
        },
