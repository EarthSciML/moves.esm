        },
        "yr_isBaseYear": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "year_rows"
          ],
          "description": "year.isBaseYear, Y/N text decoded by a `codes` map on the binding -- a text column is a hard error at the ingest boundary without one. S1 uses it, and it is Y for 2020, which is why §1.5's two folds collapse.",
          "update": {
            "kind": "data",
            "source": "db_year",
            "from": {
              "file_variable": "isBaseYear",
              "codes": {
                "map": {
                  "Y": 1,
                  "N": 0
                },
                "case_insensitive": true
              }
            }
          }
        },
