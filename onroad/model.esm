        "cyr_refuelingVaporProgramAdjust": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "countyyear_rows"
          ],
          "description": "countyYear.refuelingVaporProgramAdjust: the Stage II vapour-recovery reduction P, applied as (1 - P). EXACTLY 0 for county 26161 in 2020, and nonzero in 7,375 of the national table's 203,616 rows -- so the arm is real data that no run in this corpus reaches, and `components/refueling_loss_rate.esm` probes it at 0.2.",
          "update": {
            "kind": "data",
            "source": "db_countyyear",
            "from": {
              "file_variable": "refuelingVaporProgramAdjust"
            }
          }
        },
        "cyr_refuelingSpillProgramAdjust": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "countyyear_rows"
          ],
          "description": "countyYear.refuelingSpillProgramAdjust, the same reduction on the spillage side. Nonzero in 7,154 national rows; probed at 0.3.",
          "update": {
            "kind": "data",
            "source": "db_countyyear",
            "from": {
              "file_variable": "refuelingSpillProgramAdjust"
            }
          }
        },
        "ftp_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fueltype_rows"
          ],
          "description": "fuelType.fuelTypeID.",
          "update": {
            "kind": "data",
            "source": "db_fueltype",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "ftp_fuelDensity": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fueltype_rows"
          ],
          "description": "fuelType.fuelDensity, grams per gallon: 2829 gasoline, 3203 diesel, 2944 E85, and NULL for CNG and electricity. The NULL is the `fuelDensity > 0` half of REFEC-7's inner join, and it is why an electricity cohort carries no refueling row at all rather than a zero one.",
          "update": {
            "kind": "data",
            "source": "db_fueltype",
            "from": {
              "file_variable": "fuelDensity"
            }
          }
        },
        "rff_averageRVP": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "REFEC-2's `RefuelingAverageRVP`: the market-share-weighted Reid vapour pressure of this fuel type's supply, in the county and month. 8.0 for gasoline and 7.7 for E85 in the one-county runs, and 0 for the three fuels whose formulations carry no RVP -- a zero that reaches the exponential and is harmless there because `vaporTermD` is zero on exactly those fuels."
        },
        "rff_energyContent": {
          "type": "unknown",
          "units": "MJ/kg",
          "shape": [
            "refuelingfactors_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "The `RefuelingFuelType` extract's first column: the market-share-weighted energy content of the same supply, kJ per gram. Summed over the formulations of this fuel type, as `rt_supplyEnergyContent` is over a rate row's -- but on FIVE rows instead of thousands, because everything REFEC-7 needs is a property of the fuel. Electricity's subtype carries NULL and the extract's `WHERE energyContent > 0` is what keeps the NaN out of the divisor."
        },
        "rff_fuelDensity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "`fuelType.fuelDensity` at this coefficient row's fuel, grams per gallon. Zero where the column is NULL, which is CNG and electricity."
        },
        "rff_fuelVolumeDivisor": {
          "type": "unknown",
          "units": "MJ/kg",
          "shape": [
            "refuelingfactors_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "kJ per gallon: energy content times fuel density. Dividing the chained Total Energy Consumption by it turns energy into fuel VOLUME, which is what both refueling rates are per."
        },
        "rff_hasFuelDivisor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "REFEC-7's INNER JOIN onto `RefuelingFuelType`, whose extract keeps only `energyContent > 0 AND fuelDensity > 0`. Electricity fails BOTH and CNG fails one, and this is the presence flag that makes an electricity cohort carry no refueling row rather than a zero one -- conventions 30, tested on its own flag and not on the divisor's value."
        },
        "rff_refuelingTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "REFEC-1: the 2008 California study relation 20.30 + 0.81 t, with t the hour's ambient temperature clamped to [vaporLowTLimit, vaporHighTLimit] -- and the ambient temperature UNCHANGED where both limits are zero, which is how the table spells `this fuel has no relation`. 68.495 degF for gasoline and E85 at 59.5 degF ambient."
        },
        "rff_tankTemperatureDif": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "REFEC-1: `vaporTermE x refuelingTemperature + vaporTermF`, clamped to [0, tankTDiffLimit]. 12.03091 at this corpus's one temperature, inside the [0, 20] window, so neither clamp fires here and `components/refueling_loss_rate.esm` is where both arms are exercised."
        },
        "rff_displacedVaporRateRaw": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "REFEC-2 before the floor: `exp(A + B dif + C T + D rvp)`, grams of vapour displaced per gallon delivered."
        },
        "rff_displacedVaporRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "REFEC-2 after the floor. `minimumRefuelingVaporLoss` is a floor where it is above -1 and a SENTINEL meaning `zero this rate` where it is -1 or below, which is what the three non-gasoline fuels carry: 3.0152931 g/gallon for gasoline, 2.8986556 for E85 and exactly 0 for the rest."
        },
        "phys_realSourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "physics_rows"
          ],
          "description": "sourceUseTypePhysics.sourceTypeID. It was `sourceUseTypePhysicsMapping.realSourceTypeID` until 7c': that table is the same rows with this column renamed and two added (tempSourceTypeID, opModeIDOffset), neither of which is read here, and the default database does not ship it because MOVES synthesises it at execution time.",
          "update": {
            "kind": "data",
            "source": "db_sourceusetypephysics",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "phys_regClassID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "physics_rows"
          ],
          "description": "sourceUseTypePhysics.regClassID. The key column that makes this table finer than the source type, and the one `aggregate.rs:352` matches a rate row's own regulatory class against before a drive cycle may weight it.",
          "update": {
            "kind": "data",
            "source": "db_sourceusetypephysics",
            "from": {
              "file_variable": "regClassID"
            }
          }
        },
        "phys_beginModelYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "physics_rows"
          ],
          "description": "sourceUseTypePhysics.beginModelYearID. The row applies to a RANGE of model years, so the rate row reaches it through a containment test and not an equality (aggregate.rs:354-358).",
          "update": {
            "kind": "data",
            "source": "db_sourceusetypephysics",
            "from": {
              "file_variable": "beginModelYearID"
            }
          }
        },
        "phys_endModelYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "physics_rows"
          ],
          "description": "sourceUseTypePhysics.endModelYearID, the inclusive upper bound.",
          "update": {
            "kind": "data",
            "source": "db_sourceusetypephysics",
            "from": {
              "file_variable": "endModelYearID"
            }
          }
        },
        "phys_rollingTermA": {
          "type": "parameter",
          "units": "kW*s/m",
          "default": 0.0,
          "shape": [
            "physics_rows"
          ],
          "description": "sourceUseTypePhysics.rollingTermA.",
          "update": {
            "kind": "data",
            "source": "db_sourceusetypephysics",
            "from": {
              "file_variable": "rollingTermA"
            }
          }
        },
        "phys_rotatingTermB": {
          "type": "parameter",
          "units": "kW*s^2/m^2",
          "default": 0.0,
          "shape": [
            "physics_rows"
          ],
          "description": "sourceUseTypePhysics.rotatingTermB.",
          "update": {
            "kind": "data",
            "source": "db_sourceusetypephysics",
            "from": {
              "file_variable": "rotatingTermB"
            }
          }
        },
        "phys_dragTermC": {
          "type": "parameter",
          "units": "kW*s^3/m^3",
          "default": 0.0,
          "shape": [
            "physics_rows"
          ],
          "description": "sourceUseTypePhysics.dragTermC.",
          "update": {
            "kind": "data",
            "source": "db_sourceusetypephysics",
            "from": {
              "file_variable": "dragTermC"
            }
          }
        },
        "phys_sourceMass": {
          "type": "parameter",
          "units": "tonne",
          "default": 0.0,
          "shape": [
            "physics_rows"
          ],
          "description": "sourceUseTypePhysics.sourceMass.",
