                  ],
                  [
                    "rt_sourceTypeID",
                    "cfr_sourceTypeID"
                  ]
                ]
              }
            ],
            "filter": {
              "op": "apply_expression_template",
              "args": [],
              "name": "model_year_in_range",
              "bindings": {
                "first_model_year": {
                  "op": "index",
                  "args": [
                    "cfr_minModelYearID",
                    "c"
                  ]
                },
                "last_model_year": {
                  "op": "index",
