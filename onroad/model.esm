                    "f"
                  ]
                }
              }
            }
          }
        },
        {
          "_comment": "J63: the criteria row picks up its coefficient set, and the two forms are selected between. BOTH ARMS ARE EVALUATED, so both have to be finite for every formulation, and the filler values on the unused side are chosen for exactly that: a diesel row carries base 1, GPA factor 1, power 1 and multiplier 0, which makes its sulfur arm a finite number even against the two formulations whose sulfur level is 0 and whose `log` is therefore minus infinity; a gasoline or ethanol row carries biodiesel coefficient 0, which makes its biodiesel arm exactly 1. Power 1 and not 0 on the diesel rows: at power 0, `exp(0*log(0))` is a NaN rather than a 1.",
          "lhs": "cfr_ratio",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "c",
              "g",
              "m",
              "f"
            ],
            "ranges": {
              "c": {
                "from": "criteriafuel_rows"
              },
              "g": {
                "from": "runspeccounty_rows"
              },
              "m": {
                "from": "runspecmonth_rows"
              },
              "f": {
                "from": "fuelformulation_rows"
              },
              "e": {
                "from": "criteriaform_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "cfr_fuelTypeID",
                    "cff_fuelTypeID"
                  ],
                  [
                    "cfr_polProcessID",
                    "cff_polProcessID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "cfr_isBiodiesel",
                        "c"
                      ]
                    },
                    0.5
                  ]
                },
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "biodiesel_ester_ratio",
                  "bindings": {
                    "coefficient": {
                      "op": "index",
                      "args": [
                        "cfr_biodieselCoefficient",
                        "c"
                      ]
                    },
                    "ester_volume": {
                      "op": "index",
                      "args": [
                        "ffx_esterVolume",
                        "f"
                      ]
                    }
                  }
                },
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "sulfur_switch_ratio",
                  "bindings": {
                    "base": {
                      "op": "index",
                      "args": [
                        "cfr_base",
                        "c"
                      ]
                    },
                    "bracket_intercept": {
                      "op": "index",
                      "args": [
                        "cfr_bracketIntercept",
                        "c"
                      ]
                    },
                    "exponent": {
                      "op": "index",
                      "args": [
                        "cff_exponent",
                        "e",
                        "g",
                        "m",
                        "f"
                      ]
                    },
                    "gpa_factor": {
                      "op": "index",
                      "args": [
                        "cfr_gpaFactor",
                        "c"
                      ]
                    },
                    "low_pivot_ppm": {
                      "op": "index",
                      "args": [
                        "cfr_lowPivot",
                        "c"
                      ]
                    },
                    "low_slope": {
                      "op": "index",
                      "args": [
                        "cfr_lowSlope",
                        "c"
                      ]
                    },
                    "multiplier": {
                      "op": "index",
                      "args": [
                        "cfr_sulfurMultiplier",
                        "c"
                      ]
                    },
                    "power": {
                      "op": "index",
                      "args": [
                        "cfr_sulfurPower",
                        "c"
                      ]
                    },
                    "sulfur_ppm": {
                      "op": "index",
                      "args": [
                        "ffx_sulfurLevel",
                        "g",
                        "m",
                        "f"
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "_comment": "J64: the fuel supply, which is what turns 2,158 formulations into the one or two a county burns in a given month. The weight is on the RATIO and MOVES puts it on the RATE -- `aggregate.rs:38` accumulates `mean_base_rate * market_share` and `adjust.rs:477` has already scaled that rate by the ratio -- and the two are the same number because the rate does not depend on the formulation. Every county in this corpus supplies one formulation per fuel type at share 1.0, so the corpus cannot tell them apart (conventions §23); linearity is the argument. The `run_rows` range is the EarthSciAST#437 trap again, for `run_fuelYearID`.",
          "lhs": "cfr_suppliedRatio",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "c",
              "g",
              "m"
            ],
            "ranges": {
              "c": {
