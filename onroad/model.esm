      "size": "n_dayofanyweek"
    },
    "emissionprocess_rows": {
      "kind": "interval",
      "size": "n_emissionprocess"
    },
    "activity_rows": {
      "kind": "interval",
      "size": {
        "op": "*",
        "args": [
          "n_agecategory",
          "n_runspecday"
        ]
      }
    },
    "cohort_rows": {
      "kind": "interval",
      "size": {
        "op": "*",
        "args": [
          "n_agecategory",
          "n_runspecsourcefueltype"
