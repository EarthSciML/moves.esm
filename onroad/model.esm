              },
              "m": {
                "from": "runspecmonth_rows"
              },
              "s": {
                "from": "fuelsupply_rows"
              },
              "f": {
                "from": "fuelformulation_rows"
              },
              "k": {
                "from": "run_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "fs_fuelFormulationID",
                    "ff_fuelFormulationID"
                  ],
                  [
                    "cfr_fuelTypeID",
                    "ff_fuelTypeID"
                  ]
                ]
              },
              {
                "on": [
                  [
                    "run_fuelRegionID",
                    "fs_fuelRegionID"
                  ],
                  [
                    "run_monthGroupID",
                    "fs_monthGroupID"
                  ],
                  [
                    "run_fuelYearID",
                    "fs_fuelYearID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "fs_marketShare",
                    "s"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "cfr_ratio",
                    "c",
                    "g",
                    "m",
                    "f"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "J65: does a criteria fuel-effect row reach this rate row? The model-year window is a filter and the four keys are a join, which is the shape `rt_emissionRateAdjustment` already uses. The answer is 0 for every electricity and CNG cohort, for diesel after model year 2006 and for ethanol before 2001 -- MOVES writes no `criteriaRatio` row for any of them and leaves the rate alone.",
          "lhs": "rt_hasCriteriaRatio",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "bool_and_or",
            "output_idx": [
              "b"
            ],
            "ranges": {
