        },
        "rst_ordinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecsourcetype_rows"
          ],
          "description": "The source-type relation's row ordinal, in file order. Everything the drive cycle and the activity relation compute once per source type is laid out against it."
        },
        "rsr_roadTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecroadtype_rows"
          ],
          "description": "runspecroadtype.roadTypeID.",
          "update": {
            "kind": "data",
