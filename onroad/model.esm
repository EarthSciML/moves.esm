        {
          "_comment": "J38: the process half of the packed id against `emissionprocess`, which is where MOVES records whether a process happens on a road.",
          "lhs": "rspp_occursOnRealRoads",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
