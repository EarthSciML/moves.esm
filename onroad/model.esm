            }
          }
        },
        "rff_minimumRefuelingVaporLoss": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.minimumRefuelingVaporLoss, 1.8 g/gallon on gasoline and E85 and -1 on the rest. The -1 is a SENTINEL meaning `floor the rate at zero`, not a floor of -1, and reading it as a floor would let a negative rate through.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "minimumRefuelingVaporLoss"
            }
          }
        },
        "rff_refuelingSpillRate": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.refuelingSpillRate, 0.31 g/gallon on fuel types 1, 2 and 5 and exactly 0 on CNG and electricity. Diesel HAS a spillage rate and no displacement rate, which is the whole reason the two output blocks differ in width.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "refuelingSpillRate"
            }
          }
        },
        "rfc_processID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingcontroltechnology_rows"
          ],
          "description": "refuelingControlTechnology.processID: 18, Refueling Displacement Loss. The table is the displacement side's control technology.",
          "update": {
            "kind": "data",
            "source": "db_refuelingcontroltechnology",
            "from": {
              "file_variable": "processID"
            }
          }
        },
        "rfc_modelYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingcontroltechnology_rows"
          ],
          "description": "refuelingControlTechnology.modelYearID, 1950-2060.",
          "update": {
            "kind": "data",
            "source": "db_refuelingcontroltechnology",
            "from": {
              "file_variable": "modelYearID"
            }
          }
        },
        "rfc_regClassID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingcontroltechnology_rows"
          ],
          "description": "refuelingControlTechnology.regClassID. A key of this table and NOT of the energy the refueling row chains off: `BaseRateCalculator`'s worker output collapses the regulatory class, so a rate row reaches this table by its bin's class and the parent energy by its cohort.",
          "update": {
            "kind": "data",
            "source": "db_refuelingcontroltechnology",
            "from": {
              "file_variable": "regClassID"
            }
          }
        },
        "rfc_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingcontroltechnology_rows"
          ],
          "description": "refuelingControlTechnology.sourceTypeID.",
          "update": {
            "kind": "data",
            "source": "db_refuelingcontroltechnology",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "rfc_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingcontroltechnology_rows"
          ],
          "description": "refuelingControlTechnology.fuelTypeID: 1 and 5 ONLY, nationally as in the run's own copy. This is the join that makes the displacement block 64 cohorts where spillage is 104, and it is a coverage fact about the table rather than a filter anybody wrote.",
          "update": {
            "kind": "data",
            "source": "db_refuelingcontroltechnology",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "rfc_ageID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingcontroltechnology_rows"
          ],
          "description": "refuelingControlTechnology.ageID, 0-40. Not independent of the model year: the rate row's age is `yearID - modelYearID`, so the two keys are one key read twice, and the join has to carry both or it matches 41 rows where it should match one.",
          "update": {
            "kind": "data",
            "source": "db_refuelingcontroltechnology",
            "from": {
              "file_variable": "ageID"
            }
          }
        },
        "rfc_refuelingTechAdjustment": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingcontroltechnology_rows"
          ],
          "description": "refuelingControlTechnology.refuelingTechAdjustment: the onboard refueling-vapour-recovery penetration T, which blends the uncontrolled and controlled displacement rates.",
          "update": {
            "kind": "data",
            "source": "db_refuelingcontroltechnology",
            "from": {
              "file_variable": "refuelingTechAdjustment"
            }
          }
        },
