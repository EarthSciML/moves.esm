                "model_year": {
                  "op": "index",
                  "args": [
                    "rt_modelYearID",
                    "b"
                  ]
                }
              }
            },
            "expr": 1.0
          }
        },
        {
          "lhs": "rt_criteriaRatioExact",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "b",
              "g",
