                "from": "runspecpollutantprocess_rows"
              },
              "x": {
                "from": "runspecpollutantprocess_rows"
              }
            },
            "filter": {
              "op": "<=",
              "args": [
                "x",
                "p"
              ]
            },
            "expr": {
              "op": "index",
              "args": [
                "rspp_isEmitted",
                "x"
              ]
            }
          }
        },
