            "crankcaseemissionratio_rows"
          ],
          "description": "crankcaseemissionratio.fuelTypeID. 1, 2, 3 and 5; no electricity row, which is what makes a crankcase block 104 cohorts where its parent is 124.",
          "update": {
            "kind": "data",
            "source": "db_crankcaseemissionratio",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
