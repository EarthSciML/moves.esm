            }
          }
        },
        "bfu_calculationEngine": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "basefuel_rows"
          ],
          "description": "baseFuel.calculationEngine -- `predictHC`, `co`, `predictNOx` or `airtoxicsA` -- decoded to 1, 2, 3 and 4 by a `codes` map. The fourth is the air-toxics engine, which this document does not compute; it is in the map because a value the map does not carry is a load error, and leaving it out would make the table's fourth engine an accident waiting for the next rung.",
          "update": {
            "kind": "data",
            "source": "db_basefuel",
            "from": {
              "file_variable": "calculationEngine",
              "codes": {
                "map": {
                  "predictHC": 1,
                  "co": 2,
                  "predictNOx": 3,
                  "airtoxicsA": 4
                },
                "case_insensitive": true
              }
            }
          }
        },
        "bfu_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "basefuel_rows"
          ],
          "description": "baseFuel.fuelTypeID; every row is gasoline.",
          "update": {
            "kind": "data",
            "source": "db_basefuel",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "bfu_modelYearGroupID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "basefuel_rows"
          ],
          "description": "baseFuel.modelYearGroupID: 19502000, 20012050 and 20512060.",
          "update": {
            "kind": "data",
            "source": "db_basefuel",
            "from": {
              "file_variable": "modelYearGroupID"
            }
          }
        },
        "bfu_fuelFormulationID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "basefuel_rows"
          ],
          "description": "baseFuel.fuelFormulationID: 99 (`High Sulfur Gasoline`) for model-year group 19502000 and 98 (`Low Sulfur Gasoline`) after it. This is the formulation the ratio is a ratio TO, and it is why the captured `criteriaRatio` carries rows for 98 and 99 whose ratio is exactly 1.",
          "update": {
            "kind": "data",
            "source": "db_basefuel",
            "from": {
              "file_variable": "fuelFormulationID"
            }
          }
        },
