              {
                "syms": [
                  "b",
                  "cy"
                ],
                "on": [
                  [
                    "rt_yearOrdinal",
                    "year_ordinal"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "evap_W",
                    "p",
