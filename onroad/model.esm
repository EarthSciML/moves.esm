              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "runspecpollutantprocess_rows": 1,
                "runspecday_rows": 1
              }
            },
            {
              "variable": "pp_WTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "runspecpollutantprocess_rows": 3,
                "runspecday_rows": 1
              }
            },
            {
              "variable": "pp_WModeCount",
