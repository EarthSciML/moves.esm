  "enums": {
    "pollutant": {
      "TotalEnergyConsumption": 91,
      "PetroleumEnergyConsumption": 92,
      "FossilFuelEnergyConsumption": 93,
      "OxidesOfNitrogen": 3
    },
    "process": {
      "RunningExhaust": 1,
      "Tirewear": 10,
      "ExtendedIdleExhaust": 90,
      "AuxiliaryPowerExhaust": 91
    },
    "fuel_type": {
      "Electricity": 9,
      "Diesel": 2
    },
    "operating_mode": {
      "Braking": 0,
      "Idling": 1,
      "HighestBinnedMode": 40,
      "CoarseModerateSpeedHighVSP": 26,
      "CoarseHighSpeedHighVSP": 36,
      "TirewearIdle": 400
    },
    "source_bin_slot": {
      "ShortModelYearGroup": 10,
      "RegulatoryClass": 12,
      "EngineTech": 14,
      "FuelType": 16
    },
    "source_type": {
      "HeavyDutyThreshold": 40
    },
    "road_type": {
      "OffNetwork": 1
    },
    "humidity_equation": {
      "CFR86": 86,
      "CFR1065": 1065
    }
  },
  "models": {
    "Onroad": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot",
            "ev_energy_divisor",
            "kilojoules_per_million_btu",
            "is_energy_pollutant",
            "energy_unit_divisor"
          ]
        },
        {
          "ref": "../lib/drive_cycle.esm",
          "only": [
            "mph_to_meters_per_second",
            "per_schedule_second",
            "vehicle_specific_power",
            "in_half_open_range",
            "bracket_low_fraction"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exact_else_wildcard",
            "bounded_low_then_high",
            "bounded_specific_humidity",
            "nox_humidity_cfr86",
            "nox_humidity_cfr1065",
            "nox_temperature_adjustment",
            "quadratic_temperature_adjustment"
          ]
        },
        {
          "ref": "../lib/keys.esm",
          "only": [
            "model_year_in_range"
          ]
        },
        {
          "ref": "../lib/meteorology.esm",
          "only": [
            "heat_index",
            "vapor_partial_pressure_from_weather",
            "specific_humidity",
            "mol_water_fraction"
          ]
        },
        {
          "ref": "../lib/fuel_effects.esm",
          "only": [
            "fuel_property_or_zero",
            "high_ethanol_property",
            "criteria_exponent",
            "biodiesel_ester_ratio",
            "sulfur_switch_ratio",
            "complex_model_property",
            "sulfur_adjust_arm"
          ]
        },
        {
          "ref": "../lib/chaining.esm",
          "only": [
            "chained_emits"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-09
      },
      "variables": {
        "rsy_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecyear_rows"
          ],
          "description": "runspecyear.yearID.",
          "update": {
            "kind": "data",
            "source": "db_runspecyear",
            "from": {
              "file_variable": "yearID"
            }
          }
        },
        "rsm_monthID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecmonth_rows"
          ],
          "description": "runspecmonth.monthID.",
          "update": {
