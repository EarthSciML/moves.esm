        "rtDay_quant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows",
            "runspeccounty_rows"
          ],
          "description": "The emitted quantity: its own rate path plus its chain. Every rate row is exactly one of the two, so the sum is a union and not a double count -- `run_chainedRowCount` is the test. Per county, which is the axis the output relation's second level reads it at."
        },
        "run_chainedRowCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many emitted rate rows carry a chain ratio: 125, the one chained pollutant-process's cohorts. A rate row can never have both a ratio and a rate of its own here, which is what makes `rtDay_quant`'s sum a union."
        },
        "bin_isSelectedAt": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The bin's membership read back at the rate row, so the chained block's row count can be counted without a second rank."
        },
        "rt_outputOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Where this rate row lands in the output relation's (pollutant-process, cohort) block: (outputBlockOrdinal - 1) x n_outputCohort + cohortRank, and 0 both for a candidate that is not emitted and for a pollutant-process whose whole block is discarded -- an ordinal no output row can match. This is the ONE key the output row joins on, and all three of its factors are computed."
        },
        "outPolProcOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "S17's row structure, decomposed from the aggregate's own loop symbol: pollutant-process-major blocks of (n_runspeccounty x n_runspecday x n_outputCohort). 3 x 1 x 1 x 125 = 375 in `process-tirewear`, 1 x 1 x 2 x 125 = 250 in `expand-day`, 1 x 3 x 1 x 125 = 375 in `expand-counties`, 1 x 1 x 1 x 248 in `expand-fueltype-diesel` and 1 x 1 x 1 x 430 in `expand-sourcetype`. The source type is INSIDE `n_outputCohort` rather than beside it, which is why five source types do not make this a five-way product."
        },
        "outBlockOffset": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The row's offset within its pollutant-process block, which the county, day and cohort levels decompose in that order."
        },
        "outCountyOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "Which of the run's counties this output row is for. The output relation is pollutant-process major, then COUNTY, then day type, then cohort; `expand-counties` is the run that makes this level wider than one."
        },
        "outCountyOffset": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The position of this row within its county's block, which is what the day and cohort levels decompose."
        },
        "outDayOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "Day-major within the county's block."
        },
        "outCohortOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The surviving cohort's rank, 1..125, which coh_rank is the other side of."
        },
        "outPolProcCohortOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The two block coordinates packed the way `rt_outputOrdinal` packs them, so one key pair carries the whole gather."
        },
        "out_modelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The output row's model year, read BACK through the rank join. A KEY column is read from the relation that OWNS it -- this one from the cohort relation through the rank, not from the rate relation through `rt_outputOrdinal` -- because since 7e several rate rows can share an output row and a `sum_product` over them would add their keys together. The VALUE columns below keep the rate join, where that sum is the point."
        },
        "out_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "Its fuel type. A KEY column is read from the relation that OWNS it -- this one from the cohort relation through the rank, not from the rate relation through `rt_outputOrdinal` -- because since 7e several rate rows can share an output row and a `sum_product` over them would add their keys together. The VALUE columns below keep the rate join, where that sum is the point."
        },
        "out_pollutantID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "Its pollutant: 91, 107 or 117. A KEY column is read from the relation that OWNS it -- this one from the cohort relation through the rank, not from the rate relation through `rt_outputOrdinal` -- because since 7e several rate rows can share an output row and a `sum_product` over them would add their keys together. The VALUE columns below keep the rate join, where that sum is the point."
        },
        "out_processID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "Its process: 1 or 9. A KEY column is read from the relation that OWNS it -- this one from the cohort relation through the rank, not from the rate relation through `rt_outputOrdinal` -- because since 7e several rate rows can share an output row and a `sum_product` over them would add their keys together. The VALUE columns below keep the rate join, where that sum is the point."
        },
        "out_meanBaseRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The collapsed base rate on the output row. Emitted as an extra column: the comparator ignores columns MOVESOutput does not have, and having it in the CSV is what makes a disagreement attributable to the rate or to the activity."
        },
        "out_adjustedMeanBaseRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The same after S15."
        },
        "out_emissionQuantDirect": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The row's own rate path, before the chain -- 0 on every PM10 row."
        },
        "out_emissionQuant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "S18: Million BTU for pollutant 91 and grams for 107 and 117. THE compared column."
        }
      },
      "equations": [
