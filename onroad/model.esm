        },
        "ff_oxidationFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelformulation_rows"
          ],
          "description": "The formulation's oxidation fraction, through `FuelSubtype`."
        },
        "ff_isHighEthanol": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelformulation_rows"
          ],
          "description": "Subtype 51 (E85) or 52 (E70): the formulations whose combustion properties `FuelEffectsGenerator.setup()` step 020 replaces wholesale. Three of the 2,158 rows."
        },
        "ff_isE10Speciated": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelformulation_rows"
          ],
          "description": "Subtype 50 (Ethanol), 51 (E85) or 52 (E70): the formulations whose running- and start-exhaust hydrocarbons MOVES speciates with E10's ratios from model year 2001. It is ONE subtype wider than `ff_isHighEthanol`, which is the property substitution's set and stops at 51 -- two sets that agree on the three formulations any run here selects and are not the same question."
        },
        "ff_speciationSubtypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelformulation_rows"
          ],
          "description": "The fuel subtype the hydrocarbon speciation tables are looked up under: 12, gasohol E10, for a 50/51/52 formulation and the formulation's own subtype otherwise. It is a JOIN KEY and not a value, which is why the substitution is made here on the formulation and not inside the lookup: a `join.on` names a column."
        },
        "ffsup_marketShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "The share of its fuel type's volume that this formulation is, in this county and this month -- `FuelSupply` resolved against the county's fuel region, the month's month group and the run's fuel year, and laid out on the formulation axis. It is 1.0 for the five formulations any run in `runspecs/` carries and 0 for the other 2,153.\n\nIT EXISTS TO BE COMPUTED ONCE. `FuelSupply` is 105,651 national rows and the collapse used to live inside `cfr_suppliedRatio`, which was affordable while one lookup needed it. The hydrocarbon species need it seven more times -- the methane ratio and the two speciation constants, each at the row's own fuel subtype and again at the E10 one -- and seven more spines over 105,651 x 2,158 took `expand-day` from 60 seconds to 564. Every lookup now joins this instead, and the run that had one such spine has none."
        },
        "ffx_RVP": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelformulation_rows"
          ],
          "description": "RVP with `changeFuelFormulationNulls` applied and NOTHING else: the property the high-ethanol substitution deliberately leaves at the formulation's own value."
        },
        "ffx_altRVP": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "The E10 base fuel's RVP where the formulation is high-ethanol and the formulation's own RVP everywhere else -- `alterHighEthanolFuelProperties` step 020's `altRVP` column. It is the mirror image of `ffx_RVP`: the substitution that every other property gets and this one does not, kept instead as a second value beside it. 8.0 against 7.7 for formulation 27002."
        },
        "ffx_esterVolume": {
          "type": "unknown",
          "units": "percent",
          "shape": [
            "fuelformulation_rows"
          ],
          "description": "Biodiesel ester volume, nulls filled. `e10FuelProperties` carries this column too and it is NULL in every row of it, so step 020's coalesce falls all the way through to the formulation's own value -- which is this, for a high-ethanol row as much as for a diesel one."
        },
        "ffx_sulfurLevel": {
          "type": "unknown",
          "units": "ppm",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "Sulfur level after the high-ethanol substitution: 7.15 ppm for formulation 27002 in region 270000000 in August 2020, against the 8.0 the table ships."
        },
        "ffx_ETOHVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "Ethanol volume after the substitution: 10, against the 74 the table ships. The E85 rows clamp it at 10 anyway, so this one is the substitution the corpus cannot see."
        },
        "ffx_aromaticContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "Aromatic content after the substitution: 23.14 against 0.0."
        },
        "ffx_T50": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "T50 after the substitution: 222.95 degrees against the sentinel 999. This is the substitution that matters -- the THC exponent carries `T50*T50`."
        },
        "ffx_T90": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "T90 after the substitution: 327.77 against the sentinel 999."
        },
        "cff_exponent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "The argument of the single `exp` the sulfur form applies: the intercept plus six standardized terms, none of them centred or scaled. It is per (coefficient set, county, month, formulation) and not per criteria row, because the thirteen source types and two model-year ranges that share a (fuelType, polProcess) share this number exactly. Plus the start strings' five ethanol cross terms, which are exactly 0 on a running set."
        },
        "cff_altExponent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "`cff_exponent` again, with `ffx_altRVP` where it reads `ffx_RVP` and nothing else changed. The whole of `altCriteriaRatio` is this one substitution: the Java replaces the string `RVP` with `altRVP` in the ethanol THC expressions and evaluates the same form."
        },
        "cfr_ratio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "`criteriaRatio.ratio` for every (criteria row, county, month, formulation) cell -- the table MOVES writes at run time and the default database ships EMPTY. `ratioGPA` is not computed: the GPA expression string is IDENTICAL to the main one in all 270 criteria rows, so the blend `ratio + gpaFract*(ratioGPA - ratio)` is the identity whatever `county.GPAFract` is."
        },
        "cfr_exponentDelta": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "How much the alternate exponent exceeds the ordinary one, per formulation. The two criteria ratios share their sulfur factor and their base divisor exactly, so their quotient is `exp` of this and no division is needed. Zero on every formulation that is not high-ethanol, because there `altRVP` IS `RVP`."
        },
        "cfr_suppliedRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "The market-share-weighted ratio over the formulations the county's fuel supply actually carries for the criteria row's fuel type. This is where the 2,158-row formulation table collapses to the five formulations a run uses."
        },
        "cfr_suppliedExponentDelta": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "The market-share-weighted exponent difference over the formulations the county's fuel supply carries for this row's fuel type -- `cfr_suppliedRatio`'s collapse, applied to the difference instead of the ratio. With one formulation per fuel type at market share 1.0, which is every run in `runspecs/`, the weighting is the identity and the number is that formulation's."
        },
        "atx_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "generalFuelRatioExpression.polProcessID for the six gaseous air toxics this chain emits: 2001 benzene, 2101 ethanol, 2401 1,3-butadiene, 2501 formaldehyde, 2601 acetaldehyde and 2701 acrolein."
        },
        "atx_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "generalFuelRatioExpression.fuelTypeID. Gasoline and E85 are the only two fuel types the toxic expressions cover; diesel and everything else reach `ATRatioNonGas` instead. Ethanol has no E85 row for model year 2000 and earlier, and acetaldehyde has no gasoline one -- the table is ragged and the rows are what it holds."
        },
        "atx_minModelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "Where each string's model-year range starts. 2001 on eleven of the fourteen rows, because the closed form is normally `ATRatio`'s model-year 2001-and-later half and `atr_complexRatio` is the other. ETHANOL AND ACROLEIN ARE THE EXCEPTION, and they are the exception for a reason that is visible in the tables: neither has a row in `ATBaseEmissions` or in `ComplexModelParameters`, so there is no complex model to be the other half, and `generalFuelRatioExpression` carries a 1950-2000 string for them instead. The split is not by model year, it is by which generator has the coefficients."
        },
        "atx_maxModelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "Where each string's model-year range ends: 2060 on the model-year-2001-and-later rows and 2000 on ethanol's and acrolein's earlier ones."
        },
        "atx_formID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "WHICH ALGEBRAIC FORM THE STRING IS: 1 the centred linear ratio benzene is written in, 2 the quadratic-over-base 1,3-butadiene is, 3 the ratio of exponentials formaldehyde, ethanol and acetaldehyde are, 4 the ETHANOL STEP -- a piecewise constant in the ethanol volume. docs/fuel-effects-generator.md 2.1 counts six forms in the corpus and names 1, 2 and 3 as D, E and F; form 4 is a SEVENTH, found here and not in that census, because every row that uses it leaves `generalFuelRatio` before a snapshot is taken. Acrolein's three rows need no form of their own: a bare constant is form 1 with a zero slope, which is what that census called `plus a bare constant`."
        },
        "atx_scale": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "The trailing factor the string multiplies its form by, for forms 1 and 2. It is 0.0 on both 1,3-butadiene rows -- the ratio is a real zero and not a missing row, which is why 50 of this run's cells are exactly 0 and every one of them is compared. On acrolein's three rows it is the WHOLE ratio, 0.000628499 before model year 2001 and 0.000766087940907 after, because those rows are form 1 with a zero slope."
        },
        "atx_fuelScale": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "A SECOND trailing factor, on the E85 rows only, and 1.0 on the gasoline ones. The string writes it as its own multiplication after the first scale, so this document does too: one product of three numbers is not the other."
        },
        "atx_linearPivot": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "Form 1's pivot: the benzene content the ratio is centred on. 0.0 where the form is not 1, which with a zero slope makes the unused arm 1 and the mask discards it."
        },
        "atx_linearSlope": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "Form 1's slope."
        },
        "atx_quadraticSquare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "Form 2's coefficient of the olefin content SQUARED."
        },
        "atx_quadraticLinear": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "Form 2's coefficient of the olefin content."
        },
        "atx_quadraticConstant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "Form 2's constant term."
        },
        "atx_quadraticBase": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "Form 2's divisor -- the base fuel's toxic fraction. It is 1.0 and not 0.0 where the form is not 2, because the unused arm is still evaluated and a divide by zero would reach the sum as a NaN."
        },
        "atx_stepCutOne": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "The first breakpoint of form 4's step, `ETOHVolume < 0.1`. Zero on every row that is not form 4, where the arm is masked and the step falls to `atx_stepLevelThree`, which is 0.0 there."
        },
        "atx_stepCutTwo": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "The second breakpoint, 6.0 volume percent ethanol."
        },
        "atx_stepCutThree": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "The third breakpoint, 9.0. The string's fourth `IF` splits again at 17.5 and returns 0.0239 on both sides of it, so the split is not a breakpoint and is not carried."
        },
        "atx_stepLevelZero": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "The ratio below the first breakpoint: a gasoline with no ethanol in it emits no ethanol, and 0.0 is a ratio that IS zero (conventions 30.1)."
        },
        "atx_stepLevelOne": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "The ratio on [0.1, 6.0)."
        },
        "atx_stepLevelTwo": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "The ratio on [6.0, 9.0)."
        },
        "atx_stepLevelThree": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows"
          ],
          "description": "The ratio at 9.0 and above, which is where this run's formulations sit -- 9114 carries 10 volume percent, so the model-year-2000-and-earlier ethanol ratio is 0.0239 flat."
        },
        "atxexp_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "Which pollutant-process's form-3 string this exponent belongs to: formaldehyde 2501, ethanol 2101 and acetaldehyde 2601. All three divide by the SAME two VOC exponents -- the numbers in the denominator are identical in all three strings -- so the six denominator rows here are three copies of one pair. They are carried as rows rather than factored out because the relation is keyed on the pollutant-process and the coefficients are data; what is shared is the FORM, and that is shared already."
        },
        "atxexp_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "Which fuel type's string. The two differ in the ethanol clamp and in the trailing scale and in nothing else."
        },
        "atxexp_intercept": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The constant term of this exponent."
        },
        "atxexp_variance": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The variance the string adds as `0.5*v` -- the lognormal correction that turns a median into a mean. It is carried as the variance and halved in the template, which is the spelling the string uses."
        },
        "atxexp_numeratorSign": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "1 on the exponent that is the NUMERATOR of form 3 and 0 on the other two."
        },
        "atxexp_denominatorSign": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "+1 and -1 on the two exponents the denominator is a DIFFERENCE of, and 0 on the numerator's. A difference written as a signed sum is what lets one `faq` gather both arms: `exp(B) - exp(C)` is `sum_product` over two rows whose signs are +1 and -1."
        },
        "atxexp_coefficientETOHVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The ethanol-volume coefficient of this exponent."
        },
        "atxexp_centerETOHVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The ethanol volume the term is centred on. Every one of these four centres and four scales is the same on all six rows -- they are the fuel sample the model was fitted to, not a per-exponent choice -- and they are columns because that is what they are in the string."
        },
        "atxexp_scaleETOHVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The ethanol volume the term is standardised by."
        },
        "atxexp_coefficientAromaticContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The aromatic-content coefficient."
        },
        "atxexp_centerAromaticContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The aromatic content the term is centred on."
        },
        "atxexp_scaleAromaticContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The aromatic content the term is standardised by."
        },
        "atxexp_coefficientT50": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The T50 coefficient."
        },
        "atxexp_centerT50": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The T50 the term is centred on."
        },
        "atxexp_scaleT50": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The T50 the term is standardised by."
        },
        "atxexp_coefficientT90": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The T90 coefficient."
        },
        "atxexp_centerT90": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The T90 the term is centred on."
        },
        "atxexp_scaleT90": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The T90 the term is standardised by."
        },
        "atxexp_etohCap": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "`least(10, ETOHVolume)`'s 10, on the E85 rows."
        },
        "atxexp_etohCapIsActive": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows"
          ],
          "description": "The indicator that turns the clamp on -- 1 on the three E85 exponents and 0 on the three gasoline ones."
        },
        "atx_exponent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsexponent_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "Each of form 3's three exponents, on every fuel formulation: an intercept, four standardised properties and half a variance. The properties are the SUBSTITUTED ones, so an E85 formulation reads the E10 base fuel's aromatics, T50 and T90 -- without which the formaldehyde ratio is negative and the benzene one is 13 percent low."
        },
        "atx_exponentialNumerator": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "`exp(A)`, gathered onto the form row that owns it."
        },
        "atx_exponentialDenominator": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "`exp(B) - exp(C)`, as one signed sum over the same two-row join."
        },
        "atx_closedFormRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "`ATRatio` wherever `generalFuelRatioExpression` supplies it: whichever of the four forms this row is written in, times the E85 scale. The three unused arms are evaluated and masked rather than branched on, and their coefficients are chosen so that each is zero or safe where its form is not the row's -- the quadratic divisor is 1.0 and not 0.0 for exactly that reason, and the step's three breakpoints are 0.0, so a masked step falls through to `atx_stepLevelThree`, which is 0.0 there."
        },
        "atx_suppliedClosedFormRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "airtoxicsform_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "The market-share collapse over the county's formulations of the row's own fuel type."
        },
        "gfb_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows"
          ],
          "description": "generalFuelRatioExpression.polProcessID for the ratios BaseRateCalculator applies to a RATED pollutant-process -- the ones `copyGeneralFuelRatioTo*` never moves into `criteriaRatio` or `ATRatio` -- and for `SulfatePMCalculator`'s residue: 11201, PM elemental carbon, and 12001, the residue, which carries the same strings and is read through `rt_residueFuelRatio` because no rate row is ever a residue. Rows 7-9 are EXTENDED IDLE's THC, CO and NOx (190, 290, 390): diesel's biodiesel form B with the running-exhaust coefficients, -0.705, -0.690 and +0.110, for model years 1950-2006. BaseRateCalculator applies them to the rated rows; the crankcase rows chained from them (117, 217, 317) carry the same strings in the table and MOVES's crankcase output is the parent's times the crankcase ratio alone, measured: 0.037000 exactly on every pre-2007 diesel cohort of `process-crankcase-extidle-single`."
        },
        "gfb_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows"
          ],
          "description": "Gasoline, E85, diesel. The strings are keyed by source type too, and it is not a key here, measured: the gasoline and diesel strings cover all 13 source types identically, and the E85 string covers 21, 31 and 32 -- which are exactly the source types `sampleVehiclePopulation` has an E85 vehicle on."
        },
        "gfb_minModelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows"
          ],
          "description": "Where each string's model-year window starts."
        },
        "gfb_maxModelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows"
          ],
          "description": "Where it ends. Outside every window the ratio is the wildcard 1 -- EC from gasoline before 2001 and from diesel after 2006 carries no fuel effect."
        },
        "gfb_isBiodiesel": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows"
          ],
          "description": "1 for form B, `1 + (least(ester, 20)/100)*c`; 0 for form A, `exp(SUM)/base`, whose exponent is two rows of the shared exponent table `atxexp_*`."
        },
        "gfb_biodieselCoefficient": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows"
          ],
          "description": "Form B's coefficient: -0.780 for elemental carbon and its residue, so 3.5 volume percent ester gives 0.9727; -0.705, -0.690 and +0.110 for extended idle's THC, CO and NOx."
        },
        "gfb_base": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows"
          ],
          "description": "Form A's divisor. 1.0 on the form-B row, where the form-A arm is evaluated and masked and must stay finite."
        },
        "gfb_exponent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "Form A's exponent, gathered from its row of the shared exponent table: the same `air_toxics_exponent` template formaldehyde's three exponents use, with no intercept, no variance and no T50 term. 0 on the form-B row, which has no exponent row."
        },
        "gfb_ratio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "The ratio on every formulation: 1.090910749585 on this corpus's gasoline and E85, 0.9727 on its diesel."
        },
        "gfb_suppliedRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "basefuelratio_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "The market-share collapse over the county's formulations of the row's own fuel type."
        },
        "ff_olefinContent": {
          "type": "parameter",
