                "ep_occursOnRealRoads",
                "e"
              ]
            }
          }
        },
        {
          "_comment": "The run relation is one row, so the cross product with it is a read.",
          "lhs": "rspp_rateRoadTypeID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
