          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The run's road type. J27: the reason no process-2 row exists in this snapshot."
        },
        "run_linkID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
