          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.fuelRegionID; 0 is the national row.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "fuelRegionID"
            }
          }
        },
        "e10_fuelYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.fuelYearID.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "fuelYearID"
            }
          }
        },
        "e10_monthGroupID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.monthGroupID.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "monthGroupID"
            }
          }
        },
        "e10_sulfurLevel": {
          "type": "parameter",
          "units": "ppm",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.sulfurLevel, ppm. NULL in all 757 national rows and in none of the 15,360 regional ones, which is what makes the regional row the only one worth reading.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "sulfurLevel"
            }
          }
        },
        "e10_RVP": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.RVP, the Reid vapour pressure of the E10 base fuel. It is the ONE column of this table the high-ethanol substitution does not write into the formulation: step 020 puts it in a NEW column, `altRVP`, and only the alternate criteria ratio reads it. `ff_RVP` next to it declares no unit either, and the two are compared and substituted for one another, so neither may declare one (docs/esm-conventions.md §57). 8.0 for region 270000000 in August 2020, against formulation 27002's own 7.7.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "RVP"
            }
          }
        },
        "e10_ETOHVolume": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.ETOHVolume; 10.0 in every regional row, which is what E10 means.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "ETOHVolume"
            }
          }
        },
        "e10_aromaticContent": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.aromaticContent.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "aromaticContent"
            }
          }
        },
        "e10_T50": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.T50, the distillation temperature that replaces the 999 sentinel.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "T50"
            }
          }
        },
        "e10_T90": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "e10fuelproperties_rows"
          ],
          "description": "e10FuelProperties.T90.",
          "update": {
            "kind": "data",
            "source": "db_e10fuelproperties",
            "from": {
              "file_variable": "T90"
            }
          }
        },
        "cfr_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "generalFuelRatioExpression.fuelTypeID: 1 gasoline, 2 diesel, 5 ethanol."
        },
        "cfr_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "generalFuelRatioExpression.polProcessID: rows 1-135 are 101 THC, 201 CO, 301 NOx at running exhaust, rows 136-270 102, 202, 302 at START exhaust -- the 135 start strings conventions 68 once left out, which carry five ethanol cross terms (`cff_coefficientETOH*`) the running ones do not."
        },
        "cfr_sourceTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "generalFuelRatioExpression.sourceTypeID. THIS IS A REAL KEY AND NOT A WILDCARD: the sulfur power is 0.168 for source types 11 and 21 and 0.125 for the other eleven, and the low-sulfur slope takes three different values across them. A relation that carried source type 21 alone would be right on six of this repository's seven RunSpecs and wrong on `expand-sourcetype`."
        },
        "cfr_minModelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "generalFuelRatioExpression.minModelYearID."
        },
        "cfr_maxModelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "generalFuelRatioExpression.maxModelYearID. The two ranges split at 2016/2017 for source types 11, 21 and 41-62 and at 2017/2018 for 31 and 32 -- Tier 3 phased in a year later for the light trucks -- which is why the boundary is data and not a constant."
        },
        "cfr_base": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "The divisor that turns the exponentiated polynomial into a RATIO: the same polynomial evaluated on the BASE fuel. Verbatim from the expression string, at the seventeen digits that round-trip it. It varies by one or two ULP across source types within a pollutant-process -- 0.00968296465631127 against 0.009682964656311278 for THC -- which is EPA's own summation noise in generating the strings, reproduced rather than smoothed. 1.0 on a biodiesel row, so that its unselected sulfur arm is finite."
        },
        "cfr_gpaFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "The second divisor, applied only in the HIGH-sulfur arm: the base fuel's ratio at Geographic Phase-In Area sulfur. Two values per pollutant-process -- source types 11 and 21 take one, the other eleven the other."
        },
        "cfr_sulfurPower": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "The fractional power the sulfur level is raised to, written `exp(g*ln(s))` in the SQL and kept that way here. It is `sulfurModelCoeff.sulfurCoeff` for (process 1, the pollutant, M6emitter 1, the source type) -- 0.168, 0.236 and 0.351 at source type 21 -- which is a corroboration and not the source: the string is the authority, because the model-year group the table is also keyed by cannot be recovered from it. 1.0 rather than 0.0 on a biodiesel row: at power 0 a formulation with sulfur 0 would make `exp(0*log(0))` a NaN in the unselected arm."
        },
        "cfr_sulfurMultiplier": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "The multiplier inside the sample-sulfur step: 2.5, 2.36 and 1.47, which are `m6SulfurCoeff.sulfurLongCoeff` for THC, CO and NOx. 0.0 on a biodiesel row."
        },
        "cfr_bracketIntercept": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "The additive constant the two sulfur steps are added to: 1.0 before Tier 3 and 1.36251294 (THC) or 1.43164032 (NOx) after it, and 1.0 for CO in both ranges. It is the one number that says the 2017+ rows are a different regulation and not a different fuel."
        },
        "cfr_lowPivot": {
          "type": "unknown",
          "units": "ppm",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "The sulfur level the LOW arm's linear credit is measured down from: 30 ppm before Tier 3 and 10 ppm after it, and only for the source types whose 2017 row moved."
        },
        "cfr_lowSlope": {
          "type": "unknown",
          "units": "1/ppm",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "The LOW arm's slope, per ppm. Zero for source type 11 on all three pollutants and for CO on 11, 21, 31 and 32 -- a motorcycle takes no low-sulfur credit at all -- which is a fact about the table and reads here as a coefficient rather than as a branch."
        },
        "cfr_isBiodiesel": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "1.0 on the 39 diesel rows, 0.0 on the 96 gasoline and ethanol ones. The form selector: diesel's criteria effect is `1 + min(ester,20)/100 * c` and has no sulfur arm at all."
        },
        "cfr_biodieselCoefficient": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriafuel_rows"
          ],
          "description": "-0.705 for THC, -0.690 for CO and +0.110 for NOx, identical across all thirteen source types. 0.0 on a non-diesel row, which makes its unselected biodiesel arm exactly 1."
        },
        "cff_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows"
          ],
          "description": "The fuel type of each coefficient set: rows 1-9 are running exhaust's (101, 201, 301 by gasoline, diesel, ethanol), rows 10-18 start exhaust's (102, 202, 302), split from the start strings the same way and checked the same way (PLAN.md 7.3.41)."
        },
        "cff_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows"
          ],
          "description": "The pollutant-process this coefficient set belongs to."
        },
        "cff_intercept": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows"
          ],
          "description": "The constant term of the exponent."
