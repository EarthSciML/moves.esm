            }
          }
        },
        "rsh_hourID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspechour_rows"
          ],
          "description": "runspechour.hourID.",
          "update": {
            "kind": "data",
            "source": "db_runspechour",
            "from": {
              "file_variable": "hourID"
            }
          }
        },
        "rsd_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecday_rows"
          ],
          "description": "runspecday.dayID.",
          "update": {
            "kind": "data",
            "source": "db_runspecday",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "rday_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "rateday_rows"
          ],
          "description": "The day types the rate-side pre-aggregation is scoped to. Equal to `rsd_dayID` on every run that does not aggregate.",
          "update": {
            "kind": "data",
            "source": "db_rateday",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "aday_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "actday_rows"
          ],
          "description": "The day types the output day's activity covers. Equal to `rsd_dayID` on every run that does not aggregate.",
          "update": {
            "kind": "data",
            "source": "db_actday",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "ahr_hourID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "aggregationhour_rows"
          ],
          "description": "The hours the run aggregates over. Equal to `rsh_hourID` on every run that does not aggregate.",
          "update": {
            "kind": "data",
            "source": "db_aggregationhour",
            "from": {
              "file_variable": "hourID"
            }
          }
        },
        "rday_hasOutputDay": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows"
          ],
          "description": "Whether this rate-side day type is itself one of the run's OUTPUT day types. It is on every run that does not aggregate; an aggregated run's output day is a SYNTHESIZED day the `dayofanyweek` table does not name, so nothing matches and the wildcard below collects every cell."
        },
        "rday_outputDayExact": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows"
          ],
          "description": "The output day ordinal this rate-side day type belongs to when `dayofanyweek` names it."
        },
        "rday_outputDayOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows"
          ],
          "description": "The output day ordinal this rate-side day type belongs to: its own when the run emits that day type, and otherwise the run's FIRST output day, which is the synthesized aggregate day."
        },
        "aday_hasOutputDay": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "actday_rows"
          ],
          "description": "Whether this activity-side day type is itself one of the run's OUTPUT day types. It is on every run that does not aggregate; an aggregated run's output day is a SYNTHESIZED day the `dayofanyweek` table does not name, so nothing matches and the wildcard below collects every cell."
        },
        "aday_outputDayExact": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "actday_rows"
          ],
          "description": "The output day ordinal this activity-side day type belongs to when `dayofanyweek` names it."
        },
        "aday_outputDayOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "actday_rows"
          ],
          "description": "The output day ordinal this activity-side day type belongs to: its own when the run emits that day type, and otherwise the run's FIRST output day, which is the synthesized aggregate day."
        },
        "rst_sourceTypeID": {
          "type": "parameter",
          "units": "1",
