          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingcontroltechnology_rows"
          ],
          "description": "refuelingControlTechnology.controlledRefuelingRate: the displaced-vapour rate of a FULLY controlled vehicle, 0.0361 g/gallon wherever T is non-zero.",
          "update": {
            "kind": "data",
            "source": "db_refuelingcontroltechnology",
            "from": {
              "file_variable": "controlledRefuelingRate"
            }
          }
        },
