        "asd_cellWeight": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows",
            "aggregationhour_rows",
            "runspecsourcetype_rows"
          ],
          "description": "The weight one (day type, hour) cell carries in the speed-distribution pre-aggregation: `hourVMTFraction` at the run's road type. Canonical multiplies this by a DayWeighting over the month, but every output day of every run in this corpus aggregates over ONE day type, so that factor is constant across the cells it is averaged over and cancels."
        },
        "asd_weightTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecday_rows",
            "runspecsourcetype_rows"
          ],
          "description": "The cell weights of one output day, summed. It is the denominator of the weighted mean and it is 1 cell wide on a run that does not aggregate."
        },
        "asd_cellShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows",
            "aggregationhour_rows",
            "runspecsourcetype_rows"
          ],
          "description": "`asd_cellWeight` normalized within its output day. On a run that does not aggregate there is one cell and this is exactly 1, which is what makes the pre-aggregation invisible to the other five RunSpecs."
        },
        "asd_effectiveFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecday_rows",
            "runspecsourcetype_rows",
            "avgspeedbin_rows"
          ],
          "description": "`avgSpeedDistribution.avgSpeedFraction` as the rate calculation sees it: the cell-weighted mean over the output day's time cells, at the run's road type. On a run that does not aggregate it is the table's own cell, read through a mean of one."
        },
        "met_roadWeighted": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows",
            "aggregationhour_rows",
            "runspecsourcetype_rows"
          ],
          "description": "PreAggDAY HourWeighting2's numerator: `sum over road types of hourVMTFraction x roadTypeVMTFraction`, over the road types `hourVMTFraction` carries -- which is where the off-network road type drops out."
        },
        "met_roadTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows",
            "aggregationhour_rows",
            "runspecsourcetype_rows"
          ],
          "description": "The same sum's denominator, `sum over road types of roadTypeVMTFraction`, over the SAME road types. Computed through the same join rather than off `roadtypedistribution` alone, because the two row sets differ."
        },
        "met_hourWeight": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows",
            "aggregationhour_rows",
            "runspecsourcetype_rows"
          ],
          "description": "HourWeighting2: the share of a source type's travel that falls in this (day type, hour) cell, road-type weighted."
        },
        "met_cellWeight": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows",
            "aggregationhour_rows"
          ],
          "description": "HourWeighting3: the cell's meteorological weight, summed over the run's source types. Canonical picks ONE source type out of a fixed ordering rather than summing; the two agree exactly on every run in this corpus, because a run either selects one source type or does not aggregate, and a mean over one cell does not depend on its weight."
        },
        "met_weightTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "`met_cellWeight` over every cell, the weighted mean's denominator."
        },
        "met_cellShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rateday_rows",
            "aggregationhour_rows"
          ],
          "description": "`met_cellWeight` normalized. Exactly 1 on a run that does not aggregate."
        },
        "run_relHumidity": {
          "type": "unknown",
          "units": "percent",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The relative humidity the heat index is computed at, cell-weighted over the run's time cells. On a run that does not aggregate it is `zonemonthhour.relHumidity` at the run's own hour."
        },
        "run_barometricPressure": {
          "type": "unknown",
          "units": "inHg",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "`county.barometricPressure` for the run's county. It is per COUNTY and not per county-month, because the pressure is a property of the place; the two humidity measures that divide by it are per county-month because the vapour pressure is."
        },
        "run_vaporPartialPressure": {
          "type": "unknown",
          "units": "kPa",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "`PV` for the run's county and month, from the same temperature and relative humidity the heat index reads."
        },
        "run_specificHumidity": {
          "type": "unknown",
          "units": "g/kg",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The hour's specific humidity, g water per kg DRY air, COMPUTED by lib/meteorology.esm's `specific_humidity` (MG-7) rather than read off `ZoneMonthHour.specificHumidity` -- which this chain could not read anyway, because it computes its meteorology rather than ingesting it. Its denominator subtracts the vapour pressure from the ambient pressure because the air it measures against is dry; the mole fraction's does not, and that one term is the only difference between them. Measured against the column it replaces: 10.053684062398 computed against 10.053684293477 stored, 2.298e-08 relative."
        },
        "run_molWaterFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The hour's water mole fraction, moles of water per mole of AMBIENT air, by lib/meteorology.esm's `mol_water_fraction` (MG-7). The CFR 1065 argument; the two humidity columns are different measures of the same air and each equation wants its own. Measured against the column it replaces: 0.015929058669 computed against 0.015929059029 stored, 2.262e-08 relative."
        },
        "run_humidityEqCFR86": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "A one-row relation carrying the code `noxhumidityadjust.humidityNOxEq` decodes `CFR 86` to, so the equation selection is a `join.on` like every other key selection in this chain rather than an `==` hidden in a filter (conventions 20.4)."
        },
        "run_humidityEqCFR1065": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The same, for `CFR 1065`."
        },
        "act_timeVMTFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "activity_rows",
            "runspecsourcetype_rows",
            "runspecmonth_rows"
          ],
          "description": "The share of the month's VMT this activity row's time cells carry: `sum over cells of dayVMTFraction x hourVMTFraction`. On a run that does not aggregate it is the single product the two columns used to be multiplied as; on a run that aggregates by month it is the whole week at every hour, and the two factors sum to 1.0 exactly and to 1 within 2.2e-07 respectively -- which is the literal 1.0 canonical writes into both tables."
        },
        "zrt_zoneID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "zoneroadtype_rows"
          ],
          "description": "zoneroadtype.zoneID.",
