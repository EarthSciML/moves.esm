              "file_variable": "inputPolProcessID"
            }
          }
        },
        "ep_processID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "emissionprocess_rows"
          ],
          "description": "emissionprocess.processID. The national table has 25 rows and the execution-database copy has the 2 this run touches, which is 59's rule again: read it whole and let the join say which row.",
          "update": {
            "kind": "data",
            "source": "db_emissionprocess",
            "from": {
              "file_variable": "processID"
            }
          }
        },
        "ep_occursOnRealRoads": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "emissionprocess_rows"
          ],
          "description": "emissionprocess.occursOnRealRoads, Y/N text decoded by a `codes` map on the binding. MOVES's own statement of where a process's rates live: Y for running exhaust, brake wear and tire wear, N for start exhaust, extended idle, APU and every evaporative process. It is the only input to `rspp_isEmitted`, so the rule that discards a whole pollutant-process block is READ rather than written down as a list of process ids.",
          "update": {
            "kind": "data",
            "source": "db_emissionprocess",
            "from": {
              "file_variable": "occursOnRealRoads",
              "codes": {
                "map": {
                  "Y": 1,
                  "N": 0
                },
                "case_insensitive": true
              }
            }
          }
        },
        "pmr_polProcessID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "pm10emissionratio_rows"
          ],
