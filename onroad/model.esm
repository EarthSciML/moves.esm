        {
          "lhs": "rt_evSalesFactor",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "or",
                "args": [
                  {
                    "op": ">",
                    "args": [
                      "rt_isElectric",
                      0.5
                    ]
                  },
                  {
                    "op": "or",
                    "args": [
                      {
                        "op": "<",
                        "args": [
                          "rt_hasEvFraction",
                          0.5
                        ]
                      },
                      {
                        "op": "<",
                        "args": [
                          "rt_hasFleetAvgAdjustment",
                          0.5
                        ]
                      }
                    ]
                  }
                ]
              },
              1.0,
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": ">",
                    "args": [
                      "rt_adjustmentCap",
                      0.0
                    ]
                  },
                  {
                    "op": "min",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          1.0,
                          {
                            "op": "-",
                            "args": [
                              1.0,
                              {
                                "op": "/",
                                "args": [
                                  {
                                    "op": "*",
                                    "args": [
                                      "rt_evFraction",
