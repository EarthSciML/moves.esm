        {
          "_comment": "The criteria polynomial, evaluated once per (coefficient set, county, month, formulation). There is no join: every range is an output axis, which is how this format spells an elementwise construction over a product of axes.",
          "lhs": "cff_exponent",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
