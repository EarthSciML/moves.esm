        },
        "run_fuelYearMultiplicity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecyear_rows"
          ],
          "description": "TFG-0's year multiplicity: how many `year` rows share the run's fuel year AND are RunSpec years. 1 here. It multiplies every weight, so it cancels out of TFG-1b's three means but not out of the gasohol market share, which is an absolute sum."
        },
