              },
              "f": {
                "from": "fuelformulation_rows"
              },
              "j": {
                "from": "sulfurmodelcoeff_rows"
              },
              "cy": {
                "from": "runspecyear_rows"
              }
            },
            "join": [
              {
                "on": [
