        },
        "om_isBinnedRunningMode": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "operating_mode_rows"
          ],
          "description": "readOperatingMode's window, inputs.rs:408-419: 1 < opModeID < 100 excluding 26 and 36. The two exclusions are load-bearing -- 26 spans 12<=VSP over 25<=speed<50 and 27-30 partition the same interval finely, so keeping both would make the classification ambiguous and its answer depend on iteration order. With them out the 21 survivors are disjoint AND exhaustive over speed>=1, which is why dss_binnedModeID can SUM an indicator instead of taking a first match."
        },
        "phys_isSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "physics_rows"
          ],
          "description": "Whether the row is one of the vehicles the run drives, with drivecycle.rs:288's guard that both masses are positive. The source type is a JOIN and no longer an axis: a physics row belongs to exactly one source type, so a per-source-type indicator was a matrix with one non-zero per column and the thing the drive cycle is actually per is THIS row."
        },
        "phys_prefixSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "physics_rows"
          ],
          "description": "An inclusive prefix count of the selection over the physics table: how many rows at or before this one the run drives."
        },
        "phys_rank": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "physics_rows"
          ],
          "description": "The prefix count ZEROED on the rows the run does not drive, so every selected row has a dense 1..n_physicsRow and every other one has a 0 that no `phy_ordinal` can match (docs/esm-conventions.md §22). This is the whole of the mapping from the 178-row national table to the run's own drive-cycle axis: WHICH rows survive stays out of the document, and the axis reads its keys back through the join."
        },
        "phy_ordinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
