          "shape": [
            "hourday_rows"
          ],
          "description": "hourday.dayID.",
          "update": {
            "kind": "data",
            "source": "db_hourday",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "hd_hourID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "hourday_rows"
          ],
          "description": "hourday.hourID. The packed hourDayID is looked up from (dayID, hourID), so hourID x 10 + dayID appears nowhere in this document.",
          "update": {
            "kind": "data",
            "source": "db_hourday",
            "from": {
              "file_variable": "hourID"
            }
          }
        },
        "dow_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "dayofanyweek_rows"
          ],
          "description": "dayofanyweek.dayID.",
          "update": {
            "kind": "data",
            "source": "db_dayofanyweek",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "dow_noOfRealDays": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "dayofanyweek_rows"
          ],
          "description": "dayofanyweek.noOfRealDays: 2 and 5. S16's divisor.",
          "update": {
            "kind": "data",
