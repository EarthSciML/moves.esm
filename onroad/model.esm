            }
          }
        },
        "smc_sulfurCoeff": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.sulfurCoeff. TWO QUANTITIES IN ONE COLUMN: an exponent for the log-log function (0.168, 0.236, 0.351 at source type 21) and a per-ppm rate for the log-linear one (1.138e-04). It is declared unitless and the sulfur level is divided by 1 ppm before it reaches either arm, which is the same boundary lib/fuel_effects.esm's `sulfur_power` draws.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "sulfurCoeff"
            }
          }
        },
        "smn_M6emitterID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelname_rows"
          ],
          "description": "sulfurModelName.M6EmitterID.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelname",
            "from": {
              "file_variable": "M6EmitterID"
            }
          }
        },
        "smn_sulfurFunctionID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelname_rows"
          ],
          "description": "sulfurModelName.sulfurFunctionID.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelname",
            "from": {
              "file_variable": "sulfurFunctionID"
            }
          }
        },
        "smn_isLogLog": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelname_rows"
          ],
          "description": "sulfurModelName.sulfurFunctionName -- `log-log` or `log-linear` -- decoded to 1 and 0 by a `codes` map. An equation carried as data, the third in this document after `noxhumidityadjust.humidityNOxEq` and `baseFuel.calculationEngine`.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelname",
            "from": {
              "file_variable": "sulfurFunctionName",
              "codes": {
                "map": {
                  "log-log": 1,
                  "log-linear": 0
                },
                "case_insensitive": true
              }
            }
          }
        },
        "cmxprop_fuelParameterID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "fuelParameterName.fuelParameterID: the eleven properties the RUNNING-exhaust complex model reads, out of the nineteen the table names. Measured: all 241 non-zero `complexModelParameters` rows of pollutant-processes 101, 201 and 301 reference these eleven and no others. Benzene and the four oxygenates are the ones left out, and leaving MTBE out is a relief rather than a loss -- `fuelParameterName` says its expression is `ff.MTBEVolume` and `criteria.rs` applies 0.1786 to it, a disagreement no row reached from here can settle."
        },
        "cmxprop_scale": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The multiplier of `fuelParameterName.fuelParameterExpression`, written so that `scale*(offset + sign*column)` reproduces all four shapes the column holds -- `k*col`, `col`, `k*(c - col)` and the bare `1` -- in the order MOVES multiplies them. Folding T50's `2.0408163*(147.91 - e200)` into `301.8 - 2.04*e200` is the same number in real arithmetic and a different one in binary64, and this file's job is the arithmetic MOVES ran."
        },
        "cmxprop_offset": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The constant inside the bracket: 147.91 for T50, 155.47 for T90, 1 for the two synthetic properties `HI` and `Intercept` that have no column at all, and 0 for the seven that are a column."
        },
        "cmxprop_useETOHVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.eTOHVolume`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useSulfurLevel": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.sulfurLevel`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useRVP": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.rVP`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useE200": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.e200`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useE300": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.e300`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useAromaticContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.aromaticContent`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useOlefinContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.olefinContent`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxcmp_cmpID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexterm_rows"
          ],
          "description": "complexModelParameterName.cmpID: the 26 the three running-exhaust pollutant-processes use, out of 64. The table ships this as a `cmpExpression` STRING; what the string says is which one or two properties the term multiplies, and that is structure rather than run data, so it is here as a pair of parameter identifiers (`criteria.rs`'s `cmp_params`)."
        },
        "cmxcmp_firstParameterID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexterm_rows"
          ],
          "description": "The first property of the product."
        },
        "cmxcmp_secondParameterID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexterm_rows"
          ],
          "description": "The second property, or 0 where the term is linear. Seven of the 26 are linear and nineteen are products -- eight of them a square, which is the same property twice and needs no special case."
        },
        "cmxeng_engineID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexengine_rows"
          ],
          "description": "WHICH FUEL MODELS EACH CALCULATION ENGINE AVERAGES OVER: 3 for predictHC, 10 for co, 6 for predictNOx. `fuelModelName.calculationEngines` carries this as a PIPE-DELIMITED SET -- `|airtoxicsA|co||` -- and no `codes` map can decode a set, so the membership is data here. It is NOT derivable from `complexModelParameters` either, and that is measured rather than assumed: fuel model 11, `All Tier2`, has non-zero CO coefficients and belongs to NO engine (`||`), so a document that took the models from the coefficient table would average CO over eleven models instead of ten."
        },
        "cmxeng_fuelModelID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexengine_rows"
          ],
          "description": "fuelModelName.fuelModelID."
        },
        "cmxcfg_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The three criteria running-exhaust pollutant-processes. Start exhaust -- 102, 202 and 302 -- uses the same six configurations in MOVES and is not here, for the reason the closed form's own relation gives."
        },
        "cmxcfg_pollutantID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The pollutant, which is how the sulfur model is keyed."
        },
        "cmxcfg_processID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The process, likewise. Both are 1 here and are carried rather than assumed, because `sulfurModelCoeff` is keyed on the pair."
        },
        "cmxcfg_engineID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The calculation engine: 1 predictHC, 2 co, 3 predictNOx, matching `baseFuel`'s `codes` map."
        },
        "cmxcfg_isPredictive": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "1 for the PREDICTIVE form, `Sum(w*exp(target)) / Sum(w*exp(base))`, which is NOx and THC; 0 for CO's atDifferenceFraction form, `1 + Sum(w*(exp(target-base) - 1))`. Both are computed for every configuration and one is selected, so both have to be finite -- they are, because every weight is finite and every exponent is a finite sum."
        },
        "cmxcfg_aliasesSulfur": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "1 for CO, which replaces the TARGET fuel's sulfur with the BASE fuel's before evaluating the polynomial (`doCOCalculations`), so its ratio carries no sulfur effect twice. 0 for NOx and THC. This is the one place the three configurations differ in their INPUTS rather than in their arithmetic."
        },
        "cmxprop_isSulfur": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The Sulfur row, which is the only one CO's alias replaces."
        },
        "cmxcfg_baseFormulationID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The formulation each configuration measures against, from `baseFuel` at the complex model's own model-year group: 99 for all three, `High Sulfur Gasoline`."
        },
        "cmx_propertyValue": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows"
          ],
          "description": "The eleven complex-model properties of every fuel formulation, after the high-ethanol substitution and the null sweep. `fuelParameterName.fuelParameterExpression` ported as a form and a table of signs. Unitless by construction: the sulfur level is divided by 1 ppm on its way in, because the complex model raises the ppm NUMBER to powers and multiplies it by other properties."
        },
        "cmx_basePropertyValue": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "complexproperty_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The same eleven properties of the configuration's BASE formulation."
        },
        "cmx_hasCentering": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "complexproperty_rows"
          ],
          "description": "Does `meanFuelParameters` carry a row for this (pollutant-process, property)? `HI` and `Intercept` have none, and neither needs one."
        },
        "cmx_centeringExact": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "complexproperty_rows"
          ],
          "description": "The centring value where a row exists, with a NULL swept to 0 -- which is what a NULL MEANS here."
        },
        "cmx_stdDevExact": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "complexproperty_rows"
          ],
          "description": "The standardising value where a row exists, with a NULL or a non-positive value taken as 1. `NaN > 0` is false, so the same comparison handles both."
        },
        "cmx_centering": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "complexproperty_rows"
          ],
