          "shape": [
            "countyyear_rows"
          ],
          "description": "countyYear.countyID.",
          "update": {
            "kind": "data",
            "source": "db_countyyear",
            "from": {
              "file_variable": "countyID"
            }
          }
        },
        "cyr_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "countyyear_rows"
          ],
          "description": "countyYear.yearID.",
