            "from": {
              "file_variable": "noOfRealDays"
            }
          }
        },
        "evTemperatureReferenceDegF": {
          "type": "parameter",
          "units": "degF",
          "default": 72.0,
          "description": "adjust.rs:108. The EV branch's reference temperature is 72 degF where the standard quadratic's is 75; that is not a typo in either place."
        },
        "evTemperatureSourceTypeCeiling": {
          "type": "parameter",
          "units": "1",
          "default": 40.0,
          "description": "adjust.rs:114. The heat-index suppression applies to source types below 40, i.e. light duty. Source type 21 qualifies, so the suppression is LIVE here and returns 1 only because 66.9 < 67."
        },
        "evTemperatureSuppressionHeatIndex": {
          "type": "parameter",
          "units": "degF",
          "default": 67.0,
          "description": "adjust.rs:114. The fixture's heat index is 59.500000000000 degF -- this run selects hour 7, not the hour 9 an earlier copy of this sentence described -- so it is 7.500 degF below the threshold and the suppression does NOT fire. The EV factor is 1 by its own `adj < 0` clamp instead: two different reasons for the same 1, and they diverge once the heat index passes 67.0. The 0.0999985 degF margin this text used to claim is `mixed-onroad`'s, whose hour 9 is at 66.900001525879; docs/meteorology-generator.md 8.2 tabulates both."
        },
        "idleCeilingMph": {
          "type": "parameter",
          "units": "mi/h",
          "default": 1.0,
          "description": "drivecycle.rs:230. A second below 1 mph is Idling; at national scale a second at exactly 0 mph is Idling too rather than the project-scale mode 501, so the two arms collapse to this one predicate."
        },
        "run_yearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecyear_rows"
          ],
          "description": "The run's calendar years, one per `runspecyear` row. It was a one-row `run_rows` relation that SUMMED `rsy_yearID`, which is the year at one selected year and 4035 at two; `expand-multiyear` selects 2015 and 2020 (PLAN.md §7.3.44)."
        },
        "run_monthID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecmonth_rows"
          ],
          "description": "The run's month."
        },
        "run_hourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The run's hour."
        },
        "run_roadTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The run's ON-NETWORK road type: the one its real-road processes are computed on, whose link carries the county's zone, and whose VMT shares the activity reads. A RunSpec that also selects the off-network road type 1 -- every `-single` run does, beside 4 -- has its off-network processes placed there by `rspp_rateRoadTypeID` and not by this; one that selects ONLY road type 1 reads road type 1 here, so its zone is still found. J27: the reason no process-2 row exists in this snapshot."
        },
        "run_linkID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The link this run computes in each selected county -- ONE ROW PER COUNTY, selected out of the national `Link`'s 22,610 by the county/road-type join."
        },
        "run_countyID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The county, read back from the link rather than from the RunSpec XML, so the join that narrowed `Link` is also what labels the output. Three rows in `expand-counties`."
        },
        "run_zoneID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The zone, which is what S9 allocates SHO to and what the heat index is read for -- and it is per county, which is how three counties get three meteorologies and three allocation factors out of one model."
        },
        "run_refuelingDisplacementProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "18, NAMED from the process enum and carried as a one-row relation so that the control-technology lookup selects its process with a `join.on` and not with a literal (conventions 20.4)."
        },
        "run_refuelingSpillageProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "19, the same for the spillage side."
        },
        "run_vaporProgramAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecyear_rows"
          ],
          "description": "`countyYear.refuelingVaporProgramAdjust` for each selected county at the analysis year: the Stage II vapour-recovery reduction P, applied as (1 - P). Exactly 0 in every run this document has been given, and nonzero in 7,375 of the national table's rows."
        },
        "run_spillProgramAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecyear_rows"
          ],
          "description": "`countyYear.refuelingSpillProgramAdjust`, the same on the spillage side, before the fuel-type fan-out below zeroes it for the fuels no Stage II program covers."
        },
        "spcy_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "spillagecountyyear_rows"
          ],
          "description": "The five fuel types the spillage section synthesises onto the county-year extract, in the SQL's own order: gasoline and E85 first, which the ALTER and the duplicate produce, then the three zero-adjustment inserts."
        },
        "spcy_retainsProgramAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "spillagecountyyear_rows"
          ],
          "description": "Whether the synthesised row KEEPS the county's spillage reduction. Gasoline and E85 do; diesel, CNG and electricity are inserted with zero. It is a property of the fuel and not of the county, which is why it is declared here rather than read."
        },
        "run_linkRoadTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The road type of the county's link the run reads its link quantities from: the on-network one (`run_roadTypeID`). One per county, though every county in a run shares the RunSpec's road types."
        },
        "run_stateID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "countyID / 1000: arithmetic, not a second lookup. Three different states in `expand-counties`, which is what makes the county join's correctness visible in the output."
        },
        "run_baseYearIsAnalysisYear": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecyear_rows"
          ],
          "description": "S1: is each of the run's years flagged as a base year? 2015 and 2020 both are, so §1.5's population and VMT folds are the empty product and finding F12 does not arise. A run whose analysis year is not a base year needs both folds; this document takes the collapsed form and says so here (docs/esm-conventions.md §15)."
        },
        "run_fuelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecyear_rows"
          ],
          "description": "year.fuelYearID for each of the run's years: the scope of the fuel supply and of the fuel-usage rebase."
        },
        "run_hpmsVtypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecsourcetype_rows"
          ],
          "description": "S3's normalisation group, per source type. HPMS 25 for source type 21, shared with 31 and 32 -- which is why the denominator below is not this source type's own population."
        },
        "run_analysisYearVMT": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecsourcetype_rows",
            "runspecyear_rows"
          ],
          "description": "S4. The stored base-year VMT, because the growth fold is empty."
        },
        "run_roadTypeVMTFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecsourcetype_rows"
          ],
          "description": "S5's road-type share, gated to onroad road types."
        },
        "run_monthVMTFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecsourcetype_rows",
            "runspecmonth_rows"
          ],
