            }
          }
        },
        "rff_vaporTermD": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.vaporTermD, the averageRVP coefficient.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "vaporTermD"
            }
          }
        },
        "rff_vaporTermE": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.vaporTermE, 0.418: the refuelingTemperature coefficient of tankTemperatureDif.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "vaporTermE"
            }
          }
        },
        "rff_vaporTermF": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.vaporTermF, -16.6: the constant term of tankTemperatureDif.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "vaporTermF"
            }
          }
        },
        "rff_vaporLowTLimit": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.vaporLowTLimit, 45 degF on gasoline and E85. A (0, 0) PAIR with the high limit disables the 2008 California study relation entirely and leaves the ambient temperature alone, which is what the other three fuels carry -- absence spelled as a pair of zeroes rather than as a missing row.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "vaporLowTLimit"
            }
          }
        },
        "rff_vaporHighTLimit": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.vaporHighTLimit, 90 degF.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "vaporHighTLimit"
            }
          }
        },
        "rff_tankTDiffLimit": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.tankTDiffLimit, 20 degF: the upper bound of the tank-temperature difference.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
