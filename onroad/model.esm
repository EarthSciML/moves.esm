        "cmx_ratioNoSulfur": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "agecategory_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows"
          ],
          "description": "`criteriaRatio.ratioNoSulfur`: the complex model's answer before the sulfur model. 1.017098 for gasoline THC at formulation 9114, which is the column the snapshot stores."
        },
        "cmx_isLogLog": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "Which of the two sulfur functions this coefficient row is, through `sulfurModelName`."
        },
        "cmx_sulfurGroupFirstYear": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "The first model year of `fuelMYGroupID`, decoded as `floor(g/10000)`. Canonical reads a 0 there as 1950; no group in this table is below 10000, so that arm is carried and never taken."
        },
        "cmx_sulfurGroupLastYear": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "The last model year, `g - 10000*floor(g/10000)`."
        },
        "cmx_modelYearOfAge": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "agecategory_rows"
          ],
          "description": "The model year each age category stands for in this run: `yearID - ageID`."
        },
        "cmx_baseSulfurLevel": {
          "type": "unknown",
          "units": "ppm",
          "shape": [
            "complexconfig_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The base formulation's sulfur level, 30 ppm for formulation 99."
        },
        "cmx_sulfurAdjustTarget": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "runspecsourcetype_rows",
            "agecategory_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows"
          ],
          "description": "`blend(targetSulfur)`: half the Normal emitter's adjustment plus half the High emitter's, each `max(sulfShort(s)/sulfShort(30), 0.5)`. The 50/50 blend IS the aggregate over `M6emitterID`, which is why there is no explicit 0.5 anywhere but in the summand."
        },
        "cmx_sulfurAdjustBase": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "runspecsourcetype_rows",
            "agecategory_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The same blend at the base fuel's sulfur."
        },
        "cmx_sulfurEffect": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "runspecsourcetype_rows",
            "agecategory_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows"
          ],
          "description": "`blend(target)/blend(base)`, the sulfur model's multiplier."
        },
        "cmx_ratio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "runspecsourcetype_rows",
            "agecategory_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows"
          ],
          "description": "`ratioNoSulfur * sulfEff` -- `criteriaRatio.ratio` for a gasoline cohort of model year 2000 or earlier."
        },
        "cmx_suppliedRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "runspecsourcetype_rows",
            "agecategory_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The market-share-weighted ratio over the gasoline formulations the county's fuel supply carries."
        },
        "rt_hasComplexRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Is this rate row a gasoline cohort of model year 2000 or earlier, at a criteria running-exhaust pollutant-process? 63 of `expand-criteria`'s 372 output cells are."
        },
        "rt_complexRatioExact": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The complex model's ratio for those rows, 0 elsewhere."
        },
        "rt_hasCriteriaRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Does a criteria fuel-effect row cover this rate row's (fuel type, pollutant-process, source type, model year)? 0 for electricity, for CNG, for diesel model years after 2006 and for ethanol model years before 2001 -- MOVES leaves all of those unscaled."
        },
        "rt_criteriaRatioExact": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The covered arm of `rt_criteriaRatio`, 0 where no row covers."
        },
        "rt_criteriaRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The criteria fuel-effect ratio `adjust.rs:477-493` scales every rate field by, for processes 1 and 2. On `expand-criteria` it runs from 0.501 to 1.044 and the NOx gasoline 2001-2016 cohorts are a factor of two, so it is not a correction -- it is half the answer."
        },
        "cty_countyID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "county_rows"
          ],
          "description": "county.countyID. The national table's key; the run selects from it through `rsc_countyID`.",
          "update": {
            "kind": "data",
            "source": "db_county",
            "from": {
              "file_variable": "countyID"
            }
          }
        },
        "cty_barometricPressure": {
          "type": "parameter",
          "units": "inHg",
          "default": 0.0,
          "shape": [
            "county_rows"
          ],
          "description": "county.barometricPressure, inches of mercury -- 29.095 for Washtenaw. The unit is declared, and every use multiplies by 3.38639 to reach kPa exactly once, in lib/meteorology.esm's `ambient_pressure_kilopascals`.\n\nWHAT IS NOT CARRIED. MOVES runs two `UPDATE County` statements before the humidity pass: MG-1 fills a missing or non-positive pressure from the altitude CLASS, MG-2 then classes a missing altitude from that pressure. Neither is here. MG-1's guard cannot fire -- across all 40 snapshots and 22,815 `County` rows not one has a NULL or non-positive pressure (docs/meteorology-generator.md 8.1) -- and MG-2 writes a column nothing downstream reads. Both arms are checked in components/meteorology.esm against the SQL as ported, which is the only place they can be checked at all.",
          "update": {
            "kind": "data",
            "source": "db_county",
            "from": {
              "file_variable": "barometricPressure"
            }
          }
        },
        "nha_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "noxhumidityadjust_rows"
          ],
          "description": "noxhumidityadjust.fuelTypeID: 1, 2 and 5. Fuel type 9 is absent, so an electricity rate row takes no humidity correction.",
          "update": {
            "kind": "data",
            "source": "db_noxhumidityadjust",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "nha_humidityNOxEq": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "noxhumidityadjust_rows"
          ],
          "description": "noxhumidityadjust.humidityNOxEq -- `CFR 86` or `CFR 1065`, decoded to 86 and 1065 by a `codes` map on the binding. An EQUATION carried as data, which is why the two forms are two filtered aggregates below and not one expression with a coefficient switch (conventions 30.4).",
          "update": {
            "kind": "data",
            "source": "db_noxhumidityadjust",
            "from": {
              "file_variable": "humidityNOxEq",
              "codes": {
                "map": {
                  "CFR 86": 86,
                  "CFR 1065": 1065
                },
                "case_insensitive": true
              }
            }
          }
        },
        "nha_humidityTermA": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "noxhumidityadjust_rows"
          ],
          "description": "noxhumidityadjust.humidityTermA: 0.0329 for CFR 86 and 9.953 for CFR 1065. The same column name, two different roles.",
          "update": {
            "kind": "data",
            "source": "db_noxhumidityadjust",
            "from": {
              "file_variable": "humidityTermA"
            }
          }
        },
        "nha_humidityTermB": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "noxhumidityadjust_rows"
          ],
          "description": "noxhumidityadjust.humidityTermB, 0.832 on the CFR 1065 row and NULL -- hence NaN -- on the two CFR 86 rows. It is read only inside an aggregate whose filter has already excluded those rows, so the NaN never reaches an operator; a document that folded both forms into one expression would return NaN for every gasoline cohort.",
          "update": {
            "kind": "data",
            "source": "db_noxhumidityadjust",
            "from": {
              "file_variable": "humidityTermB"
            }
          }
        },
        "nha_humidityLowBound": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "noxhumidityadjust_rows"
          ],
          "description": "noxhumidityadjust.humidityLowBound: 3.0 g/kg for CFR 86, 0.002 mole fraction for CFR 1065. Two different UNITS in one column, which is why the bound has to travel with the equation.",
          "update": {
            "kind": "data",
            "source": "db_noxhumidityadjust",
            "from": {
              "file_variable": "humidityLowBound"
            }
          }
        },
        "nha_humidityUpBound": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "noxhumidityadjust_rows"
          ],
          "description": "noxhumidityadjust.humidityUpBound: 17.71 g/kg for CFR 86, 0.035 mole fraction for CFR 1065.",
          "update": {
            "kind": "data",
            "source": "db_noxhumidityadjust",
            "from": {
              "file_variable": "humidityUpBound"
            }
          }
        },
        "hd_hourDayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "hourday_rows"
          ],
          "description": "hourday.hourDayID.",
          "update": {
            "kind": "data",
            "source": "db_hourday",
            "from": {
              "file_variable": "hourDayID"
            }
          }
        },
        "hd_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "hourday_rows"
          ],
          "description": "hourday.dayID.",
          "update": {
            "kind": "data",
            "source": "db_hourday",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "hd_hourID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "hourday_rows"
          ],
          "description": "hourday.hourID. The packed hourDayID is looked up from (dayID, hourID), so hourID x 10 + dayID appears nowhere in this document.",
          "update": {
            "kind": "data",
            "source": "db_hourday",
            "from": {
              "file_variable": "hourID"
            }
          }
        },
        "dow_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "dayofanyweek_rows"
          ],
          "description": "dayofanyweek.dayID.",
          "update": {
            "kind": "data",
            "source": "db_dayofanyweek",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "dow_noOfRealDays": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "dayofanyweek_rows"
          ],
          "description": "dayofanyweek.noOfRealDays: 2 and 5. S16's divisor.",
          "update": {
            "kind": "data",
            "source": "db_dayofanyweek",
            "from": {
              "file_variable": "noOfRealDays"
            }
          }
        },
        "evTemperatureReferenceDegF": {
          "type": "parameter",
          "units": "degF",
          "default": 72.0,
          "description": "adjust.rs:108. The EV branch's reference temperature is 72 degF where the standard quadratic's is 75; that is not a typo in either place."
        },
        "evTemperatureSourceTypeCeiling": {
          "type": "parameter",
          "units": "1",
          "default": 40.0,
          "description": "adjust.rs:114. The heat-index suppression applies to source types below 40, i.e. light duty. Source type 21 qualifies, so the suppression is LIVE here and returns 1 only because 66.9 < 67."
        },
        "evTemperatureSuppressionHeatIndex": {
          "type": "parameter",
          "units": "degF",
          "default": 67.0,
          "description": "adjust.rs:114. The fixture's heat index is 59.500000000000 degF -- this run selects hour 7, not the hour 9 an earlier copy of this sentence described -- so it is 7.500 degF below the threshold and the suppression does NOT fire. The EV factor is 1 by its own `adj < 0` clamp instead: two different reasons for the same 1, and they diverge once the heat index passes 67.0. The 0.0999985 degF margin this text used to claim is `mixed-onroad`'s, whose hour 9 is at 66.900001525879; docs/meteorology-generator.md 8.2 tabulates both."
        },
        "idleCeilingMph": {
          "type": "parameter",
          "units": "mi/h",
          "default": 1.0,
          "description": "drivecycle.rs:230. A second below 1 mph is Idling; at national scale a second at exactly 0 mph is Idling too rather than the project-scale mode 501, so the two arms collapse to this one predicate."
        },
        "run_yearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The run's analysis year. Every run-level quantity is a one-row RELATION and not a scalar: a scalar has no state in a document that ingests (finding F16)."
        },
        "run_monthID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecmonth_rows"
          ],
          "description": "The run's month."
        },
        "run_hourID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The run's hour."
        },
        "run_roadTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The run's road type. J27: the reason no process-2 row exists in this snapshot."
        },
        "run_linkID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The link this run computes in each selected county -- ONE ROW PER COUNTY, selected out of the national `Link`'s 22,610 by the county/road-type join."
        },
        "run_countyID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The county, read back from the link rather than from the RunSpec XML, so the join that narrowed `Link` is also what labels the output. Three rows in `expand-counties`."
        },
        "run_zoneID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The zone, which is what S9 allocates SHO to and what the heat index is read for -- and it is per county, which is how three counties get three meteorologies and three allocation factors out of one model."
        },
        "run_linkRoadTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "The link's road type, which is what the output row is labelled with. One per county, though every county in a run shares the RunSpec's road types."
        },
        "run_stateID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows"
          ],
          "description": "countyID / 1000: arithmetic, not a second lookup. Three different states in `expand-counties`, which is what makes the county join's correctness visible in the output."
        },
        "run_baseYearIsAnalysisYear": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "S1: is 2020 flagged as a base year? It is, so §1.5's population and VMT folds are the empty product and finding F12 does not arise. A run whose analysis year is not a base year needs both folds; this document takes the collapsed form and says so here (docs/esm-conventions.md §15)."
        },
        "run_fuelYearID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "year.fuelYearID for the analysis year: the scope of the fuel-usage rebase."
        },
        "run_hpmsVtypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecsourcetype_rows"
          ],
          "description": "S3's normalisation group, per source type. HPMS 25 for source type 21, shared with 31 and 32 -- which is why the denominator below is not this source type's own population."
        },
        "run_analysisYearVMT": {
          "type": "unknown",
          "units": "1",
          "shape": [
