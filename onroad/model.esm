        },
        "outNoOfRealDays": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "J35: 5, this run's only day type being the weekday one (docs/esm-conventions.md 42). It was 2 for the weekend block and 5 for the weekday block while the RunSpec's out-of-range `<day key=>` selected both."
        },
        "out_activity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "S16, mod.rs:1602-1608: SHO over noOfRealDays. Leaving the divisor out gives 4.48 on the weekday rows this run emits where §6.1 wants 0.8955."
