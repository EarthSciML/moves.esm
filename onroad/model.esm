        "rt_speciationAltQuotient": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "`altCriteriaRatio / criteriaRatio` -- the ratio of the pseudo-THC tally `altTHC` to the reported THC -- computed as the exponential of the exponent difference, because the two ratios share every other factor. 0.9934070 for formulation 27002 on this corpus, against 0.993396 read off the run. One outside the E10 model years and processes."
        },
        "rt_speciationOperandCorrection": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "What the NMOG and VOC arms multiply by, over and above their speciation constant: the operand MOVES speciates them from, as a multiple of the NMHC this document actually reports. On the E10 path that operand is `altTHC x (1 - CH4THCRatio[E10])` while the reported NMHC is `THC x (1 - CH4THCRatio[own])`, so the correction is the quotient of the two; everywhere else it is one. The denominator cannot vanish: `CH4THCRatio` tops out at 0.959 over the national table's 1,117 rows and is 0 where the table has no row at all."
        },
        "rt_methaneChainRatio": {
          "type": "unknown",
          "units": "1",
