          "shape": [
            "fuelformulation_rows"
          ],
          "description": "Whether the formulation has an RVP: a NULL is the one value not equal to itself."
        },
        "ff_hasETOHVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelformulation_rows"
          ],
          "description": "Whether it has an ethanol volume, before the high-ethanol substitution -- which supplies one for subtypes 51 and 52 whatever the table says."
        },
        "tfg_weight": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "TFG-1a's weight: the formulation's market share in the county's fuel region, fuel year and month group, times the year multiplicity, for a formulation of an evaporative fuel type with a positive share, else 0."
        },
        "tfg_gasPortionRVP": {
          "type": "unknown",
          "units": "1",
