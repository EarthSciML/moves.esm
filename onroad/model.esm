          "default": 0.0,
          "shape": [
            "meanfuelparameters_rows"
          ],
          "description": "meanFuelParameters.fuelTypeID.",
          "update": {
            "kind": "data",
            "source": "db_meanfuelparameters",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "mfp_modelYearGroupID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "meanfuelparameters_rows"
          ],
          "description": "meanFuelParameters.modelYearGroupID; the criteria complex model centres at 19502000.",
          "update": {
            "kind": "data",
            "source": "db_meanfuelparameters",
            "from": {
              "file_variable": "modelYearGroupID"
            }
          }
        },
        "mfp_fuelParameterID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "meanfuelparameters_rows"
          ],
          "description": "meanFuelParameters.fuelParameterID, the property this row centres.",
          "update": {
            "kind": "data",
            "source": "db_meanfuelparameters",
            "from": {
              "file_variable": "fuelParameterID"
            }
          }
        },
        "mfp_centeringValue": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "meanfuelparameters_rows"
          ],
          "description": "meanFuelParameters.centeringValue. NULL -- hence NaN -- on the E200, E300 and Benzene rows of THC and NOx; a NULL means NO CENTRING, which is 0.",
          "update": {
            "kind": "data",
            "source": "db_meanfuelparameters",
            "from": {
              "file_variable": "centeringValue"
            }
          }
        },
        "mfp_stdDevValue": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "meanfuelparameters_rows"
          ],
          "description": "meanFuelParameters.stdDevValue. NULL means NO STANDARDISING, which is 1 and not 0 -- a different null from the column beside it. Every CO row is NULL here and none is NULL in `centeringValue`. NOTE the shipped `complexModelParameterName.cmpExpression` text OMITS this division even where the value is not 1, so the table's own expression is incomplete relative to what MOVES computes; `criteria.rs` applies it and so does this document.",
          "update": {
            "kind": "data",
            "source": "db_meanfuelparameters",
            "from": {
              "file_variable": "stdDevValue"
            }
          }
        },
        "fmw_fuelModelID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fuelmodelwtfactor_rows"
          ],
          "description": "fuelModelWtFactor.fuelModelID.",
          "update": {
            "kind": "data",
            "source": "db_fuelmodelwtfactor",
            "from": {
              "file_variable": "fuelModelID"
            }
          }
        },
        "fmw_modelYearGroupID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fuelmodelwtfactor_rows"
          ],
          "description": "fuelModelWtFactor.modelYearGroupID: 19502000 for the CO fuel models and 0 for the predictive ones.",
          "update": {
            "kind": "data",
            "source": "db_fuelmodelwtfactor",
            "from": {
              "file_variable": "modelYearGroupID"
            }
          }
        },
        "fmw_ageID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fuelmodelwtfactor_rows"
          ],
          "description": "fuelModelWtFactor.ageID. This key is why the complex-model ratio is a property of the COHORT and not only of the fuel.",
          "update": {
            "kind": "data",
            "source": "db_fuelmodelwtfactor",
            "from": {
              "file_variable": "ageID"
            }
          }
        },
        "fmw_fuelModelWtFactor": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fuelmodelwtfactor_rows"
          ],
          "description": "fuelModelWtFactor.fuelModelWtFactor, the weight this fuel model carries in the sum.",
          "update": {
            "kind": "data",
            "source": "db_fuelmodelwtfactor",
            "from": {
              "file_variable": "fuelModelWtFactor"
            }
          }
        },
        "bfu_calculationEngine": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "basefuel_rows"
          ],
          "description": "baseFuel.calculationEngine -- `predictHC`, `co`, `predictNOx` or `airtoxicsA` -- decoded to 1, 2, 3 and 4 by a `codes` map. The fourth is the air-toxics engine, which this document does not compute; it is in the map because a value the map does not carry is a load error, and leaving it out would make the table's fourth engine an accident waiting for the next rung.",
          "update": {
            "kind": "data",
            "source": "db_basefuel",
            "from": {
              "file_variable": "calculationEngine",
              "codes": {
                "map": {
                  "predictHC": 1,
                  "co": 2,
                  "predictNOx": 3,
                  "airtoxicsA": 4
                },
                "case_insensitive": true
              }
            }
          }
        },
        "bfu_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "basefuel_rows"
          ],
          "description": "baseFuel.fuelTypeID; every row is gasoline.",
          "update": {
            "kind": "data",
            "source": "db_basefuel",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "bfu_modelYearGroupID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "basefuel_rows"
          ],
          "description": "baseFuel.modelYearGroupID: 19502000, 20012050 and 20512060.",
          "update": {
            "kind": "data",
            "source": "db_basefuel",
            "from": {
              "file_variable": "modelYearGroupID"
            }
          }
        },
        "bfu_fuelFormulationID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "basefuel_rows"
          ],
          "description": "baseFuel.fuelFormulationID: 99 (`High Sulfur Gasoline`) for model-year group 19502000 and 98 (`Low Sulfur Gasoline`) after it. This is the formulation the ratio is a ratio TO, and it is why the captured `criteriaRatio` carries rows for 98 and 99 whose ratio is exactly 1.",
          "update": {
            "kind": "data",
            "source": "db_basefuel",
            "from": {
              "file_variable": "fuelFormulationID"
            }
          }
        },
        "smc_processID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.processID.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "processID"
            }
          }
        },
        "smc_pollutantID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.pollutantID.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "pollutantID"
            }
          }
        },
        "smc_M6emitterID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.M6emitterID: 1 Normal, 2 High. The two are blended 50/50, so the aggregate over this key IS the blend.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "M6emitterID"
            }
          }
        },
        "smc_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.sourceTypeID. The sulfur model is per source type, like the closed form's own sulfur power.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "smc_fuelMYGroupID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.fuelMYGroupID. The model-year range is encoded IN the identifier -- `19972000` is 1997 to 2000 -- so the two bounds are decoded arithmetically rather than read from a column.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "fuelMYGroupID"
            }
          }
        },
        "smc_sulfurFunctionID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.sulfurFunctionID, which of the two functions `sulfurModelName` names.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "sulfurFunctionID"
            }
          }
        },
        "smc_sulfurCoeff": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.sulfurCoeff. TWO QUANTITIES IN ONE COLUMN: an exponent for the log-log function (0.168, 0.236, 0.351 at source type 21) and a per-ppm rate for the log-linear one (1.138e-04). It is declared unitless and the sulfur level is divided by 1 ppm before it reaches either arm, which is the same boundary lib/fuel_effects.esm's `sulfur_power` draws.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "sulfurCoeff"
            }
          }
        },
        "smn_M6emitterID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelname_rows"
          ],
          "description": "sulfurModelName.M6EmitterID.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelname",
            "from": {
              "file_variable": "M6EmitterID"
            }
          }
        },
        "smn_sulfurFunctionID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelname_rows"
          ],
          "description": "sulfurModelName.sulfurFunctionID.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelname",
            "from": {
              "file_variable": "sulfurFunctionID"
            }
          }
        },
        "smn_isLogLog": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelname_rows"
          ],
          "description": "sulfurModelName.sulfurFunctionName -- `log-log` or `log-linear` -- decoded to 1 and 0 by a `codes` map. An equation carried as data, the third in this document after `noxhumidityadjust.humidityNOxEq` and `baseFuel.calculationEngine`.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelname",
            "from": {
              "file_variable": "sulfurFunctionName",
              "codes": {
                "map": {
                  "log-log": 1,
                  "log-linear": 0
                },
                "case_insensitive": true
              }
            }
          }
        },
        "cmxprop_fuelParameterID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "fuelParameterName.fuelParameterID: the eleven properties the RUNNING-exhaust complex model reads, out of the nineteen the table names. Measured: all 241 non-zero `complexModelParameters` rows of pollutant-processes 101, 201 and 301 reference these eleven and no others. Benzene and the four oxygenates are the ones left out, and leaving MTBE out is a relief rather than a loss -- `fuelParameterName` says its expression is `ff.MTBEVolume` and `criteria.rs` applies 0.1786 to it, a disagreement no row reached from here can settle."
        },
        "cmxprop_scale": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The multiplier of `fuelParameterName.fuelParameterExpression`, written so that `scale*(offset + sign*column)` reproduces all four shapes the column holds -- `k*col`, `col`, `k*(c - col)` and the bare `1` -- in the order MOVES multiplies them. Folding T50's `2.0408163*(147.91 - e200)` into `301.8 - 2.04*e200` is the same number in real arithmetic and a different one in binary64, and this file's job is the arithmetic MOVES ran."
        },
        "cmxprop_offset": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The constant inside the bracket: 147.91 for T50, 155.47 for T90, 1 for the two synthetic properties `HI` and `Intercept` that have no column at all, and 0 for the seven that are a column."
        },
        "cmxprop_useETOHVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.eTOHVolume`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useSulfurLevel": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.sulfurLevel`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useRVP": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.rVP`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useE200": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.e200`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useE300": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.e300`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useAromaticContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.aromaticContent`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useOlefinContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.olefinContent`: +1 where the property IS that column, -1 where the column is subtracted inside the bracket, 0 otherwise. Exactly one of the seven is non-zero on each row, so the sum that reads them adds one number to six zeros."
        },
        "cmxprop_useBenzeneContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.benzeneContent`. Benzene is a property of the AIR-TOXICS engine and of no criteria pollutant-process, which is why the eleven above did not carry it."
        },
        "cmxprop_useMTBEVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The sign this property applies to `fuelFormulation.MTBEVolume`. `fuelParameterName` writes the MTBE property as the bare column and puts the 0.1786 volume-to-mass factor in `complexModelParameterName`'s term expression instead; this document keeps the factor in `cmxprop_scale`, where every other property's scale lives, and the two spellings are the same arithmetic because the term is linear in it. Unfalsifiable on this corpus: MTBE volume is 0 on all seven supplied formulations."
        },
        "cmxprop_useETBEVolume": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "Selects `ffx_ETBEVolume`. One property reads it: `ETBE`, fuelParameterID 11."
        },
        "cmxcmp_cmpID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexterm_rows"
          ],
          "description": "complexModelParameterName.cmpID: the 26 the three running-exhaust pollutant-processes use, out of 64. The table ships this as a `cmpExpression` STRING; what the string says is which one or two properties the term multiplies, and that is structure rather than run data, so it is here as a pair of parameter identifiers (`criteria.rs`'s `cmp_params`)."
        },
        "cmxcmp_firstParameterID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexterm_rows"
          ],
          "description": "The first property of the product."
        },
        "cmxcmp_secondParameterID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexterm_rows"
          ],
          "description": "The second property, or 0 where the term is linear. Seven of the 26 are linear and nineteen are products -- eight of them a square, which is the same property twice and needs no special case."
        },
        "cmxeng_engineID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexengine_rows"
          ],
          "description": "WHICH FUEL MODELS EACH CALCULATION ENGINE AVERAGES OVER: 3 for predictHC, 10 for co, 6 for predictNOx. `fuelModelName.calculationEngines` carries this as a PIPE-DELIMITED SET -- `|airtoxicsA|co||` -- and no `codes` map can decode a set, so the membership is data here. It is NOT derivable from `complexModelParameters` either, and that is measured rather than assumed: fuel model 11, `All Tier2`, has non-zero CO coefficients and belongs to NO engine (`||`), so a document that took the models from the coefficient table would average CO over eleven models instead of ten."
        },
        "cmxeng_fuelModelID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexengine_rows"
          ],
          "description": "fuelModelName.fuelModelID."
        },
        "cmxcfg_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The eleven complex-model configurations: the three criteria running-exhaust pollutant-processes 101, 201 and 301, the four air toxics whose model-year-2000-and-earlier ratio the complex model supplies -- benzene 2001, 1,3-butadiene 2401, formaldehyde 2501 and acetaldehyde 2601 -- VOC's own 8701, which is those four quotients' shared denominator, and since step 7f the three criteria START-exhaust ones, 102, 202 and 302, whose coefficients complexModelParameters and sulfurModelCoeff carry at process 2."
        },
        "cmxcfg_pollutantID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The pollutant, which is how the sulfur model is keyed."
        },
        "cmxcfg_processID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The process, likewise. Both are 1 here and are carried rather than assumed, because `sulfurModelCoeff` is keyed on the pair."
        },
        "cmxcfg_engineID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The calculation engine: 1 predictHC, 2 co, 3 predictNOx, matching `baseFuel`'s `codes` map."
        },
        "cmxcfg_isPredictive": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "1 for the PREDICTIVE form, `Sum(w*exp(target)) / Sum(w*exp(base))`, which is NOx and THC; 0 for CO's atDifferenceFraction form, `1 + Sum(w*(exp(target-base) - 1))`. Both are computed for every configuration and one is selected, so both have to be finite -- they are, because every weight is finite and every exponent is a finite sum."
        },
        "cmxcfg_aliasesSulfur": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "1 for CO, which replaces the TARGET fuel's sulfur with the BASE fuel's before evaluating the polynomial (`doCOCalculations`), so its ratio carries no sulfur effect twice. 0 for NOx and THC. This is the one place the three configurations differ in their INPUTS rather than in their arithmetic."
        },
        "cmxcfg_meanModelYearGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "Which `meanFuelParameters` model-year group supplies this configuration's centring and standardising values: 19502000 for the three criteria pollutant-processes and 0 for the four air-toxics ones. It was the literal 19502000 until the air-toxics engine arrived, and a constant that turns out to be a key is docs/esm-conventions.md 47's width-one trap -- the criteria configurations could not see it because all three sit in the same group."
        },
        "cmxcfg_baseModelYearGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "Which `baseFuel` model-year group names this configuration's base formulation: 19502000 for the three criteria pollutant-processes, whose base is High Sulfur Gasoline 99, and 0 for the air-toxics engine, whose base is `Base Gasoline Fuel` 96. `criteria.rs` reads this as 19502000-then-0; the group is per configuration here because that is what the two values ARE, and a fallback would hide which one each configuration used."
        },
        "cmxcfg_isCriteria": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "1 for the three configurations `criteriaRatio` is made of. It was implicit while those were the only three, and `rt_hasComplexRatio` would otherwise hand a benzene rate row the criteria fuel-effect ratio -- the join is on the pollutant-process alone and the air-toxics configurations answer to it."
        },
        "cmxcfg_isAirToxic": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "1 for the four configurations `ATRatio`'s complex-model half is made of. VOC's own 8701 is NOT one of them: it is the DENOMINATOR of all four quotients, and a rate row carrying it is an emitted species and not a toxic."
        },
        "cmxprop_isSulfur": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows"
          ],
          "description": "The Sulfur row, which is the only one CO's alias replaces."
        },
        "cmxcfg_baseFormulationID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows"
          ],
          "description": "The formulation each configuration measures against, from `baseFuel` at the complex model's own model-year group: 99 for all three, `High Sulfur Gasoline`."
        },
        "cmx_propertyValue": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexproperty_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "fuelformulation_rows",
            "runspecyear_rows"
          ],
          "description": "The fifteen complex-model properties of every fuel formulation, after the high-ethanol substitution and the null sweep. `fuelParameterName.fuelParameterExpression` ported as a form and a table of signs. Unitless by construction: the sulfur level is divided by 1 ppm on its way in, because the complex model raises the ppm NUMBER to powers and multiplies it by other properties."
        },
        "cmx_basePropertyValue": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "complexconfig_rows",
            "complexproperty_rows",
            "runspeccounty_rows",
            "runspecmonth_rows",
            "runspecyear_rows"
          ],
          "description": "The same fifteen properties of the configuration's BASE formulation."
        },
        "cmx_hasCentering": {
          "type": "unknown",
