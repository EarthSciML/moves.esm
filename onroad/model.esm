        "hcs_oxySpeciation": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "hcspeciation_rows"
          ],
          "description": "hcspeciation.oxySpeciation, the coefficient on the fuel's oxygen weight percent. It is EXACTLY ZERO in all 2,562 rows of the national table, so the oxygenate term `oxySpeciation x volToWtPercentOxy x totalOxygenate` contributes nothing anywhere and this document does not carry the two fuel properties it would need. That is a fact about the DATA and not about MOVES, so it is counted rather than assumed: `run_oxySpeciationReached` is the number of rows a run's joins reach whose coefficient is not zero, asserted at 0, and the day a county database ships one the run says so instead of quietly dropping a term (lib/adjustments.esm's `speciation_factor` is the form it would take).",
          "update": {
            "kind": "data",
            "source": "db_hcspeciation",
            "from": {
              "file_variable": "oxySpeciation"
            }
          }
        },
