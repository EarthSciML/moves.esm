                  "args": [
                    "nha_humidityTermB",
                    "h"
                  ]
                },
                "bounded_mole_fraction": {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "bounded_low_then_high",
                  "bindings": {
                    "value": {
                      "op": "index",
                      "args": [
                        "run_molWaterFraction",
                        "g",
                        "m"
                      ]
                    },
                    "low_bound": {
                      "op": "index",
                      "args": [
                        "nha_humidityLowBound",
                        "h"
                      ]
                    },
                    "up_bound": {
                      "op": "index",
                      "args": [
                        "nha_humidityUpBound",
                        "h"
                      ]
