                    "rt_ageGroupID",
                    "erba_ageGroupID"
                  ]
                ]
              }
            ],
            "expr": 1.0
          },
          "_comment": "J58, the existence half: the same join as J22 against `emissionratebyage`, with the cohort's AGE GROUP as a sixth key pair. `sbweighted.rs:276-289` keeps the rate row only when its ageGroupID is `AgeCategory[year - modelYearID]`, which is what `rt_ageGroupID` already is."
        },
        {
          "_comment": "Which arm this rate row's pollutant-process lives in. The two rate tables are DISJOINT in polProcessID -- a pollutant either deteriorates with age or does not -- so this SELECTS rather than adds, and `run_rateRowsInBothRateTables` is the check that the disjointness holds for the run rather than being assumed here.",
          "lhs": "rt_hasRate",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "exact_else_wildcard",
            "bindings": {
              "has_exact": "rt_hasRateByAge",
              "exact_value": 1.0,
              "wildcard_value": "rt_hasRateAgeless"
            }
          }
        },
