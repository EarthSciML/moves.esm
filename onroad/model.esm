        "rt_isTOG": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Pollutant 86. TOG is the only chained pollutant-process in this port with TWO parents and no table of its own: it is methane plus NMOG, so its arm is the number one and the work is done by the second parent."
        },
        "rt_ch4RatioOwn": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "`methaneTHCRatio.CH4THCRatio` at the row's OWN fuel subtype, market-share weighted over the county's fuel supply. This is the one the REPORTED methane and NMHC use, on every fuel and every model year -- the E10 substitution below changes what NMOG and VOC are computed from and not what NMHC is reported as, which is the fidelity note that makes the E85 rows come out at 0.178 of THC and not 0.662."
        },
        "rt_ch4RatioE10": {
          "type": "unknown",
          "units": "1",
          "shape": [
