        "coh_acFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows",
            "runspeccounty_rows"
          ],
          "description": "S15(d), setup.rs:409-411: the run-level clamped activity times the two per-cohort fractions. Exactly 0 here because the activity clamped. Per county, through the activity."
        },
        "out_dayID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The row's day type."
