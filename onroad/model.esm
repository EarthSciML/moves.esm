                    "cmp_fuelModelID"
                  ],
                  [
                    "cmxcmp_cmpID",
                    "cmp_cmpID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "apply_expression_template",
                      "args": [],
                      "name": "fuel_property_or_zero",
                      "bindings": {
                        "value": {
                          "op": "index",
                          "args": [
                            "cmp_coeff1",
                            "x"
                          ]
                        }
                      }
                    },
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "apply_expression_template",
                          "args": [],
                          "name": "fuel_property_or_zero",
                          "bindings": {
                            "value": {
                              "op": "index",
                              "args": [
                                "cmp_coeff2",
                                "x"
                              ]
                            }
                          }
                        },
                        {
                          "op": "apply_expression_template",
                          "args": [],
