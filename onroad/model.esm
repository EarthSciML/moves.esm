        },
        "bin_usedFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcebin_rows",
            "runspeccounty_rows"
          ],
          "description": "S12, source_bin_distribution_generator.rs:1590-1637: the same activity re-attributed to the fuel each cohort actually BURNS. The equipped and used sides must agree on model year, engine technology, regulatory class and model-year group and differ only in the fuel. This is the column the base rate is weighted by (sbweighted.rs:148-165), and using the equipped one instead is a factor of 55 on the E85 rows. PER COUNTY, because `fuelUsageFraction` is keyed by county -- E85 is not available everywhere, so the same cohort grid is re-attributed differently in each. The self-join matches on the SOURCE TYPE as well as the model year, engine technology and regulatory class: with one source type selected that was implied, and with two a passenger car would be re-attributed a light commercial truck's activity."
        },
        "er_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "emissionrate_rows"
          ],
          "description": "The fuel type unpacked from the packed sourceBinID. `floor(bin/1e16) mod 100` has a small exact quotient even though the id itself is past 2^53, which is what makes the INVERSE safe where composing one is not (§2.2, §4.4)."
        },
        "er_engTechID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "emissionrate_rows"
          ],
          "description": "The engine technology, slot 1e14."
        },
        "er_regClassID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "emissionrate_rows"
          ],
          "description": "The regulatory class, slot 1e12."
        },
        "er_shortModYrGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "emissionrate_rows"
          ],
          "description": "The short model-year group, slot 1e10."
        },
        "bin_fleetAvgGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcebin_rows"
          ],
          "description": "The bin's fleet-average group, from its regulatory class: 20 is group 1."
        },
        "bin_salesAllFuels": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcebin_rows"
          ],
          "description": "The denominator of the EV share: this model year's age-0 sales across every fuel, in this fleet-average group and over every source type. Population times the age-0 fraction times the sample-vehicle share, which is what MOVES sums."
        },
        "bin_salesElectric": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcebin_rows"
          ],
          "description": "The same sum restricted to fuelType 9. The ratio of the two is evSalesFraction.evFraction, which the default database does not ship because MOVES derives it at execution time."
        },
        "bin_hasElectricRow": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcebin_rows"
          ],
          "description": "Whether any fuelType-9 sample-vehicle row survives the join at all. MOVES emits an evSalesFraction row for exactly the groups that have one -- its two subqueries are INNER joined -- and the share may still be 0, so presence and value are two facts and this is the first of them."
        },
        "bin_evFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcebin_rows"
          ],
          "description": "The EV share of this model year's sales in this fleet-average group. COMPUTED here since 7c' rather than read from an execution database's evSalesFraction: MOVES builds that table from four default tables this document already ingests, and the ratio is the whole of it."
        },
        "bin_hasEvFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcebin_rows"
          ],
          "description": "Whether the EV share exists for this cohort: a miss leaves the factor at 1 rather than dividing by 1 - 0. It used to mean `evsalesfraction has a row`, and it means the same thing now stated as the condition under which MOVES would have written one -- a fuelType-9 sample-vehicle row, and sales above zero."
        },
        "coh_acPenetrationFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "J30."
        },
        "coh_functioningACFraction": {
