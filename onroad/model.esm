        },
        "rff_vaporTermA": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.vaporTermA, the constant term of the displaced-vapour exponential. -1.2798 on gasoline and E85 and 0 on diesel, CNG and electricity.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "vaporTermA"
            }
          }
        },
        "rff_vaporTermB": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.vaporTermB, the tankTemperatureDif coefficient.",
          "update": {
            "kind": "data",
            "source": "db_refuelingfactors",
            "from": {
              "file_variable": "vaporTermB"
            }
          }
        },
        "rff_vaporTermC": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "refuelingFactors.vaporTermC, the refuelingTemperature coefficient.",
          "update": {
            "kind": "data",
