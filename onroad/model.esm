    "Onroad": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot",
            "ev_energy_divisor",
            "kilojoules_per_million_btu",
            "is_energy_pollutant",
            "energy_unit_divisor"
          ]
        },
        {
          "ref": "../lib/drive_cycle.esm",
          "only": [
            "mph_to_meters_per_second",
            "per_schedule_second",
            "vehicle_specific_power",
            "in_half_open_range",
            "bracket_low_fraction"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exact_else_wildcard"
          ]
        },
        {
          "ref": "../lib/keys.esm",
          "only": [
            "model_year_in_range"
          ]
        },
        {
          "ref": "../lib/meteorology.esm",
          "only": [
            "heat_index"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-09
      },
      "variables": {
        "rsy_yearID": {
          "type": "parameter",
          "units": "1",
