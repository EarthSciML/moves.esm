          "description": "Starts at the run's hour-day and the activity row's age: AdjustStarts.sql's `startsPerDay x combinedAgeEffectFraction x monthAdjustment x allocationFraction x ifnull(startAllocFactor, 1)`, then `x noOfRealDays`. The zone's allocation factor is the ROW-MERGED one. What BaseRateCalculator.sql's Process2 section reads as `activity`."
        },
        "rspp_isStart": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecpollutantprocess_rows"
          ],
          "description": "Whether this pollutant-process is START EXHAUST (2): starts are its activity, StartOperatingModeDistributionGenerator's startsOpModeDistribution its operating-mode weights, and StartTempAdjustment its temperature term."
        },
        "rt_isStart": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether the rate row is start exhaust."
        },
        "sod_weight": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecday_rows",
            "operating_mode_rows",
            "runspecsourcetype_rows"
          ],
          "description": "StartOperatingModeDistributionGenerator step 400 outside PROJECT domain: `startsOpModeDistribution`'s opModeFraction at the day type, the run's hour and the source type, copied to every start pollutant-process by `select distinct ... cross join pollutantprocessassoc` and `INSERT IGNORE`, which keeps the FIRST age's fraction. Read at age 0, the table's first; `run_startModeAgeVariation` counts a key whose fraction another age disagrees with."
        },
        "run_startModeAgeVariation": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "startsOpModeDistribution rows at the run's day types, hours and source types whose fraction differs from the age-0 row of their key, which the model's `sod_weight` reads for every age as MOVES's INSERT IGNORE does. 0: the default database's fractions do not vary with age. Counted by `run_selectionUnported`."
        },
        "rt_startModelYearGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "pollutantProcessMappedModelYear's modelYearGroupID at the rate row's pollutant-process and model year: StartTempAdjustment's model-year key."
        },
        "rtMode_startTemperatureIncrement": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "operating_mode_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "baseratecalculator.go:1041-1060 and :1339-1350: what start exhaust ADDS to a mode's rate before the mode is weighted -- `weightFraction x (B exp(A (min(T,75)-75)) + C)` for a LOG row, the cubic in `min(T,75)-75` for a POLY one -- where the weight fraction is the same mode weight the rate is under. Written here per unit weight, so that `rtDay_meanBaseRate` weights it as it weights the rate. 0 off start exhaust and where StartTempAdjustment has no row. PM's multiplicative form (11202, 11802) is not written: no RunSpec here selects start PM, and `run_selectionUnported` counts one that would."
        },
        "rtMode_rateRows": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "operating_mode_rows"
          ],
          "description": "How many rows of the rate table the row's pollutant-process lives in carry its source bin at this mode: the BaseRate rows the Go's start-temperature loop runs over. An additive term exists only where a rate row does."
        },
        "rtMode_weightedStartIncrement": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "operating_mode_rows",
            "runspeccounty_rows",
            "runspecmonth_rows"
          ],
          "description": "The start-temperature increment under the source-bin activity fraction alone, at the modes the rate table carries: the Go's weight fraction is BaseRate's opModeFraction, which carries the fuel-usage-rebased source-bin share and NOT the EV-sales back-scaling `rtMode_weightedRate` applies to the rate. Measured: with that factor in, Washtenaw's 2017-2020 THC and NOx starts came out up to 0.84% high."
        },
        "run_startPMSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "Start-exhaust PM pollutant-processes on a selected road, whose multiplicative start-temperature form is not ported. Counted by `run_selectionUnported`."
        },
        "run_offNetworkActivitySelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "Hotelling and start pollutant-processes on a selected road: the activities this model reads at the run's hours without a pre-aggregation."
        },
        "cff_coefficientETOHSquared": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows"
          ],
          "description": "The START-exhaust exponent's ethanol cross terms (generalFuelRatioExpression at 102, 202, 302): ETOHVolume squared. 0 on the nine running sets, whose strings carry no cross term, so their exponent is what it was."
        },
        "cff_coefficientETOHxT50": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows"
          ],
          "description": "The START-exhaust exponent's ethanol cross terms (generalFuelRatioExpression at 102, 202, 302): ETOHVolume x T50. 0 on the nine running sets, whose strings carry no cross term, so their exponent is what it was."
        },
        "cff_coefficientETOHxT90": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows"
          ],
          "description": "The START-exhaust exponent's ethanol cross terms (generalFuelRatioExpression at 102, 202, 302): ETOHVolume x T90. 0 on the nine running sets, whose strings carry no cross term, so their exponent is what it was."
        },
        "cff_coefficientETOHxRVP": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows"
          ],
          "description": "The START-exhaust exponent's ethanol cross terms (generalFuelRatioExpression at 102, 202, 302): ETOHVolume x RVP. 0 on the nine running sets, whose strings carry no cross term, so their exponent is what it was."
        },
        "cff_coefficientETOHxAromaticContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "criteriaform_rows"
          ],
          "description": "The START-exhaust exponent's ethanol cross terms (generalFuelRatioExpression at 102, 202, 302): ETOHVolume x aromaticContent. 0 on the nine running sets, whose strings carry no cross term, so their exponent is what it was."
        }
      },
      "equations": [
        {
          "_comment": "S0. The run scope, each value lifted from its own one-row source relation. An aggregate over (run_rows x source_rows) with no join clause is the cross product of two one-row relations.",
          "lhs": "run_yearID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "s"
            ],
            "ranges": {
              "s": {
                "from": "runspecyear_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "rsy_yearID",
                "s"
              ]
            }
          }
        },
        {
          "lhs": "run_monthID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "s"
            ],
