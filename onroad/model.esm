          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.M6emitterID: 1 Normal, 2 High. The two are blended 50/50, so the aggregate over this key IS the blend.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "M6emitterID"
            }
          }
        },
        "smc_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.sourceTypeID. The sulfur model is per source type, like the closed form's own sulfur power.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "smc_fuelMYGroupID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.fuelMYGroupID. The model-year range is encoded IN the identifier -- `19972000` is 1997 to 2000 -- so the two bounds are decoded arithmetically rather than read from a column.",
          "update": {
            "kind": "data",
            "source": "db_sulfurmodelcoeff",
            "from": {
              "file_variable": "fuelMYGroupID"
            }
          }
        },
        "smc_sulfurFunctionID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sulfurmodelcoeff_rows"
          ],
          "description": "sulfurModelCoeff.sulfurFunctionID, which of the two functions `sulfurModelName` names.",
          "update": {
            "kind": "data",
