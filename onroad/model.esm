              "file_variable": "ageID"
            }
          }
        },
        "fmw_fuelModelWtFactor": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fuelmodelwtfactor_rows"
          ],
          "description": "fuelModelWtFactor.fuelModelWtFactor, the weight this fuel model carries in the sum.",
          "update": {
