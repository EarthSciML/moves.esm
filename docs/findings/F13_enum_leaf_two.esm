{
  "esm": "1.0.0",
  "metadata": {
    "name": "F13EnumLeaftwo",
    "description": "HELPER for F13_enums_collide_across_a_mount.esm, and a positive control: this leaf declares `probe.Symbol` = 2, reads it with an `enum` op, and asserts 2. It PASSES standalone, which is what attributes the mounted failure to the mount. It is excluded from the tripwire stage by name, like join_leaf.esm.",
    "authors": ["EarthSciML Authors and Contributors"],
    "tags": ["finding", "helper", "enums"]
  },
  "enums": { "probe": { "Symbol": 2 } },
  "index_sets": { "leaf_two_rows": { "kind": "interval", "size": 1 } },
  "models": {
    "F13EnumLeaftwo": {
      "tolerance": { "rel": 1e-12 },
      "variables": {
        "leaf_two_symbolValue": {
          "type": "unknown", "shape": ["leaf_two_rows"], "units": "1",
          "description": "The value this file's own `enums` block gives the symbol."
        }
      },
      "equations": [
        { "lhs": "leaf_two_symbolValue",
          "rhs": { "op": "makearray", "args": [], "regions": [[[1, 1]]],
            "values": [{ "op": "enum", "args": ["probe", "Symbol"] }] } }
      ],
      "tests": [
        { "id": "the_leaf_reads_its_own_enum", "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [ { "variable": "leaf_two_symbolValue", "time": 0.0, "expected": 2, "coords": { "leaf_two_rows": 1 } } ] }
      ]
    }
  }
}
