{
  "esm": "1.0.0",
  "metadata": {
    "name": "F3LibWithEnum",
    "description": "Template-library half of finding F3. Declares an `enums` block AND a template whose body resolves a symbol from it. Note that this file VALIDATES on its own -- nothing rejects a library that carries enums, and the enum op inside the body resolves here -- which is what makes the failure at the import edge a surprise rather than a documented restriction.",
    "authors": ["EarthSciML Authors and Contributors"]
  },
  "enums": { "activity_unit": { "g_per_hp_hr": 1, "g_per_gallon": 2 } },
  "expression_templates": {
    "is_rate_per_horsepower_hour": {
      "params": ["unit_code"],
      "body": { "op": "==", "args": ["unit_code", { "op": "enum", "args": ["activity_unit", "g_per_hp_hr"] }] }
    }
  }
}
