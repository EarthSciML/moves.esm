            "f41_rows"
          ],
          "units": "1",
          "description": "The value this file's own `enums` block gives the symbol -- an ordinary assertable quantity, so nothing but the annotation is under test."
        }
      },
      "equations": [
        {
          "lhs": "f41_symbolValue",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  1
                ]
              ]
            ],
            "values": [
              {
                "op": "enum",
                "args": [
                  "probe",
                  "Symbol"
                ]
              }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "an_assertion_carries_a_description_saying_what_it_faces",
          "description": "The assertion below is TRUE -- the symbol is 1 and the document computes 1 -- so the only thing that can fail here is the `description` on it. That is the whole repro: when an annotation key becomes legal this test passes, and until then the document does not even load.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "f41_symbolValue",
              "time": 0.0,
              "expected": 1,
              "coords": {
                "f41_rows": 1
              },
              "description": "THIS FIELD IS THE FINDING. It faces the PORT and not any reference: the value is this document's own enum. docs/esm-conventions.md 35.4 asks for exactly this sentence, on the assertion, and the schema has no property for it."
            }
          ]
        }
      ]
    }
  }
}
