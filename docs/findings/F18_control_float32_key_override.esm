   "tests": [
    {
     "id": "an_overridden_key_survives_while_the_document_stays_float32",
     "description": "nrsourceusetype rows 1 and 2 carry SCC 2260001010 and 2260001020 and loadFactor 1.0 and 0.34. With scc overridden to Float64 both codes read back exactly; without the override both become 2260001024. loadFactor is left at the document's Float32, so row 2 must read the binary32 value of 0.34 exactly -- 0.3400000035762787 -- which is what proves the document is still evaluating in binary32 and the control has not silently become vacuous. Zero tolerance on all three: the default 1e-6 is orders of magnitude too loose to see either failure.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "assertions": [
      {
       "variable": "echoed",
       "time": 0.0,
       "expected": 2260001010,
       "coords": {
        "r": 1
       },
       "tolerance": {
        "rel": 0.0,
        "abs": 0.0
       }
      },
      {
       "variable": "echoed",
       "time": 0.0,
       "expected": 2260001020,
       "coords": {
        "r": 2
       },
       "tolerance": {
        "rel": 0.0,
        "abs": 0.0
       }
      },
      {
