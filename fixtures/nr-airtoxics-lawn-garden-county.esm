      "tech_point_rows"
     ]
    },
    "tp_vocShare": {
     "type": "unknown",
     "units": "1",
     "description": "The share-weighted VOC multiple of THC. The market-share collapse happens HERE and nowhere earlier, which is what makes it the mean of the products.",
