        "from": "equipment_point_rows"
       },
       "s": {
        "from": "age_slot_rows"
       }
      },
      "join": [
       {
        "on": [
         [
          "cohort_pointOrdinal",
          "point_ordinal"
         ]
        ]
       },
       {
        "on": [
         [
          "cohort_ageSlot",
          "slot_ageID"
         ]
        ]
       }
      ],
