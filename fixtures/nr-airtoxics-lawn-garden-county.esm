    {
     "lhs": "det_ageExponent",
     "rhs": {
      "op": "aggregate",
      "args": [],
      "semiring": "sum_product",
      "output_idx": [
       "q3",
       "cc"
      ],
      "ranges": {
       "q3": {
        "from": "rated_pp_rows"
       },
       "cc": {
        "from": "engine_tech_rows"
       },
       "d": {
        "from": "nrdeterioration_rows"
       }
      },
      "join": [
