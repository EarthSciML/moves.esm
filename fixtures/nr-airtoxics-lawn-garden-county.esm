    "rpp_isNamed": {
     "type": "unknown",
     "units": "1",
     "description": "1 on the ten pollutants the source names. The other nineteen take their root from whichever ratio table carries them.",
     "shape": [
      "runspecpollutantprocess_rows"
     ]
    },
    "rpp_hasParticleRatio": {
     "type": "unknown",
     "units": "1",
     "description": "1 where nrPAHParticleRatio names this output pollutant, which is what makes it PM2.5-rooted.",
     "shape": [
      "runspecpollutantprocess_rows"
     ]
    },
    "rpp_hasDioxinRate": {
     "type": "unknown",
     "units": "1",
     "description": "1 where nrDioxinEmissionRate names it, which makes it fuel-rooted.",
     "shape": [
      "runspecpollutantprocess_rows"
     ]
    },
    "rpp_hasMetalRate": {
     "type": "unknown",
     "units": "1",
     "description": "1 where nrMetalEmissionRate names it, which makes it fuel-rooted.",
     "shape": [
      "runspecpollutantprocess_rows"
     ]
    },
    "rpp_rootPollutantID": {
     "type": "unknown",
     "units": "1",
     "description": "The rated block this output row derives from, read from the ratio table that names the pollutant rather than from a map written here (docs/esm-conventions.md 32.2: the tell is in the ratio tables' own pollutantID column). The ten named pollutants take their root from the source's own constants.",
     "shape": [
      "runspecpollutantprocess_rows"
     ]
    },
    "rated_pollutantID": {
     "type": "unknown",
     "units": "1",
     "description": "The pollutant half of each rated polProcessID, which rpp_rootPollutantID joins to.",
     "shape": [
      "rated_pp_rows"
     ]
    },
    "tpq_multiplier": {
     "type": "unknown",
     "units": "1",
     "description": "What this output pollutant is, as a multiple of its rated block, for one equipment point and one engine technology. NRHCSpeciationCalculator's five species, NRAirToxicsCalculator's twenty toxics and the NonHAPTOG pass are all in this one expression and NOTHING in it branches on the pollutant: each term carries a coefficient that is 0 wherever it does not apply, which is docs/esm-conventions.md 33.3's share columns applied to a chain of ratios rather than to a composition. Reading it top to bottom: the direct blocks, methane, NMHC, NMOG, VOC, the eight subtype-keyed toxics, the two gaseous PAH, NonHAPTOG's subtrahend, PM2.5 and the two particulate PAH, and the metals and dioxins with their grams-to-gallons conversion.",
     "shape": [
      "tech_point_rows",
      "runspecpollutantprocess_rows"
     ]
    },
    "rcq_multiplier": {
     "type": "unknown",
     "units": "1",
     "description": "tpq_multiplier on the roll-up's own axes. 108 x 100 x 29 cells, and the last place the flat (point x technology) relation is mentioned.",
     "shape": [
      "equipment_point_rows",
      "engine_tech_rows",
      "runspecpollutantprocess_rows"
     ]
    }
