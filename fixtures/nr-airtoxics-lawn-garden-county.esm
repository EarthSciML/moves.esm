    "tcq_atShare": {
     "type": "unknown",
     "units": "1",
     "description": "The eight nrATRatio toxics, already carrying their VOC operand: the market-share collapse of the per-subtype VOC share times that subtype's atRatio. 0 on every output pollutant the table does not name, which is what lets one expression serve all 29 blocks with no branch on the pollutant.",
     "shape": [
      "tech_category_rows",
      "runspecpollutantprocess_rows"
     ]
    },
    "tc_integratedShare": {
     "type": "unknown",
     "units": "1",
     "description": "The subtype-keyed half of what NonHAPTOG subtracts, as a multiplier on the root THC: the same per-subtype VOC share times the atRatios whose pollutant is in nrIntegratedSpecies. The gaseous-PAH half is separate because that table is not keyed by subtype.",
     "shape": [
      "tech_category_rows"
     ]
    },
    "tp_tcOrdinal": {
     "type": "unknown",
     "units": "1",
     "description": "Which (technology, category) cell this (point, technology) cell reads its speciation shares from. This is the whole of the equipment point's influence on the speciation: the point contributes its horse-power range bin and nothing else.",
