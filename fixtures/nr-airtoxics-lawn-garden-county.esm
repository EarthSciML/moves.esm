     "rhs": {
      "op": "aggregate",
      "args": [],
      "output_idx": [
       "p"
      ],
      "ranges": {
       "p": {
        "from": "adjustment_rows"
       },
       "n": {
        "from": "run_scope_rows"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "apply_expression_template",
         "args": [],
         "name": "exhaust_temperature_adjustment",
         "bindings": {
          "a_cold": {
           "op": "index",
           "args": [
            "adj_temperatureCoefficientCold",
            "p"
           ]
          },
          "a_hot": {
           "op": "index",
           "args": [
            "adj_temperatureCoefficientHot",
            "p"
           ]
          },
          "temperature": {
           "op": "index",
           "args": [
            "run_meanTemperature",
            "n"
           ]
          }
         }
        },
        {
         "op": "apply_expression_template",
         "args": [],
