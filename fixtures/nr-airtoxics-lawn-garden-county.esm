    {
     "_comment": "find_scrappage_percent, twice, over the real 197-row table. `max_product` over the curve rows admitted by a filter that is a genuine range predicate: the largest percent among breakpoints at or below the life fraction. The curve is monotone, so `the largest percent below` and `the percent of the last breakpoint below` are the same row -- and its first breakpoint is 0.0, so the reduction is never empty for a non-negative life fraction.",
     "lhs": "slot_percentScrapped",
     "rhs": {
      "op": "aggregate",
      "args": [],
      "semiring": "max_product",
      "output_idx": [
       "r",
       "s"
      ],
      "ranges": {
       "r": {
        "from": "equipment_point_rows"
       },
       "s": {
        "from": "age_slot_rows"
       },
       "v": {
        "from": "nrscrappagecurve_rows"
       },
       "e": {
        "from": "default_curve_rows"
       }
      },
      "join": [
       {
        "on": [
         [
          "crv_NREquipTypeID",
          "dc_NREquipTypeID"
         ]
        ]
       }
      ],
      "filter": {
       "op": "<=",
       "args": [
        {
         "op": "index",
         "args": [
          "crv_fractionLifeUsed",
          "v"
         ]
        },
        {
         "op": "index",
         "args": [
          "slot_fractionLifeUsed",
          "r",
          "s"
         ]
        }
       ]
      },
      "expr": {
       "op": "index",
       "args": [
        "crv_percentageScrapped",
        "v"
       ]
