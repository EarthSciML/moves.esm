    "crv_NREquipTypeID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrscrappagecurve_rows"
     ],
     "description": "nrscrappagecurve.NREquipTypeID: J10's key. Every one of this snapshot's 197 rows carries 0, the default curve.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrscrappagecurve",
      "from": {
       "file_variable": "NREquipTypeID"
      }
     }
    },
