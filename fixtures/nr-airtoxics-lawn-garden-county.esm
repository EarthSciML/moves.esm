 "models": {
  "NrAirToxicsLawnGardenCounty": {
   "expression_template_imports": [
    {
     "ref": "../lib/population.esm",
     "only": [
      "pop_file_rounding",
      "max_equipment_ages",
      "median_life_years",
      "year_over_year_scrap_fraction",
      "scrappage_sales_growth",
      "surviving_equipment",
      "truncate_toward_zero",
      "linear_series_interpolation",
      "annualized_growth_factor",
      "agedist_cohort_term"
     ]
    },
    {
     "ref": "../lib/identifiers.esm",
     "only": [
      "scc_zero_tail",
      "pol_process_id",
      "pollutant_id_of",
      "process_id_of",
      "null_output_column"
     ]
    },
    {
     "ref": "../lib/keys.esm",
     "only": [
      "latest_at_or_before_key",
      "scc_lookup_ladder_key",
      "scc_equipment_chain_key",
      "state_default_precedence",
      "flat_relation_major",
      "flat_relation_minor"
     ]
    },
    {
     "ref": "../lib/conversion.esm",
     "only": [
      "days_per_week",
      "default_month_fraction",
      "default_day_fraction",
      "unit_conversion",
      "emission_unit_g_per_hp_hr"
     ]
    },
    {
     "ref": "../lib/emission_factors.esm",
     "only": [
      "deterioration_age",
      "deterioration_factor"
     ]
    },
    {
     "ref": "../lib/adjustments.esm",
     "only": [
      "exhaust_temperature_adjustment",
      "oxygenate_adjustment",
      "exact_else_wildcard"
     ]
    },
    {
     "ref": "../lib/nonroad_speciation.esm",
     "only": [
      "nonroad_fuel_gallons",
      "gallons_to_grams",
      "nonroad_engine_gasoline_density",
      "ratio_scaled",
      "rate_scaled",
      "grams_to_gallons_factor",
      "non_hap_tog",
      "nmhc_share",
      "total_organic_gases",
      "air_toxics_gasoline_density",
      "nonroad_pm25_fraction_of_pm10_gasoline",
      "nr_hp_category_small",
      "nr_hp_category_large"
     ]
    }
   ],
   "tolerance": {
    "rel": 1e-12
   },
   "variables": {
    "runCountyID": {
     "type": "parameter",
     "default": 26161.0,
     "description": "The RunSpec's county FIPS. Not in any snapshot table -- it comes from the RunSpec XML -- so it is a parameter here, and it is the only geographic literal in this document: the state FIPS below is arithmetic on it and the surrogate is looked up through it."
    },
    "runStateID": {
     "type": "parameter",
     "default": 26.0,
     "description": "The RunSpec's state, Michigan. countyID / 1000 gives the same number; it is declared separately because nrbaseyearequippopulation keys on stateID and nrstatesurrogate on a state-level countyID, and conflating the two is how a state population becomes a county one."
    },
    "runYearID": {
     "type": "parameter",
     "default": 2020.0,
     "description": "The episode year. getind.f's surrogate-year precedence is relative to it."
    },
    "runBaseYearID": {
     "type": "parameter",
     "default": 1990.0,
     "description": "NONROAD's base population year. Every real nrbaseyearequippopulation row carries it, so the join looks vacuous -- it is not: the table is the only place the base year is asserted, and reading a future base year's rows would grow the population twice."
    },
    "point_sourceTypeID": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "THE RUN SCOPE OF THIS FIXTURE, and the only thing about the six equipment points that is declared rather than read. `nrsourceusetype` row 1059 is docs/nonroad-logging-county.md \u00a76.1's two-stroke chain saw; 1389 and 1390 are \u00a76.2's two feller/buncher points; 1386, 1387 and 1388 are \u00a76.3's three. Everything else about a point -- its SCC, horsepower, annual hours, load factor, median life and base-year population -- is joined out of the snapshot from this key, so a mistyped source type moves the derived SCC and the comparison against MOVESOutput fails on the key set rather than quietly summing the wrong equipment. That the six are the COMPLETE set for these three SCCs is not assumed either: `scc_equipmentPointCount` counts them out of the real table and the test pins 1, 3 and 2."
    },
    "point_ordinal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "This point's 1-based position, which is what the cohort relation joins on."
    },
    "scc_equipmentPointCount": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "How many nrsourceusetype rows carry THIS POINT'S SCC and have a base-year population row in this state -- 1 for 2260007005, 3 for 2265007010, 2 for 2265007015. It exists to close the one hole `point_sourceTypeID` opens: a declared point list can be wrong by OMISSION, and an omitted point is invisible in every other check because its rows simply do not appear. Counted out of the real tables and pinned per point, a seventh point appearing in the snapshot makes this test red."
    },
    "point_SCC": {
     "type": "unknown",
     "element_type": "Float64",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "This equipment point's SCC, and THE REASON THIS DOCUMENT NEEDS A PER-VARIABLE `element_type`. The document evaluates in `Float32` (see `domain`), because the reference is `real*4` throughout its floating-point quantities. Its keys are not: `2260007005` is 135x binary32's exact-integer limit of 2^24, and rounds to `2260006912` -- which is not a wrong last digit but a different equipment category, so every `join.on` over it matches nothing and the run emits zeros (docs/findings F18, measured end to end: 35 of 87 assertions, every emissionQuant exactly 0). `Float64` here is the Fortran's `INTEGER SCC` said in the only vocabulary the format has. Every SCC-valued variable in this document carries the same override, and nothing else does; the quantities the roll-up multiplies stay at the document's precision.\n\nThe six points carry three distinct SCCs -- 2260007005 once, 2265007010 three times, 2265007015 twice -- which is what makes the output relation a SUM over points rather than a relabelling of them."
    },
    "point_stateID": {
     "type": "unknown",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The run's state, as a relation."
    },
    "point_baseYearID": {
     "type": "unknown",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The base population year, as a relation."
    },
    "scc_SCC": {
     "type": "parameter",
     "element_type": "Float64",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrscc_rows"
     ],
     "description": "nrscc.SCC. utf8 in the file and a numeric key here: `float_columns` decodes the decimal text, and every SCC in these tables is below 2^53 so the decode is exact and joins on it are exact.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrscc",
      "from": {
       "file_variable": "SCC"
      }
     }
    },
    "scc_NREquipTypeID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrscc_rows"
     ],
     "description": "nrscc.NREquipTypeID: the first hop of J1, from SCC to equipment type.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrscc",
      "from": {
       "file_variable": "NREquipTypeID"
      }
     }
    },
    "eqt_NREquipTypeID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrequipmenttype_rows"
     ],
     "description": "nrequipmenttype.NREquipTypeID: J1's right-hand side.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrequipmenttype",
      "from": {
       "file_variable": "NREquipTypeID"
      }
     }
    },
    "eqt_surrogateID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrequipmenttype_rows"
     ],
     "description": "nrequipmenttype.surrogateID: the DB form of NONROAD's ALLOCATE.XRF. Surrogate 8, Timber Product Output, for all three logging equipment types.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrequipmenttype",
      "from": {
       "file_variable": "surrogateID"
      }
     }
    },
    "sut_SCC": {
     "type": "parameter",
     "element_type": "Float64",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrsourceusetype_rows"
     ],
     "description": "nrsourceusetype.SCC. One row per EQUIPMENT POINT -- an (SCC, hpAvg) pair -- which is the grain the whole chain runs at.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrsourceusetype",
      "from": {
       "file_variable": "SCC"
      }
     }
    },
    "sut_sourceTypeID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrsourceusetype_rows"
     ],
     "description": "nrsourceusetype.sourceTypeID: J4's key into the base-year population.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrsourceusetype",
      "from": {
       "file_variable": "sourceTypeID"
      }
     }
    },
    "pop_sourceTypeID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrbaseyearequippopulation_rows"
     ],
     "description": "nrbaseyearequippopulation.sourceTypeID, over all 62,699 rows of the table.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrbaseyearequippopulation",
      "from": {
       "file_variable": "sourceTypeID"
      }
     }
    },
    "pop_stateID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrbaseyearequippopulation_rows"
     ],
     "description": "nrbaseyearequippopulation.stateID: J5's key. Every state is in this table, so without the join the population is the national one.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrbaseyearequippopulation",
      "from": {
       "file_variable": "stateID"
      }
     }
    },
    "pop_NRBaseYearID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrbaseyearequippopulation_rows"
     ],
     "description": "nrbaseyearequippopulation.NRBaseYearID.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrbaseyearequippopulation",
      "from": {
       "file_variable": "NRBaseYearID"
      }
     }
    },
    "pop_population": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrbaseyearequippopulation_rows"
     ],
     "description": "nrbaseyearequippopulation.population, decimal text in the file, at the full precision the table stores. The engine never sees this number -- see point_statePopulation.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrbaseyearequippopulation",
      "from": {
       "file_variable": "population"
      }
     }
    },
    "sur_surrogateID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrstatesurrogate_rows"
     ],
     "description": "nrstatesurrogate.surrogateID, over all 62,821 rows -- the .ALO files.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrstatesurrogate",
      "from": {
       "file_variable": "surrogateID"
      }
     }
    },
    "sur_countyID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrstatesurrogate_rows"
     ],
     "description": "nrstatesurrogate.countyID. A state row carries the state FIPS in this same column, which is why the county and state quantities below are two rows of ONE relation and not two tables.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrstatesurrogate",
      "from": {
       "file_variable": "countyID"
      }
     }
    },
    "sur_surrogateYearID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrstatesurrogate_rows"
     ],
     "description": "nrstatesurrogate.surrogateYearID: what getind.f's `latest at or before, else earliest after` rule ranks on.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrstatesurrogate",
      "from": {
       "file_variable": "surrogateYearID"
      }
     }
    },
    "sur_surrogatequant": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrstatesurrogate_rows"
     ],
     "description": "nrstatesurrogate.surrogatequant, decimal text. Without float_columns the allocation fraction below would be a division of two strings.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrstatesurrogate",
      "from": {
       "file_variable": "surrogatequant"
      }
     }
    },
    "point_surrogateID": {
     "type": "unknown",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "J1 twice over: this SCC's equipment type, and that type's allocation surrogate. Read out of nrscc and nrequipmenttype rather than declared, so a snapshot that reassigned chain saws to another surrogate would move this fixture's answer instead of being ignored."
    },
    "tgt_isCounty": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "Which of the two lookups this row is: 1 for the county, 0 for the state. The pair is one relation because alocty.f divides one row of nrstatesurrogate by another row of the same table, and F11 says a relation cannot be joined to itself."
    },
    "tgt_countyID": {
     "type": "unknown",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "The FIPS each lookup keys on. The state row's is ARITHMETIC on the county's -- floor(county/1000) x 1000 (nonroad_loader.rs:1043) -- and not a second input."
    },
    "tgt_pointOrdinal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "Which equipment point this surrogate target belongs to. The relation is the flat product of the six points and the two targets -- odd positions the county, even the state -- so that every column of it stays a 1-D array and can be a `join.on` key."
    },
    "tgt_surrogateID": {
     "type": "unknown",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "The surrogate both lookups key on, carried from point_surrogateID onto both rows."
    },
    "tgt_yearAtOrBeforeCount": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "getind.f, first half: does this (surrogate, FIPS) have a row at or before the episode year? A counting semi-join. The (surrogateID, countyID) equality is a composite `join.on`; the year comparison is a genuine range predicate and stays in `filter`."
    },
    "tgt_latestYearAtOrBefore": {
     "type": "unknown",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "The latest such year, under the max semiring."
    },
    "tgt_earliestYearAfter": {
     "type": "unknown",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "getind.f's fallback: the earliest year AFTER the episode year, used only when nothing at or before exists."
    },
    "tgt_effectiveYearID": {
     "type": "unknown",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "`vallow` else `valhi`, reduced to a key so that the lookup below is a plain three-column equi-join."
    },
    "tgt_quant": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "surrogate_target_rows"
     ],
     "description": "J6: the surrogate quantity for each lookup. County 26161 gets 1,512,186 and state 26000 gets 466,969,286, both at surrogateYearID 2002."
    },
    "point_allocationCountyQuant": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The county row's quantity, selected out of the pair by its own membership column."
    },
    "point_allocationStateQuant": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The state row's."
    },
    "point_allocationFraction": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "alocty.f. A non-positive state quantity gives 0 rather than a division (nonroad_loader.rs:1076), which is the guard the decoy surrogate in components/geographic_allocation.esm exercises."
    },
    "point_rawStatePopulation": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "What the state population would be without the .POP quantization. Computed only so a test can show the two apart; nothing downstream reads it."
    },
    "point_statePopulation": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The state population as the engine sees it: canonical writes the .POP file with %17.1f, so each row is rounded to one decimal BEFORE summing (nonroad_loader.rs:1226). Rounding the sum instead would differ wherever a source type has rows in more than one populated state."
    },
    "point_countyPopulation": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The `population` factor of the \u00a72.6(b) roll-up product: the grown-on-state, allocated-afterwards quantity of \u00a72.1."
    },
    "runDayID": {
     "type": "parameter",
     "default": 5.0,
     "description": "The RunSpec's day type, weekday. From the RunSpec XML and not from a table -- nrdayallocation is keyed BY it, and MOVESOutput carries it unoffset (\u00a78.3)."
    },
    "nationalDefaultStateID": {
     "type": "parameter",
     "default": 0.0,
     "description": "stateID 0 in nrmonthallocation: the national default row a state-specific row outranks (\u00a74.6)."
    },
    "daytimeHourFirst": {
     "type": "parameter",
     "default": 6.0,
     "description": "First hourID of the daytime averaging window emsadj.f takes the ambient temperature over."
    },
    "daytimeHourLast": {
     "type": "parameter",
     "default": 18.0,
     "description": "Last hourID of it, inclusive. Thirteen hours, not twelve."
    },
    "run_countyID": {
     "type": "unknown",
     "shape": [
      "run_scope_rows"
     ],
     "description": "The run's county, as a relation, so zone and regioncounty are reached by `join.on`."
    },
    "run_yearID": {
     "type": "unknown",
     "shape": [
      "run_scope_rows"
     ],
     "description": "The episode year, as a relation, for the year -> fuelYear lookup."
    },
    "point_dayID": {
     "type": "unknown",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The run's day type, as a relation."
    },
    "point_engineFuelKindID": {
     "type": "unknown",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "Two-stroke or four-stroke, DERIVED from the SCC rather than declared: \u00a75.3 says an SCC beginning 2260 is two-stroke gasoline and one beginning 2265 is four-stroke. Getting it wrong is a 24% error on NOx (\u00a74.3), and it is not in any table."
    },
    "rsm_monthID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "runspecmonth_rows"
     ],
     "description": "runspecmonth.monthID = 8. Read from the table and not from the RunSpec XML, whose month key is a ZERO-BASED index (7); this table carries the resolved ID (\u00a70).",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_runspecmonth",
      "from": {
       "file_variable": "monthID"
      }
     }
    },
    "rpp_polProcessID": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "runspecpollutantprocess_rows"
     ],
     "description": "runspecpollutantprocess.polProcessID: 101, 201, 301, 10001. This is the fixture's pollutant axis AND J25's output gate, which is why it is read rather than declared -- CO2 (9001) is computed by the engine and never selected, so an axis written by hand would have to remember not to include it.",
     "update": {
