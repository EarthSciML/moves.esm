     "type": "unknown",
     "units": "1",
     "shape": [
      "run_scope_rows"
     ],
     "description": "Hours in the averaging window that the zone actually has rows for: 13, not 12 -- the window is inclusive at both ends."
    },
    "run_daytimeTemperatureSum": {
     "type": "unknown",
     "units": "degF",
     "shape": [
      "run_scope_rows"
     ],
     "description": "Their sum."
    },
    "run_meanTemperature": {
     "type": "unknown",
     "units": "degF",
     "shape": [
      "run_scope_rows"
     ],
     "description": "tamb. 73.576924 for this county-month, which is BELOW emsadj.f's 75 degF branch point -- the cold coefficients apply.\n\nIT LIVES ON A ONE-ROW RELATION AND NOT ON THE EQUIPMENT-POINT ONE, and that is the shape rule this document follows throughout: a quantity goes on the axis it actually varies over. `tamb` is a property of the county, the month and the daytime hours, so the six points share it; putting it on the point axis would have been six identical contractions over a 930,816-row table, which is not wrong but is 14 of the document's 31 seconds and says the wrong thing about what depends on what. The converse mistake is the dangerous one and this document contains its counterexample -- `pp_adjustment` really does vary per point, because one point is two-stroke and five are four-stroke."
    },
    "run_fuelYearID": {
     "type": "unknown",
     "shape": [
      "run_scope_rows"
     ],
     "description": "J19: the fuel year for this calendar year."
    },
    "run_fuelRegionCodeID": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "run_scope_rows"
     ],
     "description": "regionCodeID 2, the NONROAD fuel region. It used to live on a separate one-row `fuel_scope_rows` relation whose only purpose was to carry a composite join key; with the run scope now six rows wide that relation would have had to be six rows too, so its two columns moved onto the point relation and the axis went away."
    },
    "run_fuelScopeFuelTypeID": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "run_scope_rows"
     ],
     "description": "MOVES fuel type 1, gasoline: which supply rows count towards `oxy` (\u00a75.4's two namespaces -- this one is the ONROAD numbering, the one `fuelformulation` speaks)."
    },
    "run_monthID": {
     "type": "unknown",
     "shape": [
      "run_scope_rows"
     ],
     "description": "The run month, read from runspecmonth rather than from the RunSpec XML's zero-based key."
    },
    "run_fuelRegionID": {
     "type": "unknown",
     "shape": [
      "run_scope_rows"
     ],
     "description": "J20: the county's NONROAD fuel region, taken at regionCodeID 2."
    },
    "run_oxygenWeightPercent": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "run_scope_rows"
     ],
     "description": "oxy: the market-share-weighted oxygen content of the county's gasoline, in weight percent. 3.653 here -- one supply row, formulation 9114 (Gasohol E10), share 1.0, 10 vol% ethanol at 0.3653 wt%/vol%."
    },
    "adj_polProcessID": {
     "type": "unknown",
     "shape": [
      "adjustment_rows"
     ],
     "description": "emsadj.f's coefficient table, key column 1. A CODE constant (\u00a75.7), in no snapshot table, which is why it is spelled out here as it is in components/exhaust_adjustment.esm."
    },
    "adj_engineFuelKindID": {
     "type": "unknown",
     "shape": [
      "adjustment_rows"
     ],
     "description": "Key column 2: rows 1-4 four-stroke, rows 5-8 two-stroke. A consumer joins on BOTH columns, because polProcessID alone no longer identifies a row."
    },
    "adj_temperatureCoefficientCold": {
     "type": "unknown",
     "units": "1/degF",
     "shape": [
      "adjustment_rows"
     ],
     "description": "\u00a74.2, the tamb <= 75 branch. Every two-stroke coefficient is 0.0 -- a documented no-op kept as data."
    },
    "adj_temperatureCoefficientHot": {
     "type": "unknown",
     "units": "1/degF",
     "shape": [
      "adjustment_rows"
     ],
     "description": "\u00a74.2, the tamb > 75 branch."
