    },
    "det_isPresent": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "1 where nrdeterioration has a row for this (pollutant process, technology). A technology the mix does not carry has no row, and its deterioration factor must then be 0 rather than 1 -- the same value an unmatched sum_product contraction produced when this join lived inside `tech_deteriorationFactor`. Keyed on the RATED pollutant-process axis: only 101 and 10001 have nrdeterioration rows and 9901 has none, so fuel consumption takes the identity factor through the same det_isPresent gate every unmatched technology takes."
    },
    "det_coefficient": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "DFCoefficient, A in 1 + A x min(age, cap)^B. Keyed on the RATED pollutant-process axis: only 101 and 10001 have nrdeterioration rows and 9901 has none, so fuel consumption takes the identity factor through the same det_isPresent gate every unmatched technology takes."
    },
    "det_ageCapValue": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "emissionCap, the age the power is capped at (\u00a74.1). Keyed on the RATED pollutant-process axis: only 101 and 10001 have nrdeterioration rows and 9901 has none, so fuel consumption takes the identity factor through the same det_isPresent gate every unmatched technology takes."
    },
    "det_ageExponent": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "DFAgeExponent, B, and 0 where nrdeterioration has no row for this (pollutant process, technology). `tech_deteriorationFactor` substitutes 1 there, so that `min(age, 0)^B` is a plain 0 rather than 0^0; it does the substitution rather than this equation doing it because the two index symbols are only BOUND inside an aggregate over them, and spelling it here left them free and silently zero (docs/findings F26). Keyed on the RATED pollutant-process axis: only 101 and 10001 have nrdeterioration rows and 9901 has none, so fuel consumption takes the identity factor through the same det_isPresent gate every unmatched technology takes."
    },
    "rated_ordinal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rated_pp_rows"
     ],
     "description": "This rated pollutant-process's 1-based position. rpp_rootOrdinal joins to it."
    },
    "rated_polProcessID": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rated_pp_rows"
     ],
     "description": "The three polProcessIDs nremissionrate carries that this run selects: 101 (THC), 9901 (fuel consumption) and 10001 (PM10). Built from the two enums each packs, never written as an integer."
    },
    "rated_unitFactor": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rated_pp_rows"
     ],
     "description": "unitcf.f's activity conversion beyond hpAvg x loadFactor. 1 for THC and PM10, whose rate is g/hp-hr. For fuel consumption the rate is lb/hp-hr: the NONROAD engine divides by CMFGAS = 6.237 lb/gal to get gallons (emissions/exhaust.rs:265) and NonroadOutputDataLoader.java:1052 multiplies by 6.237 and by 453.592 g/lb to get grams. The two densities cancel and the factor is 453.592 -- written as the round trip rather than as the cancelled constant, because docs/nr-airtoxics-lawn-garden-county.md 2.6's toxics path converts back with a DIFFERENT density (6.17) and a reader has to be able to see that these are two constants and not one."
    },
    "techRate_exactIsPresent": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "Does nremissionrate carry a row for THIS point's own SCC, this pollutant-process, this technology, in an hp bin containing hpAvg? A presence test, so the body is 1 (docs/esm-conventions.md 3)."
    },
    "techRate_zero3IsPresent": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "The same at the seven-digit equipment root."
    },
    "techRate_exactValue": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "The rate at the point's own SCC, 0 where there is none. Measured over all 108 points and all three chain levels: at most ONE hp bin per (SCC, technology, pollutant-process) contains a point's hpAvg, so this contraction is a lookup and not a sum."
    },
    "techRate_zero3Value": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "The rate at the equipment root."
    },
    "techRate_zero6Value": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "The rate at the four-digit engine-family root, the chain's last resort."
    },
    "techRate_meanBaseRate": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "The zero-hour emission factor the reference's per-technology chain walk lands on: the point's own SCC if it has one, else the equipment root, else the engine-family root. Native units g/hp-hr for THC and PM10 and lb/hp-hr for fuel consumption, neither of which the unit registry can spell."
    },
    "rated_adjustment": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "rated_pp_rows"
     ],
     "description": "The adjustment this run's engine fuel kind selects, one per selected pollutant process: 0.978082, 0.762555, 1.679458, 1.0. Joined on the composite (polProcessID, engineFuelKindID), so a port that had wired the four-stroke row here would show 0.838, 0.772, 1.438 instead. On the RATED axis: a chained pollutant is its root times a ratio, so it inherits the root's emsadj.f adjustment."
    },
    "rpp_pollutantID": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "runspecpollutantprocess_rows"
     ],
     "description": "The pollutant half of runspecpollutantprocess.polProcessID, which every speciation lookup keys on."
    },
    "rpp_isRated": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "runspecpollutantprocess_rows"
     ],
     "description": "1 on the three pollutant-processes nremissionrate carries. Read from the rate axis rather than declared, so a snapshot whose rate table gained a fourth would show up as a number."
    },
    "rpp_rootOrdinal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "runspecpollutantprocess_rows"
     ],
     "description": "Which rated block this output row derives from, as an ordinal into rated_pp_rows -- the join that anchors the chain at its root (docs/esm-conventions.md 32.2). 0 means no rated block reaches this row, which no row of this run is."
    },
