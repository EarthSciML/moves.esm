    "run_processID": {
     "type": "unknown",
     "units": "1",
     "description": "The process every speciation table is keyed on. A one-row relation, because a scalar cannot be a join key (docs/esm-conventions.md 16.1).",
     "shape": [
      "run_scope_rows"
     ]
    },
    "run_nmogPollutantID": {
     "type": "unknown",
     "units": "1",
     "description": "The nrHCSpeciation row NMOG reads. Carried as a one-row relation so that the constant equality is a join.on pair and not an `==` in a filter (20.4).",
     "shape": [
      "run_scope_rows"
     ]
    },
    "run_vocPollutantID": {
     "type": "unknown",
     "units": "1",
     "description": "The nrHCSpeciation row VOC reads.",
     "shape": [
      "run_scope_rows"
     ]
    },
    "run_gallonsFactor": {
     "type": "unknown",
     "units": "1",
     "description": "nrairtoxics.go's grams-to-gallons conversion, TWO SEQUENTIAL DIVISIONS at the air-toxics calculator's own 6.17 lb/gal -- not the 6.237 the NONROAD engine used on the way out. components/nr_air_toxics.esm asserts both the association and the round trip.",
     "shape": [
      "run_scope_rows"
     ]
    },
    "run_pm25Fraction": {
     "type": "unknown",
     "units": "1",
     "description": "NonroadOutputDataLoader.java:454-481's per-fuel PM2.5 fraction of the NONROAD engine's single PM tally. 0.92 for gasoline. It is a LOADER constant: it is in no table and ../moves.rs does not carry it.",
     "shape": [
      "run_scope_rows"
     ]
    },
    "fst_marketShare": {
     "type": "unknown",
     "units": "1",
     "description": "The market share this run's gasoline supply gives each fuel subtype. The nonroad worker fans one emission out into one per nrFuelSupply entry, each scaled by its market share (calc/mwo/mworeader.go parseLines), and every speciation ratio keys on the subtype -- so the supply collapses HERE, onto a 17-row relation, and the whole speciation chain is formed per subtype and collapsed once at the end (docs/esm-conventions.md 32.3). Two formulations are supplied in this county, at shares 1.0 and 0.0.",
     "shape": [
      "nrfuelsubtype_rows"
     ]
    },
    "tp_pointOrdinal": {
     "type": "unknown",
     "units": "1",
     "description": "The equipment point of this (point, technology) cell. THE RELATION IS FLAT because a join.on key column must be 1-D (docs/esm-conventions.md 27.1) and every speciation lookup keys on the horse-power category, which is a function of BOTH coordinates. 108 x 100 rows, decoded by lib/keys.esm's shared floor division so the two coordinates cannot disagree about where a block ends.",
     "shape": [
      "tech_point_rows"
     ]
    },
    "tp_techOrdinal": {
     "type": "unknown",
     "units": "1",
     "description": "The technology ordinal of this cell.",
     "shape": [
      "tech_point_rows"
     ]
    },
