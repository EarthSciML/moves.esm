          }
         ]
        }
       ]
      },
      "expr": {
       "op": "index",
       "args": [
        "mix_modelYearID",
        "m"
       ]
      }
     },
     "_comment": "THE LOWER HP BOUND IS STRICT, and that is docs/nr-airtoxics-lawn-garden-county.md 2.1(b): nonroad_loader.rs takes the FIRST (SCC, hpMin, hpMax) bin containing hpAvg, and `hpMin <= hpAvg` admits two of them wherever hpAvg sits on a bin boundary -- 2260004071's 3.0 hp is in both (1, 3) and (3, 6) of 2260000000. The bins tile from 0 and every hpAvg is positive, so the strict bound picks exactly the reference's bin; measured over all 108 points at all three chain levels, 0 differences. Without it tech_fractionTotal is 2 on that SCC and its emissions are 1.24 to 1.43 times the reference's."
    },
    {
     "lhs": "cohort_mixYearID",
     "rhs": {
      "op": "aggregate",
      "args": [],
      "output_idx": [
       "c"
      ],
      "ranges": {
       "c": {
        "from": "cohort_rows"
       }
      },
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "latest_at_or_before_key",
       "bindings": {
        "has_at_or_before": {
         "op": ">",
         "args": [
          {
           "op": "index",
           "args": [
            "cohort_mixYearAtOrBeforeCount",
            "c"
           ]
          },
          0.0
         ]
        },
        "latest_at_or_before": {
         "op": "index",
         "args": [
          "cohort_latestMixYearAtOrBefore",
          "c"
         ]
