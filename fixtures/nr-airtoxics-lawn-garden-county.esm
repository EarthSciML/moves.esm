   "tests": [
    {
     "id": "the_chain_is_anchored_at_three_rated_blocks",
     "description": "nremissionrate carries three of this run's 29 pollutant-processes and every other output row is a multiple of one of them. If rpp_rootOrdinal were 0 anywhere a whole block would emit zeros with a perfect key set, which is the least attributable failure a fixture can have (docs/esm-conventions.md 34.1), so the minimum is pinned as well as the maximum. rated_polProcessID is built from enums and read back here at both ends of the rate join.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "assertions": [
      {
       "variable": "rated_polProcessID",
       "time": 0.0,
       "expected": 101.0,
       "coords": {
        "rated_pp_rows": 1
       }
      },
      {
       "variable": "rated_polProcessID",
       "time": 0.0,
       "expected": 9901.0,
       "coords": {
        "rated_pp_rows": 2
       }
      },
      {
       "variable": "rated_polProcessID",
       "time": 0.0,
       "expected": 10001.0,
       "coords": {
        "rated_pp_rows": 3
       }
      },
      {
       "variable": "rpp_rootOrdinal",
       "time": 0.0,
       "expected": 1.0,
       "reduce": "min"
      },
      {
       "variable": "rpp_rootOrdinal",
       "time": 0.0,
       "expected": 3.0,
       "reduce": "max"
      },
      {
       "variable": "rpp_isRated",
       "time": 0.0,
       "expected": 1.0,
       "reduce": "max"
      }
     ]
    },
    {
     "id": "the_technology_mix_and_the_hp_category_are_both_discriminating",
     "description": "Two structural claims that the emitted numbers cannot make. tech_fractionTotal must be 1 on every populated cohort: 2 would mean the strict hp lower bound admitted a second .TECH bin, which is the 1.24-to-1.43x error on SCC 2260004071 that specification 2.1(b) measures, and 0 would mean the equipment chain found no bin at all. And the horse-power category must take BOTH its values -- 1,908 of this run's 2,063 worker cells are 'S' and 155 are 'L' -- because a document that dropped the category from the speciation key would join to the wrong rows on the 155 rather than to none.",
     "tolerance": {
      "rel": 1.1920929e-07
     },
     "assertions": [
      {
       "variable": "tech_fractionTotal",
       "time": 0.0,
       "expected": 1.0,
       "reduce": "max"
      },
      {
       "variable": "tp_nrHPCategory",
       "time": 0.0,
       "expected": 2.0,
       "reduce": "max"
      },
      {
       "variable": "hcat_code",
       "time": 0.0,
       "expected": 1.0,
       "coords": {
        "hp_category_rows": 1
       }
      },
      {
       "variable": "hcat_code",
       "time": 0.0,
       "expected": 2.0,
       "coords": {
        "hp_category_rows": 2
       }
      }
     ],
     "time_span": {
      "start": 0.0,
      "end": 0.0
     }
    },
    {
     "id": "the_speciation_constants_reach_both_technology_coefficient_sets",
     "description": "The speciation happens INSIDE the engine-technology contraction, and this is where that is checkable: nrMethaneTHCRatio takes two values on this sector's technologies at fuel subtype 12, 0.02 and 0.149, so the share-weighted CH4 multiplier over the (point, technology) grid must reach 0.149 exactly. A document that speciated the aggregated THC of a cohort would have to pick one number; the snapshot's own emitted CH4/THC takes 404 distinct values between 0.023141 and 0.149001 over the 484 cohorts. The two run-level constants beside it are the ones no comparison against a six-significant-figure column could see: the grams-to-gallons factor is TWO sequential divisions (0.000357313520289105, against 0.00035731352028910493 for the algebraically equal single division), and the PM2.5 fraction is a loader constant that appears in no table.",
     "tolerance": {
      "rel": 1.1920929e-07
     },
     "assertions": [
      {
       "variable": "tp_methaneShare",
       "time": 0.0,
       "expected": 0.149,
       "reduce": "max"
      },
      {
       "variable": "tp_nmogShare",
       "time": 0.0,
       "expected": 1.0388,
       "reduce": "max"
      },
      {
       "variable": "tp_vocShare",
       "time": 0.0,
       "expected": 1.03586,
       "reduce": "max"
      },
      {
       "variable": "run_gallonsFactor",
       "time": 0.0,
       "expected": 0.000357313520289105,
       "coords": {
        "run_scope_rows": 1
       }
      },
      {
       "variable": "run_pm25Fraction",
       "time": 0.0,
       "expected": 0.92,
       "coords": {
        "run_scope_rows": 1
       }
      },
      {
       "variable": "fst_marketShare",
       "time": 0.0,
       "expected": 1.0,
       "reduce": "max"
      }
     ],
     "time_span": {
      "start": 0.0,
      "end": 0.0
     }
    },
    {
     "id": "the_largest_emitted_cell_is_the_snapshots_largest",
     "description": "One value assertion against the reference, at the cell the capture stores best: fuel consumption for SCC 2265004071 model year 2020, which MOVESOutput carries as 4170270 g and which is the largest number in the whole 14,036-row table. It is asserted by a max reduction rather than by an output-row ordinal, because the ordinal is a layout detail and the maximum is a claim about the answer. The tolerance is tolerance.toml's own per-cell gate; the row-by-row comparison is compare-output.py's job and is not duplicated here.",
     "tolerance": {
      "rel": 2e-05
     },
     "assertions": [
      {
       "variable": "out_emissionQuant",
       "time": 0.0,
       "expected": 4170270.0,
       "reduce": "max"
      }
     ],
     "time_span": {
      "start": 0.0,
      "end": 0.0
     }
    }
   ]
  }
 }
}
