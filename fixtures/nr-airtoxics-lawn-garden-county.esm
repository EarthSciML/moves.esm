         "bindings": {
          "coefficient": {
           "op": "index",
           "args": [
            "adj_oxygenateCoefficient",
            "p"
           ]
          },
          "oxygen_weight_percent": {
           "op": "index",
           "args": [
            "run_oxygenWeightPercent",
            "n"
           ]
          }
         }
        }
       ]
      }
     }
    },
