        1.0,
        0.0
       ]
      }
     }
    },
    {
     "lhs": "slot_detAge",
     "rhs": {
      "op": "aggregate",
      "args": [],
      "output_idx": [
       "r",
       "s"
      ],
      "ranges": {
       "r": {
        "from": "equipment_point_rows"
       },
       "s": {
