     ]
    },
    "tp_engTechID": {
     "type": "unknown",
     "units": "1",
     "description": "The technology's engTechID, read back through the technology ordinal.",
     "shape": [
      "tech_point_rows"
     ]
    },
    "tp_nonroadFuelTypeID": {
     "type": "unknown",
     "units": "1",
     "description": "The point's NONROAD fuel type. Gasoline is 1 in both the NONROAD and the MOVES namespace (5.4), so the four fuel-type-keyed ratio tables and the block's own fuelTypeID agree here and could not be told apart by this run.",
     "shape": [
      "tech_point_rows"
     ]
    },
    "tp_nrHPCategory": {
     "type": "unknown",
     "units": "1",
     "description": "nrHPCategory[(hpID, engTechID)] as a 1-D key column. A cell with no nrhpcategory row reads 0 -- the Go map's zero value, carried into the lookup key verbatim, which then matches nothing. Measured: 0 of this run's cells take that arm.",
     "shape": [
      "tech_point_rows"
     ]
    },
