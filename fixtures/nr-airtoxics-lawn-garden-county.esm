     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrscrappagecurve_rows"
     ],
     "description": "nrscrappagecurve.fractionLifeused -- LOWERCASE u in the file, where every Fortran listing and \u00a71.2 write fractionLifeUsed. Column 1: the breakpoint, in fractions of median life consumed. Decimal text, so it is in float_columns.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrscrappagecurve",
      "from": {
       "file_variable": "fractionLifeused"
      }
     }
    },
    "crv_percentageScrapped": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "nrscrappagecurve_rows"
     ],
     "description": "nrscrappagecurve.percentageScrapped. Column 2: cumulative percent scrapped at that breakpoint, 0 at 0.0 and 100 at 2.0. Also decimal text.",
     "update": {
      "kind": "data",
      "source": "nr_airtoxics_lawn_garden_county_nrscrappagecurve",
      "from": {
       "file_variable": "percentageScrapped"
      }
     }
    },
    "dc_NREquipTypeID": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "default_curve_rows"
     ],
     "description": "The equipment type whose scrappage curve this run reads, 0, as a one-row relation so the restriction is a `join.on` and not a filter (\u00a73). WHAT THIS DOES NOT PORT: scrptime reads the curve for the equipment's OWN NREquipTypeID and falls back to 0 when there is none, and that fallback ladder is not here, because this snapshot's nrscrappagecurve is 197 rows all at type 0 and a ladder over one rung would be untestable. A snapshot carrying per-type curves would need it, and would silently mix curves without it -- which is why the restriction is written as a join on a named type rather than left out."
    },
    "slot_ageID": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "age_slot_rows"
     ],
     "description": "1-based equipment age in years, 1 to MXAGYR = 51. Age 1 is the newest cohort. This is the fold's slot axis and is longer than `age_rows`, which carries only the cohorts this SCC actually has."
    },
    "slot_modelYearID": {
     "type": "unknown",
     "shape": [
      "age_slot_rows"
     ],
     "description": "runYearID - (slot - 1): 2020 in slot 1, back to 1970 in slot 51. The slot axis is the same rectangle for every equipment point; which of its members are POPULATED is what differs, and that is `slot_isPopulated`."
    },
    "point_medianLifeYears": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "min(25, (medianLifeFullLoad / loadFactor) / hoursUsedPerYear) = 0.90051866 yr. The division order is scrptime.rs:102's, LEFT TO RIGHT, and the cap is MXAGYR/2."
    },
    "point_medianLifePerYear": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "1 / medianLifeYears = 1.1104711: the life fraction one year of use consumes."
    },
    "slot_fractionLifeUsed": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "age_slot_rows"
     ],
     "description": "(age - 1) / medianLifeYears: how much of the median life this cohort has consumed."
    },
    "slot_priorFractionLifeUsed": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "age_slot_rows"
     ],
     "description": "The same for the age before it, floored at 0 so age 1's predecessor reads the curve's origin. Computed rather than read from the neighbouring row, because a relation cannot be joined to itself (docs/findings F11)."
    },
    "slot_percentScrapped": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "age_slot_rows"
     ],
     "description": "Cumulative percent scrapped at this age: the curve's value at the last breakpoint AT OR BELOW slot_fractionLifeUsed. find_scrappage_percent does NOT interpolate between breakpoints (output/find.rs:233-244), which is why all 197 points are read rather than a few around the answer."
    },
    "slot_priorPercentScrapped": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "age_slot_rows"
     ],
     "description": "The same at the previous age. scrptime works with both at once, which is what makes the year-over-year fraction a difference of cumulatives rather than a curve of its own."
    },
    "slot_yearScrapFraction": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "age_slot_rows"
     ],
     "description": "yryrfrcscrp: the fraction of the cohort SURVIVING at the previous age that is scrapped during this one. Once the previous age is fully scrapped the entry is 0 rather than a division by zero (scrptime.rs:126-131)."
    },
    "slot_survivalFraction": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "age_slot_rows"
     ],
     "description": "1 - yryrfrcscrp: the factor agedist.f applies when it shifts a cohort one year older. \u00a77.3 LIVES HERE. For this equipment point age 3's cumulative scrappage is exactly 100%, so this is 100 x 0.265 / 26.5 subtracted from 1 -- exactly 0 in binary64 and 5.9604645e-08 in the binary32 this document declares. Thirty fold iterations later that residue is the whole of model year 2018, four MOVESOutput rows."
    },
    "point_equipmentLifeYears": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "nyrlif = 3: the first age at which cumulative scrappage reaches 100%, and so the number of model years this equipment point spans. Capped at MXAGYR for totality; the cap cannot bind, because the median life is itself capped at MXAGYR/2 and the curve reaches 100% at twice the median life."
    },
    "point_salesGrowth": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The sales trend scrptime.rs:139-143 infers from ONE year's population growth -- grwfac(1990, 1991), not the growth over the whole projection."
    },
    "slot_survivingEquipment": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "age_slot_rows"
     ],
     "description": "The 1990 stock at this age: the sales of the year it was built, decayed by its cumulative scrappage (scrptime.rs:147-165). The cohort at age `a` was sold nyrlif - a sales-years after the curve's start, so the sales index is a subtraction rather than an array read. Ages beyond nyrlif carry 0."
    },
    "point_survivingEquipmentTotal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "The normalizing sum of slot_survivingEquipment, accumulated in ascending age order as scrptime accumulates it."
    },
    "point_grownModelYearFractionTotal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "totpopfrc: the grown fractions this point actually contributes, summed. agedist.f's residual is defined so that the whole 51-slot vector sums to totpop/baspop, and the slots the skip removes are the ones that carry nothing, so this must come back to the cumulative growth ratio the document derives from nrgrowthindex by a completely different route. It is the fold's only end-to-end self-check, and it is now made once per equipment point rather than once."
    },
    "slot_baseModelYearFraction": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "age_slot_rows"
     ],
     "description": "modfrc before growth: the share of the 1990 population at this age, (0.8506725, 0.1493275, 0) for this point (\u00a76.1 step 2). Sums to 1."
    },
    "fold_yearID": {
     "type": "unknown",
     "shape": [
      "fold_year_rows"
     ],
     "description": "The calendar year each fold row stands for: runBaseYearID + (row - 1), so row 1 is 1990 -- the base distribution before any growth -- and row 31 is 2020. Two equations index the last row as the literal 31; the assertion that this column's row 31 is 2020 is what guards that literal."
    },
    "fold_lowYearID": {
     "type": "unknown",
     "shape": [
      "equipment_point_rows",
      "fold_year_rows"
     ],
     "description": "getgrw.f, first half: the latest year at or below this fold year that this run's growth pattern is actually tabulated at. Pattern 2176 is tabulated at 1990 and then annually from 1999 to 2040, so for 1991..1998 this is 1990 and thereafter it is the fold year itself."
    },
    "fold_highYearID": {
     "type": "unknown",
     "shape": [
      "equipment_point_rows",
      "fold_year_rows"
     ],
     "description": "The earliest tabulated year at or above it: 1999 for 1991..1998, and equal to fold_lowYearID wherever the fold year is itself tabulated. EQUAL IS THE COMMON CASE and it is what the interpolation below has to be guarded against, not a corner."
    },
    "fold_lowIndicator": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "fold_year_rows"
     ],
     "description": "G at fold_lowYearID, truncated toward zero because canonical writes the /GROWTH/ packet with %20d (nonroad_loader.rs:1516). Selected by TWO RANGE PREDICATES rather than an equality: at or below the fold year and at or above the low year, which exactly one tabulated row satisfies. That keeps \u00a73's rule -- a filter carries a genuine predicate -- without needing to join on a two-axis column."
    },
    "fold_highIndicator": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "fold_year_rows"
     ],
     "description": "G at fold_highYearID, the same way."
    },
    "fold_indicator": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "fold_year_rows"
     ],
     "description": "getgrw.f's indicator at this fold year: the tabulated value where the year is tabulated, and the two-point linear interpolation between the bracketing years where it is not. G(1990) = 321, G(1991) = 449.8889, G(2020) = 1508. WHAT THIS DOES NOT PORT: getgrw's two EXTRAPOLATION branches, for a query below the first tabulated year or above the last. They cannot fire here -- 1990 through 2020 lies inside pattern 2176's span 1990 to 2040 -- and components/growth_index.esm ports and tests both."
    },
    "fold_priorIndicator": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "fold_year_rows"
     ],
     "description": "The indicator one fold year earlier, which is the base of this row's one-year growth step. Row 1 reads ITSELF rather than an out-of-range row, which makes row 1's growth factor exactly 0 -- the value the base row needs, since the fold takes no step there."
    },
    "fold_annualGrowthFactor": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows",
      "fold_year_rows"
     ],
     "description": "grwfac(year-1, year): the ANNUALIZED fractional change (g - b) / (b x span), not the cumulative ratio. This is the series agedist folds one year at a time, and it is where the /GROWTH/ truncation earns its keep -- the year-over-year changes sit near zero, so the truncation decides the SIGN of the factor and with it which model years survive the fold's clamp."
    },
    "point_popGrowthFactor": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "grwfac(1990, 1991) = 0.401523, read out of fold_annualGrowthFactor at row 2. scrptime's sales curve is built from the FIRST year's rate alone (\u00a72.2(c)); using the cumulative ratio here would compound a per-year rate as though it were a total."
    },
    "point_mixExactIsPresent": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "Does nrengtechfraction have exhaust rows for this exact SCC in this hp bin?"
    },
    "point_mixZero3IsPresent": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "Rung 2 of the equipment chain."
    },
    "point_mixEffectiveSCC": {
     "type": "unknown",
     "element_type": "Float64",
     "shape": [
      "equipment_point_rows"
     ],
     "description": "2260007005: this SCC has its own .TECH rows. \u00a76.2's SCCs fall back to 2265000000, which is what makes the walk load-bearing."
    },
    "tech_engTechID": {
     "type": "unknown",
     "shape": [
      "engine_tech_rows"
     ],
     "description": "The EXHAUST engine-technology code space, 100 through 199, enumerated arithmetically. \u00a75.5 puts every exhaust engTechID this model uses in that window -- 121-126 for two-stroke handheld, 127-144 for four-stroke non-handheld -- and the joins below select the codes the tables actually carry, so the window is a superset and not a transcription. It exists because a technology is the grain at which the mix, the rates and the deterioration coefficients meet, and without an axis for it the three tables can only meet in one contraction over 9,554 x 55,471 x 424 rows. `tech_fractionTotal` is the check that the window really is a superset: a mix that summed to less than 1 would mean a code fell outside it."
    },
    "tech_fraction": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "cohort_rows",
      "engine_tech_rows"
     ],
     "description": "J11: this cohort's share of each technology, from the .TECH row set the equipment chain and the hp bin selected at the cohort's mix year. Zero for every code the mix does not carry."
    },
    "tech_fractionTotal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "cohort_rows"
     ],
     "description": "The mix must sum to 1 for every cohort. This is what proves the 100-199 window covers the codes the data uses, and it is also the check that the hp bin and the processGroup filter did not admit a second bin's rows -- two bins would sum to 2."
    },
    "tech_deteriorationFactor": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "cohort_rows",
      "rated_pp_rows",
      "engine_tech_rows"
     ],
     "description": "J14: 1 + A x min(detage, cap)^B, on the COMPOSITE (polProcessID, engTechID). A single-key join on polProcessID alone would sum every technology's coefficient -- for THC at tech 125 that is 2.5x too large, which \u00a76.1's printed 269.14 g would catch immediately. 1 where the (pollutant-process, technology) pair has no nrdeterioration row, which is every one of the 9901 rows."
    },
    "cell_emissionQuant": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "cohort_rows",
      "runspecpollutantprocess_rows"
     ],
     "description": "GRAMS, carried unitless: the chain multiplies an emission factor in g/hp-hr, and the unit registry has no name for horsepower, so no factor in this product carries a unit and the result cannot declare one either (conventions \u00a711). clcems.f's whole product for one (model year, pollutant process) cell, summed over the technologies the mix carries: the base rate, the deterioration factor at this cohort's age, the adjustment, the unit conversion, adjtime, the annual hours, the month-day factor, the allocated population, the grown model-year fraction and the technology's share. Grams, because the short-ton conversion and its inverse cancel exactly (\u00a76.1 step 5). The rated block reaches this row through rpp_rootOrdinal, so a chained pollutant is its root's product times a multiplier rather than a second copy of the chain."
    },
    "out_cohortOrdinal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "output_rows"
     ],
     "description": "Which of the 36 emitted (SCC, modelYearID) cohorts this output row belongs to. The output is a FLAT row relation with key COLUMNS, not a grid: the fixture's key set is ragged -- 3, 29 and 4 model years across three SCCs -- and a `ragged` axis is not usable (docs/findings F14). 144 is 36 x 4 and the 36 is `cohort_ownerRank` at the end of the cohort relation, so the axis SIZE is a claim the document checks rather than a count typed in from the snapshot."
    },
    "out_pointOrdinal": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "output_rows"
     ],
     "description": "The equipment point that OWNS this row's cohort. It labels the row -- the fuel type comes through it -- and does not weight it: the quantity sums every point of the row's SCC, not just this one."
