              "expected": 0.0,
              "coords": {
                "cohort_rows": 4
              }
            },
            {
              "variable": "Nonroad.cohort_isPopulated",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "cohort_rows": 4
              }
            },
            {
              "variable": "Nonroad.cohort_ordinal",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
