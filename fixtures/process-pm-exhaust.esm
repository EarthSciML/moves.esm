              }
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "rtSup_isSupplied",
