  "models": {
    "Fixture": {
      "subsystems": {
        "Onroad": {
          "ref": "../onroad/model.esm",
          "bindings": {
            "n_outputRate": 728
          }
        }
      },
      "variables": {},
      "equations": [],
      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, hour 7, source type 21, road type 4, county 26161, zone 261610 -- the same scope as `process-airtoxics` and `process-crankcase-running`, and this snapshot's `sho` table is byte-identical to theirs, so the activity half S1-S9 is literally the same 82 numbers those rungs verified. The RunSpec XML on disk says month 7 and hour 6; the execution database says 8 and 7 and it is the authority (docs/process-pm-exhaust.md 0.1). Four run-level numbers are pinned besides: `GPAFract` is 0, so the base-rate fuel-effect blend selects its normal arm; the temperature is 59.5 degF, which is BELOW the PM arm's 72 degF ceiling, so the exponential and not the flat branch is the live one; the A/C activity quadratic is negative and clamps to 0; and `run_residuePollutantID` is the 120 `pmspeciation.inputPollutantID` is joined against. `specificHumidity` and `molWaterFraction` are NOT read and have no variable: neither PM pollutant enters the NOx humidity arm.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
