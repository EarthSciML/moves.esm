          "shape": [
            "generalfuelratio_rows"
          ],
          "description": "generalfuelratio.fuelTypeID. The base-rate arm joins on the FORMULATION (adjust.rs:455) and the SulfatePMCalculator arm on the fuel TYPE (sulfate_pm_calculator.rs:660), so both columns are read and the two stages key differently on purpose.",
          "update": {
            "kind": "data",
            "source": "pm_generalfuelratio",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "run_residuePollutantID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "`NON_EC_NON_SO4_PM_POLLUTANT`, 120, as a one-row column so that `pmspeciation.inputPollutantID` can be an ordinary equi-join key rather than an equality filter (docs/esm-conventions.md 3 and 20.4)."
        },
        "rspp_isChainOutput": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecpollutantprocess_rows"
          ],
          "description": "Whether this pollutant-process appears as an OUTPUT of `runspecchainedto`, i.e. is computed by scaling or summing another one. 1 on six of the seven; only 11201 never does."
        },
        "rspp_isChainInput": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "runspecpollutantprocess_rows"
          ],
          "description": "Whether this pollutant-process appears as an INPUT of `runspecchainedto`, i.e. is consumed by a chained calculator. 1 on five of the seven."
        },
        "run_chainCycleCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many pollutant-processes are BOTH an input and an output of the chain table. FOUR -- 11001, 11501, 11801 and 11901 -- which is the 2-cycles 11801 <-> 11501 and 11801 <-> 11901 measured rather than asserted in prose. `SulfatePMCalculator` consumes composite NonECPM and re-emits it, so MOVES's chain declaration records both directions; a fixed-point iteration over it (docs/esm-conventions.md 32.1) does not terminate, and this count is why this document computes no chain root."
        },
        "run_unchainedPolProcessCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many of the run's pollutant-processes are never an output of the chain table. ONE -- 11201 -- while TWO pollutant-processes are RATED. That gap is the measurement: MOVES's chain declaration cannot identify the rated set here, so `rt_hasRate` decides it and the chain table decides nothing."
        },
        "rt_ecPolProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "polProcessID of unadjusted elemental carbon, on this rate row's own process."
        },
        "rt_nonECPMPolProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "polProcessID of composite non-EC particulate, on this rate row's own process."
        },
        "rt_sulfatePolProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "polProcessID of particulate sulfate, on this rate row's own process."
        },
        "rt_waterPolProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "polProcessID of particulate water, on this rate row's own process."
        },
        "rt_residuePolProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "polProcessID of the INTERNAL residue, on this rate row's own process."
        },
        "rt_pm25TotalPolProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "polProcessID of total exhaust PM2.5, on this rate row's own process."
        },
        "rt_isElementalCarbon": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this rate row is unadjusted elemental carbon."
        },
        "rt_isNonECPM": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this rate row is the re-summed composite NonECPM."
        },
        "rt_isSulfate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this rate row is particulate sulfate."
        },
        "rt_isWater": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this rate row is particulate water."
        },
        "rt_isPM25Total": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this rate row is total exhaust PM2.5."
        },
        "fsu_sulfurLevel": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "The sulfur level of the formulation this supply row carries, ppm. It is the only fuel PROPERTY this fixture reads: every other fuel effect arrives pre-evaluated in `generalfuelratio`."
        },
        "rt_sulfateFractionRaw": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The BASE sulfate share of composite NonECPM for this cohort's band, before the sulfur adjustment. This is the value the RESIDUE split uses."
        },
        "rt_waterFractionRaw": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The base water share, 0 on every row of this snapshot."
        },
        "rt_baseFuelSulfurLevel": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The sulfur level the base fractions were measured at, and the divisor of the adjustment. 0 where no row matches, which is why it is guarded before dividing."
        },
        "rt_baseFuelSulfateFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "How much of the base sulfate fraction tracks the fuel's sulfur."
        },
        "rt_hasSulfateFractions": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether `sulfatefractions` carries a band for this cohort at all. 0 on every electricity cohort, and one of the two conjuncts of `rt_emits`."
        },
        "rt_baseFuelSulfurLevelGuarded": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The divisor with a VALUE substituted where no band matched. It has to be a value and not an indicator on the product: 0/0 is NaN and 0 x NaN is NaN, so multiplying an unguarded quotient by a 0 flag would poison the sum (docs/esm-conventions.md 29, and `process-refueling` met the same shape on a NULL-bearing column)."
        },
        "rtSup_sulfurAdjustment": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "fuelsupply_rows"
          ],
          "description": "1 + BaseFuelSulfateFraction x (sulfurLevel / BaseFuelSulfurLevel - 1), per SUPPLIED formulation: how far this formulation's sulfur moves the base fractions. 0.3387 on pre-2004 gasoline and E85, 0.8317 from 2004, 0.2955 on pre-2007 diesel and 0.7818 from 2007."
        },
        "rt_sulfateFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The market-share-weighted, sulfur-ADJUSTED sulfate share of NonECPM. This is the fraction pollutant 115 takes."
        },
        "rt_waterFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The same for water. Exactly 0 throughout, because the base fraction is."
        },
        "rt_residueFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "greatest(1 - H2OnonECPMFraction - SulfatenonECPMFraction, 0), gated on a band having matched. THE UNADJUSTED FRACTIONS, which is the asymmetry that makes the split non-conserving: 0.92 on gasoline and E85, 0.95 on pre-2007 diesel, 0.26 from 2007."
        },
        "rt_ecCrankcaseRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The crankcase split's ratio on the copied elemental carbon. Exactly 1 here."
        },
        "rt_hasEcCrankcase": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether a split row exists for elemental carbon on this cohort. 0 on electricity."
        },
        "rt_sulfateCrankcaseRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The same on particulate sulfate."
        },
        "rt_hasSulfateCrankcase": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Its existence half."
        },
        "rt_waterCrankcaseRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The same on particulate water."
        },
        "rt_hasWaterCrankcase": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Its existence half."
        },
        "rt_residueCrankcaseRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The same on the internal residue."
        },
        "rt_hasResidueCrankcase": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Its existence half. The four are computed separately because MOVES looks them up separately, under four different polProcessIDs; that they have identical fuel coverage in this snapshot is a fact about the data and not a licence to look one up."
        },
        "rt_residueFuelRatioValue": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "generalfuelratio.fuelEffectRatio at (polProcessID 12001, fuel type, source type) under the model-year and age bands: 1.090910749585 on gasoline and E85 of model year 2001 or later, 0.9727 on diesel of 2006 or earlier."
        },
        "rt_hasResidueFuelRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether a 12001 row matched. It is an UPDATE and not a join in the SQL, so a miss is a factor of ONE and not a dropped row -- pre-2001 gasoline, post-2006 diesel and all of electricity miss it."
        },
        "rt_residueFuelRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The factor actually applied to the residue: the ratio where a row exists, 1 where none does."
        },
        "rt_pm10Ratio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "pm10emissionratio.PM10PM25Ratio for this rate row: 1.130430 on gasoline and E85, 1.086960 on diesel, and 0 on every rate row that is not a PM10 row -- because the table's polProcessID IS the output one, so this lookup doubles as the test for which rows those are."
        },
        "rt_pmSpeciationFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "pmspeciation.pmSpeciationFraction taking the internal residue to organic carbon: 0.706723639947 on gasoline and E85, 0.725817529328 and 0.741704256107 on diesel either side of 2007, and 0 on every rate row that is not an organic-carbon row."
        },
        "rt_totalShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The share of EVERY species this rate row takes as a TOTAL: 1 on the PM2.5-total rows (sulfate_pm_calculator.rs's `MakePM2.5Total`, whose `PM25_TOTAL_INPUTS` is all four), the PM10 ratio on the PM10 rows, and 0 elsewhere."
        },
        "rt_ecShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "How much of this cohort's elemental carbon this rate row emits."
        },
        "rt_sulfateShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "How much of its sulfate."
        },
        "rt_waterShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "How much of its water."
        },
        "rt_residueShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "How much of its residue. The residue is dropped from MOVESOutput and reaches it three ways: inside PM2.5 total, inside the re-summed NonECPM, and speciated into organic carbon."
        },
        "rt_ecParentHasRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this cohort's elemental-carbon parent carries a rate. 0 on (model year 2000, electricity) and 1 on the other 124 selected cohorts."
        },
        "rt_nonECParentHasRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this cohort's NonECPM parent carries a rate. The same 124 cohorts: the one miss is a source-bin miss on the short model-year group and both pollutant-processes share the source bin."
        },
        "rt_cohortIsSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this rate row's COHORT is selected, read back off the cohort relation. It has to be the cohort's answer and not the rate row's: `pollutantprocessmodelyear` carries no rows for 11101 or 11901, so `rt_isSelected` is 0 on two of the seven blocks and using it here would empty them."
        },
        "run_criteriaRatioReach": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many (rate row, SUPPLIED formulation) pairs the criteria-ratio lookup reaches. ZERO, because `criteriaratio` has no rows at all in this snapshot -- the mirror image of `process-airtoxics`, where this table had 733 and `generalfuelratio` had none. The step is written anyway, with all five of its exact key pairs, and this counts the zero: an empty source and a step that was never written look identical from the answer (docs/esm-conventions.md 23)."
        },
        "rtDay_ratedRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows"
          ],
          "description": "The A/C-, temperature- and fuel-adjusted base rate of a RATED block, per day type. Exactly 0 on the five pollutant-processes `emissionratebyage` does not carry."
        },
        "rtDay_ratedQuant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows"
          ],
          "description": "A rated block's emitted quantity in grams: rate x activity. This is what `BaseRateCalculator` hands `SulfatePMCalculator` -- 248 non-zero cells on 11201 and 248 on 11801, and 0 everywhere else in the rate relation."
        },
        "rtDay_ecQuant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows"
          ],
          "description": "This cohort's unadjusted elemental carbon, on every rate row of the cohort."
        },
        "rtDay_nonECQuant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows"
          ],
          "description": "This cohort's composite NonECPM, on every rate row of the cohort. It is consumed by the split AND re-summed from it, which is exactly why MOVES's chain table has a cycle in it."
        },
        "rtDay_spmEC": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows"
          ],
          "description": "The copied elemental carbon after the crankcase split. Its fuel effect is already inside `rtDay_ecQuant`, applied at the base rate on polProcessID 11201."
        },
        "rtDay_spmSulfate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows"
          ],
          "description": "Particulate sulfate: NonECPM x the sulfur-ADJUSTED sulfate fraction, after the split."
        },
        "rtDay_spmWater": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows"
          ],
          "description": "Particulate water: NonECPM x the adjusted water fraction. Exactly 0 on all 1,456 cells, because `H2OnonECPMFraction` is 0 on all six `sulfatefractions` rows."
        },
        "rtDay_spmResidue": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "runspecday_rows"
          ],
          "description": "The internal residue: NonECPM x the UNADJUSTED residue fraction, x the residue's own general fuel ratio, after the split. Never emitted, and it reaches MOVESOutput three ways (see `rt_residueShare`)."
        }
      },
