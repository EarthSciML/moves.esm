    "pm_generalfuelratio": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/process-pm-exhaust/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__generalfuelratio.parquet"
