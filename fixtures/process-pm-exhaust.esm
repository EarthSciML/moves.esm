  "models": {
    "ProcessPmExhaust": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot"
          ]
        },
        {
          "ref": "../lib/drive_cycle.esm",
          "only": [
            "mph_to_meters_per_second",
            "vehicle_specific_power",
            "in_half_open_range",
            "bracket_low_fraction"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exact_else_wildcard",
            "gpa_blend",
            "pm_temperature_adjustment",
            "fuel_sulfur_sulfate_adjustment"
          ]
        },
        {
          "ref": "../lib/keys.esm",
          "only": [
            "in_inclusive_range",
            "model_year_in_range",
            "flat_relation_major",
            "flat_relation_minor"
          ]
        }
