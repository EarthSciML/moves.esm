              "coords": {
                "activity_rows": 1
              }
            },
            {
              "variable": "act_averageSpeed",
              "time": 0.0,
              "expected": 48.185058,
              "coords": {
                "activity_rows": 42
              }
            },
            {
              "variable": "act_sho",
              "time": 0.0,
              "expected": 4.88065,
              "coords": {
                "activity_rows": 41
              }
            },
            {
              "variable": "act_sho",
              "time": 0.0,
              "expected": 402.618,
              "coords": {
                "activity_rows": 42
              }
            },
            {
              "variable": "act_sho",
              "time": 0.0,
              "expected": 129.468,
              "coords": {
                "activity_rows": 62
              }
            },
            {
              "variable": "act_sho",
              "time": 0.0,
              "expected": 54.7283,
              "coords": {
                "activity_rows": 1
              }
            }
          ]
        },
        {
          "id": "the_four_worked_examples_reach_MOVESOutput",
          "description": "docs/mixed-onroad.md \u00a76.1-\u00a76.4, asserted against the numbers MOVESOutput stores rather than against this document's own. A (MY 1980, gasoline, weekend) is the largest single row and shows every factor at once; B (MY 2020, gasoline, weekday) is the largest activity; C (MY 2000, electricity, weekday) exercises the EV efficiency divisor at its largest -- 22.1% -- and D (MY 2020, electricity, weekend) at the other end of the age-group ladder. The tolerance is the fixture's own per-cell gate, because MOVESOutput stores six significant figures and \u00a77.1 attributes every residual here to that. The three SCCs are exact integers and are asserted exactly: an SCC off by one digit relabels a whole fuel type and still passes a per-pollutant sum.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "tolerance": {
            "rel": 2e-05
          },
          "assertions": [
            {
