      },
      "metadata": {
        "tags": [
          "rates"
        ],
        "note": "115 rows. The EV share of a model year's sales, and the reason S13's back-scaling is MODEL-YEAR dependent -- \u00a77.3 measures that omitting it leaves a 5.5e-2 residual where the full factorisation leaves 1.4e-5.",
        "esio_format": "parquet"
      }
    },
    "mo_fleetavgadjustment": {
      "kind": "static",
