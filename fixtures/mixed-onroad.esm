      },
      "metadata": {
        "tags": [
          "rates"
        ],
        "note": "11 rows. J25 is not an equi-join: beginModelYearID <= MY <= endModelYearID is a range predicate, so it is a two-pair join.on plus a filter. adjustmentCap is NULL in every row and arrives as NaN, which `cap > 0` reads as absent.",
        "esio_format": "parquet"
      }
    },
    "mo_regulatoryclass": {
      "kind": "static",
