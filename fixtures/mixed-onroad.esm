      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, 9am, source type 21, road type 4, county 26161, zone 261610, polProcessID 9101 built from the two enums, and 2020 flagged as a base year so \u00a71.5's two folds are the empty product.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_monthID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_hourID",
              "time": 0.0,
              "expected": 9.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_sourceTypeID",
              "time": 0.0,
              "expected": 21.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_roadTypeID",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_countyID",
              "time": 0.0,
              "expected": 26161.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_zoneID",
              "time": 0.0,
              "expected": 261610.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_stateID",
              "time": 0.0,
              "expected": 26.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_polProcessID",
              "time": 0.0,
              "expected": 9101.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_pollutantID",
              "time": 0.0,
              "expected": 91.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_processID",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_baseYearIsAnalysisYear",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_fuelYearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_hpmsVtypeID",
              "time": 0.0,
              "expected": 25.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_daysInMonth",
              "time": 0.0,
              "expected": 31.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_monthGroupID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "run_rows": 1
              }
            }
          ]
        },
        {
          "id": "the_drive_cycle_scaffolding_is_a_single_physics_row_and_two_data_thresholds",
          "description": "The three facts W's correctness rests on that are not W itself: the braking thresholds are READ from operatingmode's Braking row rather than written as drivecycle.rs's -2.0 and -1.0 literals; exactly one physics-mapping row is selected, so dss_vsp is one polynomial and not a sum of several; and every average-speed bin's bracketing weights sum to 1, which is what catches a duplicated bracket speed or a bin with no bracket.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "run_brakeRate1Sec",
              "time": 0.0,
              "expected": -2.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_brakeRate3Sec",
              "time": 0.0,
              "expected": -1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_physicsRowsSelected",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_fuelUsageWildcardCount",
              "time": 0.0,
              "expected": 5.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "asb_scheduleFractionTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "avgspeedbin_rows": 1
              }
            },
            {
              "variable": "asb_scheduleFractionTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "avgspeedbin_rows": 8
              }
            },
            {
              "variable": "asb_scheduleFractionTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "avgspeedbin_rows": 16
              }
            }
          ]
        },
        {
          "id": "the_cohort_row_rule_admits_exactly_the_snapshots_cohorts",
          "description": "125 of the 164 candidates survive `stmyFraction > 0`, and every one of them has an emissionrate row -- so the two suppression mechanisms agree here, which is the fact that distinguishes this slice from process-evap-leaks, where the rate table's absence takes 125 down to 64. n_outputCohort is checked against this, not the other way round.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "cohortSurvivorCount",
              "time": 0.0,
              "expected": 125.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "cohortRateCount",
              "time": 0.0,
              "expected": 125.0,
              "coords": {
                "run_rows": 1
              }
            }
          ]
        },
        {
          "id": "the_drive_cycle_weights_are_a_distribution_over_the_twenty_three_running_modes",
          "description": "W itself, checked on the two properties that do not require the reference. It is a DISTRIBUTION: the weights sum to the avgSpeedFraction column's own total, which is 1 to that column's six stored significant figures and not exactly -- 1.0000004 for the weekend and 0.9999999 for the weekday -- so the gate is ABSOLUTE at 1e-5 and not relative (docs/esm-conventions.md \u00a720.5). And it covers exactly the 23 operating modes \u00a75.5 says carry a 9101 rate: a classification that admitted the coarse modes 26 or 36, or that lost the braking arm, changes this count before it changes any emission.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "tolerance": {
            "abs": 1e-05
          },
          "assertions": [
            {
              "variable": "dc_WTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "runspecday_rows": 1
              }
            },
            {
              "variable": "dc_WTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "runspecday_rows": 2
              }
            },
            {
              "variable": "dc_WModeCount",
              "time": 0.0,
              "expected": 23.0,
              "coords": {
                "runspecday_rows": 1
              }
            },
            {
              "variable": "dc_WModeCount",
              "time": 0.0,
              "expected": 23.0,
              "coords": {
                "runspecday_rows": 2
              }
            }
          ]
        },
        {
          "id": "the_activity_chain_reproduces_the_worked_examples",
          "description": "docs/mixed-onroad.md \u00a76.1 and \u00a76.2, at the four named stages a wrong factor shows up at. travelFraction[21, 40] normalised over the whole HPMS group is 1.609175e-03; over source type 21 alone it is 4.10e-03 and every row is 2.55x high. averageSpeed is the ARITHMETIC mean, 66.094076 for the weekend and 48.185058 for the weekday; the harmonic mean gives 49.44 and 34.98 and S8 divides by the result. The two `sho` values are the snapshot's own, to its six stored significant figures: omitting weeksPerMonth gives 21.61 instead of 4.8806.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "tolerance": {
            "rel": 2e-06
          },
          "assertions": [
            {
