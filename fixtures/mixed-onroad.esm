  "models": {
    "Fixture": {
      "subsystems": {
        "Onroad": {
          "ref": "../onroad/model.esm",
          "bindings": {
            "n_outputRate": 125
          }
        }
      },
      "variables": {},
      "equations": [],
      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, 9am, road type 4, county 26161, zone 261610, and 2020 flagged as a base year so §1.5's two folds are the empty product.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "runspecyear_rows": 1
              }
            },
            {
              "variable": "Onroad.run_monthID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "runspecmonth_rows": 1
              }
            },
            {
              "variable": "Onroad.run_hourID",
              "time": 0.0,
              "expected": 9.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.run_roadTypeID",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.run_countyID",
              "time": 0.0,
              "expected": 26161.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_zoneID",
              "time": 0.0,
              "expected": 261610.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_stateID",
              "time": 0.0,
              "expected": 26.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_baseYearIsAnalysisYear",
              "time": 0.0,
