          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The link's road type, which is what the output row is labelled with."
        },
        "run_stateID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
