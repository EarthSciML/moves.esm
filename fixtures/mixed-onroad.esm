{
  "esm": "1.2.0",
  "metadata": {
    "name": "mixed-onroad fixture",
    "description": "The `mixed-onroad` fixture: the run's EXECUTION database -- the snapshot's own tables, cut from the default database for this RunSpec and holding its generators' intermediate tables -- mounted on `onroad/model.esm`. It holds no logic: its `data_sources` are the catalogue under the names the model reads, and its one model, `Fixture`, mounts the domain model as a SUBSYSTEM, binds the run's declared counts, and carries the run's inline tests: assertions on the mounted model's intermediate values (`Onroad.*` / `Nonroad.*`) against this snapshot. A test written inside a `{ref}`'d model does not run (finding F47), so the assertions live here, in the document that supplies the data they are about (esm-spec §6.6; conventions §106). run-tests.sh's fixture stage runs them, then emits the model's `out_*` relation and compares it with the snapshot's MOVESOutput. No RunSpec in `runspecs/` covers this run, so this fixture is its only check.\n\nUntil 2026-10-30 this file inlined its own copy of the onroad model (14157 lines, frozen at the commit that last touched it), so the logic every fixture shared was written fourteen times. PLAN.md §7.1, docs/esm-conventions.md §106."
  },
  "models": {
    "Fixture": {
      "subsystems": {
        "Onroad": {
          "ref": "catalogues/onroad-execution-db.esm",
          "url_substitutions": {
            "snapshot": "mixed-onroad"
          },
          "bindings": {
            "n_outputRate": 125
          }
        }
      },
      "variables": {},
      "equations": [],
      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, 9am, road type 4, county 26161, zone 261610, and 2020 flagged as a base year so §1.5's two folds are the empty product.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "runspecyear_rows": 1
              }
            },
            {
              "variable": "Onroad.run_monthID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "runspecmonth_rows": 1
              }
            },
            {
              "variable": "Onroad.run_hourID",
              "time": 0.0,
              "expected": 9.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.run_roadTypeID",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.run_countyID",
              "time": 0.0,
              "expected": 26161.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_zoneID",
              "time": 0.0,
              "expected": 261610.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_stateID",
              "time": 0.0,
              "expected": 26.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_baseYearIsAnalysisYear",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "runspecyear_rows": 1
              }
            },
            {
              "variable": "Onroad.run_fuelYearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "runspecyear_rows": 1
              }
            },
            {
              "variable": "Onroad.run_hpmsVtypeID",
              "time": 0.0,
              "expected": 25.0,
              "coords": {
                "runspecsourcetype_rows": 1
              }
            },
            {
              "variable": "Onroad.run_daysInMonth",
              "time": 0.0,
              "expected": 31.0,
              "coords": {
                "runspecmonth_rows": 1
              }
            },
            {
              "variable": "Onroad.run_monthGroupID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "runspecmonth_rows": 1
              }
            }
          ]
        },
        {
          "id": "the_drive_cycle_scaffolding_is_a_single_physics_row_and_two_data_thresholds",
          "description": "The three facts W's correctness rests on that are not W itself: the braking thresholds are READ from operatingmode's Braking row rather than written as drivecycle.rs's -2.0 and -1.0 literals; exactly one physics-mapping row is selected, so dss_vsp is one polynomial and not a sum of several; and every average-speed bin's bracketing weights sum to 1, which is what catches a duplicated bracket speed or a bin with no bracket.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.run_brakeRate1Sec",
              "time": 0.0,
              "expected": -2.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.run_brakeRate3Sec",
              "time": 0.0,
              "expected": -1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.run_physicsRowsSelected",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.run_fuelUsageWildcardCount",
              "time": 0.0,
              "expected": 5.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.asb_scheduleFractionTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "avgspeedbin_rows": 1
              }
            },
            {
              "variable": "Onroad.asb_scheduleFractionTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "avgspeedbin_rows": 8
              }
            },
            {
              "variable": "Onroad.asb_scheduleFractionTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "avgspeedbin_rows": 16
              }
            }
          ]
        },
        {
          "id": "the_cohort_row_rule_admits_exactly_the_snapshots_cohorts",
          "description": "125 of the 164 candidates survive `stmyFraction > 0`, and every one of them has an emissionrate row -- so the two suppression mechanisms agree here, which is the fact that distinguishes this slice from process-evap-leaks, where the rate table's absence takes 125 down to 64. `cohortSurvivorCount` counts the cohorts the output carries, so its 125 says both at once; the separate rate-matched count that once stood beside it is gone from the model. n_outputCohort is checked against this, not the other way round.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.cohortSurvivorCount",
              "time": 0.0,
              "expected": 125.0,
              "coords": {
                "run_rows": 1
              }
            }
          ]
        },
        {
          "id": "the_activity_chain_reproduces_the_worked_examples",
          "description": "docs/mixed-onroad.md §6.1 and §6.2, at the stages a wrong factor shows up at. travelFraction[21, 40] normalised over the whole HPMS group is 1.609175e-03; over source type 21 alone it is 4.10e-03 and every row is 2.55x high. averageSpeed is the ARITHMETIC mean, 48.185058 for the weekday; the harmonic mean gives 34.98 and S8 divides by the result. The three `sho` values are the snapshot's own `sho` table, to its six stored significant figures, at ageID 0, 20 and 40.\n\nRE-ADDRESSED FOR THE ONE-DAY RUN, BY KEY (docs/esm-conventions.md §40, §42). `activity_rows` is (day, age) with the day OUTERMOST, so it was 2 x 41 and is now 1 x 41: every ordinal above 41 moved down by 41 and every ordinal at or below 41 named a WEEKEND row that no longer exists. The weekend claims -- averageSpeed 66.094076, sho 4.88065 at the oldest cohort and 54.7283 at the newest -- are gone with it, and the weekday values that were asserted at 42 and 62 are asserted at 1 and 21. travelFraction is day-INDEPENDENT, so its two assertions keep both their ordinals and their values, which is the check that the re-addressing did not silently move a claim as well as an address.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "tolerance": {
            "rel": 2e-06
          },
          "assertions": [
            {
              "variable": "Onroad.act_travelFraction",
              "time": 0.0,
              "expected": 0.001609174853309,
              "coords": {
                "activity_rows": 41
              }
            },
            {
              "variable": "Onroad.act_travelFraction",
              "time": 0.0,
              "expected": 0.01804420293236,
              "coords": {
                "activity_rows": 1
              }
            },
            {
              "variable": "Onroad.act_averageSpeed",
              "time": 0.0,
              "expected": 48.185058,
              "coords": {
                "activity_rows": 1
              }
            },
            {
              "variable": "Onroad.act_sho",
              "time": 0.0,
              "expected": 402.618,
              "coords": {
                "activity_rows": 1
              }
            },
            {
              "variable": "Onroad.act_sho",
              "time": 0.0,
              "expected": 129.468,
              "coords": {
                "activity_rows": 21
              }
            },
            {
              "variable": "Onroad.act_sho",
              "time": 0.0,
              "expected": 35.9053,
              "coords": {
                "activity_rows": 41
              }
            }
          ]
        },
        {
          "id": "the_four_worked_examples_reach_MOVESOutput",
          "description": "docs/mixed-onroad.md §6.1-§6.4, asserted against the numbers MOVESOutput stores rather than against this document's own. All four examples are now WEEKDAY, because the run selects dayID 5 alone (§42): A (MY 1980, gasoline) is the largest single row and shows every factor at once; B (MY 2020, gasoline) is the largest activity; C (MY 2000, electricity) exercises the EV efficiency divisor at its largest -- 22.1% -- and D (MY 2020, electricity) at the other end of the age-group ladder. A and D used to name the weekend rows of the same two cohorts, so what changed is the day and not the cohort: 0.895519 -> 1.99515 on A and 0.0913402 -> 0.176518 on D, both from the snapshot's own MOVESOutput. `output_rows` is (day, block, cohort) with the day OUTERMOST, so every ordinal above 125 moved down by 125 and every ordinal at or below 125 named a weekend row; each coordinate here was re-addressed BY KEY and re-read at that key's new ordinal (docs/esm-conventions.md §40). The tolerance is the fixture's own per-cell gate, because MOVESOutput stores six significant figures and §7.1 attributes every residual here to that. The three SCCs are exact integers and are asserted exactly: an SCC off by one digit relabels a whole fuel type and still passes a per-pollutant sum.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "tolerance": {
            "rel": 2e-05
          },
          "assertions": [
            {
              "variable": "Onroad.out_emissionQuant",
              "time": 0.0,
              "expected": 1.99515,
              "coords": {
                "output_rows": 41
              }
            },
            {
              "variable": "Onroad.out_emissionQuant",
              "time": 0.0,
              "expected": 11.8503,
              "coords": {
                "output_rows": 1
              }
            },
            {
              "variable": "Onroad.out_emissionQuant",
              "time": 0.0,
              "expected": 0.000496572,
              "coords": {
                "output_rows": 125
              }
            },
            {
              "variable": "Onroad.out_emissionQuant",
              "time": 0.0,
              "expected": 0.176518,
              "coords": {
                "output_rows": 105
              }
            },
            {
              "variable": "Onroad.out_modelYearID",
              "time": 0.0,
              "expected": 1980.0,
              "coords": {
                "output_rows": 41
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "Onroad.out_fuelTypeID",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "output_rows": 41
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "Onroad.out_modelYearID",
              "time": 0.0,
              "expected": 2000.0,
              "coords": {
                "output_rows": 125
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "Onroad.out_fuelTypeID",
              "time": 0.0,
              "expected": 9.0,
              "coords": {
                "output_rows": 125
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "Onroad.out_SCC",
              "time": 0.0,
              "expected": 2201210401.0,
              "coords": {
                "output_rows": 41
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "Onroad.out_SCC",
              "time": 0.0,
              "expected": 2209210401.0,
              "coords": {
                "output_rows": 105
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "Onroad.out_SCC",
              "time": 0.0,
              "expected": 2205210401.0,
              "coords": {
                "output_rows": 87
              },
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-09
      }
    }
  }
}
