        "metaparameter": "n_emissionrate"
      },
      "metadata": {
        "tags": [
          "rates"
        ],
        "note": "69,200 rows, arriving with `sourceBinID` already packed and NO component columns -- which is why J22 keys on the four unpacked slots and not on the id (\u00a72.2).",
        "esio_format": "parquet"
      }
    },
    "mo_evsalesfraction": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/mixed-onroad/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__evsalesfraction.parquet"
