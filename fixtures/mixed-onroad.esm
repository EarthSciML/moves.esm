                "runspecday_rows": 2
              }
            },
            {
              "variable": "cohDay_meanBaseRate",
              "time": 0.0,
              "expected": 205339.0,
              "coords": {
                "cohort_rows": 1,
                "runspecday_rows": 1
              }
            },
            {
              "variable": "cohDay_meanBaseRate",
              "time": 0.0,
