        "tags": [
          "cohorts"
        ],
        "note": "192 rows. shortModYrGroupID is the two-digit code that occupies the fifth decimal slot of a packed sourceBinID; this document unpacks that slot and never builds one.",
        "esio_format": "parquet"
      }
    },
    "mo_fuelusagefraction": {
      "kind": "static",
