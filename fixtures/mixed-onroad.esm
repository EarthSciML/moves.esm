      },
      "metadata": {
        "tags": [
          "cohorts"
        ],
        "note": "5 rows, and NOT the identity. 0.982134 of every E85 bin's activity is attributed to the gasoline supply and 0.017866 stays, because a flex-fuel vehicle mostly burns gasoline, and sbweighted.rs:148-165 weights the base rate by the REBASED distribution. Measured: using the raw stmyFraction instead is a factor of 55 on the E85 rows.",
        "esio_format": "parquet"
      }
    },
    "mo_agecategory": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/mixed-onroad/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__agecategory.parquet"
