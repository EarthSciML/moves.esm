      "size": "n_temperatureadjustment"
    },
    "evefficiency_rows": {
      "kind": "interval",
      "size": "n_evefficiency"
    },
    "hourday_rows": {
      "kind": "interval",
      "size": "n_hourday"
    },
    "dayofanyweek_rows": {
      "kind": "interval",
      "size": "n_dayofanyweek"
    },
    "activity_rows": {
      "kind": "interval",
      "size": {
        "op": "*",
        "args": [
          "n_agecategory",
          "n_runspecday"
        ]
      }
    },
    "cohort_rows": {
      "kind": "interval",
      "size": {
        "op": "*",
        "args": [
          "n_agecategory",
          "n_runspecsourcefueltype"
        ]
      }
    },
    "output_rows": {
      "kind": "interval",
      "size": {
        "op": "*",
        "args": [
          "n_outputCohort",
          "n_runspecday"
        ]
      }
    }
  },
