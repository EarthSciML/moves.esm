        "tags": [
          "cohorts",
          "shape"
        ],
        "note": "41 rows, seven age groups. Its extent is the model-year window -- [runYear - 40, runYear] -- and the first factor of both derived axes; its ageGroupID is the key S15(f)'s EV efficiency is selected on.",
        "esio_format": "parquet"
      }
    },
    "mo_emissionrate": {
      "kind": "static",
