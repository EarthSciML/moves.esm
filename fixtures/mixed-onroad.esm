              "time": 0.0,
              "expected": 15.7531,
              "coords": {
                "cohort_rows": 144,
                "runspecday_rows": 2
              }
            },
            {
              "variable": "cohDay_meanBaseRateACAdj",
              "time": 0.0,
              "expected": 56676.3,
              "coords": {
                "cohort_rows": 41,
                "runspecday_rows": 1
              }
            },
            {
