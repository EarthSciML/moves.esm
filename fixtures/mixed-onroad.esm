    "pollutant": {
      "TotalEnergyConsumption": 91
    },
    "process": {
      "RunningExhaust": 1
    },
    "fuel_type": {
      "Electricity": 9
    },
    "operating_mode": {
      "Idling": 1,
      "HighestBinnedMode": 40,
      "CoarseModerateSpeedHighVSP": 26,
      "CoarseHighSpeedHighVSP": 36
    },
    "source_bin_slot": {
      "ShortModelYearGroup": 10,
      "RegulatoryClass": 12,
      "EngineTech": 14,
      "FuelType": 16
    }
  },
  "models": {
    "MixedOnroad": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot",
            "ev_energy_divisor",
            "kilojoules_per_million_btu"
          ]
        },
        {
          "ref": "../lib/drive_cycle.esm",
          "only": [
            "mph_to_meters_per_second",
            "vehicle_specific_power",
            "in_half_open_range",
            "bracket_low_fraction"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exact_else_wildcard"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-09
      },
