{
  "esm": "1.2.0",
  "metadata": {
    "name": "nonroad execution-database catalogue",
    "description": "The 41 execution-database tables a `fixtures/` run of `nonroad/model.esm` reads, under the names the model reads (`db_*`), mounting the model itself. Every location names its snapshot through `{snapshot}`, which the fixture binds on its mount edge (`url_substitutions`, esm-spec §4.7/§8.2): the fixtures differed in nothing else, so this is the one copy of what was written once per fixture until 2026-11-01 (conventions §106). Loaded alone it leaves `{snapshot}` unbound and reads nothing."
  },
  "data_sources": {
    "db_nremissionrate": {
      "kind": "static",
      "source": {
        "url_template": "../../../moves.rs/characterization/snapshots/{snapshot}/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__nremissionrate.parquet"
      },
      "reader_options": {
        "float_columns": [
          "SCC",
          "meanBaseRate"
        ]
      },
      "extent": {
        "metaparameter": "n_nremissionrate"
      },
      "metadata": {
        "tags": [
          "emission-factors"
        ],
        "esio_format": "parquet"
      }
    },
