              "variable": "Onroad.rt_isSelected",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "rate_rows": 144
              }
            },
            {
              "variable": "Onroad.rt_survives",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 144
              }
            },
