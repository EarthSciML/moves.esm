              "variable": "Onroad.rt_tempAdjustTermA",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 1
              }
            },
            {
              "variable": "Onroad.rt_tempAdjustTermA",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 657
              }
            },
            {
              "variable": "Onroad.rt_hasTempAdjustExact",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 657
              }
            },
            {
              "variable": "Onroad.rt_temperatureFactor",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "rate_rows": 1
              }
            },
            {
              "variable": "Onroad.rt_temperatureFactor",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "rate_rows": 329
              }
