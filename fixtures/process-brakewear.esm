              "time": 0.0,
              "expected": 1.98517e-05,
              "coords": {
                "rate_rows": 472,
                "runspecday_rows": 1
              }
            },
            {
              "variable": "Onroad.rtDay_meanBaseRateACAdj",
              "time": 0.0,
              "expected": 26899.6,
              "coords": {
                "rate_rows": 1,
                "runspecday_rows": 1
              }
            },
            {
              "variable": "Onroad.rtDay_meanBaseRateACAdj",
              "time": 0.0,
