  "models": {
    "ProcessBrakewear": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot",
            "ev_energy_divisor",
            "kilojoules_per_million_btu"
