{
  "esm": "1.2.0",
  "metadata": {
    "name": "process-brakewear fixture",
    "description": "The `process-brakewear` fixture: the run's EXECUTION database -- the snapshot's own tables, cut from the default database for this RunSpec and holding its generators' intermediate tables -- mounted on `onroad/model.esm`. It holds no logic: its `data_sources` are the catalogue under the names the model reads, and its one model, `Fixture`, mounts the domain model as a SUBSYSTEM, binds the run's declared counts, and carries the run's inline tests: assertions on the mounted model's intermediate values (`Onroad.*` / `Nonroad.*`) against this snapshot. A test written inside a `{ref}`'d model does not run (finding F47), so the assertions live here, in the document that supplies the data they are about (esm-spec §6.6; conventions §106). run-tests.sh's fixture stage runs them, then emits the model's `out_*` relation and compares it with the snapshot's MOVESOutput. `runspecs/process-brakewear.esm` reproduces the same run from the DEFAULT database through the same model, so the pair is a differential test of the execution-database cut: one model, one oracle, two catalogues.\n\nUntil 2026-10-30 this file inlined its own copy of the onroad model (17086 lines, frozen at the commit that last touched it), so the logic every fixture shared was written fourteen times. PLAN.md §7.1, docs/esm-conventions.md §106."
  },
  "models": {
    "Fixture": {
      "subsystems": {
        "Onroad": {
          "ref": "catalogues/onroad-execution-db.esm",
          "url_substitutions": {
            "snapshot": "process-brakewear"
          }
        }
      },
      "variables": {},
      "equations": [],
      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, hour 7, road type 4, county 26161, zone 261610. The RunSpec XML says month 7 and hour 6; the execution database says 8 and 7, and it is the authority (docs/mixed-onroad.md 0.1). 59.5 degF is the hour's temperature and its heat index -- the two columns are equal in every row of this snapshot and the document still reads them separately, because adjust.rs uses the first for the temperature adjustment and the second for the A/C term and the EV suppression.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "runspecyear_rows": 1
              }
            },
            {
              "variable": "Onroad.run_monthID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "runspecmonth_rows": 1
              }
            },
            {
              "variable": "Onroad.rsd_hourID",
              "time": 0.0,
              "expected": 7.0,
              "coords": {
                "runspecday_rows": 1
              }
            },
            {
              "variable": "Onroad.run_roadTypeID",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.run_countyID",
              "time": 0.0,
              "expected": 26161.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_zoneID",
              "time": 0.0,
              "expected": 261610.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_stateID",
              "time": 0.0,
              "expected": 26.0,
              "coords": {
                "runspeccounty_rows": 1
              }
            },
            {
              "variable": "Onroad.run_baseYearIsAnalysisYear",
              "time": 0.0,
