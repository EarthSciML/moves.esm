                "from": "run_rows"
              },
              "s": {
                "from": "runspecmonth_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "rsm_monthID",
                "s"
              ]
            }
          }
        },
        {
          "lhs": "run_hourID",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "s": {
                "from": "runspechour_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "rsh_hourID",
                "s"
              ]
            }
          }
        },
        {
          "lhs": "run_sourceTypeID",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "s": {
                "from": "runspecsourcetype_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "rst_sourceTypeID",
                "s"
              ]
            }
          }
        },
        {
          "lhs": "run_roadTypeID",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
