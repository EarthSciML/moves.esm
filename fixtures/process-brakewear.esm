              "time": 0.0,
              "expected": 2.60985,
              "coords": {
                "rate_rows": 165
              }
            },
            {
              "variable": "Onroad.rt_chainRatio",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "rate_rows": 205
              }
            },
            {
              "variable": "Onroad.rt_chainRatio",
              "time": 0.0,
              "expected": 2.60985,
              "coords": {
                "rate_rows": 206
              }
            },
            {
              "variable": "Onroad.rt_chainRatio",
              "time": 0.0,
              "expected": 1.42475,
              "coords": {
                "rate_rows": 288
              }
            },
            {
              "variable": "Onroad.rt_chainRatio",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "rate_rows": 308
              }
            },
            {
              "variable": "Onroad.rtDay_quantDirect",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 165,
                "runspecday_rows": 1
              }
            },
            {
              "variable": "Onroad.rtDay_quantDirect",
