              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "avgspeedbin_rows": 16
              }
            }
          ]
        },
        {
          "id": "the_cohort_row_set_is_the_same_125_for_both_rate_paths",
          "description": "125 of the 164 candidates survive `stmyFraction > 0`, and all 125 reach an emissionrate row, for BOTH computed pollutant-processes -- which is the claim that lets one cohort rank serve all three output blocks and is asserted rather than assumed. The chained pollutant has no pollutantprocessmodelyear rows and therefore no source-bin distribution of its own, and its 125 output rows come from the chain instead -- `run_chainedRowCount` counts them, and `cohortSurvivorCount` counts the 125. The per-pollutant-process selection and rate counts (125, 0, 125) and their 250 total are gone from the model and are not asserted, so that the two rate paths select the SAME 125 is now checked only through the emitted key set.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.cohortSurvivorCount",
              "time": 0.0,
              "expected": 125.0,
              "coords": {
                "run_rows": 1
              }
