        "rt_hasRefuelingFactors": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether `refuelingfactors` carries this fuel type at all. Both refueling working tables INNER JOIN it, so a fuel without a row gets no rate row of either kind -- which is what keeps fuel type 3 out of the spillage block even though the county-year fan-out below synthesises a row for it."
        },
        "rt_vaporProgramAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
