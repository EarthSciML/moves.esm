        "sta_isInHpmsGroup": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcetypeage_rows"
          ],
          "description": "Membership of the run's HPMS group, as a semi-join through sourceusetype."
        },
        "om_isBinnedRunningMode": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "operating_mode_rows"
          ],
          "description": "readOperatingMode's window, inputs.rs:408-419: 1 < opModeID < 100 excluding 26 and 36. The two exclusions are load-bearing -- 26 spans 12<=VSP over 25<=speed<50 and 27-30 partition the same interval finely, so keeping both would make the classification ambiguous and its answer depend on iteration order. With them out the 21 survivors are disjoint AND exhaustive over speed>=1, which is why dss_binnedModeID can SUM an indicator instead of taking a first match."
        },
        "phys_isSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "physics_rows"
          ],
          "description": "The physics rows this source type selects, with drivecycle.rs:288's guard that both masses are positive."
        },
        "ds_firstSecond": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_schedule_rows"
          ],
          "description": "drivecycle.rs:203-206: a schedule's first second is its MINIMUM second, not zero and not row zero. Reached through the 49-row schedule table rather than by a min over the 63,602-row relation joined to itself -- the same answer at 1300x the leaf count."
        },
        "dss_priorSecond": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "second - 1: the key column of the first neighbouring-second join."
        },
        "dss_prior2Second": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "second - 2."
        },
        "dss_prior3Second": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "second - 3. The three-second brake test needs the accelerations at s, s-1 and s-2, and an acceleration at s-2 needs the speed at s-3."
        },
        "dss_nextSecond": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "second + 1, read only by a schedule's first second, whose acceleration is a COPY of its successor's."
        },
        "dss_priorSpeed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "The speed one second earlier in the same schedule; 0 where there is none, which is why the companion presence column exists."
        },
        "dss_priorPresent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "1 where a row for second-1 exists. An inner join fills an unmatched row with the semiring identity, and for sum_product that 0 is indistinguishable from a genuine speed of 0 -- 185 of the 63,602 rows have no predecessor, 49 because their schedule starts there and 136 because 19 schedules have interior gaps."
        },
        "dss_prior2Speed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "The speed two seconds earlier."
        },
        "dss_prior2Present": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "1 where a row for second-2 exists. Both this and dss_priorPresent gate the three-second brake test, which is the Rust's `if let (Some(b1), Some(b2))`."
        },
        "dss_prior3Speed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "The speed three seconds earlier."
        },
        "dss_prior3Present": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "1 where a row for second-3 exists."
        },
        "dss_nextSpeed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "The speed one second later."
        },
        "dss_nextPresent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "1 where a row for second+1 exists."
        },
        "dss_firstSecond": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "This row's schedule's first second, carried down from the schedule relation so the copy rule is a comparison and not a positional assumption."
        },
        "dss_acceleration": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "drivecycle.rs:236-252, in mph/s. A second with a predecessor takes the difference; a schedule's FIRST second copies its successor's; a gap-interior second with neither keeps the zero the Rust's Default leaves, and that zero is not braking."
        },
        "dss_priorAcceleration": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
