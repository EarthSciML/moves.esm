          "update": {
            "kind": "data",
            "source": "rf_runspechour",
            "from": {
              "file_variable": "hourID"
            }
          }
        },
        "rsd_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecday_rows"
          ],
