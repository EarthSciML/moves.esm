        {
          "_comment": "S4 (J6). One clause, two pairs: the HPMS type and the year.",
          "lhs": "run_analysisYearVMT",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "h": {
                "from": "hpmsvtypeyear_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_hpmsVtypeID",
                    "hvy_HPMSVtypeID"
                  ],
                  [
                    "run_yearID",
                    "hvy_yearID"
