        "yr_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "year_rows"
          ],
          "description": "year.yearID.",
          "update": {
            "kind": "data",
            "source": "rf_year",
            "from": {
              "file_variable": "yearID"
            }
          }
        },
        "yr_fuelYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "year_rows"
          ],
          "description": "year.fuelYearID: the key the fuel-usage rebase is scoped by.",
          "update": {
            "kind": "data",
            "source": "rf_year",
            "from": {
              "file_variable": "fuelYearID"
            }
          }
        },
        "yr_isBaseYear": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "year_rows"
          ],
          "description": "year.isBaseYear, Y/N text decoded by a `codes` map on the binding -- a text column is a hard error at the ingest boundary without one. S1 uses it, and it is Y for 2020, which is why \u00a71.5's two folds collapse.",
          "update": {
            "kind": "data",
            "source": "rf_year",
            "from": {
              "file_variable": "isBaseYear",
              "codes": {
                "map": {
                  "Y": 1,
                  "N": 0
                },
                "case_insensitive": true
              }
            }
          }
        },
        "sty_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypeyear_rows"
          ],
          "description": "sourcetypeyear.yearID.",
          "update": {
            "kind": "data",
            "source": "rf_sourcetypeyear",
            "from": {
              "file_variable": "yearID"
            }
          }
        },
        "sty_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypeyear_rows"
          ],
          "description": "sourcetypeyear.sourceTypeID.",
          "update": {
            "kind": "data",
            "source": "rf_sourcetypeyear",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "sty_sourceTypePopulation": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypeyear_rows"
          ],
          "description": "sourcetypeyear.sourceTypePopulation.",
          "update": {
            "kind": "data",
            "source": "rf_sourcetypeyear",
            "from": {
              "file_variable": "sourceTypePopulation"
            }
          }
        },
        "stad_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypeagedistribution_rows"
          ],
          "description": "sourcetypeagedistribution.sourceTypeID.",
