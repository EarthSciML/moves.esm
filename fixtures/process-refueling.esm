      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, hour 7, source type 21, road type 4, county 26161, zone 261610. The RunSpec XML says month 7 and hour 6; the execution database says 8 and 7, and it is the authority (docs/mixed-onroad.md 0.1). 59.5 degF is the hour's temperature and its heat index -- the two columns are equal in every row of this snapshot and the document still reads them separately, because adjust.rs uses the first for the temperature adjustment and the second for the A/C term and the EV suppression.\n\nAND THE ROAD TYPE, which this fixture leans on harder than any before it: the RunSpec selects ONE road type and it is not the off-network one. `BaseRateGenerator` emits start-exhaust rates off-network (roadTypeID 1) and hotelling rates for source type 62 only, so with road type 4 alone selected the run's other two energy pollutant-processes reach the output with nothing -- which is what lets the refueling stage sum the chained energy over cohorts instead of carrying the energy row's own road type.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_monthID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_hourID",
              "time": 0.0,
              "expected": 7.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_sourceTypeID",
              "time": 0.0,
              "expected": 21.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_roadTypeID",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_countyID",
              "time": 0.0,
              "expected": 26161.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_zoneID",
              "time": 0.0,
              "expected": 261610.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_stateID",
              "time": 0.0,
              "expected": 26.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_baseYearIsAnalysisYear",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_fuelYearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_hpmsVtypeID",
              "time": 0.0,
              "expected": 25.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_daysInMonth",
              "time": 0.0,
              "expected": 31.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_monthGroupID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_temperature",
              "time": 0.0,
              "expected": 59.5,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_heatIndex",
              "time": 0.0,
              "expected": 59.5,
              "coords": {
                "run_rows": 1
              }
            },
            {
