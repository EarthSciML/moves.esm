        "rt_fuelVolumeDivisor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "energyContent x fuelDensity at this rate row's fuel type, kJ per gallon."
        },
        "rt_hasFuelDivisor": {
          "type": "unknown",
          "units": "1",
