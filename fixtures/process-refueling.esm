          "units": "1",
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "REFEC-1: 68.495 degF for gasoline and E85, whose (45, 90) window puts 59.5 through the 2008 California study relation 20.30 + 0.81 t; 59.5 unchanged for diesel and electricity, whose (0, 0) pair disables it."
        },
        "rff_tankTemperatureDif": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "REFEC-1: 0.418 x 68.495 - 16.6 = 12.03091, inside the [0, 20] window. Neither clamp fires at this temperature -- components/refueling_loss_rate.esm is where both do."
        },
        "rff_displacedVaporRateRaw": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "REFEC-2 before the floor, grams of vapour displaced per gallon delivered."
        },
        "rff_displacedVaporRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "refuelingfactors_rows"
          ],
          "description": "REFEC-2 after the floor: 3.0152931 for gasoline, 2.8986556 for E85, and exactly 0 for diesel and electricity, whose minimumRefuelingVaporLoss of -1 is the SENTINEL that means `no vapour`. Their raw rate is exp(0) = 1, so a port that read -1 as an ordinary floor would emit a rate of 1 rather than 0."
        },
        "rt_isEnergySource": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this rate row's pollutant-process is one the refueling formulae consume."
