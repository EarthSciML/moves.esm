            "rate_rows"
          ],
          "description": "The refueling process this rate row produces, 0 if none. It is the KEY both refueling rate lookups below join on, which is how the pollutant intersection reaches them: a Total Organic Gases row carries 0 and matches no `processID`."
        },
        "rt_displacedVaporRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "REFEC-2's rate at this rate row's fuel type."
