        "ftp_fuelDensity": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fueltype_rows"
          ],
          "description": "fueltype.fuelDensity, grams per gallon: 2829 gasoline, 3203 diesel, 2944 E85, NULL electricity.",
          "update": {
            "kind": "data",
