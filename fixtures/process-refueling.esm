          "update": {
            "kind": "data",
            "source": "rf_runspecday",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "rst_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecsourcetype_rows"
          ],
          "description": "runspecsourcetype.sourceTypeID.",
          "update": {
            "kind": "data",
            "source": "rf_runspecsourcetype",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "rsr_roadTypeID": {
          "type": "parameter",
