        },
        "run_acActivityRaw": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "setup.rs:409 before the clamp, in Horner form as the canonical SQL writes it: A + h(B + Ch) = -0.0189 here."
        },
        "run_acActivity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "setup.rs:411's clamp(0, 1), which makes it exactly 0. Written out rather than factored into a `clamp01` template, because \u00a74.8 argues the VALUE each of this chain's two clamps takes is the load-bearing fact and a shared template would hide which is which."
        },
        "run_evTemperatureIsSuppressed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "adjust.rs:114's `sourceTypeID < 40 && heatIndex > 67.0`. FALSE here by one tenth of a degree."
        },
        "run_brakingOpModeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The Braking operating mode, NAMED. It was a bare literal 0 until finding F32 was fixed upstream -- an `enums` value had to be a positive integer and MOVES's Braking mode is genuinely 0, so the one mode this document most needed to name was the one it could not. A constant equality is still a join.on (docs/esm-conventions.md \u00a720.4), so this one-row column is what the two braking-rate lookups key on."
        },
        "run_brakeRate1Sec": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "-2 mph/s, READ from the Braking row of operatingmode rather than written into drivecycle.rs's own literal."
        },
        "run_brakeRate3Sec": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "-1 mph/s, the three-consecutive-seconds threshold."
        },
        "run_physicsRowsSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many physics-mapping rows this source type selects. ONE here, and a test pins it: the mapping is per (sourceTypeID, regClassID, model-year range), so a snapshot with two rows would make dss_vsp a SUM of two polynomials and return a plausible wrong number rather than failing."
        },
        "run_fuelUsageWildcardCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many fuelusagefraction rows carry modelYearGroupID 0. All five, which licenses the rebase omitting that key pair: source_bin_distribution_generator.rs:1547 makes 0 a wildcard, and a row with a real group would need a predicate this document does not carry."
        },
        "cohortSurvivorCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "125, computed from the chain, so `n_outputCohort` is a CHECKED declaration rather than a transcription."
        },
        "sta_ageFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcetypeage_rows"
          ],
          "description": "S3's denominator is assembled on the 533-row (source type, age) relation because that is the SMALL side of the join to the 33,579-row distribution (finding F17)."
        },
        "sta_population": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sourcetypeage_rows"
          ],
          "description": "Population per (source type, age) for every source type, not only the run's."
