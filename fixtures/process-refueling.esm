  "models": {
    "ProcessRefueling": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/keys.esm",
          "only": [
            "model_year_in_range"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot",
            "ev_energy_divisor",
            "kilojoules_per_million_btu"
          ]
        },
        {
          "ref": "../lib/drive_cycle.esm",
          "only": [
            "mph_to_meters_per_second",
            "vehicle_specific_power",
            "in_half_open_range",
            "bracket_low_fraction"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exact_else_wildcard"
          ]
        },
        {
          "ref": "../lib/refueling.esm",
          "only": [
            "positive_else_zero",
            "refueling_temperature",
            "tank_temperature_dif",
            "displaced_vapor_rate",
            "floored_vapor_rate",
            "adjusted_vapor_rate",
            "adjusted_spill_rate",
            "refueling_emission_quantity"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-09
      },
      "variables": {
        "rsy_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecyear_rows"
          ],
          "description": "runspecyear.yearID.",
          "update": {
            "kind": "data",
            "source": "rf_runspecyear",
            "from": {
              "file_variable": "yearID"
            }
          }
        },
        "rsm_monthID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecmonth_rows"
          ],
          "description": "runspecmonth.monthID.",
          "update": {
            "kind": "data",
