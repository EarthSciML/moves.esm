  "models": {
    "ProcessNoxSpeciation": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot",
            "kilojoules_per_million_btu",
            "is_energy_pollutant",
            "energy_unit_divisor"
          ]
        },
        {
          "ref": "../lib/drive_cycle.esm",
          "only": [
            "mph_to_meters_per_second",
            "vehicle_specific_power",
            "in_half_open_range",
            "bracket_low_fraction"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exact_else_wildcard",
            "gpa_blend",
            "bounded_low_then_high",
            "nox_humidity_cfr86",
            "nox_humidity_cfr1065",
            "nox_temperature_adjustment",
            "quadratic_temperature_adjustment"
          ]
        },
        {
          "ref": "../lib/meteorology.esm",
          "only": [
            "heat_index",
            "vapor_partial_pressure_from_weather",
            "specific_humidity",
            "mol_water_fraction"
          ]
        },
        {
          "ref": "../lib/keys.esm",
          "only": [
            "model_year_in_range",
            "flat_relation_major",
            "flat_relation_minor"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-09
      },
      "variables": {
        "rsy_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecyear_rows"
          ],
          "description": "runspecyear.yearID.",
          "update": {
            "kind": "data",
            "source": "nox_runspecyear",
            "from": {
              "file_variable": "yearID"
            }
          }
        },
        "rsm_monthID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecmonth_rows"
          ],
          "description": "runspecmonth.monthID.",
          "update": {
            "kind": "data",
            "source": "nox_runspecmonth",
            "from": {
              "file_variable": "monthID"
            }
          }
        },
        "rsh_hourID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspechour_rows"
          ],
          "description": "runspechour.hourID.",
          "update": {
            "kind": "data",
            "source": "nox_runspechour",
            "from": {
              "file_variable": "hourID"
            }
          }
        },
        "rsd_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecday_rows"
          ],
          "description": "runspecday.dayID.",
          "update": {
            "kind": "data",
            "source": "nox_runspecday",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "rst_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecsourcetype_rows"
          ],
          "description": "runspecsourcetype.sourceTypeID.",
          "update": {
            "kind": "data",
            "source": "nox_runspecsourcetype",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "rsr_roadTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecroadtype_rows"
          ],
          "description": "runspecroadtype.roadTypeID.",
          "update": {
            "kind": "data",
            "source": "nox_runspecroadtype",
            "from": {
              "file_variable": "roadTypeID"
            }
          }
        },
        "rsft_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecsourcefueltype_rows"
          ],
          "description": "runspecsourcefueltype.sourceTypeID.",
          "update": {
            "kind": "data",
            "source": "nox_runspecsourcefueltype",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "rsft_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecsourcefueltype_rows"
          ],
          "description": "runspecsourcefueltype.fuelTypeID, in file order: the cohort grid's fuel blocks are defined against that order.",
          "update": {
            "kind": "data",
            "source": "nox_runspecsourcefueltype",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "lnk_linkID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "link_rows"
          ],
          "description": "link.linkID.",
          "update": {
            "kind": "data",
            "source": "nox_link",
            "from": {
              "file_variable": "linkID"
            }
          }
        },
        "lnk_countyID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "link_rows"
          ],
          "description": "link.countyID.",
          "update": {
            "kind": "data",
            "source": "nox_link",
            "from": {
              "file_variable": "countyID"
            }
          }
        },
        "lnk_zoneID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "link_rows"
          ],
          "description": "link.zoneID.",
          "update": {
            "kind": "data",
