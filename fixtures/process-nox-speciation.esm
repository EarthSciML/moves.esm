        "cty_GPAFract": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "county_rows"
          ],
          "description": "county.GPAFract, 0.0. The second argument of every fuel-effect blend.",
          "update": {
            "kind": "data",
