            "start": 0.0,
            "end": 0.0
          },
          "tolerance": {
            "rel": 1e-09
          },
          "assertions": [
            {
              "variable": "rt_hasTempAdjustExact",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 1
              }
            },
            {
              "variable": "rt_tempAdjustTermA",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 1
              }
            },
            {
              "variable": "rt_tempAdjustTermB",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 1
              }
            },
            {
              "variable": "rt_noxTemperatureAdjust",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "rate_rows": 1
              }
            },
            {
