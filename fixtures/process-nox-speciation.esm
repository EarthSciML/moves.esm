            {
              "variable": "Onroad.run_fuelUsageWildcardCount",
              "time": 0.0,
              "expected": 5.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "Onroad.asb_scheduleFractionTotal",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "avgspeedbin_rows": 1
              }
            },
            {
              "variable": "Onroad.asb_scheduleFractionTotal",
              "time": 0.0,
              "expected": 1.0,
