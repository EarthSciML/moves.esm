          "_comment": "S15's temperature branch, adjust.rs:88-143. mixed-onroad and process-brakewear carry the EV-energy branch of the same function; this fixture carries the NOx one, and neither can reach the other's pollutant.",
          "lhs": "rt_isNoxTotal",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "rt_pollutantID",
                      {
                        "op": "enum",
                        "args": [
                          "pollutant",
                          "OxidesOfNitrogen"
                        ]
                      }
                    ]
                  },
                  {
                    "op": "or",
                    "args": [
                      {
                        "op": "==",
                        "args": [
                          "rt_processID",
                          {
                            "op": "enum",
                            "args": [
                              "process",
                              "RunningExhaust"
                            ]
                          }
                        ]
                      },
                      {
                        "op": "or",
                        "args": [
                          {
                            "op": "==",
                            "args": [
                              "rt_processID",
                              {
                                "op": "enum",
                                "args": [
                                  "process",
                                  "ExtendedIdleExhaust"
                                ]
                              }
                            ]
                          },
                          {
                            "op": "==",
                            "args": [
                              "rt_processID",
                              {
                                "op": "enum",
                                "args": [
                                  "process",
                                  "AuxiliaryPowerExhaust"
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1.0,
              0.0
            ]
          }
        },
