        "zmh_relHumidity": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "zonemonthhour_rows"
          ],
          "description": "zonemonthhour.relHumidity, in PERCENT and not as a fraction -- 90.400001525879 at hour 7. Reading it as a fraction leaves the mole fraction a clean factor of 100 low and still finite, which is the shape of error a plot does not show (docs/meteorology-generator.md 1.1). It is the second argument of BOTH derived chains here: the heat-index regression and the vapour partial pressure.",
          "update": {
            "kind": "data",
            "source": "nox_zonemonthhour",
            "from": {
              "file_variable": "relHumidity"
            }
          }
        },
        "zmh_heatIndex": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zonemonthhour_rows"
          ],
          "description": "`ZoneMonthHour.heatIndex`, COMPUTED rather than read back off the reference: MeteorologyGenerator.doHeatIndex MG-3, ported as lib/meteorology.esm's `heat_index` (docs/meteorology-generator.md 2.2). The dry-bulb temperature below 78 degF, the National Weather Service regression capped at 120 degF at or above it. The run's hour is 7 at 59.500000000000 degF, so the identity arm is what reaches `run_heatIndex` and the computed value equals the reference's stored one bit for bit; over all 24 rows the two agree to 7.93e-15 relative."
        },
        "zmh_vaporPartialPressure": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zonemonthhour_rows"
          ],
          "description": "The Java's `PV`, kPa: MG-4 (Fahrenheit to Kelvin at the exact 5/9), MG-5 (the Goff-Gratch saturation pressure) and MG-6 (times the relative humidity as a fraction) composed in lib/meteorology.esm's `vapor_partial_pressure_from_weather`. BOTH humidity columns are built from it and neither is built from the other, which is why it is a variable here rather than two copies of one expression. It is the ONE part of the humidity chain that needs no county, so it lives on the 24-hour relation; the pressure has to be joined and lives on the run relation."
        },
        "stmy_modelYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
