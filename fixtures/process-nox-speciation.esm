            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.rt_shortModYrGroupID",
              "time": 0.0,
              "expected": 40.0,
              "coords": {
                "rate_rows": 1
              }
            },
            {
              "variable": "Onroad.rt_shortModYrGroupID",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
