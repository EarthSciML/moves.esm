        },
        "run_vaporPartialPressure": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "`PV` for the run's zone, month and hour, gathered off the 24-hour relation on the same three-column key the temperature and the heat index use."
        },
        "run_barometricPressure": {
          "type": "unknown",
          "units": "inHg",
          "shape": [
            "run_rows"
          ],
          "description": "`County.barometricPressure` for the run's county, inches of mercury. MOVES reaches it as ZoneMonthHour -> Zone -> County; this document has no `Zone` table and reaches it as run -> County on `run_countyID = cty_countyID`, which is the same last leg and the same key J30 already uses for `GPAFract`. That is why the two humidity columns are computed on the RUN relation and not, like the heat index, on the 24-hour one: the heat index needs no county and the humidities do, and a 24x1 contraction with no key would be the dropped join docs/meteorology-generator.md 3 measures at 48 wrong rows out of 72 on `expand-counties`."
        },
        "run_specificHumidity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The hour's specific humidity, g water per kg DRY air, COMPUTED by lib/meteorology.esm's `specific_humidity` (MG-7) rather than read off `ZoneMonthHour.specificHumidity`. Its denominator subtracts the vapour pressure from the ambient pressure because the air it measures against is dry; the mole fraction's does not, and that one term is the only difference between them.\n\nMeasured against the column it replaced: 10.053684062398 computed against 10.053684293477 stored, 2.298e-08 relative. That is the storage limit of the reference column, not this port's accuracy, and it is 870x below tolerance.toml's 2e-05 per-cell gate. It is also NOT zero, which is why this fixture -- with process-crankcase-running -- is one of only two of the nine whose output bytes move at all."
        },
        "run_molWaterFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The hour's water mole fraction, moles of water per mole of AMBIENT air, COMPUTED by lib/meteorology.esm's `mol_water_fraction` (MG-7). The CFR 1065 argument; the two humidity columns are different measures of the same air and each equation wants its own. Measured against the column it replaced: 0.015929058669 computed against 0.015929059029 stored, 2.262e-08 relative."
        },
        "run_gpaFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "county.GPAFract for the run's county, 0.0. Every fuel-effect blend's weight."
        },
        "fsu_fuelSubtypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "The supplied formulation's fuel subtype, hop one of two."
        },
        "fsu_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "The supplied formulation's FUEL TYPE, hop two. 0 for supply row 28001, whose subtype 30 has no `fuelsubtype` row -- and 0 matches no cohort, which is the drop."
        },
        "fsu_monthID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "The supplied formulation's month, resolved from its month GROUP so it can be compared with the run's month."
        },
        "fsu_isInCountyRegion": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "Does `regioncounty` place this supply row's region in the run's county? A `max`-semiring PRESENCE flag and not a join, because the pair (region, county) appears once per `regionCodeID` and joining it as a relation would match twice and double every market share (docs/esm-conventions.md 3)."
        },
        "fsu_matchesRun": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "Does this supply row's (fuel year, month) match the run's? Also a presence flag: `run_rows` has one row, so this is an equality test written as the join it is."
        },
        "fsu_isSupplied": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "In the county's region, in the run's fuel year and month. The mask every market-share weight is multiplied by."
        },
        "rt_modelYearGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The model-year GROUP `pollutantprocessmappedmodelyear` puts this rate row's model year in, FOR THIS ROW'S OWN pollutant-process. The species and their parent do not agree about it -- model year 1990 is group 1990 for 3201 and group 19881989 for 301 is not, but 1988 and 1989 are, and the 1994 boundary moves too -- which is why the group is a column of the rate relation and not of the cohort."
        },
        "rt_directSurvives": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Selected AND rated: what survival means for a pollutant-process that has rates of its own. Zero on all three species, whose polProcessID appears nowhere in `emissionratebyage`."
        },
        "rt_parentDirectSurvives": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Does the pollutant-process this row is CHAINED FROM survive on this same cohort? A self-join of the rate relation on (chained-from pollutant-process, cohort), the same pair `rtDay_quantChained` joins on. Zero on an unchained row, whose chain key is 0 and matches no polProcessID. This is a ONE-LEVEL chain, which is all MOVES asks of these two calculators; a species chained off a species would need its parent's survival resolved first."
        },
        "rt_hasChainRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Does `nono2ratio` carry a ratio for this species, source type, fuel type and model-year group? Zero for every fuel type 9 row, which is the whole reason the species blocks are 104 cohorts and the parent's is 124."
        },
        "rt_prefixSurvives": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The inclusive prefix count of `rt_survives` over the WHOLE pollutant-process-major rate relation (docs/esm-conventions.md 22). `process-refueling` ranks the same way for the same reason; `process-brakewear` could divide by a block length instead only because its three blocks were the same 125 cohorts. Counting across blocks numbers all 436 survivors 1..436 in one pass and the block boundaries fall wherever the mask puts them."
        },
        "rateSurvivorCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "How many (pollutant-process, cohort) pairs survive in total: 436, recomputed from the mask so `n_outputRate` is a CHECKED declaration rather than a transcription."
        },
        "rtSupply_criteriaRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "fuelsupply_rows"
          ],
          "description": "The GPA-blended criteria fuel effect for this rate row and this supplied formulation. Zero where `criteriaratio` has no row, which the flag beside it distinguishes from a genuine ratio of zero."
        },
        "rtSupply_hasCriteriaRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "fuelsupply_rows"
          ],
          "description": "Whether that lookup found anything. E85 model years 1998-2000 have no row, and neither do the three species, and both take no fuel effect rather than a zero one."
        },
        "rtSupply_factor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows",
            "fuelsupply_rows"
          ],
          "description": "The effect actually applied: the blended ratio where one exists, 1 where none does."
        },
        "rt_criteriaFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "S15's fuel effect, market-share weighted over the formulations the county supplies for this row's fuel type. adjust.rs:475-493 scales each per-formulation base rate by its own ratio and aggregate.rs:38 then sums `rate x marketShare`, so the factor a shared base rate can be multiplied by is the SHARE-WEIGHTED MEAN of the ratios -- one number per rate row, equal to the single ratio wherever a fuel type is supplied one formulation, and 1 on every pollutant-process `criteriaratio` does not carry."
        },
        "rt_isNoxTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Is this the TOTAL-NOx branch of `general_temp_adjust`? adjust.rs:127 gates it on pollutant 3 and process 1, 90 or 91 together. Two of those processes are not in this run and are named anyway, because the rule is the port and not the run; the three species are pollutants 32, 33 and 34 and take the fall-through instead."
        },
        "rt_isDiesel": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Diesel, which the NOx temperature term treats differently from every other fuel."
        },
        "rt_hasHumidityRow": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Does `noxhumidityadjust` carry a row for this fuel type? Fuel type 9 does not, and adjust.rs:521's `nha.map_or(1.0, ...)` is what this flag reproduces."
        },
        "rt_humidityCFR86": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The CFR 86 humidity correction, or 0 where the fuel's equation is not CFR 86. The equation is a TEXT column, so the branch is a filter on a decoded code and the two arms are separate aggregates -- which is also what keeps the CFR 86 rows' NULL `humidityTermB` out of the other arm's arithmetic."
        },
        "rt_humidityCFR1065": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The CFR 1065 humidity correction, or 0 where the fuel's equation is not CFR 1065."
        },
        "rt_noxHumidityFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "`calculate_nox_k`. Exactly one arm can be non-zero for a given fuel type, so their SUM is the selection; a fuel type with no row takes 1."
        },
        "rt_noxTemperatureAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The NOx branch's temperature term: `(77 - T) x A`, switched off above 77 degF, for diesel; the ordinary quadratic about 75 degF for everything else. Both coefficients are 0 for every model year this run emits, so the term is 0 and the whole NOx factor is the humidity correction -- which is why the humidity half is the half that has to be right."
        },
        "rt_standardTemperatureAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "`general_temp_adjust`'s fall-through term, the quadratic about 75 degF that every pollutant with no branch of its own takes. Its coefficients are 0 for all three species, so it evaluates to 0 and their factor is exactly 1."
        },
        "rt_temperatureFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "S15's temperature adjustment. For total NOx it is `(1 + tempAdjust) x k` -- the humidity correction MULTIPLIES the temperature factor rather than adding to it, which is the part a reader would not guess from the table names."
        },
        "outRateOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "Which surviving rate row this output row is, 1..436. The minor coordinate of the flat (day type, survivor) product, so it cannot disagree with the major one about where a block ends."
        }
      },
      "equations": [
