          "_comment": "J29: the A/C activity quadratic's three coefficients, on (monthGroupID via monthofanyyear, hourID).",
          "lhs": "run_acActivityTermA",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
