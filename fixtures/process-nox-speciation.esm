          "shape": [
            "run_rows"
          ],
          "description": "How many emitted rate rows arrive through the chain: 312, three species x 104 cohorts. A rate row can never carry both a ratio and a rate of its own here, which is what makes `rtDay_quant`'s sum a union."
        },
        "coh_isSelectedAt": {
