          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "second - 3. The three-second brake test needs the accelerations at s, s-1 and s-2, and an acceleration at s-2 needs the speed at s-3."
        },
        "dss_nextSecond": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "second + 1, read only by a schedule's first second, whose acceleration is a COPY of its successor's."
        },
        "dss_priorSpeed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
