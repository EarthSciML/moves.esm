            { "variable": "outSourceHours", "time": 0.0, "expected": 260.0573038920831, "coords": { "output_rows": 65 } },
            { "variable": "outNoOfRealDays", "time": 0.0, "expected": 2.0, "coords": { "output_rows": 1 } },
