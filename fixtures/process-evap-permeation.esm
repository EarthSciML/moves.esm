    },
    "evp_link": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__link.parquet" },
      "extent": { "metaparameter": "n_link" },
      "metadata": { "tags": ["scope"], "note": "1 row: link 2616104 in zone 261610 of county 26161, on road type 4. An ON-network road type, and A10 turns that one value into E1's ratio being exactly 1.", "esio_format": "parquet" }
    },
    "evp_county": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__county.parquet" },
      "extent": { "metaparameter": "n_county" },
      "reader_options": { "float_columns": ["GPAFract"] },
      "metadata": { "tags": ["scope", "fuel"], "note": "1 row, Washtenaw County. Two columns reach the answer: `stateID` = 26, which PC-6 reads here rather than deriving from the county id, and `GPAFract` = 0, which makes PC-3's geographic-phase-in blend return the ordinary fuel adjustment. The zero is READ, not assumed.", "esio_format": "parquet" }
    },
    "evp_sourcetypepolprocess": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__sourcetypepolprocess.parquet" },
      "extent": { "metaparameter": "n_sourcetypepolprocess" },
      "metadata": { "tags": ["cohorts"], "note": "1 row: source type 21, polProcessID 111, isRegClassReqd 'N'. THE per-process key rule (C2'). Y/N text through a `codes` map. In the process-evap-leaks snapshot the same table says 'Y' for polProcessID 113, and a chain that inherited that value emits 125 cohort keys that match nothing.", "esio_format": "parquet" }
    },
    "evp_averagetanktemperature": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__averagetanktemperature.parquet" },
      "extent": { "metaparameter": "n_averagetanktemperature" },
      "reader_options": { "float_columns": ["averageTankTemperature"] },
      "metadata": { "tags": ["temperature", "read-from-generator"], "note": "288 rows = 2 tank-temperature groups x 48 hour-days x 3 operating modes, all zone 261610 and month 8. THE ONE TABLE THIS FIXTURE READS RATHER THAN COMPUTES: it is TankTemperatureGenerator TTG-5's output, and docs/evap-permeation.md 8.1 records why. Of the 12 cells the run's two hour-days reach, the 8 soak cells (modes 150 and 151) enter PC-2b at an opModeFraction this document computes to be exactly 0, so only the 4 operating-mode cells are load-bearing; `tankTemperatureSoakWeight` asserts the zero and `cohDay_tempAdjustByMode` shows the soak cells are non-zero, which is docs/esm-conventions.md 23's corollary.", "esio_format": "parquet" }
    },
    "evp_temperatureadjustment": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__temperatureadjustment.parquet" },
      "extent": { "metaparameter": "n_temperatureadjustment" },
      "reader_options": { "float_columns": ["tempAdjustTermA", "tempAdjustTermB"] },
      "metadata": { "tags": ["temperature"], "note": "2 rows, polProcessID 111, one for fuel type 1 and one for fuel type 5, both with tempAdjustTermA 0.0625, tempAdjustTermB 0.0385 and model years [1950, 2060]. PC-2a's exponential. The SQL cross-joins this with AverageTankTemperature -- there is no ON clause -- and then expands across the model-year range, which this document applies as a filter on the cohort's own model year instead of materialising `modelyear`'s 111 rows.", "esio_format": "parquet" }
    },
    "evp_hcpermeationcoeff": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__hcpermeationcoeff.parquet" },
      "extent": { "metaparameter": "n_hcpermeationcoeff" },
      "reader_options": { "float_columns": ["fuelAdjustment", "fuelAdjustmentGPA"] },
      "metadata": { "tags": ["fuel"], "note": "120 rows, all polProcessID 111: 8 ethanol bins x 15 fuel model-year groups. PC-3's coefficient table.", "esio_format": "parquet" }
    },
    "evp_etohbin": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__etohbin.parquet" },
      "extent": { "metaparameter": "n_etohbin" },
      "reader_options": { "float_columns": ["etohThreshLow", "etohThreshHigh"] },
      "metadata": { "tags": ["fuel"], "note": "8 rows. The half-open ethanol-volume brackets PC-3 narrows the coefficient through: `etohThreshLow <= ETOHVolume < etohThreshHigh`. The bins are NOT in threshold order in the file (id 7 covers [12.5, 17.5), between ids 3 and 4), which is why the bracket is a test and not an index.", "esio_format": "parquet" }
    },
    "evp_fuelsupply": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__fuelsupply.parquet" },
      "extent": { "metaparameter": "n_fuelsupply" },
      "reader_options": { "float_columns": ["marketShare"] },
      "metadata": { "tags": ["fuel"], "note": "5 rows: formulations 90, 9114, 25003, 27002 and 28001 for fuel year 2020, month group 8. Every marketShare is 1.0, so this fixture tests that PC-3 sums OVER the supply and does not test the weighting at all (docs/evap-permeation.md 7.1).", "esio_format": "parquet" }
    },
    "evp_fuelformulation": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__fuelformulation.parquet" },
      "extent": { "metaparameter": "n_fuelformulation" },
      "reader_options": { "float_columns": ["ETOHVolume"] },
      "metadata": { "tags": ["fuel"], "note": "2158 rows, of which the five supplied ones matter. Two columns are read: fuelSubtypeID, which resolves the formulation to a fuel type, and ETOHVolume, which selects the ethanol bin. ETOHVolume is NULL nowhere in this file -- `suppliedEtohAbsentCount` measures that -- so the Processing section's opening `update FuelFormulation set ETOHVolume = 0 where ETOHVolume is null` is inert here and is still written, because an absent volume arrives as NaN and every half-open bracket test would then admit it.", "esio_format": "parquet" }
    },
    "evp_fuelsubtype": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__fuelsubtype.parquet" },
      "extent": { "metaparameter": "n_fuelsubtype" },
      "metadata": { "tags": ["fuel"], "note": "13 rows, subtype to fuel type. The INNER JOIN that drops formulation 28001, whose fuelSubtypeID 30 has no row here, so that supply row resolves to no fuel type and contributes to nothing.", "esio_format": "parquet" }
    },
    "evp_regclasssourcetypefraction": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__regclasssourcetypefraction.parquet" },
      "extent": { "metaparameter": "n_regclasssourcetypefraction" },
      "reader_options": { "float_columns": ["regClassFraction"] },
      "metadata": { "tags": ["rates"], "note": "125 rows: exactly one per (source type 21, fuel type, model year), regClassID 20, regClassFraction 1.0 on every one. PC-1b's WithRegClassID section splits the base rate onto regClassID by this fraction and PC-6 aggregates regClassID away again, so what survives is the SUM of the fractions -- which is why this document carries a total rather than a regulatory-class axis. On this fixture the two PC-1b sections are indistinguishable: every fraction is 1 and every selected cohort has a row.", "esio_format": "parquet" }
    },
    "evp_sourcetypemodelyeargroup": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__sourcetypemodelyeargroup.parquet" },
      "extent": { "metaparameter": "n_sourcetypemodelyeargroup" },
      "metadata": { "tags": ["temperature"], "note": "37 rows. (sourceTypeID, modelYearGroupID) to tankTemperatureGroupID: PC-6's gate, and what keeps source type 21's model-year group 19781995 on tank-temperature group 5 while 1996 and later are on group 3. Picking the wrong group is a wrong answer rather than a missing row -- 0.911 against 0.759 on the weekend adjustment.", "esio_format": "parquet" }
    },
    "evp_pollutantprocessmappedmodelyear": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__pollutantprocessmappedmodelyear.parquet" },
      "extent": { "metaparameter": "n_pollutantprocessmappedmodelyear" },
      "metadata": { "tags": ["fuel"], "note": "333 rows, polProcessID 111, 8611 and 8711. fuelMYGroupID to the model years it covers: the join that turns PC-3's 15 coefficient groups into a per-model-year adjustment. It is a DIFFERENT column from the modelYearGroupID beside it -- model year 1980 is fuel group 19751986 and model-year group 19781995 -- and joining on the wrong one admits nothing.", "esio_format": "parquet" }
    },
    "evp_movesoutput": {
      "kind": "static",
      "source": { "url_template": "../../moves.rs/characterization/snapshots/process-evap-permeation/tables/db__out_process_evap_permeation__movesoutput.parquet" },
      "extent": { "metaparameter": "n_movesoutput" },
      "metadata": { "tags": ["oracle", "expected-output"], "note": "The 128-row expected output: the other half of the comparison, shipped in the same snapshot. DECLARED AND CONSUMED BY NOTHING -- reading it would transcribe the answer, and its extent would transcribe the answer's shape. compare-output.py reads it directly under tolerance.toml.", "esio_format": "parquet" }
    }
  },

  "metaparameters": {
    "n_runspecyear": { "type": "integer", "default": 0, "description": "Rows in runspecyear. Runtime-discovered by `extent`, as every entry here is: a fixture that wrote the count would be asserting the snapshot's shape rather than measuring it, and a 0 that survives to evaluation is a build error rather than a small answer (docs/esm-conventions.md 11)." },
    "n_runspecmonth": { "type": "integer", "default": 0, "description": "Rows in runspecmonth." },
    "n_runspechour": { "type": "integer", "default": 0, "description": "Rows in runspechour." },
    "n_runspecday": { "type": "integer", "default": 0, "description": "Rows in runspecday. The SECOND factor of the activity axis and of the output axis." },
    "n_runspecsourcetype": { "type": "integer", "default": 0, "description": "Rows in runspecsourcetype." },
    "n_runspecroadtype": { "type": "integer", "default": 0, "description": "Rows in runspecroadtype." },
    "n_runspecsourcefueltype": { "type": "integer", "default": 0, "description": "Rows in runspecsourcefueltype. The second factor of the cohort axis." },
    "n_year": { "type": "integer", "default": 0, "description": "Rows in year." },
    "n_sourcetypeyear": { "type": "integer", "default": 0, "description": "Rows in sourcetypeyear." },
    "n_sourcetypeagedistribution": { "type": "integer", "default": 0, "description": "Rows in sourcetypeagedistribution." },
    "n_sourcetypeage": { "type": "integer", "default": 0, "description": "Rows in sourcetypeage." },
    "n_sourceusetype": { "type": "integer", "default": 0, "description": "Rows in sourceusetype." },
    "n_hpmsvtypeyear": { "type": "integer", "default": 0, "description": "Rows in hpmsvtypeyear." },
    "n_roadtypedistribution": { "type": "integer", "default": 0, "description": "Rows in roadtypedistribution." },
    "n_roadtype": { "type": "integer", "default": 0, "description": "Rows in roadtype." },
    "n_monthvmtfraction": { "type": "integer", "default": 0, "description": "Rows in monthvmtfraction." },
    "n_dayvmtfraction": { "type": "integer", "default": 0, "description": "Rows in dayvmtfraction." },
    "n_hourvmtfraction": { "type": "integer", "default": 0, "description": "Rows in hourvmtfraction." },
    "n_monthofanyyear": { "type": "integer", "default": 0, "description": "Rows in monthofanyyear." },
    "n_avgspeedbin": { "type": "integer", "default": 0, "description": "Rows in avgspeedbin." },
    "n_avgspeeddistribution": { "type": "integer", "default": 0, "description": "Rows in avgspeeddistribution." },
    "n_zoneroadtype": { "type": "integer", "default": 0, "description": "Rows in zoneroadtype." },
    "n_samplevehiclepopulation": { "type": "integer", "default": 0, "description": "Rows in samplevehiclepopulation." },
    "n_pollutantprocessmodelyear": { "type": "integer", "default": 0, "description": "Rows in pollutantprocessmodelyear." },
    "n_modelyeargroup": { "type": "integer", "default": 0, "description": "Rows in modelyeargroup." },
    "n_sourcebin": { "type": "integer", "default": 0, "description": "Rows in sourcebin." },
    "n_fuelusagefraction": { "type": "integer", "default": 0, "description": "Rows in fuelusagefraction." },
    "n_emissionratebyage": { "type": "integer", "default": 0, "description": "Rows in emissionratebyage. 968 here against the leaks slice's 6,564, because this process's rate table carries one operating mode where that one carries three." },
    "n_agecategory": { "type": "integer", "default": 0, "description": "Rows in agecategory. The FIRST factor of both derived axes." },
    "n_soakactivityfraction": { "type": "integer", "default": 0, "description": "Rows in soakactivityfraction." },
    "n_opmodepolprocassoc": { "type": "integer", "default": 0, "description": "Rows in opmodepolprocassoc." },
    "n_pollutantprocessassoc": { "type": "integer", "default": 0, "description": "Rows in pollutantprocessassoc." },
    "n_fueltype": { "type": "integer", "default": 0, "description": "Rows in fueltype." },
    "n_hourday": { "type": "integer", "default": 0, "description": "Rows in hourday." },
    "n_dayofanyweek": { "type": "integer", "default": 0, "description": "Rows in dayofanyweek." },
    "n_link": { "type": "integer", "default": 0, "description": "Rows in link." },
    "n_county": { "type": "integer", "default": 0, "description": "Rows in county." },
    "n_sourcetypepolprocess": { "type": "integer", "default": 0, "description": "Rows in sourcetypepolprocess." },
    "n_averagetanktemperature": { "type": "integer", "default": 0, "description": "Rows in averagetanktemperature: the one generator output this document reads." },
    "n_temperatureadjustment": { "type": "integer", "default": 0, "description": "Rows in temperatureadjustment." },
    "n_hcpermeationcoeff": { "type": "integer", "default": 0, "description": "Rows in hcpermeationcoeff." },
    "n_etohbin": { "type": "integer", "default": 0, "description": "Rows in etohbin." },
    "n_fuelsupply": { "type": "integer", "default": 0, "description": "Rows in fuelsupply." },
    "n_fuelformulation": { "type": "integer", "default": 0, "description": "Rows in fuelformulation." },
    "n_fuelsubtype": { "type": "integer", "default": 0, "description": "Rows in fuelsubtype." },
    "n_regclasssourcetypefraction": { "type": "integer", "default": 0, "description": "Rows in regclasssourcetypefraction." },
    "n_sourcetypemodelyeargroup": { "type": "integer", "default": 0, "description": "Rows in sourcetypemodelyeargroup." },
    "n_pollutantprocessmappedmodelyear": { "type": "integer", "default": 0, "description": "Rows in pollutantprocessmappedmodelyear." },
    "n_movesoutput": { "type": "integer", "default": 0, "description": "Rows in the expected MOVESOutput. Declared so the file is version-controlled beside the inputs; nothing reads it." },
    "n_outputCohort": { "type": "integer", "default": 64, "description": "THE ONE DECLARED NUMBER IN THIS DOCUMENT: how many (fuelTypeID, modelYearID) cohorts reach MOVESOutput. 64 = 41 gasoline model years, 1980-2020, which is n_agecategory of them, plus 23 E85, 1998-2020. Which cohorts survive is a RESULT of the chain -- C2's `stmyFraction > 0` and the absence of any emissionratebyage row for a diesel or electricity bin -- and materialising them as an index set is finding F5's value invention, which validates and materialises empty. So it is declared, and `cohortSurvivorCount` below computes the same number from the chain so that a test pins the two together." }
  },

  "index_sets": {
    "runspecyear_rows": { "kind": "interval", "size": "n_runspecyear" },
    "runspecmonth_rows": { "kind": "interval", "size": "n_runspecmonth" },
    "runspechour_rows": { "kind": "interval", "size": "n_runspechour" },
    "runspecday_rows": { "kind": "interval", "size": "n_runspecday" },
    "runspecsourcetype_rows": { "kind": "interval", "size": "n_runspecsourcetype" },
    "runspecroadtype_rows": { "kind": "interval", "size": "n_runspecroadtype" },
    "runspecsourcefueltype_rows": { "kind": "interval", "size": "n_runspecsourcefueltype" },
    "year_rows": { "kind": "interval", "size": "n_year" },
    "sourcetypeyear_rows": { "kind": "interval", "size": "n_sourcetypeyear" },
    "sourcetypeagedistribution_rows": { "kind": "interval", "size": "n_sourcetypeagedistribution" },
