  },

  "enums": {
    "pollutant": { "TotalGaseousHydrocarbons": 1 },
    "process": { "EvapPermeation": 11 },
    "road_type": { "OffNetwork": 1, "UrbanRestrictedAccess": 4 },
    "operating_mode": { "HotSoaking": 150, "ColdSoaking": 151, "Operating": 300 }
  },

  "models": {
    "EvapPermeationFixture": {
      "expression_template_imports": [
        { "ref": "../lib/evaporative.esm",
          "only": ["operating_share_of_activity", "soak_share", "tank_temperature_adjustment"] },
        { "ref": "../lib/onroad_activity.esm",
          "only": ["weeks_per_month", "share_of_group", "onroad_scc"] },
        { "ref": "../lib/adjustments.esm", "only": ["gpa_blend"] },
        { "ref": "../lib/drive_cycle.esm", "only": ["in_half_open_range"] },
        { "ref": "../lib/keys.esm",
          "only": ["in_inclusive_range", "model_year_in_range",
                   "flat_relation_block_index", "flat_relation_major", "flat_relation_minor"] },
        { "ref": "../lib/identifiers.esm",
          "only": ["pol_process_id", "null_output_column", "output_column_is_absent"] }
      ],

      "tolerance": { "rel": 1e-12 },

      "variables": {
        "rsy_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecyear_rows"], "description": "runspecyear.yearID.", "update": { "kind": "data", "source": "evp_runspecyear", "from": { "file_variable": "yearID" } } },
        "rsm_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecmonth_rows"], "description": "runspecmonth.monthID.", "update": { "kind": "data", "source": "evp_runspecmonth", "from": { "file_variable": "monthID" } } },
        "rsh_hourID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspechour_rows"], "description": "runspechour.hourID.", "update": { "kind": "data", "source": "evp_runspechour", "from": { "file_variable": "hourID" } } },
        "rsd_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecday_rows"], "description": "runspecday.dayID, in file order, which the activity and output ordinals index.", "update": { "kind": "data", "source": "evp_runspecday", "from": { "file_variable": "dayID" } } },
        "rst_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecsourcetype_rows"], "description": "runspecsourcetype.sourceTypeID.", "update": { "kind": "data", "source": "evp_runspecsourcetype", "from": { "file_variable": "sourceTypeID" } } },
        "rsr_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecroadtype_rows"], "description": "runspecroadtype.roadTypeID.", "update": { "kind": "data", "source": "evp_runspecroadtype", "from": { "file_variable": "roadTypeID" } } },
        "rsft_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecsourcefueltype_rows"], "description": "runspecsourcefueltype.fuelTypeID, in file order: the cohort relation's fuel ordinal indexes this column.", "update": { "kind": "data", "source": "evp_runspecsourcefueltype", "from": { "file_variable": "fuelTypeID" } } },
        "rsft_ordinal": { "type": "unknown", "shape": ["runspecsourcefueltype_rows"], "description": "The runspecsourcefueltype relation's own row ordinal, 1..4, so that the cohort relation joins to it by position." },

        "yr_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["year_rows"], "description": "year.yearID.", "update": { "kind": "data", "source": "evp_year", "from": { "file_variable": "yearID" } } },
        "yr_fuelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["year_rows"], "description": "year.fuelYearID: C4's scope key, and the column PC-3's and PC-4's `INNER JOIN Year` existence checks run through.", "update": { "kind": "data", "source": "evp_year", "from": { "file_variable": "fuelYearID" } } },
        "yr_isBaseYear": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["year_rows"], "description": "year.isBaseYear, decoded Y to 1 and N to 0 by a `codes` map (esm-spec 8.9.1) -- a text column is a hard error at the ingest boundary without one.", "update": { "kind": "data", "source": "evp_year", "from": { "file_variable": "isBaseYear", "codes": { "map": { "Y": 1, "N": 0 }, "case_insensitive": true } } } },

        "sty_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeyear_rows"], "description": "sourcetypeyear.yearID.", "update": { "kind": "data", "source": "evp_sourcetypeyear", "from": { "file_variable": "yearID" } } },
        "sty_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeyear_rows"], "description": "sourcetypeyear.sourceTypeID.", "update": { "kind": "data", "source": "evp_sourcetypeyear", "from": { "file_variable": "sourceTypeID" } } },
        "sty_sourceTypePopulation": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeyear_rows"], "description": "sourcetypeyear.sourceTypePopulation, decimal text in the file. A2's population before the age split.", "update": { "kind": "data", "source": "evp_sourcetypeyear", "from": { "file_variable": "sourceTypePopulation" } } },

        "stad_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeagedistribution_rows"], "description": "sourcetypeagedistribution.sourceTypeID.", "update": { "kind": "data", "source": "evp_sourcetypeagedistribution", "from": { "file_variable": "sourceTypeID" } } },
        "stad_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeagedistribution_rows"], "description": "sourcetypeagedistribution.yearID.", "update": { "kind": "data", "source": "evp_sourcetypeagedistribution", "from": { "file_variable": "yearID" } } },
        "stad_ageID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeagedistribution_rows"], "description": "sourcetypeagedistribution.ageID.", "update": { "kind": "data", "source": "evp_sourcetypeagedistribution", "from": { "file_variable": "ageID" } } },
        "stad_ageFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeagedistribution_rows"], "description": "sourcetypeagedistribution.ageFraction.", "update": { "kind": "data", "source": "evp_sourcetypeagedistribution", "from": { "file_variable": "ageFraction" } } },

        "sta_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeage_rows"], "description": "sourcetypeage.sourceTypeID.", "update": { "kind": "data", "source": "evp_sourcetypeage", "from": { "file_variable": "sourceTypeID" } } },
        "sta_ageID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeage_rows"], "description": "sourcetypeage.ageID.", "update": { "kind": "data", "source": "evp_sourcetypeage", "from": { "file_variable": "ageID" } } },
        "sta_relativeMAR": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeage_rows"], "description": "sourcetypeage.relativeMAR: how far a vehicle of this age drives relative to the fleet.", "update": { "kind": "data", "source": "evp_sourcetypeage", "from": { "file_variable": "relativeMAR" } } },

        "sut_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourceusetype_rows"], "description": "sourceusetype.sourceTypeID.", "update": { "kind": "data", "source": "evp_sourceusetype", "from": { "file_variable": "sourceTypeID" } } },
        "sut_HPMSVtypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourceusetype_rows"], "description": "sourceusetype.HPMSVtypeID: A3's normalisation group.", "update": { "kind": "data", "source": "evp_sourceusetype", "from": { "file_variable": "HPMSVtypeID" } } },

        "hvy_HPMSVtypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hpmsvtypeyear_rows"], "description": "hpmsvtypeyear.HPMSVtypeID.", "update": { "kind": "data", "source": "evp_hpmsvtypeyear", "from": { "file_variable": "HPMSVtypeID" } } },
        "hvy_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hpmsvtypeyear_rows"], "description": "hpmsvtypeyear.yearID.", "update": { "kind": "data", "source": "evp_hpmsvtypeyear", "from": { "file_variable": "yearID" } } },
        "hvy_HPMSBaseYearVMT": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hpmsvtypeyear_rows"], "description": "hpmsvtypeyear.HPMSBaseYearVMT: A4, national annual vehicle-miles.", "update": { "kind": "data", "source": "evp_hpmsvtypeyear", "from": { "file_variable": "HPMSBaseYearVMT" } } },

        "rtd_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtypedistribution_rows"], "description": "roadtypedistribution.sourceTypeID.", "update": { "kind": "data", "source": "evp_roadtypedistribution", "from": { "file_variable": "sourceTypeID" } } },
        "rtd_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtypedistribution_rows"], "description": "roadtypedistribution.roadTypeID.", "update": { "kind": "data", "source": "evp_roadtypedistribution", "from": { "file_variable": "roadTypeID" } } },
        "rtd_roadTypeVMTFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtypedistribution_rows"], "description": "roadtypedistribution.roadTypeVMTFraction: A5's road-type share.", "update": { "kind": "data", "source": "evp_roadtypedistribution", "from": { "file_variable": "roadTypeVMTFraction" } } },

        "rt_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtype_rows"], "description": "roadtype.roadTypeID.", "update": { "kind": "data", "source": "evp_roadtype", "from": { "file_variable": "roadTypeID" } } },
        "rt_isAffectedByOnroad": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtype_rows"], "description": "roadtype.isAffectedByOnroad: the gate that keeps roadTypeID 100, the NONROAD pseudo-road-type, out of A5.", "update": { "kind": "data", "source": "evp_roadtype", "from": { "file_variable": "isAffectedByOnroad" } } },

        "mvf_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthvmtfraction_rows"], "description": "monthvmtfraction.sourceTypeID.", "update": { "kind": "data", "source": "evp_monthvmtfraction", "from": { "file_variable": "sourceTypeID" } } },
        "mvf_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthvmtfraction_rows"], "description": "monthvmtfraction.monthID.", "update": { "kind": "data", "source": "evp_monthvmtfraction", "from": { "file_variable": "monthID" } } },
        "mvf_monthVMTFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthvmtfraction_rows"], "description": "monthvmtfraction.monthVMTFraction.", "update": { "kind": "data", "source": "evp_monthvmtfraction", "from": { "file_variable": "monthVMTFraction" } } },

        "dvf_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.sourceTypeID.", "update": { "kind": "data", "source": "evp_dayvmtfraction", "from": { "file_variable": "sourceTypeID" } } },
        "dvf_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.monthID.", "update": { "kind": "data", "source": "evp_dayvmtfraction", "from": { "file_variable": "monthID" } } },
        "dvf_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.roadTypeID.", "update": { "kind": "data", "source": "evp_dayvmtfraction", "from": { "file_variable": "roadTypeID" } } },
        "dvf_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.dayID.", "update": { "kind": "data", "source": "evp_dayvmtfraction", "from": { "file_variable": "dayID" } } },
        "dvf_dayVMTFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.dayVMTFraction: a share of the MONTH's vehicle-miles.", "update": { "kind": "data", "source": "evp_dayvmtfraction", "from": { "file_variable": "dayVMTFraction" } } },

        "hvf_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.sourceTypeID.", "update": { "kind": "data", "source": "evp_hourvmtfraction", "from": { "file_variable": "sourceTypeID" } } },
        "hvf_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.roadTypeID.", "update": { "kind": "data", "source": "evp_hourvmtfraction", "from": { "file_variable": "roadTypeID" } } },
        "hvf_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.dayID.", "update": { "kind": "data", "source": "evp_hourvmtfraction", "from": { "file_variable": "dayID" } } },
        "hvf_hourID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.hourID.", "update": { "kind": "data", "source": "evp_hourvmtfraction", "from": { "file_variable": "hourID" } } },
        "hvf_hourVMTFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.hourVMTFraction: a share of that day type's own 24 hours.", "update": { "kind": "data", "source": "evp_hourvmtfraction", "from": { "file_variable": "hourVMTFraction" } } },

        "moy_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthofanyyear_rows"], "description": "monthofanyyear.monthID.", "update": { "kind": "data", "source": "evp_monthofanyyear", "from": { "file_variable": "monthID" } } },
        "moy_noOfDays": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthofanyyear_rows"], "description": "monthofanyyear.noOfDays: 31 for August, the input to A7's divisor.", "update": { "kind": "data", "source": "evp_monthofanyyear", "from": { "file_variable": "noOfDays" } } },

        "asb_avgSpeedBinID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeedbin_rows"], "description": "avgspeedbin.avgSpeedBinID.", "update": { "kind": "data", "source": "evp_avgspeedbin", "from": { "file_variable": "avgSpeedBinID" } } },
        "asb_avgBinSpeed": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeedbin_rows"], "description": "avgspeedbin.avgBinSpeed, in miles per hour. `mi h-1` is not a registry unit, so the unit is named here and not declared.", "update": { "kind": "data", "source": "evp_avgspeedbin", "from": { "file_variable": "avgBinSpeed" } } },

        "asd_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.sourceTypeID.", "update": { "kind": "data", "source": "evp_avgspeeddistribution", "from": { "file_variable": "sourceTypeID" } } },
        "asd_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.roadTypeID.", "update": { "kind": "data", "source": "evp_avgspeeddistribution", "from": { "file_variable": "roadTypeID" } } },
        "asd_hourDayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.hourDayID.", "update": { "kind": "data", "source": "evp_avgspeeddistribution", "from": { "file_variable": "hourDayID" } } },
        "asd_avgSpeedBinID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.avgSpeedBinID.", "update": { "kind": "data", "source": "evp_avgspeeddistribution", "from": { "file_variable": "avgSpeedBinID" } } },
        "asd_avgSpeedFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.avgSpeedFraction. A6 sums fraction x binSpeed: the ARITHMETIC mean.", "update": { "kind": "data", "source": "evp_avgspeeddistribution", "from": { "file_variable": "avgSpeedFraction" } } },

        "zrt_zoneID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["zoneroadtype_rows"], "description": "zoneroadtype.zoneID.", "update": { "kind": "data", "source": "evp_zoneroadtype", "from": { "file_variable": "zoneID" } } },
        "zrt_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["zoneroadtype_rows"], "description": "zoneroadtype.roadTypeID.", "update": { "kind": "data", "source": "evp_zoneroadtype", "from": { "file_variable": "roadTypeID" } } },
        "zrt_SHOAllocFactor": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["zoneroadtype_rows"], "description": "zoneroadtype.SHOAllocFactor: A9.", "update": { "kind": "data", "source": "evp_zoneroadtype", "from": { "file_variable": "SHOAllocFactor" } } },

        "svp_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.sourceTypeID.", "update": { "kind": "data", "source": "evp_samplevehiclepopulation", "from": { "file_variable": "sourceTypeID" } } },
        "svp_modelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.modelYearID.", "update": { "kind": "data", "source": "evp_samplevehiclepopulation", "from": { "file_variable": "modelYearID" } } },
        "svp_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.fuelTypeID.", "update": { "kind": "data", "source": "evp_samplevehiclepopulation", "from": { "file_variable": "fuelTypeID" } } },
        "svp_engTechID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.engTechID: 1 for conventional internal combustion, 30 for electric drive.", "update": { "kind": "data", "source": "evp_samplevehiclepopulation", "from": { "file_variable": "engTechID" } } },
        "svp_regClassID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.regClassID: 20 throughout for passenger cars. This process's bin key DISCARDS it -- see coh_binRegClassID.", "update": { "kind": "data", "source": "evp_samplevehiclepopulation", "from": { "file_variable": "regClassID" } } },
        "svp_stmyFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.stmyFraction. C2's row rule is `> 0` on this column and it is what makes the output key set ragged.", "update": { "kind": "data", "source": "evp_samplevehiclepopulation", "from": { "file_variable": "stmyFraction" } } },

        "ppmy_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmodelyear_rows"], "description": "pollutantprocessmodelyear.polProcessID.", "update": { "kind": "data", "source": "evp_pollutantprocessmodelyear", "from": { "file_variable": "polProcessID" } } },
        "ppmy_modelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmodelyear_rows"], "description": "pollutantprocessmodelyear.modelYearID.", "update": { "kind": "data", "source": "evp_pollutantprocessmodelyear", "from": { "file_variable": "modelYearID" } } },
        "ppmy_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmodelyear_rows"], "description": "pollutantprocessmodelyear.modelYearGroupID: 19781995 for model year 1980, 1996 for 1996. The adjacent fuelMYGroupID is a DIFFERENT mapping and PC-3 uses that one instead.", "update": { "kind": "data", "source": "evp_pollutantprocessmodelyear", "from": { "file_variable": "modelYearGroupID" } } },

        "myg_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["modelyeargroup_rows"], "description": "modelyeargroup.modelYearGroupID.", "update": { "kind": "data", "source": "evp_modelyeargroup", "from": { "file_variable": "modelYearGroupID" } } },
        "myg_shortModYrGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["modelyeargroup_rows"], "description": "modelyeargroup.shortModYrGroupID. Read for C2's existence chain; no document here builds a packed source-bin id.", "update": { "kind": "data", "source": "evp_modelyeargroup", "from": { "file_variable": "shortModYrGroupID" } } },

        "sb_sourceBinID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.sourceBinID, about 1.01e18. Exact in binary64 because every id ends in 1e10; the join is on it and no arithmetic touches it (finding F18).", "update": { "kind": "data", "source": "evp_sourcebin", "from": { "file_variable": "sourceBinID" } } },
        "sb_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.fuelTypeID.", "update": { "kind": "data", "source": "evp_sourcebin", "from": { "file_variable": "fuelTypeID" } } },
        "sb_engTechID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.engTechID.", "update": { "kind": "data", "source": "evp_sourcebin", "from": { "file_variable": "engTechID" } } },
        "sb_regClassID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.regClassID: 0 on all 80 rows of THIS snapshot, and 20 on all 80 of the leaks snapshot's. The bin's dimensions are per (sourceTypeID, polProcessID), which is C2'.", "update": { "kind": "data", "source": "evp_sourcebin", "from": { "file_variable": "regClassID" } } },
        "sb_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.modelYearGroupID: the FULL group code, not the short one packed into the id.", "update": { "kind": "data", "source": "evp_sourcebin", "from": { "file_variable": "modelYearGroupID" } } },
        "sb_engSizeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.engSizeID: 0 on every onroad bin. Read so that `sourceBinZeroSlotCount` can prove it, because C4's equipped-to-used match includes it and this document's cohort relation does not carry it.", "update": { "kind": "data", "source": "evp_sourcebin", "from": { "file_variable": "engSizeID" } } },
        "sb_weightClassID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.weightClassID: 0 on every onroad bin, for the same reason.", "update": { "kind": "data", "source": "evp_sourcebin", "from": { "file_variable": "weightClassID" } } },

        "fuf_countyID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.countyID.", "update": { "kind": "data", "source": "evp_fuelusagefraction", "from": { "file_variable": "countyID" } } },
        "fuf_fuelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.fuelYearID.", "update": { "kind": "data", "source": "evp_fuelusagefraction", "from": { "file_variable": "fuelYearID" } } },
        "fuf_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.modelYearGroupID: 0 on all five rows, which is the WILDCARD. `fuelUsageWildcardCount` proves it, which is what licenses this document implementing the wildcard branch alone.", "update": { "kind": "data", "source": "evp_fuelusagefraction", "from": { "file_variable": "modelYearGroupID" } } },
        "fuf_sourceBinFuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.sourceBinFuelTypeID: the fuel the vehicle is EQUIPPED for.", "update": { "kind": "data", "source": "evp_fuelusagefraction", "from": { "file_variable": "sourceBinFuelTypeID" } } },
        "fuf_fuelSupplyFuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.fuelSupplyFuelTypeID: the fuel it actually BURNS.", "update": { "kind": "data", "source": "evp_fuelusagefraction", "from": { "file_variable": "fuelSupplyFuelTypeID" } } },
        "fuf_usageFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.usageFraction: 0.982134 of E85-equipped activity onto gasoline, 0.017866 staying, 1 on the three identity pairs.", "update": { "kind": "data", "source": "evp_fuelusagefraction", "from": { "file_variable": "usageFraction" } } },

        "era_sourceBinID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.sourceBinID, packed.", "update": { "kind": "data", "source": "evp_emissionratebyage", "from": { "file_variable": "sourceBinID" } } },
        "era_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.polProcessID: 111 on all 968 rows of this extract, and joined on anyway so that a wider extract needs no new join.", "update": { "kind": "data", "source": "evp_emissionratebyage", "from": { "file_variable": "polProcessID" } } },
        "era_opModeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.opModeID: 300 on every row here. PC-1b does NOT join on it, so this column is read only to measure that (`rateNonOperatingRowCount`) rather than to key on.", "update": { "kind": "data", "source": "evp_emissionratebyage", "from": { "file_variable": "opModeID" } } },
        "era_ageGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.ageGroupID: seven values per bin. PC-1a's tag picks the one containing the cohort's age.", "update": { "kind": "data", "source": "evp_emissionratebyage", "from": { "file_variable": "ageGroupID" } } },
        "era_meanBaseRate": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.meanBaseRate, grams of THC per hour. THE base rate of this slice, and a default-database INPUT table.", "update": { "kind": "data", "source": "evp_emissionratebyage", "from": { "file_variable": "meanBaseRate" } } },

        "ac_ageID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["agecategory_rows"], "description": "agecategory.ageID, 0 to 40 in file order.", "update": { "kind": "data", "source": "evp_agecategory", "from": { "file_variable": "ageID" } } },
        "ac_ageGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["agecategory_rows"], "description": "agecategory.ageGroupID: seven groups over the 41 ages, each id a concatenated range (3, 405, 607, 809, 1014, 1519, 2099) and not a number to do arithmetic on.", "update": { "kind": "data", "source": "evp_agecategory", "from": { "file_variable": "ageGroupID" } } },
        "ac_ordinal": { "type": "unknown", "shape": ["agecategory_rows"], "description": "The agecategory relation's own row ordinal, 1..41, so the derived relations join to it by position rather than by assuming the file's ageID order." },

        "saf_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.sourceTypeID.", "update": { "kind": "data", "source": "evp_soakactivityfraction", "from": { "file_variable": "sourceTypeID" } } },
        "saf_zoneID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.zoneID.", "update": { "kind": "data", "source": "evp_soakactivityfraction", "from": { "file_variable": "zoneID" } } },
        "saf_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.monthID.", "update": { "kind": "data", "source": "evp_soakactivityfraction", "from": { "file_variable": "monthID" } } },
        "saf_hourDayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.hourDayID.", "update": { "kind": "data", "source": "evp_soakactivityfraction", "from": { "file_variable": "hourDayID" } } },
        "saf_opModeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.opModeID: 150 and 151 only -- the table carries no operating mode 300, which is why E3's residual row exists at all.", "update": { "kind": "data", "source": "evp_soakactivityfraction", "from": { "file_variable": "opModeID" } } },
        "saf_soakActivityFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.soakActivityFraction: 0.00668717 and 0.993313 at hourDayID 72, 0.0221274 and 0.977873 at 75.", "update": { "kind": "data", "source": "evp_soakactivityfraction", "from": { "file_variable": "soakActivityFraction" } } },

        "omppa_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["opmodepolprocassoc_rows"], "description": "opmodepolprocassoc.polProcessID: 111 on three rows and -1 on the other 24.", "update": { "kind": "data", "source": "evp_opmodepolprocassoc", "from": { "file_variable": "polProcessID" } } },
        "omppa_opModeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["opmodepolprocassoc_rows"], "description": "opmodepolprocassoc.opModeID. E2's admission filter.", "update": { "kind": "data", "source": "evp_opmodepolprocassoc", "from": { "file_variable": "opModeID" } } },

        "ppa_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessassoc_rows"], "description": "pollutantprocessassoc.polProcessID.", "update": { "kind": "data", "source": "evp_pollutantprocessassoc", "from": { "file_variable": "polProcessID" } } },
        "ppa_processID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessassoc_rows"], "description": "pollutantprocessassoc.processID: PC-6's split, and the last two digits of the output SCC.", "update": { "kind": "data", "source": "evp_pollutantprocessassoc", "from": { "file_variable": "processID" } } },
        "ppa_pollutantID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessassoc_rows"], "description": "pollutantprocessassoc.pollutantID.", "update": { "kind": "data", "source": "evp_pollutantprocessassoc", "from": { "file_variable": "pollutantID" } } },

        "ft_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fueltype_rows"], "description": "fueltype.fuelTypeID.", "update": { "kind": "data", "source": "evp_fueltype", "from": { "file_variable": "fuelTypeID" } } },
        "ft_subjectToEvapCalculations": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fueltype_rows"], "description": "fueltype.subjectToEvapCalculations, Y/N text decoded through a `codes` map: 1 for gasoline and E85, 0 for diesel and electricity.", "update": { "kind": "data", "source": "evp_fueltype", "from": { "file_variable": "subjectToEvapCalculations", "codes": { "map": { "Y": 1, "N": 0 }, "case_insensitive": true } } } },

        "hd_hourDayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourday_rows"], "description": "hourday.hourDayID.", "update": { "kind": "data", "source": "evp_hourday", "from": { "file_variable": "hourDayID" } } },
        "hd_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourday_rows"], "description": "hourday.dayID.", "update": { "kind": "data", "source": "evp_hourday", "from": { "file_variable": "dayID" } } },
        "hd_hourID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourday_rows"], "description": "hourday.hourID.", "update": { "kind": "data", "source": "evp_hourday", "from": { "file_variable": "hourID" } } },

        "dow_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayofanyweek_rows"], "description": "dayofanyweek.dayID.", "update": { "kind": "data", "source": "evp_dayofanyweek", "from": { "file_variable": "dayID" } } },
        "dow_noOfRealDays": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayofanyweek_rows"], "description": "dayofanyweek.noOfRealDays: 2 and 5. PC-5's divisor, and the factor A7 multiplied in.", "update": { "kind": "data", "source": "evp_dayofanyweek", "from": { "file_variable": "noOfRealDays" } } },

        "lnk_linkID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["link_rows"], "description": "link.linkID.", "update": { "kind": "data", "source": "evp_link", "from": { "file_variable": "linkID" } } },
        "lnk_countyID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["link_rows"], "description": "link.countyID.", "update": { "kind": "data", "source": "evp_link", "from": { "file_variable": "countyID" } } },
        "lnk_zoneID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["link_rows"], "description": "link.zoneID: A9's, E2's and PC-2b's spatial key.", "update": { "kind": "data", "source": "evp_link", "from": { "file_variable": "zoneID" } } },
        "lnk_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["link_rows"], "description": "link.roadTypeID = 4. A10 turns this one value into the whole slice's operating-mode distribution.", "update": { "kind": "data", "source": "evp_link", "from": { "file_variable": "roadTypeID" } } },

        "cty_countyID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["county_rows"], "description": "county.countyID.", "update": { "kind": "data", "source": "evp_county", "from": { "file_variable": "countyID" } } },
        "cty_stateID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["county_rows"], "description": "county.stateID = 26. PC-6 reads the output row's state from this column; fixtures/nr-logging-county.esm derives it as floor(countyID / 1000) because its chain has no County table, and the two agree here.", "update": { "kind": "data", "source": "evp_county", "from": { "file_variable": "stateID" } } },
        "cty_GPAFract": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["county_rows"], "description": "county.GPAFract = 0 for Washtenaw County: PC-3's geographic-phase-in weight. Read rather than assumed, and measured by `run_gpaFraction`, because at 0 the blend returns the ordinary fuelAdjustment and the GPA column is never tested (docs/evap-permeation.md 7.1).", "update": { "kind": "data", "source": "evp_county", "from": { "file_variable": "GPAFract" } } },

        "stpp_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypepolprocess_rows"], "description": "sourcetypepolprocess.sourceTypeID.", "update": { "kind": "data", "source": "evp_sourcetypepolprocess", "from": { "file_variable": "sourceTypeID" } } },
        "stpp_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypepolprocess_rows"], "description": "sourcetypepolprocess.polProcessID.", "update": { "kind": "data", "source": "evp_sourcetypepolprocess", "from": { "file_variable": "polProcessID" } } },
        "stpp_isRegClassReqd": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypepolprocess_rows"], "description": "sourcetypepolprocess.isRegClassReqd, Y/N text through a `codes` map. C2': 'N' here, 'Y' in the leaks and vapour-venting snapshots, and it decides every source-bin key in the run.", "update": { "kind": "data", "source": "evp_sourcetypepolprocess", "from": { "file_variable": "isRegClassReqd", "codes": { "map": { "Y": 1, "N": 0 }, "case_insensitive": true } } } },

        "att_tankTemperatureGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["averagetanktemperature_rows"], "description": "averagetanktemperature.tankTemperatureGroupID: 3 and 5.", "update": { "kind": "data", "source": "evp_averagetanktemperature", "from": { "file_variable": "tankTemperatureGroupID" } } },
        "att_zoneID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["averagetanktemperature_rows"], "description": "averagetanktemperature.zoneID.", "update": { "kind": "data", "source": "evp_averagetanktemperature", "from": { "file_variable": "zoneID" } } },
        "att_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["averagetanktemperature_rows"], "description": "averagetanktemperature.monthID.", "update": { "kind": "data", "source": "evp_averagetanktemperature", "from": { "file_variable": "monthID" } } },
        "att_hourDayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["averagetanktemperature_rows"], "description": "averagetanktemperature.hourDayID: all 48, of which this run reaches 72 and 75.", "update": { "kind": "data", "source": "evp_averagetanktemperature", "from": { "file_variable": "hourDayID" } } },
        "att_opModeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["averagetanktemperature_rows"], "description": "averagetanktemperature.opModeID: 150 hot soaking, 151 cold soaking, 300 all running.", "update": { "kind": "data", "source": "evp_averagetanktemperature", "from": { "file_variable": "opModeID" } } },
        "att_averageTankTemperature": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["averagetanktemperature_rows"], "description": "averagetanktemperature.averageTankTemperature, degrees Fahrenheit. THE READ (docs/evap-permeation.md 8.1): TTG-5's output, of which mode 151 is TTG-1's quarter-hour recurrence and modes 150 and 300 are TTG-4's walk over SampleVehicleTrip. Only mode 300 reaches an output digit here.", "update": { "kind": "data", "source": "evp_averagetanktemperature", "from": { "file_variable": "averageTankTemperature" } } },

        "ta_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["temperatureadjustment_rows"], "description": "temperatureadjustment.polProcessID.", "update": { "kind": "data", "source": "evp_temperatureadjustment", "from": { "file_variable": "polProcessID" } } },
        "ta_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["temperatureadjustment_rows"], "description": "temperatureadjustment.fuelTypeID: 1 and 5.", "update": { "kind": "data", "source": "evp_temperatureadjustment", "from": { "file_variable": "fuelTypeID" } } },
        "ta_minModelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["temperatureadjustment_rows"], "description": "temperatureadjustment.minModelYearID = 1950.", "update": { "kind": "data", "source": "evp_temperatureadjustment", "from": { "file_variable": "minModelYearID" } } },
        "ta_maxModelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["temperatureadjustment_rows"], "description": "temperatureadjustment.maxModelYearID = 2060. With 1950 it covers every model year this run has, so PC-2a's expansion is measurably inert here and is written anyway.", "update": { "kind": "data", "source": "evp_temperatureadjustment", "from": { "file_variable": "maxModelYearID" } } },
        "ta_tempAdjustTermA": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["temperatureadjustment_rows"], "description": "temperatureadjustment.tempAdjustTermA = 0.0625: PC-2a's coefficient.", "update": { "kind": "data", "source": "evp_temperatureadjustment", "from": { "file_variable": "tempAdjustTermA" } } },
        "ta_tempAdjustTermB": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["temperatureadjustment_rows"], "description": "temperatureadjustment.tempAdjustTermB = 0.0385: PC-2a's exponent, per degree Fahrenheit of tank temperature.", "update": { "kind": "data", "source": "evp_temperatureadjustment", "from": { "file_variable": "tempAdjustTermB" } } },

        "hpc_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hcpermeationcoeff_rows"], "description": "hcpermeationcoeff.polProcessID.", "update": { "kind": "data", "source": "evp_hcpermeationcoeff", "from": { "file_variable": "polProcessID" } } },
        "hpc_etohThreshID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hcpermeationcoeff_rows"], "description": "hcpermeationcoeff.etohThreshID: which ethanol bracket this coefficient is for.", "update": { "kind": "data", "source": "evp_hcpermeationcoeff", "from": { "file_variable": "etohThreshID" } } },
        "hpc_fuelMYGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hcpermeationcoeff_rows"], "description": "hcpermeationcoeff.fuelMYGroupID: the FUEL model-year group, resolved to model years through pollutantprocessmappedmodelyear.", "update": { "kind": "data", "source": "evp_hcpermeationcoeff", "from": { "file_variable": "fuelMYGroupID" } } },
        "hpc_fuelAdjustment": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hcpermeationcoeff_rows"], "description": "hcpermeationcoeff.fuelAdjustment: PC-3's ordinary multiplier.", "update": { "kind": "data", "source": "evp_hcpermeationcoeff", "from": { "file_variable": "fuelAdjustment" } } },
        "hpc_fuelAdjustmentGPA": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hcpermeationcoeff_rows"], "description": "hcpermeationcoeff.fuelAdjustmentGPA: the geographic-phase-in multiplier, blended in at GPAFract. GPAFract is 0 here, so this column reaches no output digit.", "update": { "kind": "data", "source": "evp_hcpermeationcoeff", "from": { "file_variable": "fuelAdjustmentGPA" } } },
        "hpc_etohThreshLow": { "type": "unknown", "shape": ["hcpermeationcoeff_rows"], "units": "1", "description": "The coefficient's ethanol bracket, brought onto the 120-row coefficient relation from `etohbin` so that PC-3 is a four-relation contraction rather than a five-relation one (finding F17)." },
        "hpc_etohThreshHigh": { "type": "unknown", "shape": ["hcpermeationcoeff_rows"], "units": "1", "description": "The upper end of the same bracket, half-open." },

        "ebn_etohThreshID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["etohbin_rows"], "description": "etohbin.etohThreshID.", "update": { "kind": "data", "source": "evp_etohbin", "from": { "file_variable": "etohThreshID" } } },
        "ebn_etohThreshLow": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["etohbin_rows"], "description": "etohbin.etohThreshLow, percent by volume.", "update": { "kind": "data", "source": "evp_etohbin", "from": { "file_variable": "etohThreshLow" } } },
        "ebn_etohThreshHigh": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["etohbin_rows"], "description": "etohbin.etohThreshHigh, exclusive.", "update": { "kind": "data", "source": "evp_etohbin", "from": { "file_variable": "etohThreshHigh" } } },

        "fsu_fuelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelsupply_rows"], "description": "fuelsupply.fuelYearID.", "update": { "kind": "data", "source": "evp_fuelsupply", "from": { "file_variable": "fuelYearID" } } },
        "fsu_fuelFormulationID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelsupply_rows"], "description": "fuelsupply.fuelFormulationID: 90, 9114, 25003, 27002 and 28001.", "update": { "kind": "data", "source": "evp_fuelsupply", "from": { "file_variable": "fuelFormulationID" } } },
        "fsu_marketShare": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelsupply_rows"], "description": "fuelsupply.marketShare: 1.0 on every row, so PC-3's weighting is untested here and only the SUM over the supply is (docs/evap-permeation.md 7.1).", "update": { "kind": "data", "source": "evp_fuelsupply", "from": { "file_variable": "marketShare" } } },
        "fsu_fuelSubtypeID": { "type": "unknown", "shape": ["fuelsupply_rows"], "units": "1", "description": "The supplied formulation's fuel subtype, brought onto the 5-row supply relation from the 2,158-row formulation table." },
        "fsu_fuelTypeID": { "type": "unknown", "shape": ["fuelsupply_rows"], "units": "1", "description": "The fuel type that formulation is a formulation OF; 0 where `fuelsubtype` carries no row, which drops formulation 28001 (subtype 30) exactly as PC-3's INNER JOIN does." },
        "fsu_etohVolumeRaw": { "type": "unknown", "shape": ["fuelsupply_rows"], "units": "1", "description": "fuelformulation.ETOHVolume for the supplied formulation, as ingested: 10.0 on gasohol 9114 and on E85 27002, 0 on the diesel and the electricity placeholder." },
        "fsu_etohVolume": { "type": "unknown", "shape": ["fuelsupply_rows"], "units": "1", "description": "The Processing section's opening `update FuelFormulation set ETOHVolume = 0 where ETOHVolume is null`, as a NaN test. Inert on this snapshot -- `suppliedEtohAbsentCount` is 0 -- and written because an absent volume ingests as NaN and every half-open bracket test would then admit it, silently summing all eight coefficients instead of one." },
        "fsu_isRunFuelYear": { "type": "unknown", "shape": ["fuelsupply_rows"], "units": "1", "description": "PC-3's `INNER JOIN Year ON (fuelYearID) WHERE y.yearID = <run year>`: a single-row existence check, spelled as a semi-join." },

        "rcs_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["regclasssourcetypefraction_rows"], "description": "regclasssourcetypefraction.sourceTypeID.", "update": { "kind": "data", "source": "evp_regclasssourcetypefraction", "from": { "file_variable": "sourceTypeID" } } },
        "rcs_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["regclasssourcetypefraction_rows"], "description": "regclasssourcetypefraction.fuelTypeID.", "update": { "kind": "data", "source": "evp_regclasssourcetypefraction", "from": { "file_variable": "fuelTypeID" } } },
        "rcs_modelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["regclasssourcetypefraction_rows"], "description": "regclasssourcetypefraction.modelYearID.", "update": { "kind": "data", "source": "evp_regclasssourcetypefraction", "from": { "file_variable": "modelYearID" } } },
        "rcs_regClassFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["regclasssourcetypefraction_rows"], "description": "regclasssourcetypefraction.regClassFraction: PC-1b's regulatory-class split, 1.0 on every row of this snapshot.", "update": { "kind": "data", "source": "evp_regclasssourcetypefraction", "from": { "file_variable": "regClassFraction" } } },

        "stmyg_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypemodelyeargroup_rows"], "description": "sourcetypemodelyeargroup.sourceTypeID.", "update": { "kind": "data", "source": "evp_sourcetypemodelyeargroup", "from": { "file_variable": "sourceTypeID" } } },
        "stmyg_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypemodelyeargroup_rows"], "description": "sourcetypemodelyeargroup.modelYearGroupID.", "update": { "kind": "data", "source": "evp_sourcetypemodelyeargroup", "from": { "file_variable": "modelYearGroupID" } } },
        "stmyg_tankTemperatureGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypemodelyeargroup_rows"], "description": "sourcetypemodelyeargroup.tankTemperatureGroupID: 5 for source type 21's model-year group 19781995, 3 for 1996 and later. PC-6's gate.", "update": { "kind": "data", "source": "evp_sourcetypemodelyeargroup", "from": { "file_variable": "tankTemperatureGroupID" } } },

        "ppmmy_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmappedmodelyear_rows"], "description": "pollutantprocessmappedmodelyear.polProcessID.", "update": { "kind": "data", "source": "evp_pollutantprocessmappedmodelyear", "from": { "file_variable": "polProcessID" } } },
        "ppmmy_modelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmappedmodelyear_rows"], "description": "pollutantprocessmappedmodelyear.modelYearID.", "update": { "kind": "data", "source": "evp_pollutantprocessmappedmodelyear", "from": { "file_variable": "modelYearID" } } },
        "ppmmy_fuelMYGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmappedmodelyear_rows"], "description": "pollutantprocessmappedmodelyear.fuelMYGroupID: model year 1980 is fuel group 19751986 where its modelYearGroupID is 19781995. PC-3 keys on THIS column.", "update": { "kind": "data", "source": "evp_pollutantprocessmappedmodelyear", "from": { "file_variable": "fuelMYGroupID" } } },

        "ffo_fuelFormulationID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelformulation_rows"], "description": "fuelformulation.fuelFormulationID.", "update": { "kind": "data", "source": "evp_fuelformulation", "from": { "file_variable": "fuelFormulationID" } } },
        "ffo_fuelSubtypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelformulation_rows"], "description": "fuelformulation.fuelSubtypeID.", "update": { "kind": "data", "source": "evp_fuelformulation", "from": { "file_variable": "fuelSubtypeID" } } },
        "ffo_etohVolume": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelformulation_rows"], "description": "fuelformulation.ETOHVolume, percent by volume: the only physical fuel property this chain reads.", "update": { "kind": "data", "source": "evp_fuelformulation", "from": { "file_variable": "ETOHVolume" } } },

        "fst_fuelSubtypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelsubtype_rows"], "description": "fuelsubtype.fuelSubtypeID.", "update": { "kind": "data", "source": "evp_fuelsubtype", "from": { "file_variable": "fuelSubtypeID" } } },
        "fst_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelsubtype_rows"], "description": "fuelsubtype.fuelTypeID. Subtype 30 -- formulation 28001's -- has no row, so that supply row resolves to no fuel type and the join drops it.", "update": { "kind": "data", "source": "evp_fuelsubtype", "from": { "file_variable": "fuelTypeID" } } },

        "run_yearID": { "type": "unknown", "shape": ["run_rows"], "description": "The analysis year, from runspecyear. A ONE-ROW RELATION and not a scalar: a scalar is not materialized in a document that ingests (finding F16) and cannot be a join key (docs/esm-conventions.md 16.1)." },
        "run_monthID": { "type": "unknown", "shape": ["run_rows"], "description": "The run's month, from runspecmonth." },
        "run_hourID": { "type": "unknown", "shape": ["run_rows"], "description": "The run's hour, from runspechour." },
        "run_sourceTypeID": { "type": "unknown", "shape": ["run_rows"], "description": "The run's source type, from runspecsourcetype: the SQL's `##loop.sourceTypeID##`." },
        "run_roadTypeID": { "type": "unknown", "shape": ["run_rows"], "description": "The run's road type, from runspecroadtype." },
        "run_polProcessID": { "type": "unknown", "shape": ["run_rows"], "description": "100 x 1 + 11 = 111, built by `pol_process_id` from the pollutant and process enums. No bare 111 appears in an equation." },
        "run_linkID": { "type": "unknown", "shape": ["run_rows"], "description": "The iteration link, from link." },
        "run_countyID": { "type": "unknown", "shape": ["run_rows"], "description": "The county, from link. C4's fuel-usage scope and PC-3's GPA fraction key on it." },
        "run_zoneID": { "type": "unknown", "shape": ["run_rows"], "description": "The zone, from link. A9's, E2's and PC-2b's spatial key." },
        "run_linkRoadTypeID": { "type": "unknown", "shape": ["run_rows"], "description": "The LINK's road type, which is a different thing from the run's selected road type and happens to agree here. A10 tests this one." },
        "run_stateID": { "type": "unknown", "shape": ["run_rows"], "description": "county.stateID = 26, READ (PC-6 joins County for it) rather than derived from the county id." },
        "run_gpaFraction": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "county.GPAFract = 0. PC-3's blend weight." },
        "run_isRegClassReqd": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "C2': sourcetypepolprocess.isRegClassReqd for (this source type, this pollutant-process). 0 here. It is the ONE bit that decides whether a source bin key carries the vehicle's regulatory class or a zero, and it is per PROCESS -- the same table says 1 for evaporative fuel leaks in the sibling snapshot." },
        "run_isOnNetworkLink": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "1 if the link's road type is not the off-network type 1. A10's branch, and what makes E1's ratio exactly 1." },
        "run_baseYearIsAnalysisYear": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A1: is the analysis year itself flagged as a base year? 1 here, which makes TotalActivityGenerator's population and VMT growth folds the empty product." },
        "run_fuelYearID": { "type": "unknown", "shape": ["run_rows"], "description": "year[analysisYear].fuelYearID = 2020. C4's and PC-3's scope." },
        "run_hpmsVtypeID": { "type": "unknown", "shape": ["run_rows"], "description": "sourceusetype[sourceType].HPMSVtypeID = 25." },
        "run_analysisYearVMT": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A4: hpmsvtypeyear[25, 2020].HPMSBaseYearVMT, national annual vehicle-miles." },
        "run_roadTypeVMTFraction": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A5: roadtypedistribution[21, 4].roadTypeVMTFraction, gated to `roadtype.isAffectedByOnroad`." },
        "run_monthVMTFraction": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A7: monthvmtfraction[21, 8].monthVMTFraction." },
        "run_daysInMonth": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "monthofanyyear[8].noOfDays = 31." },
        "run_weeksPerMonth": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A7's DIVISOR, 31/7, by lib/onroad_activity.esm's `weeks_per_month`." },
        "run_shoAllocFactor": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A9: zoneroadtype[261610, 4].SHOAllocFactor." },
        "run_sourceTypePopulation": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A2: sourcetypeyear[2020, 21].sourceTypePopulation." },
        "run_travelGroupTotal": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A3's DENOMINATOR: sum of population x relativeMAR over every (source type, age) in the run's HPMS group -- source types 21, 31 and 32 for HPMS 25, not just the run's." },
        "run_pollutantID": { "type": "unknown", "shape": ["run_rows"], "description": "pollutantprocessassoc[111].pollutantID = 1." },
        "run_processID": { "type": "unknown", "shape": ["run_rows"], "description": "pollutantprocessassoc[111].processID = 11. Also the SCC's last two digits." },

        "sta_ageFraction": { "type": "unknown", "shape": ["sourcetypeage_rows"], "units": "1", "description": "The age distribution brought onto the 533-row (source type, age) relation from the 33,579-row table. Two relations in one node, which is what keeps it affordable." },
        "sta_population": { "type": "unknown", "shape": ["sourcetypeage_rows"], "units": "1", "description": "A2 on the same relation." },
        "sta_isInHpmsGroup": { "type": "unknown", "shape": ["sourcetypeage_rows"], "units": "1", "description": "Semi-join over sourceusetype: is this row's source type in the run's HPMS group?" },

        "day_ordinal": { "type": "unknown", "shape": ["runspecday_rows"], "description": "The runspecday relation's own row ordinal, 1..2." },
        "day_hourDayID": { "type": "unknown", "shape": ["runspecday_rows"], "description": "hourday[dayID, runHour].hourDayID: 72 and 75. Looked up, not computed." },
        "day_shoTotal": { "type": "unknown", "shape": ["runspecday_rows"], "units": "1", "description": "E1's numerator: SHO summed over the 41 ages for this day type." },
        "day_sourceHoursTotal": { "type": "unknown", "shape": ["runspecday_rows"], "units": "1", "description": "E1's denominator. Identical to day_shoTotal here because the link is on-network -- which is why the ratio is EXACTLY 1 and not approximately 1." },
        "day_fractionOfOperating": { "type": "unknown", "shape": ["runspecday_rows"], "units": "1", "description": "E1, by lib/evaporative.esm's `operating_share_of_activity`." },
        "day_soakSum": { "type": "unknown", "shape": ["runspecday_rows"], "units": "1", "description": "E3's `SUM(opModeFraction)` over the soak modes of this day type: exactly 0 here." },

        "mode_opModeID": { "type": "unknown", "shape": ["evap_op_mode_rows"], "description": "The three operating modes this pollutant-process has: 150 hot-soaking, 151 cold-soaking, 300 operating, built from `enums`. The axis is size 3 rather than discovered because opmodepolprocassoc holds 27 rows and compacting the 3 that carry polProcessID 111 is finding F5's value invention; `modeAssociationCount` proves there are exactly three." },
        "mode_isAssociated": { "type": "unknown", "shape": ["evap_op_mode_rows"], "units": "1", "description": "E2's admission semi-join: does opmodepolprocassoc carry this mode for the run's pollutant-process?" },

        "omd_hasSoakRow": { "type": "unknown", "shape": ["runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "Is there a soakactivityfraction row for this (day type, operating mode)? 1 for modes 150 and 151, 0 for 300." },
        "omd_soakActivityFraction": { "type": "unknown", "shape": ["runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "soakactivityfraction brought onto the (day type, mode) rectangle, scoped by source type, zone and month." },
        "omd_soakShare": { "type": "unknown", "shape": ["runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "E2, by lib/evaporative.esm's `soak_share`, gated by the admission semi-join. Exactly 0 on all six cells here, COMPUTED from A10's identity." },
        "omd_opModeFraction": { "type": "unknown", "shape": ["runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "E2 and E3 together: {150: 0, 151: 0, 300: 1} on both day types. THIS IS WHERE THE TWO TANK-TEMPERATURE MODES THIS FIXTURE CANNOT CHECK ARE MULTIPLIED BY ZERO -- and the zero is computed, not assumed." },

        "act_dayOrdinal": { "type": "unknown", "shape": ["activity_rows"], "description": "Which day type this activity row belongs to, by lib/keys.esm's `flat_relation_major` over a block of n_agecategory. The block length is the DISCOVERED extent of agecategory, not a literal." },
        "act_ageOrdinal": { "type": "unknown", "shape": ["activity_rows"], "description": "Which age, by `flat_relation_minor` over the same block." },
        "act_ageID": { "type": "unknown", "shape": ["activity_rows"], "description": "agecategory.ageID for this row, joined on the ordinal." },
        "act_dayID": { "type": "unknown", "shape": ["activity_rows"], "description": "runspecday.dayID for this row." },
        "act_hourDayID": { "type": "unknown", "shape": ["activity_rows"], "description": "The packed hour-day key for this row." },
        "act_ageFraction": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A2: the run's source type's age distribution at this age." },
        "act_population": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A2: population x ageFraction." },
        "act_relativeMAR": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A3: sourcetypeage[21, ageID].relativeMAR." },
        "act_populationMar": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A3's numerator." },
        "act_travelGroupTotal": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A3's denominator brought to every row." },
        "act_travelFraction": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A3, by lib/onroad_activity.esm's `share_of_group`." },
        "act_annualVMT": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A5: analysisYearVMT x roadTypeVMTFraction x travelFraction. Still NATIONAL." },
        "act_dayVMTFraction": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "dayvmtfraction for this (source type, month, road type, day type)." },
        "act_hourVMTFraction": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "hourvmtfraction for this (source type, road type, day type, hour)." },
        "act_averageSpeed": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A6: the ARITHMETIC mean of the speed-bin distribution, in mph. 67.0416879 on the weekend and 56.361205525 on the weekday; the harmonic means of the same two distributions are 54.2427 and 35.5758, and A8 divides by this number." },
        "act_vmt": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A7." },
        "act_sho": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A8 and A9: vmt / averageSpeed, guarded, times the zone allocation factor. This is the `sho` table -- 82 rows the document does not read." },
        "act_sourceHours": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A10: SourceHours = SHO at an ON-network link and SHP at the off-network one. The off-network branch emits not-a-number rather than silently reusing SHO." },

        "coh_ordinal": { "type": "unknown", "shape": ["cohort_rows"], "description": "The cohort relation's own row ordinal, 1..164. The relation is the RECTANGLE (41 model years x 4 fuel types) whose two factors are both discovered extents; membership is a column, not a shrunken axis (finding F14)." },
        "coh_fuelOrdinal": { "type": "unknown", "shape": ["cohort_rows"], "description": "Which of runspecsourcefueltype's fuels, fuel-major so that each occupies one contiguous run of rows." },
        "coh_ageOrdinal": { "type": "unknown", "shape": ["cohort_rows"], "description": "Which age category." },
        "coh_fuelTypeID": { "type": "unknown", "shape": ["cohort_rows"], "description": "runspecsourcefueltype.fuelTypeID, joined on the fuel ordinal." },
        "coh_ageID": { "type": "unknown", "shape": ["cohort_rows"], "description": "agecategory.ageID, joined on the age ordinal." },
        "coh_ageGroupID": { "type": "unknown", "shape": ["cohort_rows"], "description": "agecategory.ageGroupID for the same row: PC-1a's key." },
        "coh_modelYearID": { "type": "unknown", "shape": ["cohort_rows"], "description": "C1: `runYear - ageID`, spanning [1980, 2020] because agecategory has 41 rows." },
        "coh_stmyFraction": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "samplevehiclepopulation.stmyFraction for this (source type, model year, fuel type)." },
        "coh_engTechID": { "type": "unknown", "shape": ["cohort_rows"], "description": "The cohort's engine technology, from the same row." },
        "coh_svpRegClassID": { "type": "unknown", "shape": ["cohort_rows"], "description": "The sample vehicle's regulatory class, 20 on every populated cohort. Read so that C2' has something to discard, and so the discard is visible." },
        "coh_binRegClassID": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C2', source_bin_distribution_generator.rs:1355: the regulatory class the SOURCE BIN key carries. `isRegClassReqd ? svpRegClassID : 0`, and it is 0 throughout this run. Every downstream key -- the bin existence test, the fuel-usage rebase's equipped/used match and PC-1b's rate join -- uses THIS column and never `coh_svpRegClassID`. Writing 20 instead produces 125 cohort keys that match none of the snapshot's 80 bins and an output of exactly zero rows (docs/esm-conventions.md 34.1)." },
        "coh_modelYearGroupID": { "type": "unknown", "shape": ["cohort_rows"], "description": "pollutantprocessmodelyear[polProcess, modelYear].modelYearGroupID." },
        "coh_modelYearGroupIsPresent": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C2's two inner joins as one semi-join." },
        "coh_isSelected": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C2's row rule: `stmyFraction > 0` AND the group chain reaches it. 125 of the 164 candidates." },
        "coh_sourceBinActivityFraction": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C3: the surviving stmyFraction. There is no normalisation anywhere in the generator." },
        "coh_binExists": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C4's existence condition as a semi-join against sourcebin on the bin's COMPONENTS -- with C2's regulatory class, which is 0." },
        "coh_usedFraction": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C4: the same activity re-attributed to the fuel each cohort actually BURNS. This is the column PC-1b weights by." },
        "coh_regClassFractionTotal": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "PC-1b's WithRegClassID section, re-collapsed: the SUM of regClassSourceTypeFraction.regClassFraction over this (source type, fuel type, model year). PC-1b splits the rate onto regClassID and PC-6 sums regClassID away again, and nothing between them is keyed on it, so the sum is the whole of the split. 1.0 on every selected cohort here, which is also why the two mutually exclusive PC-1b sections are indistinguishable on this fixture." },
        "coh_binWeightedRate": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "PC-1b before the regulatory-class split: `sum over bins and age-group rate rows of sourceBinActivityFraction x meanBaseRate`, grams of THC per hour. The join does not constrain opModeID -- PC-1b's does not either -- so there is no operating-mode axis on the rate." },
        "coh_permeationRate": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "`SBWeightedPermeationRate`: the bin-weighted rate times the regulatory-class fraction total." },
        "coh_hasRate": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "Does emissionratebyage carry any row for this cohort's bin at all? 1 for gasoline and E85, 0 for diesel and electricity -- their 39 bins have no rate rows, which is the second of the two mechanisms that take the 125 surviving cohorts down to 64." },
        "coh_survives": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "Both mechanisms: selected by C2 AND rate-bearing. 64 of the 164." },
        "coh_weightedFuelAdjustment": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "PC-3: `sum over the supplied formulations of marketShare x (fuelAdjustment + GPAFract x (fuelAdjustmentGPA - fuelAdjustment))`, narrowed through the ethanol bracket and the mapped model years. 2.1383 on gasoline and E85 from 1999, 2.0728 at 1998, 1.7545 at 1996-1997, 1.6593 at 1980-1995." },
        "coh_fuelAdjustedRate": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "PC-4: `FuelAdjustedEmissionRate` = permeation rate x fuel adjustment. The `INNER JOIN Year (yearID, fuelYearID)` PC-4 also carries is the same one-row existence check PC-3 already applied to the supply and is not repeated." },
        "coh_tankTemperatureGroupID": { "type": "unknown", "shape": ["cohort_rows"], "description": "PC-6's gate resolved forward: sourcetypemodelyeargroup[sourceType, modelYearGroup].tankTemperatureGroupID. 5 for model years 1980-1995 and 3 for 1996 and later. Resolving it on the cohort rather than testing it at the output is what turns PC-6's gate into a join key." },

        "cohq_ordinal": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The EQUIPPED side of C4, as a second relation over a second index set, because a relation cannot be joined to itself (finding F11) and the fuel-usage remap pairs a cohort with other cohorts of its own model year." },
        "cohq_fuelOrdinal": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's fuel ordinal." },
        "cohq_ageOrdinal": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's age ordinal." },
        "cohq_fuelTypeID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's fuel type: the fuel the VEHICLE is built for." },
        "cohq_modelYearID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's model year." },
        "cohq_engTechID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's engine technology." },
        "cohq_binRegClassID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "units": "1", "description": "The equipped side's BIN regulatory class -- C2' again, and it has to be the same rule on both sides of the match or the rebase pairs nothing." },
        "cohq_modelYearGroupID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's model-year group." },
        "cohq_sourceBinActivityFraction": { "type": "unknown", "shape": ["cohort_equipped_rows"], "units": "1", "description": "The equipped side's C3 fraction." },

        "era_fuelTypeID": { "type": "unknown", "shape": ["emissionratebyage_rows"], "description": "The bin components brought onto the 968-row rate relation, on the packed sourceBinID. Pre-attaching them here rather than joining sourcebin inside PC-1b is what turns PC-1b into a two-relation contraction (finding F17)." },
        "era_engTechID": { "type": "unknown", "shape": ["emissionratebyage_rows"], "description": "Likewise, the bin's engine technology." },
        "era_regClassID": { "type": "unknown", "shape": ["emissionratebyage_rows"], "description": "Likewise, the bin's regulatory class -- 0 on every bin of this snapshot." },
        "era_modelYearGroupID": { "type": "unknown", "shape": ["emissionratebyage_rows"], "description": "Likewise, the bin's model-year group." },
        "era_isEvapFuel": { "type": "unknown", "shape": ["emissionratebyage_rows"], "units": "1", "description": "Is the bin's fuel subject to evaporative calculations? Measurably inert on this fixture -- emissionratebyage carries no rows for the diesel or electricity bins either -- and present so that a fixture where the flag and the rate table's coverage disagree fails at one join." },
        "era_isRunPolProcess": { "type": "unknown", "shape": ["emissionratebyage_rows"], "units": "1", "description": "Is this rate row the run's pollutant-process? 1 on all 968 rows of this extract; joined anyway." },

        "cohDay_tempAdjustByMode": { "type": "unknown", "shape": ["cohort_rows", "runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "PC-2a on the keys that reach the output: `tempAdjustTermA x exp(tempAdjustTermB x averageTankTemperature)`, by lib/evaporative.esm's `tank_temperature_adjustment`, at this cohort's tank-temperature group and fuel type, this day type's hour-day and this operating mode. PC-2a's model-year expansion is the `filter`: the adjustment does not depend on the model year and only its RANGE does. All three modes are non-zero -- 0.75854, 0.86995 and 1.20064 on the weekend at group 3 -- which is the half of docs/esm-conventions.md 23's corollary that says the zero below is a weight and not an absent computation." },
        "cohDay_weightedTemperatureAdjust": { "type": "unknown", "shape": ["cohort_rows", "runspecday_rows"], "units": "1", "description": "PC-2b: the sum over operating modes of PC-2a's adjustment times `omd_opModeFraction`. The soak modes are summed at weight 0 rather than left out, so the document computes the reference's whole expression and the zero is visible in it." },

        "fuelUsageWildcardCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many fuelusagefraction rows carry the model-year-group WILDCARD 0: five of five." },
        "sourceBinZeroSlotCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many source bins have engSizeID and weightClassID both zero: 80 of 80." },
        "sourceBinRegClassZeroCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many source bins carry regClassID 0: 80 of 80, which is what C2' looks like from the other side. In the process-evap-leaks snapshot the same count is 0." },
        "evapFuelCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many fuel types are subject to evaporative calculations: two. Proves the `codes` map decoded the Y/N column rather than silently delivering a default." },
        "modeAssociationCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many of the three declared operating modes opmodepolprocassoc associates with the run's pollutant-process: three." },
        "rateNonOperatingRowCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many emissionratebyage rows carry an operating mode other than 300: zero. PC-1b does not join on opModeID, so a rate table with soak-mode rows would sum them into the same weighted rate -- this count is what says the fixture cannot tell that arm from the other one." },
        "suppliedEtohAbsentCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many supplied formulations have no ETOHVolume: zero, so the Processing section's NULL-to-0 coercion is inert here and is written anyway." },
        "cohortSurvivorCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "The surviving cohorts, counted from the chain: 64. This is what makes `n_outputCohort` a checked declaration rather than a transcription." },
        "cohortTankGroupCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many surviving cohorts resolve a tank-temperature group: 64 of 64. PC-6's gate is an INNER join, so a cohort that resolved none would be silently dropped -- one missing key rather than a wrong number." },
        "cohortRegClassFractionCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many surviving cohorts have a regClassSourceTypeFraction row: 64 of 64. PC-1b's WithRegClassID section is an INNER join and drops a cohort that has none, so this count is the other half of what makes the two PC-1b sections agree here." },
        "tankTemperatureSoakWeight": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "The total weight the two SOAK operating modes carry into PC-2b over both day types: exactly 0. This is the number docs/evap-permeation.md 0.3 measures by perturbation and the reason the 192 soak cells of `averagetanktemperature` cannot move an output digit -- asserted here so that a run where they COULD matter fails this assertion first." },

        "outCohortOrdinal": { "type": "unknown", "shape": ["output_rows"], "description": "Which surviving cohort this output row is, 1..64, by `flat_relation_minor`." },
        "outDayOrdinal": { "type": "unknown", "shape": ["output_rows"], "description": "Which day type this output row is, by `flat_relation_major`. The 128 rows are cohort-minor within day-major blocks." },
        "outCohortRow": { "type": "unknown", "shape": ["output_rows"], "description": "The row of the 164-row cohort relation this output row draws from. The surviving cohorts are two contiguous runs -- all 41 gasoline model years, then E85 from 1998 -- so the map skips the 41 diesel rows between them. THIS IS THE DECLARED PART, checked by `cohortSurvivorCount` and by the comparator's exact key set." },
        "outAgeID": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "PC-5's key into the activity relation: `runYear - modelYearID`." },
        "outSourceHours": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "PC-5: `sourceHours` for this row's (hourDayID, ageID)." },
        "outNoOfRealDays": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "PC-5's divisor: 2 on the weekend rows and 5 on the weekday rows." },
        "outHourDayID": { "type": "unknown", "shape": ["output_rows"], "description": "This row's packed hour-day key." },
        "outFuelAdjustedQuant": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "PC-5: `FuelAdjustedEmissionQuant` = fuel-adjusted rate x sourceHours / noOfRealDays, in grams." },
        "outWeightedTemperatureAdjust": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "PC-2b's adjustment brought onto the output row, on (cohort, day type). 0.7585 on the weekend and 0.6744 on the weekday for tank-temperature group 3; 0.9112 and 0.7346 for group 5." },

        "out_yearID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.yearID." },
        "out_monthID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.monthID." },
        "out_dayID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.dayID, from the day relation on the ordinal." },
        "out_hourID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.hourID = 7." },
        "out_stateID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.stateID = 26, from county." },
        "out_countyID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.countyID." },
        "out_zoneID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.zoneID, which this run leaves NULL: `null_output_column` is 0/0, a NaN, and the comparator reads NaN, NULL and empty as the same thing." },
        "out_linkID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.linkID, NULL." },
        "out_pollutantID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.pollutantID = 1." },
        "out_processID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.processID = 11." },
        "out_sourceTypeID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.sourceTypeID = 21." },
        "out_regClassID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.regClassID, NULL. PC-1b through PC-5 carry it and PC-6's output breakdown aggregates it away; on this fixture that aggregation is over the single class 0 that C2' left in the bin key." },
        "out_fuelTypeID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.fuelTypeID, from the cohort relation." },
        "out_fuelSubTypeID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.fuelSubTypeID, NULL." },
        "out_modelYearID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.modelYearID, from the cohort relation -- joined, not transcribed." },
        "out_roadTypeID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.roadTypeID = 4, from the link. tolerance.toml ignores this column, but the SCC's road-type slot is computed from it and that is compared." },
        "out_SCC": { "type": "unknown", "shape": ["output_rows"], "description": "PC-6's SCC: 22e8 + fuelTypeID x 1e6 + sourceTypeID x 1e4 + roadTypeID x 1e2 + processID, by lib/onroad_activity.esm's `onroad_scc`. 2201210411 for gasoline and 2205210411 for E85." },
        "out_engTechID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.engTechID, NULL." },
        "out_sectorID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.sectorID, NULL -- a NONROAD column." },
        "out_hpID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.hpID, NULL -- a NONROAD column." },
        "out_emissionQuant": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "MOVESOutput.emissionQuant, in grams of THC: PC-6, `weightedTemperatureAdjust x fuelAdjustedEmissionQuant`. `g` is a registry unit but no factor in the product carries one, so neither can the product." },

        "absentRegClassIndicator": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "1 where out_regClassID is absent, by lib/identifiers.esm's `output_column_is_absent`. The absence cannot be pinned directly -- `Assertion.expected` is a JSON number so NaN cannot be written down -- so this is how PC-6's NULL columns get a test with a non-zero expected value (docs/esm-conventions.md 18.2)." },
        "presentQuantIndicator": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "The NEGATIVE control: the same template applied to out_emissionQuant, which is present, so it reads 0 on every row." }
      },

      "equations": [
        {
          "_comment": "The run scope, each value lifted from its own one-row source relation. An aggregate over (run_rows x source_rows) with NO join clause is the cross product of two one-row relations.",
          "lhs": "run_yearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspecyear_rows" } },
            "expr": { "op": "index", "args": ["rsy_yearID", "s"] } }
        },
        { "lhs": "run_monthID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspecmonth_rows" } },
            "expr": { "op": "index", "args": ["rsm_monthID", "s"] } } },
        { "lhs": "run_hourID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspechour_rows" } },
            "expr": { "op": "index", "args": ["rsh_hourID", "s"] } } },
        { "lhs": "run_sourceTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspecsourcetype_rows" } },
            "expr": { "op": "index", "args": ["rst_sourceTypeID", "s"] } } },
        { "lhs": "run_roadTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspecroadtype_rows" } },
            "expr": { "op": "index", "args": ["rsr_roadTypeID", "s"] } } },
        { "lhs": "run_linkID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "l": { "from": "link_rows" } },
            "expr": { "op": "index", "args": ["lnk_linkID", "l"] } } },
        { "lhs": "run_countyID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "l": { "from": "link_rows" } },
            "expr": { "op": "index", "args": ["lnk_countyID", "l"] } } },
        { "lhs": "run_zoneID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "l": { "from": "link_rows" } },
            "expr": { "op": "index", "args": ["lnk_zoneID", "l"] } } },
        { "lhs": "run_linkRoadTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "l": { "from": "link_rows" } },
            "expr": { "op": "index", "args": ["lnk_roadTypeID", "l"] } } },
        {
          "_comment": "PC-6 joins County for the output row's state; this document reads the column rather than deriving floor(countyID / 1000) as the NONROAD fixture must.",
          "lhs": "run_stateID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "y": { "from": "county_rows" } },
            "join": [ { "on": [["run_countyID", "cty_countyID"]] } ],
            "expr": { "op": "index", "args": ["cty_stateID", "y"] } } },
        { "lhs": "run_gpaFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "y": { "from": "county_rows" } },
            "join": [ { "on": [["run_countyID", "cty_countyID"]] } ],
            "expr": { "op": "index", "args": ["cty_GPAFract", "y"] } } },
        {
          "_comment": "A10's branch condition: the off-network road type is 1 and every on-network type is above it.",
          "lhs": "run_isOnNetworkLink",
          "rhs": { "op": "ifelse", "args": [
            { "op": ">", "args": ["run_linkRoadTypeID", { "op": "enum", "args": ["road_type", "OffNetwork"] }] },
            1.0, 0.0] } },
        { "lhs": "run_polProcessID",
          "rhs": { "op": "makearray", "args": [], "regions": [[[1, 1]]],
            "values": [
              { "op": "apply_expression_template", "args": [], "name": "pol_process_id",
                "bindings": {
                  "pollutant_id": { "op": "enum", "args": ["pollutant", "TotalGaseousHydrocarbons"] },
                  "process_id": { "op": "enum", "args": ["process", "EvapPermeation"] } } }
            ] } },
        {
          "_comment": "C2': the per-PROCESS source-bin key rule. isRegClassReqd is read here and applied at coh_binRegClassID; nothing in this document assumes it.",
          "lhs": "run_isRegClassReqd",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "q": { "from": "sourcetypepolprocess_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "stpp_sourceTypeID"],
                               ["run_polProcessID", "stpp_polProcessID"]] } ],
            "expr": { "op": "index", "args": ["stpp_isRegClassReqd", "q"] } } },
        {
          "_comment": "A1: is the analysis year flagged as a base year? The flag is Y/N text decoded by a `codes` map at ingest.",
          "lhs": "run_baseYearIsAnalysisYear",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "y": { "from": "year_rows" } },
            "join": [ { "on": [["run_yearID", "yr_yearID"]] } ],
            "expr": { "op": "index", "args": ["yr_isBaseYear", "y"] } } },
        { "lhs": "run_fuelYearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "y": { "from": "year_rows" } },
            "join": [ { "on": [["run_yearID", "yr_yearID"]] } ],
            "expr": { "op": "index", "args": ["yr_fuelYearID", "y"] } } },
        { "lhs": "run_hpmsVtypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "u": { "from": "sourceusetype_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "sut_sourceTypeID"]] } ],
            "expr": { "op": "index", "args": ["sut_HPMSVtypeID", "u"] } } },
        { "lhs": "run_analysisYearVMT",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "h": { "from": "hpmsvtypeyear_rows" } },
            "join": [ { "on": [["run_hpmsVtypeID", "hvy_HPMSVtypeID"], ["run_yearID", "hvy_yearID"]] } ],
            "expr": { "op": "index", "args": ["hvy_HPMSBaseYearVMT", "h"] } } },
        {
          "_comment": "A5, gated to `roadtype` membership: two clauses over two relations, composing by conjunction.",
          "lhs": "run_roadTypeVMTFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "d": { "from": "roadtypedistribution_rows" },
                        "w": { "from": "roadtype_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "rtd_sourceTypeID"], ["run_roadTypeID", "rtd_roadTypeID"]] },
                      { "on": [["rtd_roadTypeID", "rt_roadTypeID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["rtd_roadTypeVMTFraction", "d"] },
              { "op": "index", "args": ["rt_isAffectedByOnroad", "w"] }] } } },
        { "lhs": "run_monthVMTFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "v": { "from": "monthvmtfraction_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "mvf_sourceTypeID"], ["run_monthID", "mvf_monthID"]] } ],
            "expr": { "op": "index", "args": ["mvf_monthVMTFraction", "v"] } } },
        { "lhs": "run_daysInMonth",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "n": { "from": "monthofanyyear_rows" } },
            "join": [ { "on": [["run_monthID", "moy_monthID"]] } ],
            "expr": { "op": "index", "args": ["moy_noOfDays", "n"] } } },
        { "lhs": "run_weeksPerMonth",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "weeks_per_month",
            "bindings": { "days_in_month": "run_daysInMonth" } } },
        { "lhs": "run_shoAllocFactor",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "z": { "from": "zoneroadtype_rows" } },
            "join": [ { "on": [["run_zoneID", "zrt_zoneID"], ["run_roadTypeID", "zrt_roadTypeID"]] } ],
            "expr": { "op": "index", "args": ["zrt_SHOAllocFactor", "z"] } } },
        { "lhs": "run_sourceTypePopulation",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "p": { "from": "sourcetypeyear_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "sty_sourceTypeID"], ["run_yearID", "sty_yearID"]] } ],
            "expr": { "op": "index", "args": ["sty_sourceTypePopulation", "p"] } } },
        { "lhs": "run_pollutantID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "a": { "from": "pollutantprocessassoc_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppa_polProcessID"]] } ],
            "expr": { "op": "index", "args": ["ppa_pollutantID", "a"] } } },
        { "lhs": "run_processID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "a": { "from": "pollutantprocessassoc_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppa_polProcessID"]] } ],
            "expr": { "op": "index", "args": ["ppa_processID", "a"] } } },

        {
          "_comment": "A3's denominator is assembled on the 533-row (source type, age) relation, because that is the SMALL side of the join to the 33,579-row distribution (finding F17).",
          "lhs": "sta_ageFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["q"],
            "ranges": { "q": { "from": "sourcetypeage_rows" },
                        "p": { "from": "sourcetypeagedistribution_rows" },
                        "k": { "from": "run_rows" } },
            "join": [ { "on": [["sta_sourceTypeID", "stad_sourceTypeID"], ["sta_ageID", "stad_ageID"]] },
                      { "on": [["stad_yearID", "run_yearID"]] } ],
            "expr": { "op": "index", "args": ["stad_ageFraction", "p"] } } },
        { "lhs": "sta_population",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["q"],
            "ranges": { "q": { "from": "sourcetypeage_rows" }, "y": { "from": "sourcetypeyear_rows" },
                        "k": { "from": "run_rows" } },
            "join": [ { "on": [["sta_sourceTypeID", "sty_sourceTypeID"], ["run_yearID", "sty_yearID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["sty_sourceTypePopulation", "y"] },
              { "op": "index", "args": ["sta_ageFraction", "q"] }] } } },
        { "lhs": "sta_isInHpmsGroup",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["q"],
            "ranges": { "q": { "from": "sourcetypeage_rows" }, "u": { "from": "sourceusetype_rows" },
                        "k": { "from": "run_rows" } },
            "join": [ { "on": [["sta_sourceTypeID", "sut_sourceTypeID"]] },
                      { "on": [["sut_HPMSVtypeID", "run_hpmsVtypeID"]] } ],
            "expr": 1.0 } },
        {
          "_comment": "A3's denominator: over every (source type, age) in the run's HPMS group, not just the run's source type.",
          "lhs": "run_travelGroupTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "q": { "from": "sourcetypeage_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["sta_population", "q"] },
                { "op": "index", "args": ["sta_relativeMAR", "q"] }] },
              { "op": "index", "args": ["sta_isInHpmsGroup", "q"] }] } } },

        {
          "_comment": "Row ordinals, so that the derived relations join to their factors by POSITION rather than by assuming a file's key order.",
          "lhs": "ac_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["g"],
            "ranges": { "g": { "from": "agecategory_rows" } }, "expr": "g" } },
        { "lhs": "day_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" } }, "expr": "k" } },
        { "lhs": "rsft_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["u"],
            "ranges": { "u": { "from": "runspecsourcefueltype_rows" } }, "expr": "u" } },
        {
          "_comment": "The packed hour-day key is LOOKED UP from (dayID, hourID), so hourID x 10 + dayID appears nowhere in this document.",
          "lhs": "day_hourDayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" }, "h": { "from": "hourday_rows" },
                        "r": { "from": "run_rows" } },
            "join": [ { "on": [["rsd_dayID", "hd_dayID"]] }, { "on": [["hd_hourID", "run_hourID"]] } ],
            "expr": { "op": "index", "args": ["hd_hourDayID", "h"] } } },

        { "lhs": "mode_opModeID",
          "rhs": { "op": "makearray", "args": [], "regions": [[[1, 1]], [[2, 2]], [[3, 3]]],
            "values": [
              { "op": "enum", "args": ["operating_mode", "HotSoaking"] },
              { "op": "enum", "args": ["operating_mode", "ColdSoaking"] },
              { "op": "enum", "args": ["operating_mode", "Operating"] }
            ] } },
        { "lhs": "mode_isAssociated",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["m"],
            "ranges": { "m": { "from": "evap_op_mode_rows" }, "w": { "from": "opmodepolprocassoc_rows" },
                        "r": { "from": "run_rows" } },
            "join": [ { "on": [["mode_opModeID", "omppa_opModeID"]] },
                      { "on": [["omppa_polProcessID", "run_polProcessID"]] } ],
            "expr": 1.0 } },

        {
          "_comment": "The activity relation's ordinals, by lib/keys.esm's flat-relation decode. The block length is n_agecategory, a DISCOVERED extent, so the decomposition carries no literal and the two coordinates share one floor division.",
          "lhs": "act_dayOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "flat_relation_major",
              "bindings": { "position": "r", "block_size": "n_agecategory" } } } },
        { "lhs": "act_ageOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "flat_relation_minor",
              "bindings": { "position": "r", "block_size": "n_agecategory" } } } },
        { "lhs": "act_ageID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "g": { "from": "agecategory_rows" } },
            "join": [ { "on": [["act_ageOrdinal", "ac_ordinal"]] } ],
            "expr": { "op": "index", "args": ["ac_ageID", "g"] } } },
        { "lhs": "act_dayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["act_dayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["rsd_dayID", "k"] } } },
        { "lhs": "act_hourDayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["act_dayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["day_hourDayID", "k"] } } },
        {
          "_comment": "A2. One clause, three pairs: source type, year and age.",
          "lhs": "act_ageFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" },
                        "p": { "from": "sourcetypeagedistribution_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "stad_sourceTypeID"],
                               ["run_yearID", "stad_yearID"],
                               ["act_ageID", "stad_ageID"]] } ],
            "expr": { "op": "index", "args": ["stad_ageFraction", "p"] } } },
        { "lhs": "act_population",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["run_sourceTypePopulation", "n"] },
              { "op": "index", "args": ["act_ageFraction", "r"] }] } } },
        { "lhs": "act_relativeMAR",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "q": { "from": "sourcetypeage_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "sta_sourceTypeID"], ["act_ageID", "sta_ageID"]] } ],
            "expr": { "op": "index", "args": ["sta_relativeMAR", "q"] } } },
        { "lhs": "act_populationMar",
          "rhs": { "op": "*", "args": ["act_population", "act_relativeMAR"] } },
        { "lhs": "act_travelGroupTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_travelGroupTotal", "n"] } } },
        { "lhs": "act_travelFraction",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "share_of_group",
            "bindings": { "numerator": "act_populationMar", "group_total": "act_travelGroupTotal" } } },
        { "lhs": "act_annualVMT",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["run_analysisYearVMT", "n"] },
                { "op": "index", "args": ["run_roadTypeVMTFraction", "n"] }] },
              { "op": "index", "args": ["act_travelFraction", "r"] }] } } },
        { "lhs": "act_dayVMTFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "v": { "from": "dayvmtfraction_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "dvf_sourceTypeID"],
                               ["run_monthID", "dvf_monthID"],
                               ["run_roadTypeID", "dvf_roadTypeID"],
                               ["act_dayID", "dvf_dayID"]] } ],
            "expr": { "op": "index", "args": ["dvf_dayVMTFraction", "v"] } } },
        { "lhs": "act_hourVMTFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "v": { "from": "hourvmtfraction_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "hvf_sourceTypeID"],
                               ["run_roadTypeID", "hvf_roadTypeID"],
                               ["act_dayID", "hvf_dayID"],
                               ["run_hourID", "hvf_hourID"]] } ],
            "expr": { "op": "index", "args": ["hvf_hourVMTFraction", "v"] } } },
        {
          "_comment": "A6: the ARITHMETIC mean. Two clauses over two relations.",
          "lhs": "act_averageSpeed",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "p": { "from": "avgspeeddistribution_rows" },
                        "b": { "from": "avgspeedbin_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "asd_sourceTypeID"],
                               ["run_roadTypeID", "asd_roadTypeID"],
                               ["act_hourDayID", "asd_hourDayID"]] },
                      { "on": [["asd_avgSpeedBinID", "asb_avgSpeedBinID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["asd_avgSpeedFraction", "p"] },
              { "op": "index", "args": ["asb_avgBinSpeed", "b"] }] } } },
        {
          "_comment": "A7. weeksPerMonth is a DIVISOR; omitting it multiplies every row by 4.43.",
          "lhs": "act_vmt",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "/", "args": [
              { "op": "*", "args": [
                { "op": "*", "args": [
                  { "op": "index", "args": ["act_annualVMT", "r"] },
                  { "op": "index", "args": ["run_monthVMTFraction", "n"] }] },
                { "op": "*", "args": [
                  { "op": "index", "args": ["act_dayVMTFraction", "r"] },
                  { "op": "index", "args": ["act_hourVMTFraction", "r"] }] }] },
              { "op": "index", "args": ["run_weeksPerMonth", "n"] }] } } },
        {
          "_comment": "A8 and A9. A8 is a LEFT JOIN whose miss gives SHO = 0 with the VMT intact.",
          "lhs": "act_sho",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "ifelse", "args": [
                { "op": ">", "args": [{ "op": "index", "args": ["act_averageSpeed", "r"] }, 0.0] },
                { "op": "/", "args": [
                  { "op": "index", "args": ["act_vmt", "r"] },
                  { "op": "index", "args": ["act_averageSpeed", "r"] }] },
                0.0] },
              { "op": "index", "args": ["run_shoAllocFactor", "n"] }] } } },
        {
          "_comment": "A10, allocation.rs:631-682. An OFF-network link takes SHP, which this document does not compute, so it emits not-a-number there rather than reusing SHO.",
          "lhs": "act_sourceHours",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [{ "op": "index", "args": ["run_isOnNetworkLink", "n"] }, 0.0] },
              { "op": "index", "args": ["act_sho", "r"] },
              { "op": "apply_expression_template", "args": [], "name": "null_output_column",
                "bindings": {} }] } } },

        { "lhs": "day_shoTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" }, "r": { "from": "activity_rows" } },
            "join": [ { "on": [["day_ordinal", "act_dayOrdinal"]] } ],
            "expr": { "op": "index", "args": ["act_sho", "r"] } } },
        { "lhs": "day_sourceHoursTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" }, "r": { "from": "activity_rows" } },
            "join": [ { "on": [["day_ordinal", "act_dayOrdinal"]] } ],
            "expr": { "op": "index", "args": ["act_sourceHours", "r"] } } },
        { "lhs": "day_fractionOfOperating",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "operating_share_of_activity",
            "bindings": { "sho_total": "day_shoTotal", "source_hours_total": "day_sourceHoursTotal" } } },
        { "lhs": "omd_hasSoakRow",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["k", "m"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" },
                        "f": { "from": "soakactivityfraction_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["day_hourDayID", "saf_hourDayID"], ["mode_opModeID", "saf_opModeID"]] },
                      { "on": [["saf_sourceTypeID", "run_sourceTypeID"],
                               ["saf_zoneID", "run_zoneID"],
                               ["saf_monthID", "run_monthID"]] } ],
            "expr": { "op": "index", "args": ["mode_isAssociated", "m"] } } },
        { "lhs": "omd_soakActivityFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k", "m"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" },
                        "f": { "from": "soakactivityfraction_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["day_hourDayID", "saf_hourDayID"], ["mode_opModeID", "saf_opModeID"]] },
                      { "on": [["saf_sourceTypeID", "run_sourceTypeID"],
                               ["saf_zoneID", "run_zoneID"],
                               ["saf_monthID", "run_monthID"]] } ],
            "expr": { "op": "index", "args": ["saf_soakActivityFraction", "f"] } } },
        { "lhs": "omd_soakShare",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["k", "m"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "apply_expression_template", "args": [], "name": "soak_share",
                "bindings": {
                  "soak_activity_fraction": { "op": "index", "args": ["omd_soakActivityFraction", "k", "m"] },
                  "operating_share": { "op": "index", "args": ["day_fractionOfOperating", "k"] } } },
              { "op": "index", "args": ["omd_hasSoakRow", "k", "m"] }] } } },
        { "lhs": "day_soakSum",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "index", "args": ["omd_soakShare", "k", "m"] } } },
        {
          "_comment": "E2 and E3. Mode 300 is the RESIDUAL of what the soak modes left, not fractionOfOperating; components/evap_operating_mode_distribution.esm carries the probe row that separates them.",
          "lhs": "omd_opModeFraction",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["k", "m"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [{ "op": "index", "args": ["omd_hasSoakRow", "k", "m"] }, 0.0] },
              { "op": "index", "args": ["omd_soakShare", "k", "m"] },
              { "op": "max", "args": [0.0,
                { "op": "-", "args": [1.0, { "op": "index", "args": ["day_soakSum", "k"] }] }] }] } } },

        {
          "_comment": "C1 and C2's candidate grid: 41 model years x 4 fuel types, both factors DISCOVERED extents. Fuel-major, so each fuel occupies one contiguous run of rows.",
          "lhs": "coh_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" } }, "expr": "c" } },
        { "lhs": "coh_fuelOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "flat_relation_major",
              "bindings": { "position": "c", "block_size": "n_agecategory" } } } },
        { "lhs": "coh_ageOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "flat_relation_minor",
              "bindings": { "position": "c", "block_size": "n_agecategory" } } } },
        { "lhs": "coh_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "u": { "from": "runspecsourcefueltype_rows" } },
            "join": [ { "on": [["coh_fuelOrdinal", "rsft_ordinal"]] } ],
            "expr": { "op": "index", "args": ["rsft_fuelTypeID", "u"] } } },
        { "lhs": "coh_ageID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "g": { "from": "agecategory_rows" } },
            "join": [ { "on": [["coh_ageOrdinal", "ac_ordinal"]] } ],
            "expr": { "op": "index", "args": ["ac_ageID", "g"] } } },
        { "lhs": "coh_ageGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "g": { "from": "agecategory_rows" } },
            "join": [ { "on": [["coh_ageOrdinal", "ac_ordinal"]] } ],
            "expr": { "op": "index", "args": ["ac_ageGroupID", "g"] } } },
        { "lhs": "coh_modelYearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "-", "args": [
              { "op": "index", "args": ["run_yearID", "n"] },
              { "op": "index", "args": ["coh_ageID", "c"] }] } } },
        { "lhs": "coh_stmyFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["coh_modelYearID", "svp_modelYearID"],
                               ["coh_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_stmyFraction", "v"] } } },
        { "lhs": "coh_engTechID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["coh_modelYearID", "svp_modelYearID"],
                               ["coh_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_engTechID", "v"] } } },
        { "lhs": "coh_svpRegClassID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["coh_modelYearID", "svp_modelYearID"],
                               ["coh_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_regClassID", "v"] } } },
        {
          "_comment": "C2', source_bin_distribution_generator.rs:1355. THE per-process key rule: the bin carries the vehicle's regulatory class only where SourceTypePolProcess says the process resolves one, and evaporative permeation does not. Every key downstream of here uses this column.",
          "lhs": "coh_binRegClassID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [{ "op": "index", "args": ["run_isRegClassReqd", "n"] }, 0.0] },
              { "op": "index", "args": ["coh_svpRegClassID", "c"] },
              0.0] } } },
        { "lhs": "coh_modelYearGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "y": { "from": "pollutantprocessmodelyear_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppmy_polProcessID"],
                               ["coh_modelYearID", "ppmy_modelYearID"]] } ],
            "expr": { "op": "index", "args": ["ppmy_modelYearGroupID", "y"] } } },
        { "lhs": "coh_modelYearGroupIsPresent",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "y": { "from": "pollutantprocessmodelyear_rows" },
                        "j": { "from": "modelyeargroup_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppmy_polProcessID"],
                               ["coh_modelYearID", "ppmy_modelYearID"]] },
                      { "on": [["ppmy_modelYearGroupID", "myg_modelYearGroupID"]] } ],
            "expr": 1.0 } },
        { "lhs": "coh_isSelected",
          "rhs": { "op": "ifelse", "args": [
            { "op": "and", "args": [
              { "op": ">", "args": ["coh_stmyFraction", 0.0] },
              { "op": ">", "args": ["coh_modelYearGroupIsPresent", 0.0] }] },
            1.0, 0.0] } },
        { "lhs": "coh_sourceBinActivityFraction",
          "rhs": { "op": "*", "args": ["coh_isSelected", "coh_stmyFraction"] } },
        { "lhs": "coh_binExists",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["coh_fuelTypeID", "sb_fuelTypeID"],
                               ["coh_engTechID", "sb_engTechID"],
                               ["coh_binRegClassID", "sb_regClassID"],
                               ["coh_modelYearGroupID", "sb_modelYearGroupID"]] } ],
            "expr": 1.0 } },

        { "lhs": "cohq_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" } }, "expr": "e" } },
        { "lhs": "cohq_fuelOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "flat_relation_major",
              "bindings": { "position": "e", "block_size": "n_agecategory" } } } },
        { "lhs": "cohq_ageOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "flat_relation_minor",
              "bindings": { "position": "e", "block_size": "n_agecategory" } } } },
        { "lhs": "cohq_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "u": { "from": "runspecsourcefueltype_rows" } },
            "join": [ { "on": [["cohq_fuelOrdinal", "rsft_ordinal"]] } ],
            "expr": { "op": "index", "args": ["rsft_fuelTypeID", "u"] } } },
        { "lhs": "cohq_modelYearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "g": { "from": "agecategory_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["cohq_ageOrdinal", "ac_ordinal"]] } ],
            "expr": { "op": "-", "args": [
              { "op": "index", "args": ["run_yearID", "n"] },
              { "op": "index", "args": ["ac_ageID", "g"] }] } } },
        { "lhs": "cohq_engTechID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["cohq_modelYearID", "svp_modelYearID"],
                               ["cohq_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_engTechID", "v"] } } },
        {
          "_comment": "C2' on the equipped side. The two sides of the fuel-usage rebase must apply the SAME bin key rule or the match pairs nothing at all.",
          "lhs": "cohq_binRegClassID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["cohq_modelYearID", "svp_modelYearID"],
                               ["cohq_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [{ "op": "index", "args": ["run_isRegClassReqd", "n"] }, 0.0] },
              { "op": "index", "args": ["svp_regClassID", "v"] },
              0.0] } } },
        { "lhs": "cohq_modelYearGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "y": { "from": "pollutantprocessmodelyear_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppmy_polProcessID"],
                               ["cohq_modelYearID", "ppmy_modelYearID"]] } ],
            "expr": { "op": "index", "args": ["ppmy_modelYearGroupID", "y"] } } },
        { "lhs": "cohq_sourceBinActivityFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "c": { "from": "cohort_rows" } },
            "join": [ { "on": [["cohq_ordinal", "coh_ordinal"]] } ],
            "expr": { "op": "index", "args": ["coh_sourceBinActivityFraction", "c"] } } },
        {
          "_comment": "C4, source_bin_distribution_generator.rs:1590-1637: the same activity re-attributed to the fuel each cohort actually BURNS. Only the wildcard branch of the model-year-group condition is modelled, which fuelUsageWildcardCount licenses.",
          "lhs": "coh_usedFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "e": { "from": "cohort_equipped_rows" },
                        "f": { "from": "fuelusagefraction_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["coh_modelYearID", "cohq_modelYearID"],
                               ["coh_engTechID", "cohq_engTechID"],
                               ["coh_binRegClassID", "cohq_binRegClassID"],
                               ["coh_modelYearGroupID", "cohq_modelYearGroupID"]] },
                      { "on": [["cohq_fuelTypeID", "fuf_sourceBinFuelTypeID"],
                               ["coh_fuelTypeID", "fuf_fuelSupplyFuelTypeID"]] },
                      { "on": [["fuf_countyID", "run_countyID"],
                               ["fuf_fuelYearID", "run_fuelYearID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["fuf_usageFraction", "f"] },
                { "op": "index", "args": ["cohq_sourceBinActivityFraction", "e"] }] },
              { "op": "index", "args": ["coh_binExists", "c"] }] } } },

        {
          "_comment": "The bin's components brought onto the 968-row rate relation, pre-attached so PC-1b is a two-relation contraction (finding F17).",
          "lhs": "era_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] } ],
            "expr": { "op": "index", "args": ["sb_fuelTypeID", "b"] } } },
        { "lhs": "era_engTechID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] } ],
            "expr": { "op": "index", "args": ["sb_engTechID", "b"] } } },
        { "lhs": "era_regClassID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] } ],
            "expr": { "op": "index", "args": ["sb_regClassID", "b"] } } },
        { "lhs": "era_modelYearGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] } ],
            "expr": { "op": "index", "args": ["sb_modelYearGroupID", "b"] } } },
        { "lhs": "era_isEvapFuel",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" },
                        "u": { "from": "fueltype_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] },
                      { "on": [["sb_fuelTypeID", "ft_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["ft_subjectToEvapCalculations", "u"] } } },
        { "lhs": "era_isRunPolProcess",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["era_polProcessID", "run_polProcessID"]] } ],
            "expr": 1.0 } },
        {
          "_comment": "PC-1a and PC-1b's inner sum in one two-relation contraction. Five key pairs: the bin's four components -- with C2's regulatory class -- and PC-1a's age group. The join does NOT constrain opModeID, exactly as PC-1b's does not, so the weighted rate has no operating-mode axis.",
          "lhs": "coh_binWeightedRate",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "a": { "from": "emissionratebyage_rows" } },
            "join": [ { "on": [["coh_fuelTypeID", "era_fuelTypeID"],
                               ["coh_engTechID", "era_engTechID"],
                               ["coh_binRegClassID", "era_regClassID"],
                               ["coh_modelYearGroupID", "era_modelYearGroupID"],
                               ["coh_ageGroupID", "era_ageGroupID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["coh_usedFraction", "c"] },
                { "op": "index", "args": ["era_meanBaseRate", "a"] }] },
              { "op": "*", "args": [
                { "op": "index", "args": ["era_isEvapFuel", "a"] },
                { "op": "index", "args": ["era_isRunPolProcess", "a"] }] }] } } },
        {
          "_comment": "PC-1b's WithRegClassID split, re-collapsed: PC-6 aggregates regClassID away and nothing between them keys on it, so the SUM of the fractions is the whole of the split.",
          "lhs": "coh_regClassFractionTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "g": { "from": "regclasssourcetypefraction_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "rcs_sourceTypeID"],
                               ["coh_fuelTypeID", "rcs_fuelTypeID"],
                               ["coh_modelYearID", "rcs_modelYearID"]] } ],
            "expr": { "op": "index", "args": ["rcs_regClassFraction", "g"] } } },
        { "lhs": "coh_permeationRate",
          "rhs": { "op": "*", "args": ["coh_binWeightedRate", "coh_regClassFractionTotal"] } },
        { "lhs": "coh_hasRate",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "a": { "from": "emissionratebyage_rows" } },
            "join": [ { "on": [["coh_fuelTypeID", "era_fuelTypeID"],
                               ["coh_engTechID", "era_engTechID"],
                               ["coh_binRegClassID", "era_regClassID"],
                               ["coh_modelYearGroupID", "era_modelYearGroupID"],
                               ["coh_ageGroupID", "era_ageGroupID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["era_isEvapFuel", "a"] },
              { "op": "index", "args": ["era_isRunPolProcess", "a"] }] } } },
        { "lhs": "coh_survives",
          "rhs": { "op": "*", "args": ["coh_isSelected", "coh_hasRate"] } },
        { "lhs": "cohortSurvivorCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "c": { "from": "cohort_rows" } },
            "expr": { "op": "index", "args": ["coh_survives", "c"] } } },

        {
          "_comment": "PC-3's fuel supply, resolved on the 5-row supply relation before the coefficient contraction reaches it: the formulation's subtype, its fuel type, its ethanol volume and the one-row Year existence check.",
          "lhs": "fsu_fuelSubtypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["s"],
            "ranges": { "s": { "from": "fuelsupply_rows" }, "f": { "from": "fuelformulation_rows" } },
            "join": [ { "on": [["fsu_fuelFormulationID", "ffo_fuelFormulationID"]] } ],
            "expr": { "op": "index", "args": ["ffo_fuelSubtypeID", "f"] } } },
        { "lhs": "fsu_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["s"],
            "ranges": { "s": { "from": "fuelsupply_rows" }, "u": { "from": "fuelsubtype_rows" } },
            "join": [ { "on": [["fsu_fuelSubtypeID", "fst_fuelSubtypeID"]] } ],
            "expr": { "op": "index", "args": ["fst_fuelTypeID", "u"] } } },
        { "lhs": "fsu_etohVolumeRaw",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["s"],
            "ranges": { "s": { "from": "fuelsupply_rows" }, "f": { "from": "fuelformulation_rows" } },
            "join": [ { "on": [["fsu_fuelFormulationID", "ffo_fuelFormulationID"]] } ],
            "expr": { "op": "index", "args": ["ffo_etohVolume", "f"] } } },
        {
          "_comment": "`update FuelFormulation set ETOHVolume = 0 where ETOHVolume is null`, the Processing section's opening statement, as the NaN test the ingest boundary leaves behind. An absent volume would otherwise satisfy every half-open bracket and sum all eight coefficients.",
          "lhs": "fsu_etohVolume",
          "rhs": { "op": "ifelse", "args": [
            { "op": "==", "args": ["fsu_etohVolumeRaw", "fsu_etohVolumeRaw"] },
            "fsu_etohVolumeRaw", 0.0] } },
        { "lhs": "fsu_isRunFuelYear",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["s"],
            "ranges": { "s": { "from": "fuelsupply_rows" }, "y": { "from": "year_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["fsu_fuelYearID", "yr_fuelYearID"]] },
                      { "on": [["yr_yearID", "run_yearID"]] } ],
            "expr": 1.0 } },
        {
          "_comment": "The ethanol bracket brought onto the 120-row coefficient relation, so PC-3 below contracts four relations rather than five.",
          "lhs": "hpc_etohThreshLow",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["h"],
            "ranges": { "h": { "from": "hcpermeationcoeff_rows" }, "b": { "from": "etohbin_rows" } },
            "join": [ { "on": [["hpc_etohThreshID", "ebn_etohThreshID"]] } ],
            "expr": { "op": "index", "args": ["ebn_etohThreshLow", "b"] } } },
        { "lhs": "hpc_etohThreshHigh",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["h"],
            "ranges": { "h": { "from": "hcpermeationcoeff_rows" }, "b": { "from": "etohbin_rows" } },
            "join": [ { "on": [["hpc_etohThreshID", "ebn_etohThreshID"]] } ],
            "expr": { "op": "index", "args": ["ebn_etohThreshHigh", "b"] } } },
        {
          "_comment": "PC-3. Three ON-less SQL joins (FuelSupply x County x HCPermeationCoeff) narrowed by the mapped model year, the fuel subtype's fuel type, the calendar year and the ethanol bracket. The bracket is a half-open MEMBERSHIP test and therefore a 0/1 factor rather than a join key; lib/adjustments.esm's `gpa_blend` is the same template the air-toxics fuel effects use.",
          "lhs": "coh_weightedFuelAdjustment",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "s": { "from": "fuelsupply_rows" },
                        "h": { "from": "hcpermeationcoeff_rows" },
                        "y": { "from": "pollutantprocessmappedmodelyear_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["hpc_polProcessID", "run_polProcessID"]] },
                      { "on": [["hpc_polProcessID", "ppmmy_polProcessID"],
                               ["hpc_fuelMYGroupID", "ppmmy_fuelMYGroupID"],
                               ["coh_modelYearID", "ppmmy_modelYearID"]] },
                      { "on": [["coh_fuelTypeID", "fsu_fuelTypeID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["fsu_marketShare", "s"] },
                { "op": "apply_expression_template", "args": [], "name": "gpa_blend",
                  "bindings": {
                    "ratio": { "op": "index", "args": ["hpc_fuelAdjustment", "h"] },
                    "ratio_gpa": { "op": "index", "args": ["hpc_fuelAdjustmentGPA", "h"] },
                    "gpa_fraction": { "op": "index", "args": ["run_gpaFraction", "n"] } } }] },
              { "op": "*", "args": [
                { "op": "apply_expression_template", "args": [], "name": "in_half_open_range",
                  "bindings": {
                    "value": { "op": "index", "args": ["fsu_etohVolume", "s"] },
                    "lower": { "op": "index", "args": ["hpc_etohThreshLow", "h"] },
                    "upper": { "op": "index", "args": ["hpc_etohThreshHigh", "h"] } } },
                { "op": "index", "args": ["fsu_isRunFuelYear", "s"] }] }] } } },
        {
          "_comment": "PC-4. The `INNER JOIN Year (yearID, fuelYearID)` PC-4 also carries is the same one-row existence check `fsu_isRunFuelYear` already applied to the supply that produced this adjustment, and is not written twice.",
          "lhs": "coh_fuelAdjustedRate",
          "rhs": { "op": "*", "args": ["coh_permeationRate", "coh_weightedFuelAdjustment"] } },

        {
          "_comment": "PC-6's SourceTypeModelYearGroup gate, resolved forward onto the cohort so that it becomes a join key on the tank temperature rather than a test at the output.",
          "lhs": "coh_tankTemperatureGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "g": { "from": "sourcetypemodelyeargroup_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "stmyg_sourceTypeID"],
                               ["coh_modelYearGroupID", "stmyg_modelYearGroupID"]] } ],
            "expr": { "op": "index", "args": ["stmyg_tankTemperatureGroupID", "g"] } } },
        {
          "_comment": "PC-2a on the keys that reach the output. The SQL cross-joins AverageTankTemperature with TemperatureAdjustment and then expands the pair across the adjustment's model-year range; the adjustment does not depend on the model year, so the expansion is a RANGE TEST and is written as the `filter` -- lib/keys.esm's `model_year_in_range`, which carries no `==` and is therefore a predicate rather than a join in disguise.",
          "lhs": "cohDay_tempAdjustByMode",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c", "k", "m"],
            "ranges": { "c": { "from": "cohort_rows" }, "k": { "from": "runspecday_rows" },
                        "m": { "from": "evap_op_mode_rows" },
                        "p": { "from": "averagetanktemperature_rows" },
                        "x": { "from": "temperatureadjustment_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["coh_tankTemperatureGroupID", "att_tankTemperatureGroupID"],
                               ["day_hourDayID", "att_hourDayID"],
                               ["mode_opModeID", "att_opModeID"]] },
                      { "on": [["att_zoneID", "run_zoneID"], ["att_monthID", "run_monthID"]] },
                      { "on": [["coh_fuelTypeID", "ta_fuelTypeID"],
                               ["ta_polProcessID", "run_polProcessID"]] } ],
            "filter": { "op": "apply_expression_template", "args": [], "name": "model_year_in_range",
              "bindings": {
                "model_year": { "op": "index", "args": ["coh_modelYearID", "c"] },
                "first_model_year": { "op": "index", "args": ["ta_minModelYearID", "x"] },
                "last_model_year": { "op": "index", "args": ["ta_maxModelYearID", "x"] } } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "tank_temperature_adjustment",
              "bindings": {
                "term_a": { "op": "index", "args": ["ta_tempAdjustTermA", "x"] },
                "term_b": { "op": "index", "args": ["ta_tempAdjustTermB", "x"] },
                "temperature": { "op": "index", "args": ["att_averageTankTemperature", "p"] } } } } },
        {
          "_comment": "PC-2b. The two soak modes are summed at a weight this document computed to be exactly zero rather than being left out, so what is written is the reference's whole expression and the zero is visible inside it (docs/esm-conventions.md 23).",
          "lhs": "cohDay_weightedTemperatureAdjust",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c", "k"],
            "ranges": { "c": { "from": "cohort_rows" }, "k": { "from": "runspecday_rows" },
                        "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["cohDay_tempAdjustByMode", "c", "k", "m"] },
              { "op": "index", "args": ["omd_opModeFraction", "k", "m"] }] } } },

        { "lhs": "fuelUsageWildcardCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "f": { "from": "fuelusagefraction_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [{ "op": "index", "args": ["fuf_modelYearGroupID", "f"] }, 0.0] },
              0.0, 1.0] } } },
        { "lhs": "sourceBinZeroSlotCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "b": { "from": "sourcebin_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": "and", "args": [
                { "op": "<=", "args": [{ "op": "index", "args": ["sb_engSizeID", "b"] }, 0.0] },
                { "op": "<=", "args": [{ "op": "index", "args": ["sb_weightClassID", "b"] }, 0.0] }] },
              1.0, 0.0] } } },
        { "lhs": "sourceBinRegClassZeroCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "b": { "from": "sourcebin_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": "<=", "args": [{ "op": "index", "args": ["sb_regClassID", "b"] }, 0.0] },
              1.0, 0.0] } } },
        { "lhs": "evapFuelCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "u": { "from": "fueltype_rows" } },
            "expr": { "op": "index", "args": ["ft_subjectToEvapCalculations", "u"] } } },
        { "lhs": "modeAssociationCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "index", "args": ["mode_isAssociated", "m"] } } },
        { "lhs": "rateNonOperatingRowCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "a": { "from": "emissionratebyage_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [
                { "op": "abs", "args": [{ "op": "-", "args": [
                  { "op": "index", "args": ["era_opModeID", "a"] },
                  { "op": "enum", "args": ["operating_mode", "Operating"] }] }] }, 0.0] },
              1.0, 0.0] } } },
        { "lhs": "suppliedEtohAbsentCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "fuelsupply_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": "==", "args": [
                { "op": "index", "args": ["fsu_etohVolumeRaw", "s"] },
                { "op": "index", "args": ["fsu_etohVolumeRaw", "s"] }] },
              0.0, 1.0] } } },
        { "lhs": "cohortTankGroupCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "c": { "from": "cohort_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["coh_survives", "c"] },
              { "op": "ifelse", "args": [
                { "op": ">", "args": [{ "op": "index", "args": ["coh_tankTemperatureGroupID", "c"] }, 0.0] },
                1.0, 0.0] }] } } },
        { "lhs": "cohortRegClassFractionCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "c": { "from": "cohort_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["coh_survives", "c"] },
              { "op": "ifelse", "args": [
                { "op": ">", "args": [{ "op": "index", "args": ["coh_regClassFractionTotal", "c"] }, 0.0] },
                1.0, 0.0] }] } } },
        {
          "_comment": "The weight the two SOAK operating modes carry into PC-2b, summed over both day types: exactly 0. This is the measurement docs/evap-permeation.md 0.3 makes by perturbation, made here as an assertion instead -- so a run in which the read tank temperatures COULD reach an output digit fails here first.",
          "lhs": "tankTemperatureSoakWeight",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["j"],
            "ranges": { "j": { "from": "run_rows" }, "k": { "from": "runspecday_rows" },
                        "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["omd_opModeFraction", "k", "m"] },
              { "op": "index", "args": ["omd_hasSoakRow", "k", "m"] }] } } },

        {
          "_comment": "O1's row structure: day-major blocks of n_outputCohort surviving cohorts, decoded by lib/keys.esm's flat-relation templates.",
          "lhs": "outDayOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "flat_relation_major",
              "bindings": { "position": "o", "block_size": "n_outputCohort" } } } },
        { "lhs": "outCohortOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "flat_relation_minor",
              "bindings": { "position": "o", "block_size": "n_outputCohort" } } } },
        {
          "_comment": "THE DECLARED STRUCTURE: the surviving cohorts are all of the first fuel's n_agecategory model years followed by the third fuel's leading block, so the map into the 164-row candidate relation skips the second fuel's n_agecategory rows.",
          "lhs": "outCohortRow",
          "rhs": { "op": "ifelse", "args": [
            { "op": "<=", "args": ["outCohortOrdinal", "n_agecategory"] },
            "outCohortOrdinal",
            { "op": "+", "args": ["outCohortOrdinal", "n_agecategory"] }] } },
        { "lhs": "out_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "c": { "from": "cohort_rows" } },
            "join": [ { "on": [["outCohortRow", "coh_ordinal"]] } ],
            "expr": { "op": "index", "args": ["coh_fuelTypeID", "c"] } } },
        { "lhs": "out_modelYearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "c": { "from": "cohort_rows" } },
            "join": [ { "on": [["outCohortRow", "coh_ordinal"]] } ],
            "expr": { "op": "index", "args": ["coh_modelYearID", "c"] } } },
        { "lhs": "out_dayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["outDayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["rsd_dayID", "k"] } } },
        { "lhs": "outHourDayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["outDayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["day_hourDayID", "k"] } } },
        { "lhs": "outAgeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "-", "args": [
              { "op": "index", "args": ["run_yearID", "n"] },
              { "op": "index", "args": ["out_modelYearID", "o"] }] } } },
        { "lhs": "outSourceHours",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "r": { "from": "activity_rows" } },
            "join": [ { "on": [["outHourDayID", "act_hourDayID"], ["outAgeID", "act_ageID"]] } ],
            "expr": { "op": "index", "args": ["act_sourceHours", "r"] } } },
        { "lhs": "outNoOfRealDays",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "w": { "from": "dayofanyweek_rows" } },
            "join": [ { "on": [["out_dayID", "dow_dayID"]] } ],
            "expr": { "op": "index", "args": ["dow_noOfRealDays", "w"] } } },
        {
          "_comment": "PC-5, with the reference's grouping: (rate x hours) / days.",
          "lhs": "outFuelAdjustedQuant",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "c": { "from": "cohort_rows" } },
            "join": [ { "on": [["outCohortRow", "coh_ordinal"]] } ],
            "expr": { "op": "/", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["coh_fuelAdjustedRate", "c"] },
                { "op": "index", "args": ["outSourceHours", "o"] }] },
              { "op": "index", "args": ["outNoOfRealDays", "o"] }] } } },
        { "lhs": "outWeightedTemperatureAdjust",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "c": { "from": "cohort_rows" },
                        "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["outCohortRow", "coh_ordinal"]] },
                      { "on": [["outDayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["cohDay_weightedTemperatureAdjust", "c", "k"] } } },
        {
          "_comment": "PC-6.",
          "lhs": "out_emissionQuant",
          "rhs": { "op": "*", "args": ["outWeightedTemperatureAdjust", "outFuelAdjustedQuant"] } },

        { "lhs": "out_yearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_yearID", "n"] } } },
        { "lhs": "out_monthID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_monthID", "n"] } } },
        { "lhs": "out_hourID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_hourID", "n"] } } },
        { "lhs": "out_stateID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_stateID", "n"] } } },
        { "lhs": "out_countyID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_countyID", "n"] } } },
        { "lhs": "out_sourceTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_sourceTypeID", "n"] } } },
        { "lhs": "out_roadTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_linkRoadTypeID", "n"] } } },
        { "lhs": "out_pollutantID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_pollutantID", "n"] } } },
        { "lhs": "out_processID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_processID", "n"] } } },
        { "lhs": "out_SCC",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "onroad_scc",
            "bindings": { "fuel_type_id": "out_fuelTypeID", "source_type_id": "out_sourceTypeID",
                          "road_type_id": "out_roadTypeID", "process_id": "out_processID" } } },
        {
          "_comment": "The seven identity columns MOVESOutput leaves NULL on this run, emitted as NaN through one template so the claim is made in one place.",
          "lhs": "out_zoneID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_linkID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_regClassID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_fuelSubTypeID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_engTechID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_sectorID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_hpID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "absentRegClassIndicator",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "output_column_is_absent",
            "bindings": { "column": "out_regClassID" } } },
        { "lhs": "presentQuantIndicator",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "output_column_is_absent",
            "bindings": { "column": "out_emissionQuant" } } }
      ],

      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "The scope every join in this document is filtered by, read from the `runspec*` tables, the link and the county. Month 8, hour 7, source type 21, road type 4, county 26161, zone 261610, state 26, and polProcessID 111 built from the two enums. What breaks if this is wrong: the RunSpec XML says `<month key=\"7\">` and `<beginhour key=\"6\">`, which are 0-based INDICES into sorted ID lists and not identifiers, and `<day key=\"5\">` is out of range for the sorted DayOfAnyWeek list and falls back to both day types. A document scoped from the XML emits 128 rows with the wrong month and hour in every one. `run_gpaFraction` is here too because PC-3's blend selects its ordinary arm only at 0 and the number is READ (docs/evap-permeation.md 0.1, 7.1).",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "run_yearID", "time": 0.0, "expected": 2020.0, "coords": { "run_rows": 1 } },
            { "variable": "run_monthID", "time": 0.0, "expected": 8.0, "coords": { "run_rows": 1 } },
            { "variable": "run_hourID", "time": 0.0, "expected": 7.0, "coords": { "run_rows": 1 } },
            { "variable": "run_sourceTypeID", "time": 0.0, "expected": 21.0, "coords": { "run_rows": 1 } },
            { "variable": "run_roadTypeID", "time": 0.0, "expected": 4.0, "coords": { "run_rows": 1 } },
            { "variable": "run_countyID", "time": 0.0, "expected": 26161.0, "coords": { "run_rows": 1 } },
            { "variable": "run_zoneID", "time": 0.0, "expected": 261610.0, "coords": { "run_rows": 1 } },
            { "variable": "run_stateID", "time": 0.0, "expected": 26.0, "coords": { "run_rows": 1 } },
            { "variable": "run_polProcessID", "time": 0.0, "expected": 111.0, "coords": { "run_rows": 1 } },
            { "variable": "run_pollutantID", "time": 0.0, "expected": 1.0, "coords": { "run_rows": 1 } },
            { "variable": "run_processID", "time": 0.0, "expected": 11.0, "coords": { "run_rows": 1 } },
            { "variable": "run_gpaFraction", "time": 0.0, "expected": 0.0, "coords": { "run_rows": 1 } },
            { "variable": "run_fuelYearID", "time": 0.0, "expected": 2020.0, "coords": { "run_rows": 1 } }
          ]
        },
        {
          "id": "the_source_bin_key_rule_is_read_per_process_and_it_is_not_the_leaks_rule",
          "description": "C2', and it is the one thing in this fixture that a sibling evaporative fixture's spine gets WRONG rather than merely differently. `sourcetypepolprocess.isRegClassReqd` is 'N' for (21, 111), so SourceBinDistributionGenerator collapses regClassID to 0 in the bin key: all 80 of this snapshot's source bins carry 0 where all 80 of the process-evap-leaks snapshot's carry 20. The sample vehicle still says 20 -- `coh_svpRegClassID` reads it -- and `coh_binRegClassID` discards it, which is what makes `coh_binExists` 1 rather than 0. What breaks if this is wrong: carrying 20 into the bin key makes every one of the 125 selected cohorts match none of the 80 bins, so `coh_binExists`, `coh_usedFraction`, `coh_binWeightedRate` and `coh_hasRate` are all 0, `cohortSurvivorCount` is 0 and the fixture emits 128 rows of zero against a 128-row truth -- a per-cell failure at every cell, with nothing in the output to say which join did it. docs/esm-conventions.md 34.1.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "run_isRegClassReqd", "time": 0.0, "expected": 0.0, "coords": { "run_rows": 1 } },
            { "variable": "sourceBinRegClassZeroCount", "time": 0.0, "expected": 80.0, "coords": { "run_rows": 1 } },
            { "variable": "coh_svpRegClassID", "time": 0.0, "expected": 20.0, "coords": { "cohort_rows": 1 } },
            { "variable": "coh_binRegClassID", "time": 0.0, "expected": 0.0, "coords": { "cohort_rows": 1 } },
            { "variable": "cohq_binRegClassID", "time": 0.0, "expected": 0.0, "coords": { "cohort_equipped_rows": 1 } },
            { "variable": "coh_binExists", "time": 0.0, "expected": 1.0, "coords": { "cohort_rows": 1 } },
            { "variable": "coh_binExists", "time": 0.0, "expected": 1.0, "coords": { "cohort_rows": 101 } }
          ]
        },
        {
          "id": "the_link_is_on_network_which_is_what_the_operating_mode_split_rests_on",
          "description": "A10: an on-network link takes SourceHours = SHO and the off-network one takes SHP. The link's road type is 4, so the two activity relations are the same numbers row for row, E1's ratio is EXACTLY 1, and both soak modes enter PC-2b at a computed zero. What breaks if this is wrong: on an off-network link `fractionOfOperating` would be 8.6e-05 and every soak weight would come alive -- and this document does not compute SHP, so it emits not-a-number there rather than reusing SHO.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "run_linkRoadTypeID", "time": 0.0, "expected": 4.0, "coords": { "run_rows": 1 } },
            { "variable": "run_isOnNetworkLink", "time": 0.0, "expected": 1.0, "coords": { "run_rows": 1 } },
            { "variable": "run_baseYearIsAnalysisYear", "time": 0.0, "expected": 1.0, "coords": { "run_rows": 1 } }
          ]
        },
        {
          "id": "the_derived_axes_are_measured_and_the_declared_one_is_checked",
          "description": "The activity relation is n_agecategory x n_runspecday = 82 rows and the cohort relation n_agecategory x n_runspecsourcefueltype = 164, both from extents the runtime discovers; the ordinals below prove the block structure those sizes imply, decoded by lib/keys.esm's `flat_relation_major` / `flat_relation_minor` rather than by two hand-written floor divisions that could disagree about a boundary. The ONE declared number, `n_outputCohort` = 64, is checked against `cohortSurvivorCount`, which counts the cohorts the chain itself keeps. What breaks if this is wrong: a chain producing 63 or 65 survivors emits 128 rows against a 126- or 130-row truth and the comparator reports missing and extra keys with no attribution.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "act_dayOrdinal", "time": 0.0, "expected": 1.0, "coords": { "activity_rows": 41 } },
            { "variable": "act_dayOrdinal", "time": 0.0, "expected": 2.0, "coords": { "activity_rows": 42 } },
            { "variable": "act_ageOrdinal", "time": 0.0, "expected": 41.0, "coords": { "activity_rows": 41 } },
            { "variable": "coh_fuelOrdinal", "time": 0.0, "expected": 3.0, "coords": { "cohort_rows": 101 } },
            { "variable": "coh_ageOrdinal", "time": 0.0, "expected": 19.0, "coords": { "cohort_rows": 101 } },
            { "variable": "cohortSurvivorCount", "time": 0.0, "expected": 64.0, "coords": { "run_rows": 1 } },
            { "variable": "cohortTankGroupCount", "time": 0.0, "expected": 64.0, "coords": { "run_rows": 1 } },
            { "variable": "cohortRegClassFractionCount", "time": 0.0, "expected": 64.0, "coords": { "run_rows": 1 } },
            { "variable": "outCohortRow", "time": 0.0, "expected": 41.0, "coords": { "output_rows": 41 } },
            { "variable": "outCohortRow", "time": 0.0, "expected": 101.0, "coords": { "output_rows": 60 } }
          ]
        },
        {
          "id": "the_activity_chain_reproduces_the_reference",
          "description": "A1 through A10 at the three ages docs/evap-leaks.md 6.0 tabulates, in both day types -- the activity chain is shared with the two landed evaporative fixtures and reaches the same numbers here from this snapshot's own tables. The snapshot's own `sho` table -- which this document does not read -- stores 27.33, 2.43728, 260.057 and 23.1918 against the values pinned here, and ./run-permeation-oracle.sh reproduces all 82 rows of `SHO` and all 82 of `SourceHours` to 3.610e-06. What breaks if this is wrong: A6 as the harmonic mean instead of the arithmetic one is 24% and 58% low and A8 divides by it; omitting A7's weeksPerMonth divisor is 4.43x; normalising A3 over the run's source type instead of its HPMS group is 2.55x.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "run_travelGroupTotal", "time": 0.0, "expected": 182397687.37007642, "coords": { "run_rows": 1 } },
            { "variable": "act_averageSpeed", "time": 0.0, "expected": 67.0416879, "coords": { "activity_rows": 1 } },
            { "variable": "act_averageSpeed", "time": 0.0, "expected": 56.361205525, "coords": { "activity_rows": 42 } },
            { "variable": "act_sourceHours", "time": 0.0, "expected": 27.330001837636907, "coords": { "activity_rows": 1 } },
            { "variable": "act_sourceHours", "time": 0.0, "expected": 2.4372787128844648, "coords": { "activity_rows": 41 } },
            { "variable": "act_sourceHours", "time": 0.0, "expected": 260.0573038920831, "coords": { "activity_rows": 42 } },
            { "variable": "act_sourceHours", "time": 0.0, "expected": 23.191807108971084, "coords": { "activity_rows": 82 } }
          ]
        },
        {
          "id": "the_operating_mode_split_puts_every_gram_on_mode_300",
          "description": "E1, E2 and E3, and the reason this fixture is allowed to READ `averagetanktemperature` without the read hiding anything. `fractionOfOperating` is 1 on both day types -- exactly, because A10 makes the numerator and the denominator the same 41 numbers -- so the soak modes take `soakActivityFraction x (1 - 1)` and operating mode 300 takes the residual 1. `tankTemperatureSoakWeight` sums the two soak weights over both day types and gets exactly 0, which is docs/evap-permeation.md 0.3's perturbation measurement written as an assertion. What breaks if this is wrong: the two soak fractions this fixture ingests are 0.00668717 and 0.993313 at hourDayID 72, so a document that took them at face value would put 99.3% of the activity on the cold-soak tank temperature instead of the operating one -- and the operating-mode-300 weight is what makes the 192 soak cells of the tank-temperature table unable to move an output digit.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "day_fractionOfOperating", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 1 } },
            { "variable": "day_fractionOfOperating", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 2 } },
            { "variable": "omd_soakActivityFraction", "time": 0.0, "expected": 0.00668717, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 1 } },
            { "variable": "omd_soakActivityFraction", "time": 0.0, "expected": 0.993313, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 2 } },
            { "variable": "omd_hasSoakRow", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 2 } },
            { "variable": "omd_opModeFraction", "time": 0.0, "expected": 0.0, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 1 } },
            { "variable": "omd_opModeFraction", "time": 0.0, "expected": 0.0, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 2 } },
            { "variable": "omd_opModeFraction", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 3 } },
            { "variable": "omd_opModeFraction", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 2, "evap_op_mode_rows": 3 } },
            { "variable": "modeAssociationCount", "time": 0.0, "expected": 3.0, "coords": { "run_rows": 1 } },
            { "variable": "tankTemperatureSoakWeight", "time": 0.0, "expected": 0.0, "coords": { "run_rows": 1 } }
          ]
        },
        {
          "id": "the_fuel_usage_rebase_moves_the_e85_cohort_by_a_factor_of_56",
          "description": "C3 against C4 on model year 2002. The raw stmyFractions are 0.985305968751 gasoline and 0.007914838927 E85; after the rebase, gasoline holds 0.9930794011657301 and E85 0.000141406512269782, because 0.982134 of E85-equipped activity is attributed to the gasoline it actually burns. What breaks if this is wrong: the two bins carry the SAME rate at this age group, so the sum over the two fuels is invariant and only the split is wrong -- by a factor of 56 on the E85 cell. The rebase's equipped-to-used match runs on `coh_binRegClassID` on BOTH sides; with the sample vehicle's class on one side and the bin's 0 on the other it pairs nothing.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "coh_stmyFraction", "time": 0.0, "expected": 0.985305968751, "coords": { "cohort_rows": 19 } },
            { "variable": "coh_usedFraction", "time": 0.0, "expected": 0.9930794011657301, "coords": { "cohort_rows": 19 } },
            { "variable": "coh_stmyFraction", "time": 0.0, "expected": 0.007914838927, "coords": { "cohort_rows": 101 } },
            { "variable": "coh_usedFraction", "time": 0.0, "expected": 0.000141406512269782, "coords": { "cohort_rows": 101 } },
            { "variable": "fuelUsageWildcardCount", "time": 0.0, "expected": 5.0, "coords": { "run_rows": 1 } },
            { "variable": "sourceBinZeroSlotCount", "time": 0.0, "expected": 80.0, "coords": { "run_rows": 1 } },
            { "variable": "evapFuelCount", "time": 0.0, "expected": 2.0, "coords": { "run_rows": 1 } }
          ]
        },
        {
          "id": "pc1_weights_the_base_rate_by_bin_and_by_regulatory_class",
          "description": "PC-1a and PC-1b at four cohorts. `emissionratebyage` carries seven age-group rates per bin and PC-1a's tag picks the one whose group contains `runYear - modelYearID`; `coh_regClassFractionTotal` is PC-1b's WithRegClassID split re-collapsed, 1.0 on every selected cohort, and `rateNonOperatingRowCount` records that this extract has no soak-mode rate row -- PC-1b's join does not constrain the operating mode, so a rate table that had one would sum it in and this fixture could not tell. What breaks if this is wrong: dropping the age-group pair from the key sums all seven rates instead of one, which is the largest single-factor error available in this slice.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "coh_ageGroupID", "time": 0.0, "expected": 3.0, "coords": { "cohort_rows": 1 } },
            { "variable": "coh_ageGroupID", "time": 0.0, "expected": 2099.0, "coords": { "cohort_rows": 41 } },
            { "variable": "coh_regClassFractionTotal", "time": 0.0, "expected": 1.0, "coords": { "cohort_rows": 1 } },
            { "variable": "coh_regClassFractionTotal", "time": 0.0, "expected": 1.0, "coords": { "cohort_rows": 101 } },
            { "variable": "rateNonOperatingRowCount", "time": 0.0, "expected": 0.0, "coords": { "run_rows": 1 } },
            { "variable": "coh_permeationRate", "time": 0.0, "expected": 0.0039292014652603721, "coords": { "cohort_rows": 1 } },
            { "variable": "coh_permeationRate", "time": 0.0, "expected": 0.010129409891890448, "coords": { "cohort_rows": 19 } },
            { "variable": "coh_permeationRate", "time": 0.0, "expected": 0.19161918659313301, "coords": { "cohort_rows": 41 } },
            { "variable": "coh_permeationRate", "time": 0.0, "expected": 1.4423464251517765e-06, "coords": { "cohort_rows": 101 } }
          ]
        },
        {
          "id": "pc3_narrows_the_fuel_adjustment_through_the_ethanol_bin_and_the_mapped_model_year",
          "description": "PC-3. Of the five supplied formulations, one is gasoline (9114, 10% ethanol) and one is E85 (27002, also 10% ethanol in this supply); 28001's fuel subtype 30 has no `fuelsubtype` row and drops out. The ethanol volume selects bin 3, [9, 12.5), and the mapped model-year group then picks the coefficient: 2.1383 for model years 1999 and later, 2.0728 at 1998, 1.7545 at 1996-1997 and 1.6593 at 1980-1995. What breaks if this is wrong: joining on `modelYearGroupID` instead of `fuelMYGroupID` -- adjacent columns of the same table, 19781995 against 19751986 for model year 1980 -- admits nothing and every cell reads zero; using an inclusive upper bracket instead of the half-open one would put a 12.5% blend in two bins at once. Two of this step's three factors are INERT here and are written anyway: every marketShare is 1.0, and GPAFract is 0 so `gpa_blend` never selects its GPA arm (docs/evap-permeation.md 7.1).",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "fsu_fuelTypeID", "time": 0.0, "expected": 1.0, "coords": { "fuelsupply_rows": 2 } },
            { "variable": "fsu_fuelTypeID", "time": 0.0, "expected": 5.0, "coords": { "fuelsupply_rows": 4 } },
            { "variable": "fsu_fuelTypeID", "time": 0.0, "expected": 0.0, "coords": { "fuelsupply_rows": 5 } },
            { "variable": "fsu_etohVolume", "time": 0.0, "expected": 10.0, "coords": { "fuelsupply_rows": 2 } },
            { "variable": "fsu_isRunFuelYear", "time": 0.0, "expected": 1.0, "coords": { "fuelsupply_rows": 2 } },
            { "variable": "suppliedEtohAbsentCount", "time": 0.0, "expected": 0.0, "coords": { "run_rows": 1 } },
            { "variable": "coh_weightedFuelAdjustment", "time": 0.0, "expected": 2.1383, "coords": { "cohort_rows": 1 } },
            { "variable": "coh_weightedFuelAdjustment", "time": 0.0, "expected": 1.6593, "coords": { "cohort_rows": 41 } },
            { "variable": "coh_weightedFuelAdjustment", "time": 0.0, "expected": 2.0728, "coords": { "cohort_rows": 105 } },
            { "variable": "coh_weightedFuelAdjustment", "time": 0.0, "expected": 2.1383, "coords": { "cohort_rows": 101 } }
          ]
        },
        {
          "id": "pc2_weights_three_tank_temperatures_and_two_of_them_carry_no_weight",
          "description": "PC-2a and PC-2b, and the two halves of docs/esm-conventions.md 23's corollary in one test. PC-2a is non-zero at ALL THREE operating modes -- 0.9137 hot-soaking, 0.6194 cold-soaking, 0.7585 operating, on the weekend at tank-temperature group 3 -- so the zero below is a WEIGHT and not an absent computation; PC-2b then weights them by {0, 0, 1} and returns the operating one. `coh_tankTemperatureGroupID` is PC-6's SourceTypeModelYearGroup gate resolved forward: 3 for model years 1996 and later and 5 for 1980-1995, and the two groups differ by 20% on the same day (0.9112 against 0.7585). What breaks if this is wrong: picking the wrong tank-temperature group is a WRONG ANSWER rather than a missing row, because both groups have a row for every hour-day.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
