            { "variable": "out_emissionQuant", "time": 0.0, "expected": 0.29469736788284168, "coords": { "output_rows": 65 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 0.34625760558050644, "coords": { "output_rows": 83 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 1.083403838011415, "coords": { "output_rows": 105 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 4.9304295602697764e-05, "coords": { "output_rows": 124 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 6.1808269386801605e-05, "coords": { "output_rows": 128 } }
