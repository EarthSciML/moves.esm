  "models": {
    "Fixture": {
      "subsystems": {
        "Onroad": {
          "ref": "../onroad/model.esm",
          "bindings": {
            "n_outputRate": 644
          }
        }
      },
      "variables": {},
      "equations": [],
      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, hour 7, road type 4, county 26161, zone 261610 -- byte for byte `process-crankcase-running`'s scope, and its THC block of MOVESOutput is byte-identical to this one's, so the whole activity half and the whole criteria-pollutant parent are already checked end to end by that fixture. The RunSpec XML says month 7 and hour 6; the execution database says 8 and 7, and it is the authority (docs/process-airtoxics.md 0.1). Three run-level numbers are pinned besides: `GPAFract` is 0, so both fuel-effect blends select their normal arm; the temperature is 59.5 degF and reaches only a quadratic whose coefficients are absent; and the A/C activity quadratic is negative and clamps to 0. (The E10 fuel subtype, 12, that the altTHC path's two lookups key on no longer has a run-level variable and is not asserted.) `specificHumidity` and `molWaterFraction` are NOT read by this fixture and have no variable: pollutant 1 never enters the NOx humidity arm.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "runspecyear_rows": 1
              }
            },
            {
              "variable": "Onroad.run_monthID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "runspecmonth_rows": 1
              }
            },
            {
              "variable": "Onroad.run_hourID",
              "time": 0.0,
              "expected": 7.0,
              "coords": {
                "run_rows": 1
              }
