      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, hour 7, source type 21, road type 4, county 26161, zone 261610 -- byte for byte `process-tirewear`'s and `process-brakewear`'s scope, so the whole activity half of this fixture is already checked end to end by two others. The RunSpec XML says month 7 and hour 6; the execution database says 8 and 7 and it is the authority (docs/mixed-onroad.md 0.1). The four columns after the temperature are new here: the two humidity columns the NOx correction reads, and the three scope numbers the fuel supply is resolved by.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_monthID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_hourID",
              "time": 0.0,
              "expected": 7.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_sourceTypeID",
              "time": 0.0,
              "expected": 21.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_roadTypeID",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_countyID",
              "time": 0.0,
              "expected": 26161.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_zoneID",
              "time": 0.0,
              "expected": 261610.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_stateID",
              "time": 0.0,
              "expected": 26.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_baseYearIsAnalysisYear",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_fuelYearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_hpmsVtypeID",
              "time": 0.0,
              "expected": 25.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
