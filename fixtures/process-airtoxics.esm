        "metaparameter": "n_runspecpollutantprocess"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "6 rows: 101 (THC) and its five chained species 2001 (benzene), 2401 (1,3-butadiene), 2501 (formaldehyde), 7901 (NMHC) and 8701 (VOC) -- ONE unchained parent and five chained descendants at three different chain DEPTHS, which no earlier fixture in this port has. It is the only place the run's pollutant/process scope is written down; it comes from here and never from the RunSpec XML. It is not an output-block axis: the output relation is ranked globally over the rate relation because the six blocks are not the same size (docs/esm-conventions.md \u00a731), and this relation's ordinal reaches the output row through the rate row instead.",
        "esio_format": "parquet"
      }
    },
    "at_runspecchainedto": {
      "kind": "static",
      "source": {
