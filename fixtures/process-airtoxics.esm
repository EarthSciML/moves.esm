  "models": {
    "ProcessAirToxics": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot"
          ]
        },
        {
          "ref": "../lib/drive_cycle.esm",
          "only": [
            "mph_to_meters_per_second",
            "vehicle_specific_power",
            "in_half_open_range",
            "bracket_low_fraction"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exact_else_wildcard",
            "gpa_blend",
            "bounded_low_then_high",
            "nox_humidity_cfr86",
            "nox_humidity_cfr1065",
            "quadratic_temperature_adjustment",
            "nox_temperature_adjustment"
          ]
        },
        {
          "ref": "../lib/keys.esm",
          "only": [
            "in_inclusive_range",
            "model_year_in_range",
            "flat_relation_major",
            "flat_relation_minor"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-09
      },
      "variables": {
        "rsy_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecyear_rows"
          ],
          "description": "runspecyear.yearID.",
          "update": {
            "kind": "data",
            "source": "at_runspecyear",
            "from": {
              "file_variable": "yearID"
            }
          }
        },
        "rsm_monthID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecmonth_rows"
          ],
          "description": "runspecmonth.monthID.",
          "update": {
            "kind": "data",
            "source": "at_runspecmonth",
            "from": {
              "file_variable": "monthID"
            }
          }
        },
        "rsh_hourID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspechour_rows"
          ],
          "description": "runspechour.hourID.",
          "update": {
            "kind": "data",
            "source": "at_runspechour",
            "from": {
              "file_variable": "hourID"
            }
          }
        },
        "rsd_dayID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecday_rows"
          ],
          "description": "runspecday.dayID.",
          "update": {
            "kind": "data",
            "source": "at_runspecday",
            "from": {
              "file_variable": "dayID"
            }
          }
        },
        "rst_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecsourcetype_rows"
          ],
          "description": "runspecsourcetype.sourceTypeID.",
          "update": {
            "kind": "data",
            "source": "at_runspecsourcetype",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "rsr_roadTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecroadtype_rows"
          ],
          "description": "runspecroadtype.roadTypeID.",
          "update": {
            "kind": "data",
            "source": "at_runspecroadtype",
            "from": {
              "file_variable": "roadTypeID"
            }
          }
        },
        "rsft_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecsourcefueltype_rows"
          ],
          "description": "runspecsourcefueltype.sourceTypeID.",
          "update": {
            "kind": "data",
            "source": "at_runspecsourcefueltype",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "rsft_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecsourcefueltype_rows"
          ],
          "description": "runspecsourcefueltype.fuelTypeID, in file order: the cohort grid's fuel blocks are defined against that order.",
          "update": {
            "kind": "data",
            "source": "at_runspecsourcefueltype",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "lnk_linkID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "link_rows"
          ],
          "description": "link.linkID.",
          "update": {
            "kind": "data",
            "source": "at_link",
            "from": {
              "file_variable": "linkID"
            }
          }
        },
        "lnk_countyID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "link_rows"
          ],
          "description": "link.countyID.",
          "update": {
            "kind": "data",
            "source": "at_link",
            "from": {
              "file_variable": "countyID"
            }
          }
        },
        "lnk_zoneID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "link_rows"
          ],
          "description": "link.zoneID.",
          "update": {
            "kind": "data",
            "source": "at_link",
            "from": {
              "file_variable": "zoneID"
            }
          }
        },
        "lnk_roadTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "link_rows"
          ],
          "description": "link.roadTypeID.",
          "update": {
            "kind": "data",
            "source": "at_link",
            "from": {
              "file_variable": "roadTypeID"
            }
          }
        },
        "yr_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "year_rows"
          ],
          "description": "year.yearID.",
          "update": {
            "kind": "data",
            "source": "at_year",
            "from": {
              "file_variable": "yearID"
            }
          }
        },
        "yr_fuelYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "year_rows"
          ],
          "description": "year.fuelYearID: the key the fuel-usage rebase is scoped by.",
          "update": {
            "kind": "data",
            "source": "at_year",
            "from": {
              "file_variable": "fuelYearID"
            }
          }
        },
        "yr_isBaseYear": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "year_rows"
          ],
          "description": "year.isBaseYear, Y/N text decoded by a `codes` map on the binding -- a text column is a hard error at the ingest boundary without one. S1 uses it, and it is Y for 2020, which is why \u00a71.5's two folds collapse.",
          "update": {
            "kind": "data",
            "source": "at_year",
            "from": {
              "file_variable": "isBaseYear",
              "codes": {
                "map": {
                  "Y": 1,
                  "N": 0
                },
                "case_insensitive": true
              }
            }
          }
        },
        "sty_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypeyear_rows"
          ],
          "description": "sourcetypeyear.yearID.",
          "update": {
            "kind": "data",
            "source": "at_sourcetypeyear",
            "from": {
              "file_variable": "yearID"
            }
          }
        },
        "sty_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "sourcetypeyear_rows"
          ],
          "description": "sourcetypeyear.sourceTypeID.",
          "update": {
            "kind": "data",
