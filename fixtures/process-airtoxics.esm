        {
          "id": "the_six_pollutant_processes_are_three_pollutants_on_two_processes",
          "description": "The run's whole scope, unpacked from `runspecpollutantprocess` and `runspecchainedto` rather than written down. THIS IS THE FIRST FIXTURE IN THE PORT WITH TWO PROCESSES ON THE SAME POLLUTANTS: 101/201/301 are Running Exhaust and come off the `BaseRateCalculator` spine; 115/215/315 are Crankcase Running Exhaust and are chained off their own pollutant's exhaust row by `CrankcaseEmissionCalculatorNonPM`. The chain declaration is MOVES's, read from `runspecchainedto`, and a chained pollutant-process is exactly one whose input is non-zero.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "rspp_pollutantID",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "runspecpollutantprocess_rows": 1
              }
            },
            {
              "variable": "rspp_pollutantID",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "runspecpollutantprocess_rows": 2
              }
            },
            {
