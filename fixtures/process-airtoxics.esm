        },
        "dss_prior3Speed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "The speed three seconds earlier."
        },
        "dss_prior3Present": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "drive_second_rows"
          ],
          "description": "1 where a row for second-3 exists."
        },
        "dss_nextSpeed": {
