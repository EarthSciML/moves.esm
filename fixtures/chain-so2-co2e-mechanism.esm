        },
        "rt_evEnergyDivisor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "adjust.rs:699: batteryEfficiency x chargingEfficiency, and exactly 1 where no row applies. It is the LAST step of the adjustment sequence, so Atmospheric CO2 and CO2 Equivalent -- chained off the divided energy -- inherit it; that is what MOVES does, because they read the divided value back out of MOVESWorkerOutput."
        },
        "rspp_isEnergy": {
