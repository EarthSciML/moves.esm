              "op": "index",
              "args": [
                "rct_inputPolProcessID",
                "h"
              ]
            }
          }
        },
        {
          "lhs": "rspp_calculatorChainInputPolProcessID",
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "rspp_pollutantID",
                      {
                        "op": "enum",
                        "args": [
                          "pollutant",
                          "AtmosphericCO2"
                        ]
