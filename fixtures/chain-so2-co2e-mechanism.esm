              "args": [
                "lnk_roadTypeID",
                "l"
              ]
            }
          }
        },
        {
          "lhs": "run_stateID",
          "rhs": {
            "op": "floor",
            "args": [
              {
                "op": "/",
                "args": [
                  "run_countyID",
                  1000
                ]
              }
            ]
          }
        },
        {
          "_comment": "S1: is the analysis year flagged as a base year? The flag is Y/N text decoded by a `codes` map at ingest.",
          "lhs": "run_baseYearIsAnalysisYear",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "y": {
                "from": "year_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_yearID",
                    "yr_yearID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "yr_isBaseYear",
                "y"
              ]
            }
          }
        },
        {
          "lhs": "run_fuelYearID",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "y": {
                "from": "year_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_yearID",
                    "yr_yearID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "yr_fuelYearID",
                "y"
              ]
            }
          }
        },
        {
          "_comment": "The geographic-phase-in share, 0 in Washtenaw County. Read rather than assumed: `gpa_blend` is applied at both fuel-effect lookups and this is the number that makes both of them return their normal value.",
          "lhs": "run_gpaFraction",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "y": {
                "from": "county_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_countyID",
                    "cty_countyID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "cty_GPAFract",
                "y"
              ]
            }
          }
        },
        {
          "_comment": "How many `regioncounty` rows this county has in this fuel year. TWO, both naming the same region under different region CODES, so the fuel supply is read as a SET membership and the duplicate cannot double a market share.",
          "lhs": "run_fuelRegionCount",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "g": {
                "from": "regioncounty_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_countyID",
                    "rgc_countyID"
                  ],
                  [
                    "run_fuelYearID",
                    "rgc_fuelYearID"
                  ]
                ]
              }
            ],
            "expr": 1.0
          }
        },
        {
          "lhs": "run_hpmsVtypeID",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "u": {
                "from": "sourceusetype_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_sourceTypeID",
                    "sut_sourceTypeID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "sut_HPMSVtypeID",
                "u"
              ]
            }
          }
        },
        {
          "_comment": "S4 (J6). One clause, two pairs: the HPMS type and the year.",
          "lhs": "run_analysisYearVMT",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "run_rows"
              },
              "h": {
                "from": "hpmsvtypeyear_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "run_hpmsVtypeID",
                    "hvy_HPMSVtypeID"
                  ],
                  [
                    "run_yearID",
                    "hvy_yearID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "hvy_HPMSBaseYearVMT",
                "h"
              ]
            }
          }
        },
        {
          "_comment": "S5 (J7), gated to `roadtype` membership: two clauses over two relations, composing by conjunction.",
          "lhs": "run_roadTypeVMTFraction",
          "rhs": {
            "op": "aggregate",
            "args": [],
