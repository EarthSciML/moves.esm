        "run_heatIndex": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The heat index at the run's hour. The one threshold it feeds here is the A/C activity clamp -- this fixture carries no EV branch. It is 59.500000000000 degF: hour 7 (`runspechour`), where the temperature is 59.5 and MG-3's sub-78 arm returns it unchanged, so the value COMPUTED by `zmh_heatIndex` is the one that used to be ingested, bit for bit. Measured against this snapshot's own `monthgrouphour` row (A -3.63154, B 0.072465, C -0.000276), the quadratic crosses 0 at a heat index of 67.4340633418 degF, so 59.5 is 7.934 degF below the clamp and the margin is unchanged exactly. The prose here used to claim 66.900001525879 with margins of 0.3 and 0.1 degF, which is `mixed-onroad`'s hour 9 and a fixture that has an EV branch at all. docs/meteorology-generator.md 8.2 has the table for all eight."
        },
        "run_acActivityTermA": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "S15(d)'s constant term, read from monthgrouphour."
        },
        "run_acActivityTermB": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "S15(d)'s linear term."
        },
        "run_acActivityTermC": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "S15(d)'s quadratic term."
        },
        "run_acActivityRaw": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "setup.rs:409 before the clamp, in Horner form as the canonical SQL writes it: A + h(B + Ch) = -0.0189 here."
        },
        "run_acActivity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "setup.rs:411's clamp(0, 1), which makes it exactly 0. Written out rather than factored into a `clamp01` template, because \u00a74.8 argues the VALUE each of this chain's two clamps takes is the load-bearing fact and a shared template would hide which is which."
        },
        "run_brakingOpModeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_rows"
          ],
          "description": "The Braking operating mode, NAMED. It was a bare literal 0 until finding F32 was fixed upstream -- an `enums` value had to be a positive integer and MOVES's Braking mode is genuinely 0, so the one mode this document most needed to name was the one it could not. A constant equality is still a join.on (docs/esm-conventions.md \u00a720.4), so this one-row column is what the two braking-rate lookups key on."
        },
