  "models": {
    "ChainSO2CO2eMechanism": {
      "expression_template_imports": [
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column"
          ]
        },
        {
          "ref": "../lib/onroad_activity.esm",
          "only": [
            "weeks_per_month",
            "share_of_group",
            "onroad_scc",
            "source_bin_slot",
            "ev_energy_divisor",
            "is_energy_pollutant",
            "energy_unit_divisor",
            "kilojoules_per_million_btu"
          ]
        },
        {
          "ref": "../lib/drive_cycle.esm",
          "only": [
            "mph_to_meters_per_second",
            "vehicle_specific_power",
            "in_half_open_range",
            "bracket_low_fraction"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exact_else_wildcard",
            "gpa_blend",
            "quadratic_temperature_adjustment",
            "speciation_factor"
          ]
        },
        {
          "ref": "../lib/meteorology.esm",
          "only": [
            "heat_index"
          ]
        },
        {
          "ref": "../lib/keys.esm",
          "only": [
            "in_inclusive_range",
            "model_year_in_range",
            "model_year_in_group",
            "flat_relation_major",
            "flat_relation_minor"
          ]
        },
        {
          "ref": "../lib/co2_equivalent.esm",
          "only": [
            "carbon_to_carbon_dioxide_mass_ratio",
            "global_warming_potential_is_selected"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-09
      },
      "variables": {
        "rsy_yearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
