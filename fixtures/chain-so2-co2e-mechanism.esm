            "fuelsupply_rows"
          ],
          "description": "Its oxidation fraction."
        },
        "fsu_energyContentRaw": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "Its energy content, NaN on electricity because the column is NULL there."
        },
        "fsu_energyContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "fuelsupply_rows"
          ],
          "description": "The NULL turned into the zero MariaDB's SUM behaves as. so2_calculator.rs models the column as a bare `f64` and guards the DIVISION instead; both reach the same place, and the guard is written where the division is."
        },
        "rt_supplyEnergyContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "`SO2FuelCalculation1.energyContent` (so2_calculator.rs:1975-2010): the market-share-weighted mean energy content of this rate row's fuel type. It is a fuel-TYPE quantity and not a per-formulation one, which is why it is formed here and then multiplied inside the supply sum below -- the two agree exactly because a constant factors out of a sum whose weights are the same market shares. ZERO on electricity, and that is the second of the two independent reasons no electricity cohort emits SO2."
        },
        "rt_supplySulfurLevel": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "`SO2FuelCalculation1.WsulfurLevel`, the same weighted mean over `sulfurLevel`."
        },
        "rt_supplyCarbonContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "`CarbonOxidationByFuelType.sumCarbonContent` (co2ae:1005-1046). The snapshot happens to CARRY the calculator's own answer in `carbonoxidationbyfueltype`; this document recomputes it from `fuelsupply` and `fuelsubtype` and the tests pin all four cells against that table rather than reading it."
        },
        "rt_supplyOxidationFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "`CarbonOxidationByFuelType.sumOxidationFraction`: 1 on each combustion fuel type and 0 on electricity."
        },
        "rt_hasFuelSupply": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether this rate row's fuel type is supplied at all. Every CO2AE join is an INNER one, so a fuel type with no supply row produces no Atmospheric CO2 row -- as distinct from electricity, which is supplied and produces a row of exactly zero."
        },
        "rt_sulfateBaseRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "J48: `SO2FuelCalculation2` expanded onto this rate row. Two key pairs and the self-described model-year band, and the polProcessID pair is what says WHICH rate rows are SO2 rows -- the same trick `hcspeciation` plays for NMOG and VOC."
        },
        "rt_hasSulfateRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "Whether a sulfate rate row exists for this fuel type and model year."
        },
        "rt_so2Factor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "so2_calculator.rs:2079-2081: SO2 = meanBaseRate x WsulfurLevel x energy / energyContent, as a multiplier on the ENERGY the chain root produced. The energy is in KILOJOULES here -- the Million BTU divisor is applied at the output row and not before -- which is what MOVES does, because `SO2Calculator` reads `MOVESWorkerOutput` and engine.rs converts on the way out. The guard is so2_calculator.rs:2073-2078: MariaDB evaluates `x / 0` as NULL and drops the row, where an f64 would return an infinity."
        },
        "rt_hasSo2Factor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "An SO2 row exists where a sulfate rate exists AND the divisor is non-zero. Both fail on electricity and either one alone would be enough, so this fixture cannot distinguish them; docs/chain-so2-co2e-mechanism.md 7.4 says so."
        },
        "rt_isAtmosphericCO2": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "co2ae_running_start_extended_idle.rs:150's `ATMOSPHERIC_CO2_POLLUTANT_ID`. Unlike SO2, whose rate table names its own polProcessID, step 1a has no table to be identified by: the calculator hard-codes both its input pollutant (91) and its output one (90), and `runspecchainedto` carries no 9001 row at all. So the constant is written down, once, and cited."
        },
        "rt_co2Factor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "co2ae:1090-1094: sumCarbonContent x sumOxidationFraction x 44/12, as a multiplier on the energy the chain root produced. Exactly ZERO on electricity, because both factors are, and the row is still emitted -- which is the difference between this stage and SO2's, and is why Atmospheric CO2 has 125 cohorts where SO2 has 104."
        },
        "rt_hasCo2Factor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "An Atmospheric CO2 row exists for every energy cohort whose fuel type is supplied."
        },
        "rt_energyChainFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
          "description": "The two stages chained off Total Energy Consumption, summed. They are disjoint by output pollutant -- `sulfateemissionrate` carries polProcessID 3101 alone and `rt_isAtmosphericCO2` is 90 alone -- so the sum is a union. Both are fuel-TYPE quantities that enter the per-formulation product below; \u00a72.7 says why that is exact."
        },
        "rt_hasEnergyChainRatio": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rate_rows"
          ],
