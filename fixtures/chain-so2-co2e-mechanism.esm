      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, hour 7, source type 21, road type 4, county 26161, zone 261610 -- byte for byte `process-crankcase-running`'s scope, and its THC block of MOVESOutput is byte-identical to this one's, so the whole activity half and the whole criteria-pollutant parent are already checked end to end by that fixture. The RunSpec XML says month 7 and hour 6; the execution database says 8 and 7, and it is the authority (docs/process-airtoxics.md 0.1). Four run-level numbers are pinned besides: `GPAFract` is 0, so both fuel-effect blends select their normal arm; the temperature is 59.5 degF and reaches both arms of the temperature branch; the A/C activity quadratic is negative and clamps to 0; and `run_e10FuelSubtypeID` is the 12 the altTHC path's two lookups key on. `specificHumidity` and `molWaterFraction` are NOT read by this fixture and have no variable: pollutant 1 never enters the NOx humidity arm.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_monthID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_hourID",
              "time": 0.0,
              "expected": 7.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_sourceTypeID",
              "time": 0.0,
              "expected": 21.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_roadTypeID",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_countyID",
              "time": 0.0,
              "expected": 26161.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_zoneID",
              "time": 0.0,
              "expected": 261610.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_linkID",
              "time": 0.0,
              "expected": 2616104.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_stateID",
              "time": 0.0,
              "expected": 26.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_monthGroupID",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_fuelYearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_baseYearIsAnalysisYear",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_gpaFraction",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "run_rows": 1
              }
            },
            {
              "variable": "run_temperature",
              "time": 0.0,
              "expected": 59.5,
              "coords": {
                "run_rows": 1
              }
