        {
          "_comment": "J35: MOVES's own chain declaration, read rather than written down.",
          "lhs": "rspp_declaredChainInputPolProcessID",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "p"
            ],
            "ranges": {
