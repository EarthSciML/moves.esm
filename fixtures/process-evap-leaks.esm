      "extent": { "metaparameter": "n_sourcetypeagedistribution" },
      "reader_options": { "float_columns": ["ageFraction"] },
      "metadata": { "tags": ["activity"], "note": "33,579 rows -- the largest table this chain reads. A2's age split, and A3's denominator ranges over every source type in the HPMS group, not just the run's.", "esio_format": "parquet" }
    },
