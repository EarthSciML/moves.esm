      "extent": { "metaparameter": "n_runspecmonth" },
      "metadata": { "tags": ["scope"], "note": "1 row, monthID 8. The XML says `<month key=\"7\">`, which is the same month.", "esio_format": "parquet" }
    },
    "evl_runspechour": {
      "kind": "static",
