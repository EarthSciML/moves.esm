      "reader_options": { "float_columns": ["noOfRealDays"] },
      "metadata": { "tags": ["output"], "note": "2 rows: 2 real days in a weekend, 5 in a week of weekdays. L9's divisor, and the factor A7 multiplied in.", "esio_format": "parquet" }
    },
