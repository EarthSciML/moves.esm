    },
    "evl_imcoverage": {
      "kind": "static",
      "source": { "url_template": "file://${MOVES_SNAPSHOTS}/process-evap-leaks/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__imcoverage.parquet" },
      "extent": { "metaparameter": "n_imcoverage" },
      "reader_options": { "float_columns": ["complianceFactor"] },
      "metadata": { "tags": ["im"], "note": "EMPTY, and consumed anyway. Its extent is 0, so L1's aggregate reads the additive identity and L9's blend gets IMAdjustFract = 0, for which lib/adjustments.esm's `im_blend` is the identity. That is the SQL's `a row with no matching cell keeps its value unchanged`, computed rather than assumed: pollutantprocessassoc marks 113 isAffectedByEvapIM = Y, so this is an absent PROGRAM, not a structural exclusion.", "esio_format": "parquet" }
    },
    "evl_hourday": {
