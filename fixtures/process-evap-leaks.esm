    },
    "evl_dayofanyweek": {
      "kind": "static",
      "source": { "url_template": "file://${MOVES_SNAPSHOTS}/process-evap-leaks/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__dayofanyweek.parquet" },
