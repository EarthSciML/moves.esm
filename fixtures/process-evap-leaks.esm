  "models": {
    "EvapLeaksFixture": {
      "expression_template_imports": [
        { "ref": "../lib/evaporative.esm",
          "only": ["operating_share_of_activity", "soak_share"] },
        { "ref": "../lib/onroad_activity.esm",
          "only": ["weeks_per_month", "share_of_group", "onroad_scc"] },
        { "ref": "../lib/adjustments.esm", "only": ["im_blend"] },
        { "ref": "../lib/identifiers.esm",
          "only": ["pol_process_id", "pollutant_id_of", "process_id_of",
                   "null_output_column", "output_column_is_absent"] }
      ],

      "tolerance": { "rel": 1e-12 },

      "variables": {
        "rsy_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecyear_rows"], "description": "runspecyear.yearID. The run scope's authority; docs/evap-leaks.md 0.1.", "update": { "kind": "data", "source": "evl_runspecyear", "from": { "file_variable": "yearID" } } },
        "rsm_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecmonth_rows"], "description": "runspecmonth.monthID.", "update": { "kind": "data", "source": "evl_runspecmonth", "from": { "file_variable": "monthID" } } },
        "rsh_hourID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspechour_rows"], "description": "runspechour.hourID.", "update": { "kind": "data", "source": "evl_runspechour", "from": { "file_variable": "hourID" } } },
        "rsd_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecday_rows"], "description": "runspecday.dayID: the day types, in file order, which the activity and output ordinals index.", "update": { "kind": "data", "source": "evl_runspecday", "from": { "file_variable": "dayID" } } },
        "rst_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecsourcetype_rows"], "description": "runspecsourcetype.sourceTypeID.", "update": { "kind": "data", "source": "evl_runspecsourcetype", "from": { "file_variable": "sourceTypeID" } } },
        "rsr_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecroadtype_rows"], "description": "runspecroadtype.roadTypeID.", "update": { "kind": "data", "source": "evl_runspecroadtype", "from": { "file_variable": "roadTypeID" } } },
        "rsft_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecsourcefueltype_rows"], "description": "runspecsourcefueltype.sourceTypeID.", "update": { "kind": "data", "source": "evl_runspecsourcefueltype", "from": { "file_variable": "sourceTypeID" } } },
        "rsft_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["runspecsourcefueltype_rows"], "description": "runspecsourcefueltype.fuelTypeID, in file order: the cohort relation's fuel ordinal indexes this column.", "update": { "kind": "data", "source": "evl_runspecsourcefueltype", "from": { "file_variable": "fuelTypeID" } } },

        "rsft_ordinal": { "type": "unknown", "shape": ["runspecsourcefueltype_rows"], "description": "The runspecsourcefueltype relation's own row ordinal, 1..4, so that the cohort relation joins to it by position. The fuels reach the cohort relation in FILE order, which is what the fuel-major block structure of both the cohort and the output relation is defined against." },

        "yr_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["year_rows"], "description": "year.yearID.", "update": { "kind": "data", "source": "evl_year", "from": { "file_variable": "yearID" } } },
        "yr_fuelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["year_rows"], "description": "year.fuelYearID: the key C4's fuel-usage remap is scoped by.", "update": { "kind": "data", "source": "evl_year", "from": { "file_variable": "fuelYearID" } } },
        "yr_isBaseYear": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["year_rows"], "description": "year.isBaseYear, decoded Y to 1 and N to 0 by a `codes` map on the binding (esm-spec 8.9.1) -- a text column is a hard error at the ingest boundary without one. A1 uses it, and measured it is Y on all 63 rows.", "update": { "kind": "data", "source": "evl_year", "from": { "file_variable": "isBaseYear", "codes": { "map": { "Y": 1, "N": 0 }, "case_insensitive": true } } } },

        "sty_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeyear_rows"], "description": "sourcetypeyear.yearID.", "update": { "kind": "data", "source": "evl_sourcetypeyear", "from": { "file_variable": "yearID" } } },
        "sty_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeyear_rows"], "description": "sourcetypeyear.sourceTypeID.", "update": { "kind": "data", "source": "evl_sourcetypeyear", "from": { "file_variable": "sourceTypeID" } } },
        "sty_sourceTypePopulation": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeyear_rows"], "description": "sourcetypeyear.sourceTypePopulation, decimal text in the file. A2's population before the age split.", "update": { "kind": "data", "source": "evl_sourcetypeyear", "from": { "file_variable": "sourceTypePopulation" } } },

        "stad_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeagedistribution_rows"], "description": "sourcetypeagedistribution.sourceTypeID.", "update": { "kind": "data", "source": "evl_sourcetypeagedistribution", "from": { "file_variable": "sourceTypeID" } } },
        "stad_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeagedistribution_rows"], "description": "sourcetypeagedistribution.yearID.", "update": { "kind": "data", "source": "evl_sourcetypeagedistribution", "from": { "file_variable": "yearID" } } },
        "stad_ageID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeagedistribution_rows"], "description": "sourcetypeagedistribution.ageID.", "update": { "kind": "data", "source": "evl_sourcetypeagedistribution", "from": { "file_variable": "ageID" } } },
        "stad_ageFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeagedistribution_rows"], "description": "sourcetypeagedistribution.ageFraction. 33,579 rows; the joins that reach it are keyed on three columns for that reason.", "update": { "kind": "data", "source": "evl_sourcetypeagedistribution", "from": { "file_variable": "ageFraction" } } },

        "sta_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeage_rows"], "description": "sourcetypeage.sourceTypeID.", "update": { "kind": "data", "source": "evl_sourcetypeage", "from": { "file_variable": "sourceTypeID" } } },
        "sta_ageID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeage_rows"], "description": "sourcetypeage.ageID.", "update": { "kind": "data", "source": "evl_sourcetypeage", "from": { "file_variable": "ageID" } } },
        "sta_relativeMAR": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcetypeage_rows"], "description": "sourcetypeage.relativeMAR: how far a vehicle of this age drives relative to the fleet. A3 weights the population by it on both sides of the normalisation.", "update": { "kind": "data", "source": "evl_sourcetypeage", "from": { "file_variable": "relativeMAR" } } },

        "sut_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourceusetype_rows"], "description": "sourceusetype.sourceTypeID.", "update": { "kind": "data", "source": "evl_sourceusetype", "from": { "file_variable": "sourceTypeID" } } },
        "sut_HPMSVtypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourceusetype_rows"], "description": "sourceusetype.HPMSVtypeID: A3's normalisation group. Getting this join wrong normalises over the wrong fleet, which docs/mixed-onroad.md measures as a 2.55x error before any emission is reached.", "update": { "kind": "data", "source": "evl_sourceusetype", "from": { "file_variable": "HPMSVtypeID" } } },

        "hvy_HPMSVtypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hpmsvtypeyear_rows"], "description": "hpmsvtypeyear.HPMSVtypeID.", "update": { "kind": "data", "source": "evl_hpmsvtypeyear", "from": { "file_variable": "HPMSVtypeID" } } },
        "hvy_yearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hpmsvtypeyear_rows"], "description": "hpmsvtypeyear.yearID.", "update": { "kind": "data", "source": "evl_hpmsvtypeyear", "from": { "file_variable": "yearID" } } },
        "hvy_HPMSBaseYearVMT": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hpmsvtypeyear_rows"], "description": "hpmsvtypeyear.HPMSBaseYearVMT: A4, national annual vehicle-miles. 2.573e12 for HPMS 25 in 2020.", "update": { "kind": "data", "source": "evl_hpmsvtypeyear", "from": { "file_variable": "HPMSBaseYearVMT" } } },

        "rtd_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtypedistribution_rows"], "description": "roadtypedistribution.sourceTypeID.", "update": { "kind": "data", "source": "evl_roadtypedistribution", "from": { "file_variable": "sourceTypeID" } } },
        "rtd_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtypedistribution_rows"], "description": "roadtypedistribution.roadTypeID.", "update": { "kind": "data", "source": "evl_roadtypedistribution", "from": { "file_variable": "roadTypeID" } } },
        "rtd_roadTypeVMTFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtypedistribution_rows"], "description": "roadtypedistribution.roadTypeVMTFraction: A5's road-type share.", "update": { "kind": "data", "source": "evl_roadtypedistribution", "from": { "file_variable": "roadTypeVMTFraction" } } },

        "rt_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtype_rows"], "description": "roadtype.roadTypeID.", "update": { "kind": "data", "source": "evl_roadtype", "from": { "file_variable": "roadTypeID" } } },
        "rt_isAffectedByOnroad": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["roadtype_rows"], "description": "roadtype.isAffectedByOnroad: the gate that keeps roadTypeID 100, the NONROAD pseudo-road-type, out of A5.", "update": { "kind": "data", "source": "evl_roadtype", "from": { "file_variable": "isAffectedByOnroad" } } },

        "mvf_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthvmtfraction_rows"], "description": "monthvmtfraction.sourceTypeID.", "update": { "kind": "data", "source": "evl_monthvmtfraction", "from": { "file_variable": "sourceTypeID" } } },
        "mvf_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthvmtfraction_rows"], "description": "monthvmtfraction.monthID.", "update": { "kind": "data", "source": "evl_monthvmtfraction", "from": { "file_variable": "monthID" } } },
        "mvf_monthVMTFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthvmtfraction_rows"], "description": "monthvmtfraction.monthVMTFraction. Keyed on source type and month only.", "update": { "kind": "data", "source": "evl_monthvmtfraction", "from": { "file_variable": "monthVMTFraction" } } },

        "dvf_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.sourceTypeID.", "update": { "kind": "data", "source": "evl_dayvmtfraction", "from": { "file_variable": "sourceTypeID" } } },
        "dvf_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.monthID.", "update": { "kind": "data", "source": "evl_dayvmtfraction", "from": { "file_variable": "monthID" } } },
        "dvf_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.roadTypeID.", "update": { "kind": "data", "source": "evl_dayvmtfraction", "from": { "file_variable": "roadTypeID" } } },
        "dvf_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.dayID.", "update": { "kind": "data", "source": "evl_dayvmtfraction", "from": { "file_variable": "dayID" } } },
        "dvf_dayVMTFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayvmtfraction_rows"], "description": "dayvmtfraction.dayVMTFraction: a share of the MONTH's vehicle-miles, which is why A7 divides by weeksPerMonth and L9 divides by noOfRealDays.", "update": { "kind": "data", "source": "evl_dayvmtfraction", "from": { "file_variable": "dayVMTFraction" } } },

        "hvf_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.sourceTypeID.", "update": { "kind": "data", "source": "evl_hourvmtfraction", "from": { "file_variable": "sourceTypeID" } } },
        "hvf_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.roadTypeID.", "update": { "kind": "data", "source": "evl_hourvmtfraction", "from": { "file_variable": "roadTypeID" } } },
        "hvf_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.dayID.", "update": { "kind": "data", "source": "evl_hourvmtfraction", "from": { "file_variable": "dayID" } } },
        "hvf_hourID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.hourID.", "update": { "kind": "data", "source": "evl_hourvmtfraction", "from": { "file_variable": "hourID" } } },
        "hvf_hourVMTFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourvmtfraction_rows"], "description": "hourvmtfraction.hourVMTFraction: a share of that day type's own 24 hours.", "update": { "kind": "data", "source": "evl_hourvmtfraction", "from": { "file_variable": "hourVMTFraction" } } },

        "moy_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthofanyyear_rows"], "description": "monthofanyyear.monthID.", "update": { "kind": "data", "source": "evl_monthofanyyear", "from": { "file_variable": "monthID" } } },
        "moy_noOfDays": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["monthofanyyear_rows"], "description": "monthofanyyear.noOfDays: 31 for August, and the input to A7's divisor. Omitting the divisor multiplies every row by 4.43.", "update": { "kind": "data", "source": "evl_monthofanyyear", "from": { "file_variable": "noOfDays" } } },

        "asb_avgSpeedBinID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeedbin_rows"], "description": "avgspeedbin.avgSpeedBinID.", "update": { "kind": "data", "source": "evl_avgspeedbin", "from": { "file_variable": "avgSpeedBinID" } } },
        "asb_avgBinSpeed": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeedbin_rows"], "description": "avgspeedbin.avgBinSpeed, in miles per hour. `mi h-1` is not a registry unit, so the unit is named here and not declared.", "update": { "kind": "data", "source": "evl_avgspeedbin", "from": { "file_variable": "avgBinSpeed" } } },

        "asd_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.sourceTypeID.", "update": { "kind": "data", "source": "evl_avgspeeddistribution", "from": { "file_variable": "sourceTypeID" } } },
        "asd_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.roadTypeID.", "update": { "kind": "data", "source": "evl_avgspeeddistribution", "from": { "file_variable": "roadTypeID" } } },
        "asd_hourDayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.hourDayID. The table carries no monthID, so one distribution serves every month.", "update": { "kind": "data", "source": "evl_avgspeeddistribution", "from": { "file_variable": "hourDayID" } } },
        "asd_avgSpeedBinID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.avgSpeedBinID.", "update": { "kind": "data", "source": "evl_avgspeeddistribution", "from": { "file_variable": "avgSpeedBinID" } } },
        "asd_avgSpeedFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["avgspeeddistribution_rows"], "description": "avgspeeddistribution.avgSpeedFraction. A6 sums fraction x binSpeed: the ARITHMETIC mean, not the harmonic one.", "update": { "kind": "data", "source": "evl_avgspeeddistribution", "from": { "file_variable": "avgSpeedFraction" } } },

        "zrt_zoneID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["zoneroadtype_rows"], "description": "zoneroadtype.zoneID.", "update": { "kind": "data", "source": "evl_zoneroadtype", "from": { "file_variable": "zoneID" } } },
        "zrt_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["zoneroadtype_rows"], "description": "zoneroadtype.roadTypeID.", "update": { "kind": "data", "source": "evl_zoneroadtype", "from": { "file_variable": "roadTypeID" } } },
        "zrt_SHOAllocFactor": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["zoneroadtype_rows"], "description": "zoneroadtype.SHOAllocFactor: A9. Purely spatial -- it allocates national road-4 activity to one zone and carries no time and no speed.", "update": { "kind": "data", "source": "evl_zoneroadtype", "from": { "file_variable": "SHOAllocFactor" } } },
        "svp_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.sourceTypeID.", "update": { "kind": "data", "source": "evl_samplevehiclepopulation", "from": { "file_variable": "sourceTypeID" } } },
        "svp_modelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.modelYearID.", "update": { "kind": "data", "source": "evl_samplevehiclepopulation", "from": { "file_variable": "modelYearID" } } },
        "svp_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.fuelTypeID.", "update": { "kind": "data", "source": "evl_samplevehiclepopulation", "from": { "file_variable": "fuelTypeID" } } },
        "svp_engTechID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.engTechID: 1 for conventional internal combustion, 30 for electric drive. Two values here, so the technology is a COLUMN and not an axis (docs/esm-conventions.md 16.3).", "update": { "kind": "data", "source": "evl_samplevehiclepopulation", "from": { "file_variable": "engTechID" } } },
        "svp_regClassID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.regClassID: 20 throughout for passenger cars.", "update": { "kind": "data", "source": "evl_samplevehiclepopulation", "from": { "file_variable": "regClassID" } } },
        "svp_stmyFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["samplevehiclepopulation_rows"], "description": "samplevehiclepopulation.stmyFraction, twelve decimals in the file: the share of a (source type, model year) population in a (fuel, engine technology) pair. C2's row rule is `> 0` on this column and it is what makes the output key set ragged.", "update": { "kind": "data", "source": "evl_samplevehiclepopulation", "from": { "file_variable": "stmyFraction" } } },

        "ppmy_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmodelyear_rows"], "description": "pollutantprocessmodelyear.polProcessID.", "update": { "kind": "data", "source": "evl_pollutantprocessmodelyear", "from": { "file_variable": "polProcessID" } } },
        "ppmy_modelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmodelyear_rows"], "description": "pollutantprocessmodelyear.modelYearID.", "update": { "kind": "data", "source": "evl_pollutantprocessmodelyear", "from": { "file_variable": "modelYearID" } } },
        "ppmy_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessmodelyear_rows"], "description": "pollutantprocessmodelyear.modelYearGroupID: 19781995 and 19992003 for the ranges, 2020 for a single year. The adjacent column fuelMYGroupID is a different mapping -- 19751986 rather than 19781995 for model year 1980 -- and joining on it instead admits nothing.", "update": { "kind": "data", "source": "evl_pollutantprocessmodelyear", "from": { "file_variable": "modelYearGroupID" } } },

        "myg_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["modelyeargroup_rows"], "description": "modelyeargroup.modelYearGroupID.", "update": { "kind": "data", "source": "evl_modelyeargroup", "from": { "file_variable": "modelYearGroupID" } } },
        "myg_shortModYrGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["modelyeargroup_rows"], "description": "modelyeargroup.shortModYrGroupID: the two-digit code that would occupy the fifth decimal slot of a packed sourceBinID. Read for C2's existence chain; no document here builds the id.", "update": { "kind": "data", "source": "evl_modelyeargroup", "from": { "file_variable": "shortModYrGroupID" } } },

        "sb_sourceBinID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.sourceBinID, about 1.01e18. Exact in binary64 because every id ends in 1e10, which contains 2^10, so each is a multiple of 1024 while the spacing at 1e18 is 128. K8 joins on it and no arithmetic touches it (finding F18, docs/esm-conventions.md 18.4).", "update": { "kind": "data", "source": "evl_sourcebin", "from": { "file_variable": "sourceBinID" } } },
        "sb_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.fuelTypeID.", "update": { "kind": "data", "source": "evl_sourcebin", "from": { "file_variable": "fuelTypeID" } } },
        "sb_engTechID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.engTechID.", "update": { "kind": "data", "source": "evl_sourcebin", "from": { "file_variable": "engTechID" } } },
        "sb_regClassID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.regClassID.", "update": { "kind": "data", "source": "evl_sourcebin", "from": { "file_variable": "regClassID" } } },
        "sb_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.modelYearGroupID: the FULL group code, not the short one packed into the id.", "update": { "kind": "data", "source": "evl_sourcebin", "from": { "file_variable": "modelYearGroupID" } } },
        "sb_engSizeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.engSizeID: 0 on every onroad bin. Read so that `sourceBinZeroSlotCount` can prove it, because C4's equipped-to-used match includes engSizeID and weightClassID and this document's cohort relation carries neither.", "update": { "kind": "data", "source": "evl_sourcebin", "from": { "file_variable": "engSizeID" } } },
        "sb_weightClassID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["sourcebin_rows"], "description": "sourcebin.weightClassID: 0 on every onroad bin, for the same reason.", "update": { "kind": "data", "source": "evl_sourcebin", "from": { "file_variable": "weightClassID" } } },

        "fuf_countyID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.countyID.", "update": { "kind": "data", "source": "evl_fuelusagefraction", "from": { "file_variable": "countyID" } } },
        "fuf_fuelYearID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.fuelYearID.", "update": { "kind": "data", "source": "evl_fuelusagefraction", "from": { "file_variable": "fuelYearID" } } },
        "fuf_modelYearGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.modelYearGroupID: 0 on all five rows, which is the WILDCARD -- `source_bin_distribution_generator.rs:1547` matches every equipped bin when it is 0 and only the named group otherwise. `fuelUsageWildcardCount` proves all five are wildcards, which is what licenses this document implementing the wildcard branch alone.", "update": { "kind": "data", "source": "evl_fuelusagefraction", "from": { "file_variable": "modelYearGroupID" } } },
        "fuf_sourceBinFuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.sourceBinFuelTypeID: the fuel the vehicle is EQUIPPED for.", "update": { "kind": "data", "source": "evl_fuelusagefraction", "from": { "file_variable": "sourceBinFuelTypeID" } } },
        "fuf_fuelSupplyFuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.fuelSupplyFuelTypeID: the fuel it actually BURNS. Only E85 differs from its equipped fuel.", "update": { "kind": "data", "source": "evl_fuelusagefraction", "from": { "file_variable": "fuelSupplyFuelTypeID" } } },
        "fuf_usageFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fuelusagefraction_rows"], "description": "fuelusagefraction.usageFraction: 0.982134 of E85-equipped activity onto gasoline, 0.017866 staying on E85, 1 on the three identity pairs.", "update": { "kind": "data", "source": "evl_fuelusagefraction", "from": { "file_variable": "usageFraction" } } },

        "era_sourceBinID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.sourceBinID, packed. K8's key.", "update": { "kind": "data", "source": "evl_emissionratebyage", "from": { "file_variable": "sourceBinID" } } },
        "era_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.polProcessID: 113 on all 6,564 rows of this extract, and joined on anyway so that a wider extract needs no new join.", "update": { "kind": "data", "source": "evl_emissionratebyage", "from": { "file_variable": "polProcessID" } } },
        "era_opModeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.opModeID: 150, 151 or 300.", "update": { "kind": "data", "source": "evl_emissionratebyage", "from": { "file_variable": "opModeID" } } },
        "era_ageGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.ageGroupID: seven values per (bin, operating mode). K12 picks the one containing the cohort's age, and dropping it sums all seven -- 9.44x on the fixture total.", "update": { "kind": "data", "source": "evl_emissionratebyage", "from": { "file_variable": "ageGroupID" } } },
        "era_meanBaseRate": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.meanBaseRate, grams of THC per hour. THE base rate of this slice, and an INPUT table -- which is the whole reason the slice needs neither the drive-cycle operating-mode distribution nor a recurrence.", "update": { "kind": "data", "source": "evl_emissionratebyage", "from": { "file_variable": "meanBaseRate" } } },
        "era_meanBaseRateIM": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["emissionratebyage_rows"], "description": "emissionratebyage.meanBaseRateIM: the inspection-and-maintenance counterpart, consumed only by L9's blend, which is the identity here because imcoverage is empty.", "update": { "kind": "data", "source": "evl_emissionratebyage", "from": { "file_variable": "meanBaseRateIM" } } },

        "ac_ageID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["agecategory_rows"], "description": "agecategory.ageID, 0 to 40 in file order: the activity relation's age ordinal indexes this column and the cohort relation's model year is the run year minus it.", "update": { "kind": "data", "source": "evl_agecategory", "from": { "file_variable": "ageID" } } },
        "ac_ageGroupID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["agecategory_rows"], "description": "agecategory.ageGroupID: seven groups over the 41 ages, each id a concatenated range (3, 405, 607, 809, 1014, 1519, 2099) and not a number to do arithmetic on.", "update": { "kind": "data", "source": "evl_agecategory", "from": { "file_variable": "ageGroupID" } } },

        "saf_sourceTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.sourceTypeID.", "update": { "kind": "data", "source": "evl_soakactivityfraction", "from": { "file_variable": "sourceTypeID" } } },
        "saf_zoneID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.zoneID.", "update": { "kind": "data", "source": "evl_soakactivityfraction", "from": { "file_variable": "zoneID" } } },
        "saf_monthID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.monthID. Keyed at the context's real month -- the `month + 1` join a stale RunSpec key once forced is gone (evap_op_mode_distribution.rs:443).", "update": { "kind": "data", "source": "evl_soakactivityfraction", "from": { "file_variable": "monthID" } } },
        "saf_hourDayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.hourDayID.", "update": { "kind": "data", "source": "evl_soakactivityfraction", "from": { "file_variable": "hourDayID" } } },
        "saf_opModeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.opModeID: 150 and 151 only -- the table carries no operating mode 300, which is why E3's residual row exists at all.", "update": { "kind": "data", "source": "evl_soakactivityfraction", "from": { "file_variable": "opModeID" } } },
        "saf_soakActivityFraction": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["soakactivityfraction_rows"], "description": "soakactivityfraction.soakActivityFraction: 0.00668717 and 0.993313 at hourDayID 72, 0.0221274 and 0.977873 at 75. TTG-6's output, downstream of finding F12's recurrence, and it reaches the answer at a weight this document computes to be exactly zero.", "update": { "kind": "data", "source": "evl_soakactivityfraction", "from": { "file_variable": "soakActivityFraction" } } },

        "omppa_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["opmodepolprocassoc_rows"], "description": "opmodepolprocassoc.polProcessID: 113 on three rows and -1 on the other 24. -1 cannot be an `enums` value (esm-schema.json requires a positive integer), which is why nothing here names it symbolically -- the join simply never admits it.", "update": { "kind": "data", "source": "evl_opmodepolprocassoc", "from": { "file_variable": "polProcessID" } } },
        "omppa_opModeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["opmodepolprocassoc_rows"], "description": "opmodepolprocassoc.opModeID. E2's admission filter: which operating modes this pollutant-process has at all.", "update": { "kind": "data", "source": "evl_opmodepolprocassoc", "from": { "file_variable": "opModeID" } } },

        "ppa_polProcessID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessassoc_rows"], "description": "pollutantprocessassoc.polProcessID.", "update": { "kind": "data", "source": "evl_pollutantprocessassoc", "from": { "file_variable": "polProcessID" } } },
        "ppa_processID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessassoc_rows"], "description": "pollutantprocessassoc.processID: K17, and the last two digits of the output SCC.", "update": { "kind": "data", "source": "evl_pollutantprocessassoc", "from": { "file_variable": "processID" } } },
        "ppa_pollutantID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["pollutantprocessassoc_rows"], "description": "pollutantprocessassoc.pollutantID.", "update": { "kind": "data", "source": "evl_pollutantprocessassoc", "from": { "file_variable": "pollutantID" } } },

        "ft_fuelTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fueltype_rows"], "description": "fueltype.fuelTypeID.", "update": { "kind": "data", "source": "evl_fueltype", "from": { "file_variable": "fuelTypeID" } } },
        "ft_subjectToEvapCalculations": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["fueltype_rows"], "description": "fueltype.subjectToEvapCalculations, Y/N text decoded through a `codes` map: 1 for gasoline and E85, 0 for diesel and electricity. K9. Measurably inert on this fixture -- emissionratebyage carries no rows for the diesel or electricity bins either -- and here so that a fixture where the two disagree fails at one join.", "update": { "kind": "data", "source": "evl_fueltype", "from": { "file_variable": "subjectToEvapCalculations", "codes": { "map": { "Y": 1, "N": 0 }, "case_insensitive": true } } } },

        "im_complianceFactor": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["imcoverage_rows"], "description": "imcoverage.complianceFactor, over a ZERO-LENGTH axis: the table is empty, so L1's aggregate over it reads the additive identity and L9's blend gets 0. Consumed rather than omitted so that a county with an evap I/M program needs no new column, and so that the emptiness is a measured 0 rather than an assumption.", "update": { "kind": "data", "source": "evl_imcoverage", "from": { "file_variable": "complianceFactor" } } },

        "hd_hourDayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourday_rows"], "description": "hourday.hourDayID.", "update": { "kind": "data", "source": "evl_hourday", "from": { "file_variable": "hourDayID" } } },
        "hd_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourday_rows"], "description": "hourday.dayID.", "update": { "kind": "data", "source": "evl_hourday", "from": { "file_variable": "dayID" } } },
        "hd_hourID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["hourday_rows"], "description": "hourday.hourID. The packed hourDayID is looked up from (dayID, hourID) rather than computed, so that hourID x 10 + dayID appears nowhere in this document.", "update": { "kind": "data", "source": "evl_hourday", "from": { "file_variable": "hourID" } } },

        "dow_dayID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayofanyweek_rows"], "description": "dayofanyweek.dayID.", "update": { "kind": "data", "source": "evl_dayofanyweek", "from": { "file_variable": "dayID" } } },
        "dow_noOfRealDays": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["dayofanyweek_rows"], "description": "dayofanyweek.noOfRealDays: 2 and 5. L9's divisor, and the factor A7 multiplied in; applying it in both places or neither is a factor of 2 and 5.", "update": { "kind": "data", "source": "evl_dayofanyweek", "from": { "file_variable": "noOfRealDays" } } },

        "lnk_linkID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["link_rows"], "description": "link.linkID.", "update": { "kind": "data", "source": "evl_link", "from": { "file_variable": "linkID" } } },
        "lnk_countyID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["link_rows"], "description": "link.countyID. The output row's stateID is floor(countyID / 1000), as fixtures/nr-logging-county.esm derives it, rather than a second table.", "update": { "kind": "data", "source": "evl_link", "from": { "file_variable": "countyID" } } },
        "lnk_zoneID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["link_rows"], "description": "link.zoneID: A9's and E2's spatial key.", "update": { "kind": "data", "source": "evl_link", "from": { "file_variable": "zoneID" } } },
        "lnk_roadTypeID": { "type": "parameter", "units": "1", "default": 0.0, "shape": ["link_rows"], "description": "link.roadTypeID = 4. A10 turns this one value into the whole slice's independence from finding F12: an on-network link takes SourceHours = SHO, an off-network one takes SHP, and only the first makes E1's ratio exactly 1.", "update": { "kind": "data", "source": "evl_link", "from": { "file_variable": "roadTypeID" } } },

        "run_yearID": { "type": "unknown", "shape": ["run_rows"], "description": "The analysis year, from runspecyear. A ONE-ROW RELATION and not a scalar: a scalar is not materialized in a document that ingests (finding F16) and cannot be a join key (docs/esm-conventions.md 16.1)." },
        "run_monthID": { "type": "unknown", "shape": ["run_rows"], "description": "The run's month, from runspecmonth." },
        "run_hourID": { "type": "unknown", "shape": ["run_rows"], "description": "The run's hour, from runspechour." },
        "run_sourceTypeID": { "type": "unknown", "shape": ["run_rows"], "description": "The run's source type, from runspecsourcetype." },
        "run_roadTypeID": { "type": "unknown", "shape": ["run_rows"], "description": "The run's road type, from runspecroadtype. A5, A7 and A9 all key on it." },
        "run_polProcessID": { "type": "unknown", "shape": ["run_rows"], "description": "100 x 1 + 13 = 113, built by `pol_process_id` from the pollutant and process enums. No bare 113 appears in an equation." },
        "run_linkID": { "type": "unknown", "shape": ["run_rows"], "description": "The iteration link, from link." },
        "run_countyID": { "type": "unknown", "shape": ["run_rows"], "description": "The county, from link. C4's fuel-usage scope keys on it." },
        "run_zoneID": { "type": "unknown", "shape": ["run_rows"], "description": "The zone, from link. A9's and E2's spatial key." },
        "run_linkRoadTypeID": { "type": "unknown", "shape": ["run_rows"], "description": "The LINK's road type, which is a different thing from the run's selected road type and happens to agree here. A10 tests this one." },
        "run_stateID": { "type": "unknown", "shape": ["run_rows"], "description": "floor(countyID / 1000) = 26. Derived rather than read from a second table, as fixtures/nr-logging-county.esm derives it." },
        "run_isOnNetworkLink": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "1 if the link's road type is not the off-network type 1. A10's branch, and the single condition this slice's independence from finding F12 rests on." },
        "run_baseYearIsAnalysisYear": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A1: is the analysis year itself flagged as a base year? 1 here, which makes TotalActivityGenerator's population and VMT growth folds the empty product. Measured, `year.isBaseYear` is Y on all 63 rows, so this is 1 for any analysis year in this corpus." },
        "run_fuelYearID": { "type": "unknown", "shape": ["run_rows"], "description": "year[analysisYear].fuelYearID = 2020. C4's scope." },
        "run_hpmsVtypeID": { "type": "unknown", "shape": ["run_rows"], "description": "sourceusetype[sourceType].HPMSVtypeID = 25. A3's normalisation group and A4's VMT key." },
        "run_analysisYearVMT": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A4: hpmsvtypeyear[25, 2020].HPMSBaseYearVMT = 2.572988371051e12 national annual vehicle-miles. The growth fold is empty (see run_baseYearIsAnalysisYear), so this is the stored base-year value." },
        "run_roadTypeVMTFraction": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A5: roadtypedistribution[21, 4].roadTypeVMTFraction = 0.259544, gated to `roadtype.isAffectedByOnroad`." },
        "run_monthVMTFraction": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A7: monthvmtfraction[21, 8].monthVMTFraction = 0.0934297." },
        "run_daysInMonth": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "monthofanyyear[8].noOfDays = 31." },
        "run_weeksPerMonth": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A7's DIVISOR, 31/7 = 4.428571428571429, by lib/onroad_activity.esm's `weeks_per_month`. Omitting it multiplies every row by 4.43; multiplying instead of dividing is 19.6x." },
        "run_shoAllocFactor": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A9: zoneroadtype[261610, 4].SHOAllocFactor = 0.001645627794." },
        "run_sourceTypePopulation": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A2: sourcetypeyear[2020, 21].sourceTypePopulation, the run's source type before the age split." },
        "run_travelGroupTotal": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "A3's DENOMINATOR: sum of population x relativeMAR over every (source type, age) in the run's HPMS group -- source types 21, 31 and 32 for HPMS 25, not just the run's. 1.82397687e8 here. Normalising over the run's source type alone is a 2.55x error that reaches every emitted row." },
        "run_pollutantID": { "type": "unknown", "shape": ["run_rows"], "description": "pollutantprocessassoc[113].pollutantID = 1, via K17." },
        "run_processID": { "type": "unknown", "shape": ["run_rows"], "description": "pollutantprocessassoc[113].processID = 13, via K17. Also the SCC's last two digits." },

        "sta_ageFraction": { "type": "unknown", "shape": ["sourcetypeage_rows"], "units": "1", "description": "The age distribution brought onto the 533-row (source type, age) relation from the 33,579-row table, on (sourceTypeID, ageID) and the run's year. Two relations in one node, which is what keeps it affordable: the five-relation form of this stage did not finish in 120 s (docs/evap-leaks.md 7.5, finding F17)." },
        "sta_population": { "type": "unknown", "shape": ["sourcetypeage_rows"], "units": "1", "description": "A2 on the same relation: the source type's population for the run's year times this age's fraction." },
        "sta_isInHpmsGroup": { "type": "unknown", "shape": ["sourcetypeage_rows"], "units": "1", "description": "Semi-join over sourceusetype: is this row's source type in the run's HPMS group? 1 for source types 21, 31 and 32. `bool_and_or` with a numeric body, bound as `> 0` (docs/esm-conventions.md 3)." },

        "ac_ordinal": { "type": "unknown", "shape": ["agecategory_rows"], "description": "The agecategory relation's own row ordinal, 1..41, so that the activity and cohort relations can join to it by position rather than by assuming the file's ageID order. The aggregate's loop symbol is usable as a value, which is what makes this expressible." },
        "day_ordinal": { "type": "unknown", "shape": ["runspecday_rows"], "description": "The runspecday relation's own row ordinal, 1..2, for the same reason." },
        "day_hourDayID": { "type": "unknown", "shape": ["runspecday_rows"], "description": "hourday[dayID, runHour].hourDayID: 72 and 75. Looked up, not computed, so that `hourID x 10 + dayID` appears nowhere." },
        "day_shoTotal": { "type": "unknown", "shape": ["runspecday_rows"], "units": "1", "description": "E1's numerator: SHO summed over the 41 ages for this day type. 594.229522 h and 5654.364 h." },
        "day_sourceHoursTotal": { "type": "unknown", "shape": ["runspecday_rows"], "units": "1", "description": "E1's denominator: sourceHours summed over the same ages. Identical to day_shoTotal here because the link is on-network and A10 makes the two relations the same numbers row for row -- which is why the ratio is EXACTLY 1 and not approximately 1." },
        "day_fractionOfOperating": { "type": "unknown", "shape": ["runspecday_rows"], "units": "1", "description": "E1: `least(1, SUM(SHO)/SUM(sourceHours))` with a zero-denominator guard, by lib/evaporative.esm's `operating_share_of_activity`. Exactly 1 on both day types, which the snapshot's own `fractionofoperating` table stores as 1.000000000000." },
        "day_soakSum": { "type": "unknown", "shape": ["runspecday_rows"], "units": "1", "description": "E3's `SUM(opModeFraction)` over the soak modes of this day type: exactly 0 here, because E2 multiplies by 1 - day_fractionOfOperating." },

        "mode_opModeID": { "type": "unknown", "shape": ["evap_op_mode_rows"], "description": "The three operating modes this pollutant-process has: 150 hot-soaking, 151 cold-soaking, 300 operating, built from `enums`. The axis is size 3 rather than discovered because opmodepolprocassoc holds 27 rows and compacting the 3 that carry polProcessID 113 is finding F5's value invention; `modeAssociationCount` proves there are exactly three." },
        "mode_isAssociated": { "type": "unknown", "shape": ["evap_op_mode_rows"], "units": "1", "description": "E2's admission semi-join: does opmodepolprocassoc carry this mode for the run's pollutant-process? 1 on all three. The table's other 24 rows are the drive-cycle modes at polProcessID -1 and are never admitted." },

        "omd_hasSoakRow": { "type": "unknown", "shape": ["runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "Is there a soakactivityfraction row for this (day type, operating mode)? 1 for modes 150 and 151, 0 for 300. This is the reference's control flow and not a test on the identifier 300: E2 emits a row per mode the table carries, and E3 emits the residual for whatever is left." },
        "omd_soakActivityFraction": { "type": "unknown", "shape": ["runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "soakactivityfraction brought onto the (day type, mode) rectangle, scoped by source type, zone and month." },
        "omd_soakShare": { "type": "unknown", "shape": ["runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "E2: `soakActivityFraction x (1 - fractionOfOperating)`, by lib/evaporative.esm's `soak_share`, gated by the admission semi-join. Exactly 0 on all six cells here, and the zero is COMPUTED from A10's identity rather than assumed." },
        "omd_opModeFraction": { "type": "unknown", "shape": ["runspecday_rows", "evap_op_mode_rows"], "units": "1", "description": "E2 and E3 together: the soak share where the table has a row, else `greatest(0, 1 - day_soakSum)`. {150: 0, 151: 0, 300: 1} on both day types, which is `opmodedistributiontemp` -- a table this document does not read. Mode 300 is a RESIDUAL, not fractionOfOperating; on this fixture the two are indistinguishable, and components/evap_operating_mode_distribution.esm carries the probe row that tells them apart." },

        "act_dayOrdinal": { "type": "unknown", "shape": ["activity_rows"], "description": "Which day type this activity row belongs to: `floor((r - 1) / n_agecategory) + 1`. The block length is the DISCOVERED extent of agecategory, not a literal." },
        "act_ageOrdinal": { "type": "unknown", "shape": ["activity_rows"], "description": "Which age: `(r - 1) - n_agecategory x floor((r - 1) / n_agecategory) + 1`, the same decomposition fixtures/nr-logging-county.esm uses for its output relation." },
        "act_ageID": { "type": "unknown", "shape": ["activity_rows"], "description": "agecategory.ageID for this row, joined on the ordinal." },
        "act_dayID": { "type": "unknown", "shape": ["activity_rows"], "description": "runspecday.dayID for this row, joined on the ordinal." },
        "act_hourDayID": { "type": "unknown", "shape": ["activity_rows"], "description": "The packed hour-day key for this row, joined from the day relation." },
        "act_ageFraction": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A2: the run's source type's age distribution at this age." },
        "act_population": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A2: population x ageFraction." },
        "act_relativeMAR": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A3: sourcetypeage[21, ageID].relativeMAR." },
        "act_populationMar": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A3's numerator: population x relativeMAR for this (source type, age)." },
        "act_travelGroupTotal": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A3's denominator brought to every row, so that the normalisation is one elementwise division. The run-level value is a one-row relation and an aggregate over (activity x run) is how it reaches an 82-row array." },
        "act_travelFraction": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A3, by lib/onroad_activity.esm's `share_of_group` with its zero-denominator guard: this cohort's share of the HPMS group's mileage-weighted population." },
        "act_annualVMT": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A5: analysisYearVMT x roadTypeVMTFraction x travelFraction. Still NATIONAL -- the zone allocation is A9." },
        "act_dayVMTFraction": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "dayvmtfraction for this (source type, month, road type, day type)." },
        "act_hourVMTFraction": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "hourvmtfraction for this (source type, road type, day type, hour)." },
        "act_averageSpeed": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A6: the ARITHMETIC mean of the speed-bin distribution, sum(avgSpeedFraction x avgBinSpeed), in mph. 67.0416879 on the weekend and 56.361205525 on the weekday; the harmonic means of the same two distributions are 54.2427 and 35.5758, and A8 divides by this number." },
        "act_vmt": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A7: annualVMT x monthVMTFraction x dayVMTFraction x hourVMTFraction / weeksPerMonth. Vehicle-miles in one hour of one day type, summed over that day type's real days in an average week." },
        "act_sho": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A8 and A9: vmt / averageSpeed, guarded against a missing speed row, times the zone allocation factor. This is the `sho` table -- 82 rows the document does not read." },
        "act_sourceHours": { "type": "unknown", "shape": ["activity_rows"], "units": "1", "description": "A10: SourceHours = SHO at an ON-network link and SHP at the off-network one (allocation.rs:631-682). The off-network branch computes SHP, which this document does not, so it emits NOT-A-NUMBER there rather than silently reusing SHO -- an off-network run then fails loudly at the first assertion instead of quietly emitting the wrong activity." },

        "cohq_ordinal": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The EQUIPPED side of C4, as a second relation over a second index set, because a relation cannot be joined to itself (finding F11) and the fuel-usage remap pairs a cohort with other cohorts of its own model year. Finding F11's cost, measured in Phase 3, is that the workaround duplicates the whole relation and not only its key column -- which is what the six `cohq_` columns below are." },
        "cohq_fuelOrdinal": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's fuel ordinal." },
        "cohq_ageOrdinal": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's age ordinal." },
        "cohq_fuelTypeID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's fuel type: the fuel the VEHICLE is built for." },
        "cohq_modelYearID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's model year." },
        "cohq_engTechID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's engine technology. C4's match requires it to agree with the used side's." },
        "cohq_regClassID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's regulatory class, likewise." },
        "cohq_modelYearGroupID": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's model-year group. C4's match requires it to agree with the used side's, which it does automatically for two cohorts of the same model year -- and the join says so rather than relying on it." },
        "cohq_sourceBinActivityFraction": { "type": "unknown", "shape": ["cohort_equipped_rows"], "description": "The equipped side's C3 fraction. Equal to coh_sourceBinActivityFraction row for row; it exists as a separate column because an operand of an equation shaped over one index set must itself be shaped over that set." },

        "coh_ordinal": { "type": "unknown", "shape": ["cohort_rows"], "description": "The cohort relation's own row ordinal, 1..164. The relation is the RECTANGLE (41 model years x 4 fuel types) whose two factors are both discovered extents -- `n_agecategory` and `n_runspecsourcefueltype` -- so this axis is measured from the files and not declared. Membership is a column, not a shrunken axis (docs/esm-conventions.md 2, finding F14)." },
        "coh_fuelOrdinal": { "type": "unknown", "shape": ["cohort_rows"], "description": "`floor((c - 1) / n_agecategory) + 1`: which of runspecsourcefueltype's fuels, fuel-major so that each occupies one contiguous run." },
        "coh_ageOrdinal": { "type": "unknown", "shape": ["cohort_rows"], "description": "`(c - 1) - n_agecategory x floor((c - 1) / n_agecategory) + 1`: which age category." },
        "coh_fuelTypeID": { "type": "unknown", "shape": ["cohort_rows"], "description": "runspecsourcefueltype.fuelTypeID, joined on the fuel ordinal." },
        "coh_ageID": { "type": "unknown", "shape": ["cohort_rows"], "description": "agecategory.ageID, joined on the age ordinal." },
        "coh_ageGroupID": { "type": "unknown", "shape": ["cohort_rows"], "description": "agecategory.ageGroupID for the same row: K12's left-hand key, and the reason this relation is keyed by AGE and derives the model year rather than the other way round." },
        "coh_modelYearID": { "type": "unknown", "shape": ["cohort_rows"], "description": "C1: `runYear - ageID`, which spans [1980, 2020] because agecategory has 41 rows. THE derived key, used by K12 through the age group and by K15 through the age." },
        "coh_stmyFraction": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "samplevehiclepopulation.stmyFraction for this (source type, model year, fuel type). Zero on 39 of the 164 candidates -- the years before E85 and electric drive existed, and the year diesel passenger cars stopped." },
        "coh_engTechID": { "type": "unknown", "shape": ["cohort_rows"], "description": "The cohort's engine technology, from the same row." },
        "coh_regClassID": { "type": "unknown", "shape": ["cohort_rows"], "description": "The cohort's regulatory class, from the same row." },
        "coh_modelYearGroupID": { "type": "unknown", "shape": ["cohort_rows"], "description": "pollutantprocessmodelyear[polProcess, modelYear].modelYearGroupID: the group the evaporative source bins are keyed by." },
        "coh_modelYearGroupIsPresent": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C2's two inner joins as one semi-join: does the pollutantprocessmodelyear-to-modelyeargroup chain reach this model year at all? Both are inner joins in the generator, so a miss drops the candidate." },
        "coh_isSelected": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C2's row rule (`source_bin_distribution_generator.rs:1337-1341`): `stmyFraction > 0` AND the group chain reaches it. 125 of the 164 candidates. Spelled as a membership COLUMN on a flat relation rather than a shrunken axis." },
        "coh_sourceBinActivityFraction": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C3: the surviving stmyFraction. There is no normalisation anywhere in the generator -- the sum-to-1 property is inherited from the input." },
        "coh_binExists": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C4's existence condition as a semi-join against sourcebin on (fuelTypeID, engTechID, regClassID, modelYearGroupID): does a source bin exist for the fuel this cohort would be re-attributed TO? The reference forms the used bin by pairing two sourcebin rows, which would be a self-join; keying on the components instead makes it a presence test, and it admits all 99 equipped-by-usage pairs on this fixture (docs/evap-leaks.md 2.2)." },
        "coh_usedFraction": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "C4: the same activity re-attributed to the fuel each cohort actually BURNS -- `sum over equipped of usageFraction x sourceBinActivityFraction`. This is the column L8 weights by, and using C3's raw fraction instead is a factor of 56 on the worst cell and nothing at all on any total (docs/evap-leaks.md 7.3)." },
        "coh_hasRate": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "Does emissionratebyage carry any row for this cohort's bin at all? 1 for gasoline and E85, 0 for diesel and electricity -- their 39 bins have no rate rows, which is the second of the two mechanisms that take the 125 surviving cohorts down to 64 (docs/evap-leaks.md 0.2, 6.4)." },
        "coh_survives": { "type": "unknown", "shape": ["cohort_rows"], "units": "1", "description": "Both mechanisms: selected by C2 AND rate-bearing. 64 of the 164, and they are the cohorts MOVESOutput carries." },
        "cohortSurvivorCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "The surviving cohorts, counted from the chain: 64. This is what makes `n_outputCohort` a checked declaration rather than a transcription -- a chain that produced 63 fails the test that pins the two together, in this document, before the comparator sees a row." },

        "era_fuelTypeID": { "type": "unknown", "shape": ["emissionratebyage_rows"], "description": "The bin components brought onto the 6,564-row rate relation by K8, on the packed sourceBinID. Pre-attaching them here rather than joining sourcebin inside L8 is what turns L8 into a two-relation contraction: the five-relation form did not finish in 120 s (docs/evap-leaks.md 7.5, finding F17 at fixture scale)." },
        "era_engTechID": { "type": "unknown", "shape": ["emissionratebyage_rows"], "description": "Likewise, the bin's engine technology." },
        "era_regClassID": { "type": "unknown", "shape": ["emissionratebyage_rows"], "description": "Likewise, the bin's regulatory class." },
        "era_modelYearGroupID": { "type": "unknown", "shape": ["emissionratebyage_rows"], "description": "Likewise, the bin's model-year group." },
        "era_isEvapFuel": { "type": "unknown", "shape": ["emissionratebyage_rows"], "units": "1", "description": "K9: is the bin's fuel subject to evaporative calculations? Measurably inert on this fixture and present so that a fixture where the flag and the rate table's coverage disagree fails at one join." },
        "era_isRunPolProcess": { "type": "unknown", "shape": ["emissionratebyage_rows"], "units": "1", "description": "Is this rate row the run's pollutant-process? 1 on all 6,564 rows of this extract; joined anyway, because the extract is the data plane's business and not the algorithm's." },

        "cohortMode_rate": { "type": "unknown", "shape": ["cohort_rows", "evap_op_mode_rows"], "units": "1", "description": "L8, `WeightedMeanBaseRate`: `sum over bins of sourceBinActivityFraction x meanBaseRate`, in grams of THC per hour, keyed by cohort and operating mode. The operating mode has its own AXIS -- docs/esm-conventions.md 11.1's remedy -- which is what lets K12, K9 and the group-by meet in one two-relation node. L8's CROSS JOIN over the run's months and hour-days carries no information and is not modelled; O1 attaches those keys where they first matter." },
        "cohortMode_rateIM": { "type": "unknown", "shape": ["cohort_rows", "evap_op_mode_rows"], "units": "1", "description": "The same sum over meanBaseRateIM, L8's second measure, consumed only by L9's blend." },

        "fuelUsageWildcardCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many fuelusagefraction rows carry the model-year-group WILDCARD 0: five of five. C4's match is `f.modelYearGroupID = 0 OR e.modelYearGroupID = f.modelYearGroupID`; this document implements the wildcard branch alone, and this count is what licenses that." },
        "sourceBinZeroSlotCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many source bins have engSizeID and weightClassID both zero: 80 of 80. C4's equipped-to-used match includes both columns and the cohort relation carries neither, so this count is what makes leaving them out of the match correct here." },
        "evapFuelCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many fuel types are subject to evaporative calculations: two, gasoline and E85. Proves the `codes` map decoded the Y/N column rather than silently delivering a default." },
        "imCoverageRowCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many imcoverage rows the run has. Zero, from a zero-length discovered axis, which is what makes L9's blend the identity as a MEASURED fact rather than an assumed one." },
        "modeAssociationCount": { "type": "unknown", "shape": ["run_rows"], "units": "1", "description": "How many of the three declared operating modes opmodepolprocassoc associates with the run's pollutant-process: three. Proves the declared 3-row mode axis is neither short nor long." },

        "outCohortOrdinal": { "type": "unknown", "shape": ["output_rows"], "description": "Which surviving cohort this output row is, 1..64: `(o - 1) - n_outputCohort x floor((o - 1) / n_outputCohort) + 1`. Not a MOVESOutput column, so it carries no `out_` prefix and is not emitted." },
        "outDayOrdinal": { "type": "unknown", "shape": ["output_rows"], "description": "Which day type this output row is, 1..2: `floor((o - 1) / n_outputCohort) + 1`. The 128 rows are cohort-minor within day-major blocks." },
        "outCohortRow": { "type": "unknown", "shape": ["output_rows"], "description": "The row of the 164-row cohort relation this output row draws from. The surviving cohorts are two contiguous runs -- all 41 gasoline model years, then E85 from 1998 -- so the map is `ordinal <= n_agecategory ? ordinal : ordinal + n_agecategory`, which skips the 41 diesel rows between them. THIS IS THE DECLARED PART: that the survivors are gasoline's whole block followed by E85's leading block is a fact about the fixture, checked by `cohortSurvivorCount` and by the comparator's exact key set, not derived. docs/evap-leaks.md 7.5(2)." },
        "outAgeID": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "`runYear - modelYearID`: K15's key into the activity relation, and the same derived age K12 used to pick the rate. moves.rs writes the subtraction at :767 and :935; this document writes it once per relation and joins on the column." },
        "outSourceHours": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "K15: `sourceHours` for this row's (hourDayID, ageID)." },
        "outNoOfRealDays": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "K19: 2 on the weekend rows and 5 on the weekday rows. L9's divisor." },
        "outHourDayID": { "type": "unknown", "shape": ["output_rows"], "description": "This row's packed hour-day key, from the day relation." },
        "outImAdjustFract": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "L1 and K21: the I/M adjustment fraction for this row. Zero everywhere, because imcoverage is empty and the aggregate over its zero-length axis reads the additive identity -- the SQL's `a row with no matching cell keeps its value unchanged`, computed." },
        "outEmissionQuantBase": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "L9 and O1: `sum over operating modes of ((rate x sourceHours) x opModeFraction) / noOfRealDays`, in grams. The grouping is the reference's and the sum over modes is O1's, so the two suppressed soak modes contribute exactly zero rather than being left out." },
        "outEmissionQuantIM": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "The same sum over the I/M rate, L9's second working column." },

        "out_yearID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.yearID." },
        "out_monthID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.monthID." },
        "out_dayID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.dayID, from the day relation on the ordinal." },
        "out_hourID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.hourID = 7." },
        "out_stateID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.stateID = floor(countyID / 1000) = 26." },
        "out_countyID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.countyID." },
        "out_zoneID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.zoneID, which this run leaves NULL: `null_output_column` is 0/0, a NaN, and the comparator reads NaN, NULL and empty as the same thing. Emitting 0 would claim zone zero." },
        "out_linkID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.linkID, NULL." },
        "out_pollutantID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.pollutantID = 1, from K17." },
        "out_processID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.processID = 13, from K17." },
        "out_sourceTypeID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.sourceTypeID = 21. Present, unlike a NONROAD row's." },
        "out_regClassID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.regClassID, NULL. L8 and L9 carry it and O1 aggregates it away, because this run's output breakdown does not select the vehicle type; on this fixture that aggregation is a no-op since sourcebin holds one class." },
        "out_fuelTypeID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.fuelTypeID, from the cohort relation." },
        "out_fuelSubTypeID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.fuelSubTypeID, NULL." },
        "out_modelYearID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.modelYearID, from the cohort relation -- joined, not transcribed." },
        "out_roadTypeID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.roadTypeID = 4, from the link. tolerance.toml ignores this column in the comparison, but the SCC's road-type slot is computed from it and that is compared." },
        "out_SCC": { "type": "unknown", "shape": ["output_rows"], "description": "O2: 22e8 + fuelTypeID x 1e6 + sourceTypeID x 1e4 + roadTypeID x 1e2 + processID (engine.rs:1450-1477), by lib/onroad_activity.esm's `onroad_scc`. 2201210413 for gasoline and 2205210413 for E85; it is COMPUTED, and the `scc` table's 14,976 rows are read by nothing." },
        "out_engTechID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.engTechID, NULL." },
        "out_sectorID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.sectorID, NULL -- a NONROAD column." },
        "out_hpID": { "type": "unknown", "shape": ["output_rows"], "description": "MOVESOutput.hpID, NULL -- a NONROAD column." },
        "out_emissionQuant": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "MOVESOutput.emissionQuant, in grams of THC: L9's product blended by lib/adjustments.esm's `im_blend`. The blend is applied after O1's sum over operating modes rather than before, which is exact and not an approximation: `im_blend` is affine in the two quantities at a fixed fraction, and the fraction is keyed on (process, pollutant, model year, fuel type, source type) -- none of which is the operating mode. `g` is a registry unit but no factor in the product carries one, so neither can the product." },

        "absentRegClassIndicator": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "1 where out_regClassID is absent, by lib/identifiers.esm's `output_column_is_absent`. The absence cannot be pinned directly -- `Assertion.expected` is a JSON number so NaN cannot be written down, and every tolerance form is a magnitude comparison a NaN actual fails -- so this is how O3 gets a test with a non-zero expected value (docs/esm-conventions.md 18.2)." },
        "presentQuantIndicator": { "type": "unknown", "shape": ["output_rows"], "units": "1", "description": "The NEGATIVE control: the same template applied to out_emissionQuant, which is present, so it reads 0 on every row. Without it an indicator stuck at 1 would satisfy the absence test." }
      },

      "equations": [
        {
          "_comment": "The run scope, each value lifted from its own one-row source relation. An aggregate over (run_rows x source_rows) with NO join clause is the cross product of two one-row relations, which is the shape fixtures/nr-logging-county.esm uses for the same job.",
          "lhs": "run_yearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspecyear_rows" } },
            "expr": { "op": "index", "args": ["rsy_yearID", "s"] } }
        },
        { "lhs": "run_monthID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspecmonth_rows" } },
            "expr": { "op": "index", "args": ["rsm_monthID", "s"] } } },
        { "lhs": "run_hourID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspechour_rows" } },
            "expr": { "op": "index", "args": ["rsh_hourID", "s"] } } },
        { "lhs": "run_sourceTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspecsourcetype_rows" } },
            "expr": { "op": "index", "args": ["rst_sourceTypeID", "s"] } } },
        { "lhs": "run_roadTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "s": { "from": "runspecroadtype_rows" } },
            "expr": { "op": "index", "args": ["rsr_roadTypeID", "s"] } } },
        { "lhs": "run_linkID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "l": { "from": "link_rows" } },
            "expr": { "op": "index", "args": ["lnk_linkID", "l"] } } },
        { "lhs": "run_countyID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "l": { "from": "link_rows" } },
            "expr": { "op": "index", "args": ["lnk_countyID", "l"] } } },
        { "lhs": "run_zoneID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "l": { "from": "link_rows" } },
            "expr": { "op": "index", "args": ["lnk_zoneID", "l"] } } },
        { "lhs": "run_linkRoadTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "l": { "from": "link_rows" } },
            "expr": { "op": "index", "args": ["lnk_roadTypeID", "l"] } } },
        { "lhs": "run_stateID",
          "rhs": { "op": "floor", "args": [{ "op": "/", "args": ["run_countyID", 1000] }] } },
        {
          "_comment": "A10's branch condition: the off-network road type is 1 and every on-network type is above it.",
          "lhs": "run_isOnNetworkLink",
          "rhs": { "op": "ifelse", "args": [
            { "op": ">", "args": ["run_linkRoadTypeID", { "op": "enum", "args": ["road_type", "OffNetwork"] }] },
            1.0, 0.0] } },
        { "lhs": "run_polProcessID",
          "rhs": { "op": "makearray", "args": [], "regions": [[[1, 1]]],
            "values": [
              { "op": "apply_expression_template", "args": [], "name": "pol_process_id",
                "bindings": {
                  "pollutant_id": { "op": "enum", "args": ["pollutant", "TotalGaseousHydrocarbons"] },
                  "process_id": { "op": "enum", "args": ["process", "EvapFuelLeaks"] } } }
            ] } },
        {
          "_comment": "A1: is the analysis year flagged as a base year? The flag is Y/N text decoded by a `codes` map at ingest.",
          "lhs": "run_baseYearIsAnalysisYear",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "y": { "from": "year_rows" } },
            "join": [ { "on": [["run_yearID", "yr_yearID"]] } ],
            "expr": { "op": "index", "args": ["yr_isBaseYear", "y"] } } },
        { "lhs": "run_fuelYearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "y": { "from": "year_rows" } },
            "join": [ { "on": [["run_yearID", "yr_yearID"]] } ],
            "expr": { "op": "index", "args": ["yr_fuelYearID", "y"] } } },
        { "lhs": "run_hpmsVtypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "u": { "from": "sourceusetype_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "sut_sourceTypeID"]] } ],
            "expr": { "op": "index", "args": ["sut_HPMSVtypeID", "u"] } } },
        {
          "_comment": "A4. One clause, two pairs: the HPMS type and the year.",
          "lhs": "run_analysisYearVMT",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "h": { "from": "hpmsvtypeyear_rows" } },
            "join": [ { "on": [["run_hpmsVtypeID", "hvy_HPMSVtypeID"], ["run_yearID", "hvy_yearID"]] } ],
            "expr": { "op": "index", "args": ["hvy_HPMSBaseYearVMT", "h"] } } },
        {
          "_comment": "A5, gated to `roadtype` membership: two clauses over two relations, composing by conjunction.",
          "lhs": "run_roadTypeVMTFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "d": { "from": "roadtypedistribution_rows" },
                        "w": { "from": "roadtype_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "rtd_sourceTypeID"], ["run_roadTypeID", "rtd_roadTypeID"]] },
                      { "on": [["rtd_roadTypeID", "rt_roadTypeID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["rtd_roadTypeVMTFraction", "d"] },
              { "op": "index", "args": ["rt_isAffectedByOnroad", "w"] }] } } },
        { "lhs": "run_monthVMTFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "v": { "from": "monthvmtfraction_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "mvf_sourceTypeID"], ["run_monthID", "mvf_monthID"]] } ],
            "expr": { "op": "index", "args": ["mvf_monthVMTFraction", "v"] } } },
        { "lhs": "run_daysInMonth",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "n": { "from": "monthofanyyear_rows" } },
            "join": [ { "on": [["run_monthID", "moy_monthID"]] } ],
            "expr": { "op": "index", "args": ["moy_noOfDays", "n"] } } },
        { "lhs": "run_weeksPerMonth",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "weeks_per_month",
            "bindings": { "days_in_month": "run_daysInMonth" } } },
        { "lhs": "run_shoAllocFactor",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "z": { "from": "zoneroadtype_rows" } },
            "join": [ { "on": [["run_zoneID", "zrt_zoneID"], ["run_roadTypeID", "zrt_roadTypeID"]] } ],
            "expr": { "op": "index", "args": ["zrt_SHOAllocFactor", "z"] } } },
        { "lhs": "run_sourceTypePopulation",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "p": { "from": "sourcetypeyear_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "sty_sourceTypeID"], ["run_yearID", "sty_yearID"]] } ],
            "expr": { "op": "index", "args": ["sty_sourceTypePopulation", "p"] } } },
        { "lhs": "run_pollutantID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "a": { "from": "pollutantprocessassoc_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppa_polProcessID"]] } ],
            "expr": { "op": "index", "args": ["ppa_pollutantID", "a"] } } },
        { "lhs": "run_processID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "a": { "from": "pollutantprocessassoc_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppa_polProcessID"]] } ],
            "expr": { "op": "index", "args": ["ppa_processID", "a"] } } },

        {
          "_comment": "A3's denominator is assembled on the 533-row (source type, age) relation, because that is the SMALL side of the join to the 33,579-row distribution. The five-relation form of this stage did not finish in 120 s (finding F17).",
          "lhs": "sta_ageFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["q"],
            "ranges": { "q": { "from": "sourcetypeage_rows" },
                        "p": { "from": "sourcetypeagedistribution_rows" },
                        "k": { "from": "run_rows" } },
            "join": [ { "on": [["sta_sourceTypeID", "stad_sourceTypeID"], ["sta_ageID", "stad_ageID"]] },
                      { "on": [["stad_yearID", "run_yearID"]] } ],
            "expr": { "op": "index", "args": ["stad_ageFraction", "p"] } } },
        { "lhs": "sta_population",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["q"],
            "ranges": { "q": { "from": "sourcetypeage_rows" }, "y": { "from": "sourcetypeyear_rows" },
                        "k": { "from": "run_rows" } },
            "join": [ { "on": [["sta_sourceTypeID", "sty_sourceTypeID"], ["run_yearID", "sty_yearID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["sty_sourceTypePopulation", "y"] },
              { "op": "index", "args": ["sta_ageFraction", "q"] }] } } },
        { "lhs": "sta_isInHpmsGroup",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["q"],
            "ranges": { "q": { "from": "sourcetypeage_rows" }, "u": { "from": "sourceusetype_rows" },
                        "k": { "from": "run_rows" } },
            "join": [ { "on": [["sta_sourceTypeID", "sut_sourceTypeID"]] },
                      { "on": [["sut_HPMSVtypeID", "run_hpmsVtypeID"]] } ],
            "expr": 1.0 } },
        {
          "_comment": "A3's denominator: over every (source type, age) in the run's HPMS group, not just the run's source type. Normalising over the run's alone is a 2.55x error.",
          "lhs": "run_travelGroupTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "q": { "from": "sourcetypeage_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["sta_population", "q"] },
                { "op": "index", "args": ["sta_relativeMAR", "q"] }] },
              { "op": "index", "args": ["sta_isInHpmsGroup", "q"] }] } } },

        {
          "_comment": "Row ordinals, so that the derived relations join to their factors by POSITION rather than by assuming a file's key order. The aggregate's loop symbol is usable as a value, which is what makes this expressible at all.",
          "lhs": "ac_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["g"],
            "ranges": { "g": { "from": "agecategory_rows" } }, "expr": "g" } },
        { "lhs": "day_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" } }, "expr": "k" } },
        {
          "_comment": "The packed hour-day key is LOOKED UP from (dayID, hourID), so hourID x 10 + dayID appears nowhere in this document.",
          "lhs": "day_hourDayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" }, "h": { "from": "hourday_rows" },
                        "r": { "from": "run_rows" } },
            "join": [ { "on": [["rsd_dayID", "hd_dayID"]] }, { "on": [["hd_hourID", "run_hourID"]] } ],
            "expr": { "op": "index", "args": ["hd_hourDayID", "h"] } } },

        { "lhs": "mode_opModeID",
          "rhs": { "op": "makearray", "args": [], "regions": [[[1, 1]], [[2, 2]], [[3, 3]]],
            "values": [
              { "op": "enum", "args": ["operating_mode", "HotSoaking"] },
              { "op": "enum", "args": ["operating_mode", "ColdSoaking"] },
              { "op": "enum", "args": ["operating_mode", "Operating"] }
            ] } },
        { "lhs": "mode_isAssociated",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["m"],
            "ranges": { "m": { "from": "evap_op_mode_rows" }, "w": { "from": "opmodepolprocassoc_rows" },
                        "r": { "from": "run_rows" } },
            "join": [ { "on": [["mode_opModeID", "omppa_opModeID"]] },
                      { "on": [["omppa_polProcessID", "run_polProcessID"]] } ],
            "expr": 1.0 } }
,
        {
          "_comment": "The activity relation's ordinals. The block length is n_agecategory, a DISCOVERED extent, so the decomposition carries no literal.",
          "lhs": "act_dayOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" } },
            "expr": { "op": "+", "args": [
              { "op": "floor", "args": [{ "op": "/", "args": [
                { "op": "-", "args": ["r", 1] }, "n_agecategory"] }] }, 1] } }
        },
        { "lhs": "act_ageOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" } },
            "expr": { "op": "+", "args": [
              { "op": "-", "args": [
                { "op": "-", "args": ["r", 1] },
                { "op": "*", "args": ["n_agecategory",
                  { "op": "floor", "args": [{ "op": "/", "args": [
                    { "op": "-", "args": ["r", 1] }, "n_agecategory"] }] }] }] }, 1] } } },
        { "lhs": "act_ageID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "g": { "from": "agecategory_rows" } },
            "join": [ { "on": [["act_ageOrdinal", "ac_ordinal"]] } ],
            "expr": { "op": "index", "args": ["ac_ageID", "g"] } } },
        { "lhs": "act_dayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["act_dayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["rsd_dayID", "k"] } } },
        { "lhs": "act_hourDayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["act_dayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["day_hourDayID", "k"] } } },
        {
          "_comment": "A2. One clause, three pairs: source type, year and age.",
          "lhs": "act_ageFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" },
                        "p": { "from": "sourcetypeagedistribution_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "stad_sourceTypeID"],
                               ["run_yearID", "stad_yearID"],
                               ["act_ageID", "stad_ageID"]] } ],
            "expr": { "op": "index", "args": ["stad_ageFraction", "p"] } } },
        { "lhs": "act_population",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["run_sourceTypePopulation", "n"] },
              { "op": "index", "args": ["act_ageFraction", "r"] }] } } },
        { "lhs": "act_relativeMAR",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "q": { "from": "sourcetypeage_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "sta_sourceTypeID"], ["act_ageID", "sta_ageID"]] } ],
            "expr": { "op": "index", "args": ["sta_relativeMAR", "q"] } } },
        { "lhs": "act_populationMar",
          "rhs": { "op": "*", "args": ["act_population", "act_relativeMAR"] } },
        { "lhs": "act_travelGroupTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_travelGroupTotal", "n"] } } },
        {
          "_comment": "A3, with the zero-denominator guard lib/onroad_activity.esm's share_of_group carries.",
          "lhs": "act_travelFraction",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "share_of_group",
            "bindings": { "numerator": "act_populationMar", "group_total": "act_travelGroupTotal" } } },
        {
          "_comment": "A5. Still national: the zone allocation is A9.",
          "lhs": "act_annualVMT",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["run_analysisYearVMT", "n"] },
                { "op": "index", "args": ["run_roadTypeVMTFraction", "n"] }] },
              { "op": "index", "args": ["act_travelFraction", "r"] }] } } },
        { "lhs": "act_dayVMTFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "v": { "from": "dayvmtfraction_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "dvf_sourceTypeID"],
                               ["run_monthID", "dvf_monthID"],
                               ["run_roadTypeID", "dvf_roadTypeID"],
                               ["act_dayID", "dvf_dayID"]] } ],
            "expr": { "op": "index", "args": ["dvf_dayVMTFraction", "v"] } } },
        { "lhs": "act_hourVMTFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "v": { "from": "hourvmtfraction_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "hvf_sourceTypeID"],
                               ["run_roadTypeID", "hvf_roadTypeID"],
                               ["act_dayID", "hvf_dayID"],
                               ["run_hourID", "hvf_hourID"]] } ],
            "expr": { "op": "index", "args": ["hvf_hourVMTFraction", "v"] } } },
        {
          "_comment": "A6: the ARITHMETIC mean. Two clauses over two relations -- the distribution selected by (source type, road type, hour-day) and each bin's speed attached on the bin id.",
          "lhs": "act_averageSpeed",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "p": { "from": "avgspeeddistribution_rows" },
                        "b": { "from": "avgspeedbin_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "asd_sourceTypeID"],
                               ["run_roadTypeID", "asd_roadTypeID"],
                               ["act_hourDayID", "asd_hourDayID"]] },
                      { "on": [["asd_avgSpeedBinID", "asb_avgSpeedBinID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["asd_avgSpeedFraction", "p"] },
              { "op": "index", "args": ["asb_avgBinSpeed", "b"] }] } } },
        {
          "_comment": "A7. weeksPerMonth is a DIVISOR; omitting it multiplies every row by 4.43.",
          "lhs": "act_vmt",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "/", "args": [
              { "op": "*", "args": [
                { "op": "*", "args": [
                  { "op": "index", "args": ["act_annualVMT", "r"] },
                  { "op": "index", "args": ["run_monthVMTFraction", "n"] }] },
                { "op": "*", "args": [
                  { "op": "index", "args": ["act_dayVMTFraction", "r"] },
                  { "op": "index", "args": ["act_hourVMTFraction", "r"] }] }] },
              { "op": "index", "args": ["run_weeksPerMonth", "n"] }] } } },
        {
          "_comment": "A8 and A9. A8 is a LEFT JOIN whose miss gives SHO = 0 with the VMT intact, and that pair is the diagnostic signature of a missing speed row.",
          "lhs": "act_sho",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "ifelse", "args": [
                { "op": ">", "args": [{ "op": "index", "args": ["act_averageSpeed", "r"] }, 0.0] },
                { "op": "/", "args": [
                  { "op": "index", "args": ["act_vmt", "r"] },
                  { "op": "index", "args": ["act_averageSpeed", "r"] }] },
                0.0] },
              { "op": "index", "args": ["run_shoAllocFactor", "n"] }] } } },
        {
          "_comment": "A10, allocation.rs:631-682. An OFF-network link takes SHP, which this document does not compute, so it emits not-a-number there rather than reusing SHO: a silent zero or a silent SHO would both be wrong quietly, and lib/identifiers.esm's null_output_column is the loudest value available.",
          "lhs": "act_sourceHours",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["r"],
            "ranges": { "r": { "from": "activity_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [{ "op": "index", "args": ["run_isOnNetworkLink", "n"] }, 0.0] },
              { "op": "index", "args": ["act_sho", "r"] },
              { "op": "apply_expression_template", "args": [], "name": "null_output_column",
                "bindings": {} }] } } },
        {
          "_comment": "E1's two totals, over the 41 ages of each day type.",
          "lhs": "day_shoTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" }, "r": { "from": "activity_rows" } },
            "join": [ { "on": [["day_ordinal", "act_dayOrdinal"]] } ],
            "expr": { "op": "index", "args": ["act_sho", "r"] } } },
        { "lhs": "day_sourceHoursTotal",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" }, "r": { "from": "activity_rows" } },
            "join": [ { "on": [["day_ordinal", "act_dayOrdinal"]] } ],
            "expr": { "op": "index", "args": ["act_sourceHours", "r"] } } },
        {
          "_comment": "E1, evap_op_mode_distribution.rs:350. Exactly 1 here, because A10 makes the two totals the same numbers.",
          "lhs": "day_fractionOfOperating",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "operating_share_of_activity",
            "bindings": { "sho_total": "day_shoTotal", "source_hours_total": "day_sourceHoursTotal" } } },
        {
          "_comment": "E2's inputs on the (day type x operating mode) rectangle: does the table carry this cell, and what does it hold?",
          "lhs": "omd_hasSoakRow",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["k", "m"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" },
                        "f": { "from": "soakactivityfraction_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["day_hourDayID", "saf_hourDayID"], ["mode_opModeID", "saf_opModeID"]] },
                      { "on": [["saf_sourceTypeID", "run_sourceTypeID"],
                               ["saf_zoneID", "run_zoneID"],
                               ["saf_monthID", "run_monthID"]] } ],
            "expr": { "op": "index", "args": ["mode_isAssociated", "m"] } } },
        { "lhs": "omd_soakActivityFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k", "m"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" },
                        "f": { "from": "soakactivityfraction_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["day_hourDayID", "saf_hourDayID"], ["mode_opModeID", "saf_opModeID"]] },
                      { "on": [["saf_sourceTypeID", "run_sourceTypeID"],
                               ["saf_zoneID", "run_zoneID"],
                               ["saf_monthID", "run_monthID"]] } ],
            "expr": { "op": "index", "args": ["saf_soakActivityFraction", "f"] } } },
        {
          "_comment": "E2, stage 2. Gated by the admission semi-join, which is what an INNER JOIN is inside a sum.",
          "lhs": "omd_soakShare",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["k", "m"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "apply_expression_template", "args": [], "name": "soak_share",
                "bindings": {
                  "soak_activity_fraction": { "op": "index", "args": ["omd_soakActivityFraction", "k", "m"] },
                  "operating_share": { "op": "index", "args": ["day_fractionOfOperating", "k"] } } },
              { "op": "index", "args": ["omd_hasSoakRow", "k", "m"] }] } } },
        { "lhs": "day_soakSum",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "index", "args": ["omd_soakShare", "k", "m"] } } },
        {
          "_comment": "E2 and E3. Mode 300 is the RESIDUAL of what the soak modes left, not fractionOfOperating; on this fixture the two agree to the last bit and components/evap_operating_mode_distribution.esm carries the probe row that separates them.",
          "lhs": "omd_opModeFraction",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["k", "m"],
            "ranges": { "k": { "from": "runspecday_rows" }, "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [{ "op": "index", "args": ["omd_hasSoakRow", "k", "m"] }, 0.0] },
              { "op": "index", "args": ["omd_soakShare", "k", "m"] },
              { "op": "max", "args": [0.0,
                { "op": "-", "args": [1.0, { "op": "index", "args": ["day_soakSum", "k"] }] }] }] } } }
,
        { "lhs": "rsft_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["u"],
            "ranges": { "u": { "from": "runspecsourcefueltype_rows" } }, "expr": "u" } },

        {
          "_comment": "C1 and C2's candidate grid: 41 model years x 4 fuel types, both factors DISCOVERED extents. Fuel-major, so each fuel occupies one contiguous run of rows.",
          "lhs": "coh_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" } }, "expr": "c" } },
        { "lhs": "coh_fuelOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" } },
            "expr": { "op": "+", "args": [
              { "op": "floor", "args": [{ "op": "/", "args": [
                { "op": "-", "args": ["c", 1] }, "n_agecategory"] }] }, 1] } } },
        { "lhs": "coh_ageOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" } },
            "expr": { "op": "+", "args": [
              { "op": "-", "args": [
                { "op": "-", "args": ["c", 1] },
                { "op": "*", "args": ["n_agecategory",
                  { "op": "floor", "args": [{ "op": "/", "args": [
                    { "op": "-", "args": ["c", 1] }, "n_agecategory"] }] }] }] }, 1] } } },
        { "lhs": "coh_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "u": { "from": "runspecsourcefueltype_rows" } },
            "join": [ { "on": [["coh_fuelOrdinal", "rsft_ordinal"]] } ],
            "expr": { "op": "index", "args": ["rsft_fuelTypeID", "u"] } } },
        { "lhs": "coh_ageID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "g": { "from": "agecategory_rows" } },
            "join": [ { "on": [["coh_ageOrdinal", "ac_ordinal"]] } ],
            "expr": { "op": "index", "args": ["ac_ageID", "g"] } } },
        { "lhs": "coh_ageGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "g": { "from": "agecategory_rows" } },
            "join": [ { "on": [["coh_ageOrdinal", "ac_ordinal"]] } ],
            "expr": { "op": "index", "args": ["ac_ageGroupID", "g"] } } },
        {
          "_comment": "C1: the model-year window is [runYear - maxAge, runYear], which agecategory's 41 rows give without a literal.",
          "lhs": "coh_modelYearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "-", "args": [
              { "op": "index", "args": ["run_yearID", "n"] },
              { "op": "index", "args": ["coh_ageID", "c"] }] } } },
        { "lhs": "coh_stmyFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["coh_modelYearID", "svp_modelYearID"],
                               ["coh_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_stmyFraction", "v"] } } },
        { "lhs": "coh_engTechID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["coh_modelYearID", "svp_modelYearID"],
                               ["coh_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_engTechID", "v"] } } },
        { "lhs": "coh_regClassID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["coh_modelYearID", "svp_modelYearID"],
                               ["coh_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_regClassID", "v"] } } },
        { "lhs": "coh_modelYearGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "y": { "from": "pollutantprocessmodelyear_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppmy_polProcessID"],
                               ["coh_modelYearID", "ppmy_modelYearID"]] } ],
            "expr": { "op": "index", "args": ["ppmy_modelYearGroupID", "y"] } } },
        {
          "_comment": "C2's two inner joins as one semi-join: pollutantprocessmodelyear to modelyeargroup. A miss drops the candidate in the generator.",
          "lhs": "coh_modelYearGroupIsPresent",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "y": { "from": "pollutantprocessmodelyear_rows" },
                        "j": { "from": "modelyeargroup_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppmy_polProcessID"],
                               ["coh_modelYearID", "ppmy_modelYearID"]] },
                      { "on": [["ppmy_modelYearGroupID", "myg_modelYearGroupID"]] } ],
            "expr": 1.0 } },
        {
          "_comment": "C2's row rule, source_bin_distribution_generator.rs:1337-1341. `stmyFraction > 0` is strict, and it is the onroad analogue of NONROAD's modfrc <= 0 skip.",
          "lhs": "coh_isSelected",
          "rhs": { "op": "ifelse", "args": [
            { "op": "and", "args": [
              { "op": ">", "args": ["coh_stmyFraction", 0.0] },
              { "op": ">", "args": ["coh_modelYearGroupIsPresent", 0.0] }] },
            1.0, 0.0] } },
        { "lhs": "coh_sourceBinActivityFraction",
          "rhs": { "op": "*", "args": ["coh_isSelected", "coh_stmyFraction"] } },
        {
          "_comment": "C4's existence condition, as a semi-join on the bin's COMPONENTS rather than by pairing two sourcebin rows -- which would be a self-join (finding F11). engSizeID and weightClassID are left out of the key because sourceBinZeroSlotCount proves they are 0 on every bin.",
          "lhs": "coh_binExists",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["coh_fuelTypeID", "sb_fuelTypeID"],
                               ["coh_engTechID", "sb_engTechID"],
                               ["coh_regClassID", "sb_regClassID"],
                               ["coh_modelYearGroupID", "sb_modelYearGroupID"]] } ],
            "expr": 1.0 } },

        {
          "_comment": "The EQUIPPED copy of the cohort relation: finding F11's workaround, and its cost is that the whole relation is duplicated and not only its key column.",
          "lhs": "cohq_ordinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" } }, "expr": "e" } },
        { "lhs": "cohq_fuelOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" } },
            "expr": { "op": "+", "args": [
              { "op": "floor", "args": [{ "op": "/", "args": [
                { "op": "-", "args": ["e", 1] }, "n_agecategory"] }] }, 1] } } },
        { "lhs": "cohq_ageOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" } },
            "expr": { "op": "+", "args": [
              { "op": "-", "args": [
                { "op": "-", "args": ["e", 1] },
                { "op": "*", "args": ["n_agecategory",
                  { "op": "floor", "args": [{ "op": "/", "args": [
                    { "op": "-", "args": ["e", 1] }, "n_agecategory"] }] }] }] }, 1] } } },
        { "lhs": "cohq_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "u": { "from": "runspecsourcefueltype_rows" } },
            "join": [ { "on": [["cohq_fuelOrdinal", "rsft_ordinal"]] } ],
            "expr": { "op": "index", "args": ["rsft_fuelTypeID", "u"] } } },
        { "lhs": "cohq_modelYearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "g": { "from": "agecategory_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["cohq_ageOrdinal", "ac_ordinal"]] } ],
            "expr": { "op": "-", "args": [
              { "op": "index", "args": ["run_yearID", "n"] },
              { "op": "index", "args": ["ac_ageID", "g"] }] } } },
        { "lhs": "cohq_engTechID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["cohq_modelYearID", "svp_modelYearID"],
                               ["cohq_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_engTechID", "v"] } } },
        { "lhs": "cohq_regClassID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "v": { "from": "samplevehiclepopulation_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_sourceTypeID", "svp_sourceTypeID"],
                               ["cohq_modelYearID", "svp_modelYearID"],
                               ["cohq_fuelTypeID", "svp_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["svp_regClassID", "v"] } } },
        { "lhs": "cohq_modelYearGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "y": { "from": "pollutantprocessmodelyear_rows" },
                        "n": { "from": "run_rows" } },
            "join": [ { "on": [["run_polProcessID", "ppmy_polProcessID"],
                               ["cohq_modelYearID", "ppmy_modelYearID"]] } ],
            "expr": { "op": "index", "args": ["ppmy_modelYearGroupID", "y"] } } },
        { "lhs": "cohq_sourceBinActivityFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["e"],
            "ranges": { "e": { "from": "cohort_equipped_rows" }, "c": { "from": "cohort_rows" } },
            "join": [ { "on": [["cohq_ordinal", "coh_ordinal"]] } ],
            "expr": { "op": "index", "args": ["coh_sourceBinActivityFraction", "c"] } } },
        {
          "_comment": "C4, source_bin_distribution_generator.rs:1590-1637: the same activity re-attributed to the fuel each cohort actually BURNS. The equipped and used sides must agree on model year, engine technology, regulatory class and model-year group, and differ only in the fuel; the used bin must exist. Only the wildcard branch of the model-year-group condition is modelled, which fuelUsageWildcardCount licenses.",
          "lhs": "coh_usedFraction",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "e": { "from": "cohort_equipped_rows" },
                        "f": { "from": "fuelusagefraction_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["coh_modelYearID", "cohq_modelYearID"],
                               ["coh_engTechID", "cohq_engTechID"],
                               ["coh_regClassID", "cohq_regClassID"],
                               ["coh_modelYearGroupID", "cohq_modelYearGroupID"]] },
                      { "on": [["cohq_fuelTypeID", "fuf_sourceBinFuelTypeID"],
                               ["coh_fuelTypeID", "fuf_fuelSupplyFuelTypeID"]] },
                      { "on": [["fuf_countyID", "run_countyID"],
                               ["fuf_fuelYearID", "run_fuelYearID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["fuf_usageFraction", "f"] },
                { "op": "index", "args": ["cohq_sourceBinActivityFraction", "e"] }] },
              { "op": "index", "args": ["coh_binExists", "c"] }] } } }
,
        {
          "_comment": "K8, pre-attached: the bin's components brought onto the 6,564-row rate relation. Doing it here rather than inside L8 is what keeps L8 a two-relation contraction; the five-relation form did not finish in 120 s (finding F17).",
          "lhs": "era_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] } ],
            "expr": { "op": "index", "args": ["sb_fuelTypeID", "b"] } } },
        { "lhs": "era_engTechID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] } ],
            "expr": { "op": "index", "args": ["sb_engTechID", "b"] } } },
        { "lhs": "era_regClassID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] } ],
            "expr": { "op": "index", "args": ["sb_regClassID", "b"] } } },
        { "lhs": "era_modelYearGroupID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] } ],
            "expr": { "op": "index", "args": ["sb_modelYearGroupID", "b"] } } },
        {
          "_comment": "K9: the evaporative fuel flag, reached through the bin. bool_and_or of the INDICATOR, so a bin whose fuel carries N reads 0.",
          "lhs": "era_isEvapFuel",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "b": { "from": "sourcebin_rows" },
                        "u": { "from": "fueltype_rows" } },
            "join": [ { "on": [["era_sourceBinID", "sb_sourceBinID"]] },
                      { "on": [["sb_fuelTypeID", "ft_fuelTypeID"]] } ],
            "expr": { "op": "index", "args": ["ft_subjectToEvapCalculations", "u"] } } },
        { "lhs": "era_isRunPolProcess",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["a"],
            "ranges": { "a": { "from": "emissionratebyage_rows" }, "n": { "from": "run_rows" } },
            "join": [ { "on": [["era_polProcessID", "run_polProcessID"]] } ],
            "expr": 1.0 } },
        {
          "_comment": "L8, liquid_leaking_calculator.rs:694-806, as a TWO-relation contraction with the operating mode on its own axis (docs/esm-conventions.md 11.1). Two clauses: the bin-and-age key of five pairs -- K12's derived age reaching it through coh_ageGroupID -- and the operating mode. K9 and the pollutant-process filter are 0/1 factors, which is what an INNER JOIN is inside a sum.",
          "lhs": "cohortMode_rate",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c", "m"],
            "ranges": { "c": { "from": "cohort_rows" }, "m": { "from": "evap_op_mode_rows" },
                        "a": { "from": "emissionratebyage_rows" } },
            "join": [ { "on": [["coh_fuelTypeID", "era_fuelTypeID"],
                               ["coh_engTechID", "era_engTechID"],
                               ["coh_regClassID", "era_regClassID"],
                               ["coh_modelYearGroupID", "era_modelYearGroupID"],
                               ["coh_ageGroupID", "era_ageGroupID"]] },
                      { "on": [["mode_opModeID", "era_opModeID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["coh_usedFraction", "c"] },
                { "op": "index", "args": ["era_meanBaseRate", "a"] }] },
              { "op": "*", "args": [
                { "op": "index", "args": ["era_isEvapFuel", "a"] },
                { "op": "index", "args": ["era_isRunPolProcess", "a"] }] }] } } },
        { "lhs": "cohortMode_rateIM",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["c", "m"],
            "ranges": { "c": { "from": "cohort_rows" }, "m": { "from": "evap_op_mode_rows" },
                        "a": { "from": "emissionratebyage_rows" } },
            "join": [ { "on": [["coh_fuelTypeID", "era_fuelTypeID"],
                               ["coh_engTechID", "era_engTechID"],
                               ["coh_regClassID", "era_regClassID"],
                               ["coh_modelYearGroupID", "era_modelYearGroupID"],
                               ["coh_ageGroupID", "era_ageGroupID"]] },
                      { "on": [["mode_opModeID", "era_opModeID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "*", "args": [
                { "op": "index", "args": ["coh_usedFraction", "c"] },
                { "op": "index", "args": ["era_meanBaseRateIM", "a"] }] },
              { "op": "*", "args": [
                { "op": "index", "args": ["era_isEvapFuel", "a"] },
                { "op": "index", "args": ["era_isRunPolProcess", "a"] }] }] } } },
        {
          "_comment": "The second of the two mechanisms that take 125 surviving cohorts down to 64: does emissionratebyage carry a rate for this cohort's bin at all? Zero for every diesel and electricity bin.",
          "lhs": "coh_hasRate",
          "rhs": { "op": "aggregate", "args": [], "semiring": "bool_and_or", "output_idx": ["c"],
            "ranges": { "c": { "from": "cohort_rows" }, "a": { "from": "emissionratebyage_rows" } },
            "join": [ { "on": [["coh_fuelTypeID", "era_fuelTypeID"],
                               ["coh_engTechID", "era_engTechID"],
                               ["coh_regClassID", "era_regClassID"],
                               ["coh_modelYearGroupID", "era_modelYearGroupID"],
                               ["coh_ageGroupID", "era_ageGroupID"]] } ],
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["era_isEvapFuel", "a"] },
              { "op": "index", "args": ["era_isRunPolProcess", "a"] }] } } },
        { "lhs": "coh_survives",
          "rhs": { "op": "*", "args": ["coh_isSelected", "coh_hasRate"] } },
        {
          "_comment": "The count that makes n_outputCohort a CHECKED declaration: 64, computed from the chain.",
          "lhs": "cohortSurvivorCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "c": { "from": "cohort_rows" } },
            "expr": { "op": "index", "args": ["coh_survives", "c"] } } },

        { "lhs": "fuelUsageWildcardCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "f": { "from": "fuelusagefraction_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": ">", "args": [{ "op": "index", "args": ["fuf_modelYearGroupID", "f"] }, 0.0] },
              0.0, 1.0] } } },
        { "lhs": "sourceBinZeroSlotCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "b": { "from": "sourcebin_rows" } },
            "expr": { "op": "ifelse", "args": [
              { "op": "and", "args": [
                { "op": "<=", "args": [{ "op": "index", "args": ["sb_engSizeID", "b"] }, 0.0] },
                { "op": "<=", "args": [{ "op": "index", "args": ["sb_weightClassID", "b"] }, 0.0] }] },
              1.0, 0.0] } } },
        { "lhs": "evapFuelCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "u": { "from": "fueltype_rows" } },
            "expr": { "op": "index", "args": ["ft_subjectToEvapCalculations", "u"] } } },
        { "lhs": "imCoverageRowCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "i": { "from": "imcoverage_rows" } },
            "expr": 1.0 } },
        { "lhs": "modeAssociationCount",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["k"],
            "ranges": { "k": { "from": "run_rows" }, "m": { "from": "evap_op_mode_rows" } },
            "expr": { "op": "index", "args": ["mode_isAssociated", "m"] } } },

        {
          "_comment": "O1's row structure: day-major blocks of n_outputCohort surviving cohorts, decomposed from the aggregate's own loop symbol -- the mechanism fixtures/nr-logging-county.esm uses for its twelve rows.",
          "lhs": "outDayOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "+", "args": [
              { "op": "floor", "args": [{ "op": "/", "args": [
                { "op": "-", "args": ["o", 1] }, "n_outputCohort"] }] }, 1] } } },
        { "lhs": "outCohortOrdinal",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "+", "args": [
              { "op": "-", "args": [
                { "op": "-", "args": ["o", 1] },
                { "op": "*", "args": ["n_outputCohort",
                  { "op": "floor", "args": [{ "op": "/", "args": [
                    { "op": "-", "args": ["o", 1] }, "n_outputCohort"] }] }] }] }, 1] } } },
        {
          "_comment": "THE DECLARED STRUCTURE: the surviving cohorts are all of the first fuel's n_agecategory model years followed by the third fuel's leading block, so the map into the 164-row candidate relation skips the second fuel's n_agecategory rows. Checked by cohortSurvivorCount and by the comparator's exact key set; see docs/evap-leaks.md 7.5(2).",
          "lhs": "outCohortRow",
          "rhs": { "op": "ifelse", "args": [
            { "op": "<=", "args": ["outCohortOrdinal", "n_agecategory"] },
            "outCohortOrdinal",
            { "op": "+", "args": ["outCohortOrdinal", "n_agecategory"] }] } },
        { "lhs": "out_fuelTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "c": { "from": "cohort_rows" } },
            "join": [ { "on": [["outCohortRow", "coh_ordinal"]] } ],
            "expr": { "op": "index", "args": ["coh_fuelTypeID", "c"] } } },
        { "lhs": "out_modelYearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "c": { "from": "cohort_rows" } },
            "join": [ { "on": [["outCohortRow", "coh_ordinal"]] } ],
            "expr": { "op": "index", "args": ["coh_modelYearID", "c"] } } },
        { "lhs": "out_dayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["outDayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["rsd_dayID", "k"] } } },
        { "lhs": "outHourDayID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["outDayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "index", "args": ["day_hourDayID", "k"] } } },
        {
          "_comment": "K15's derived key: the same runYear - modelYearID the rate stage used through the age group.",
          "lhs": "outAgeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "-", "args": [
              { "op": "index", "args": ["run_yearID", "n"] },
              { "op": "index", "args": ["out_modelYearID", "o"] }] } } },
        { "lhs": "outSourceHours",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "r": { "from": "activity_rows" } },
            "join": [ { "on": [["outHourDayID", "act_hourDayID"], ["outAgeID", "act_ageID"]] } ],
            "expr": { "op": "index", "args": ["act_sourceHours", "r"] } } },
        { "lhs": "outNoOfRealDays",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "w": { "from": "dayofanyweek_rows" } },
            "join": [ { "on": [["out_dayID", "dow_dayID"]] } ],
            "expr": { "op": "index", "args": ["dow_noOfRealDays", "w"] } } },
        {
          "_comment": "L1 and K21. imcoverage is EMPTY, so this sum over a zero-length axis is 0 whatever the factor -- which is why imCoverageRowCount pins the row count rather than this pinning a value. L1's full formula also needs `imfactor`, likewise empty and not declared: with no covering row there is nothing to multiply.",
          "lhs": "outImAdjustFract",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "i": { "from": "imcoverage_rows" } },
            "expr": { "op": "*", "args": [
              { "op": "index", "args": ["im_complianceFactor", "i"] }, 0.01] } } },
        {
          "_comment": "L9 and O1 in one contraction: the operating modes are summed, so the two soak modes contribute exactly zero rather than being left out. The grouping inside is the reference's, ((rate x hours) x fraction) / days.",
          "lhs": "outEmissionQuantBase",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "c": { "from": "cohort_rows" },
                        "m": { "from": "evap_op_mode_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["outCohortRow", "coh_ordinal"]] },
                      { "on": [["outDayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "/", "args": [
              { "op": "*", "args": [
                { "op": "*", "args": [
                  { "op": "index", "args": ["cohortMode_rate", "c", "m"] },
                  { "op": "index", "args": ["outSourceHours", "o"] }] },
                { "op": "index", "args": ["omd_opModeFraction", "k", "m"] }] },
              { "op": "index", "args": ["outNoOfRealDays", "o"] }] } } },
        { "lhs": "outEmissionQuantIM",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "c": { "from": "cohort_rows" },
                        "m": { "from": "evap_op_mode_rows" }, "k": { "from": "runspecday_rows" } },
            "join": [ { "on": [["outCohortRow", "coh_ordinal"]] },
                      { "on": [["outDayOrdinal", "day_ordinal"]] } ],
            "expr": { "op": "/", "args": [
              { "op": "*", "args": [
                { "op": "*", "args": [
                  { "op": "index", "args": ["cohortMode_rateIM", "c", "m"] },
                  { "op": "index", "args": ["outSourceHours", "o"] }] },
                { "op": "index", "args": ["omd_opModeFraction", "k", "m"] }] },
              { "op": "index", "args": ["outNoOfRealDays", "o"] }] } } },
        {
          "_comment": "L9's trailing UPDATE, by lib/adjustments.esm's im_blend. Applied after O1's sum rather than before, which is exact: the blend is affine in the two quantities at a fixed fraction, and the fraction is keyed on (process, pollutant, model year, fuel type, source type) -- none of which is the operating mode.",
          "lhs": "out_emissionQuant",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "im_blend",
            "bindings": { "rate_im": "outEmissionQuantIM", "fraction_im": "outImAdjustFract",
                          "rate_base": "outEmissionQuantBase" } } },

        { "lhs": "out_yearID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_yearID", "n"] } } },
        { "lhs": "out_monthID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_monthID", "n"] } } },
        { "lhs": "out_hourID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_hourID", "n"] } } },
        { "lhs": "out_stateID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_stateID", "n"] } } },
        { "lhs": "out_countyID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_countyID", "n"] } } },
        { "lhs": "out_sourceTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_sourceTypeID", "n"] } } },
        { "lhs": "out_roadTypeID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_linkRoadTypeID", "n"] } } },
        { "lhs": "out_pollutantID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_pollutantID", "n"] } } },
        { "lhs": "out_processID",
          "rhs": { "op": "aggregate", "args": [], "semiring": "sum_product", "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" }, "n": { "from": "run_rows" } },
            "expr": { "op": "index", "args": ["run_processID", "n"] } } },
        {
          "_comment": "O2, engine.rs:1450-1477. Computed from four columns of the row itself; the `scc` table's 14,976 rows are read by nothing.",
          "lhs": "out_SCC",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "onroad_scc",
            "bindings": { "fuel_type_id": "out_fuelTypeID", "source_type_id": "out_sourceTypeID",
                          "road_type_id": "out_roadTypeID", "process_id": "out_processID" } } },
        {
          "_comment": "O3: the seven identity columns MOVESOutput leaves NULL on this run, emitted as NaN through one template so the claim is made in one place.",
          "lhs": "out_zoneID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_linkID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_regClassID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_fuelSubTypeID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_engTechID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_sectorID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        { "lhs": "out_hpID",
          "rhs": { "op": "aggregate", "args": [], "output_idx": ["o"],
            "ranges": { "o": { "from": "output_rows" } },
            "expr": { "op": "apply_expression_template", "args": [], "name": "null_output_column", "bindings": {} } } },
        {
          "_comment": "O3's testable half, and its negative control. `Assertion.expected` is a JSON number so a NaN cannot be pinned directly; `1 - [x>0] - [x<=0]` separates absent from present using only ops the format has (docs/esm-conventions.md 18.2).",
          "lhs": "absentRegClassIndicator",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "output_column_is_absent",
            "bindings": { "column": "out_regClassID" } } },
        { "lhs": "presentQuantIndicator",
          "rhs": { "op": "apply_expression_template", "args": [], "name": "output_column_is_absent",
            "bindings": { "column": "out_emissionQuant" } } }
      ],

      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "The scope every join in this document is filtered by, read from the `runspec*` tables and the link. Month 8, hour 7, source type 21, road type 4, county 26161, zone 261610, link road type 4, and polProcessID 113 built from the two enums. What breaks if this is wrong: the RunSpec XML says `<month key=\"7\">` and `<beginhour key=\"6\">`, which are 0-based INDICES into sorted ID lists and not identifiers (moves.rs, xml_format.rs:600-626), and `<day key=\"5\">` is out of range for the sorted DayOfAnyWeek list and falls back to both day types (default_db_setup.rs:2504-2540). All 27 onroad fixtures show the same three offsets. A document scoped from the XML emits 128 rows with the wrong month and hour in every one -- which the exact-key-set gate rejects wholesale, the good failure -- or, worse, reads the XML for one dimension only and quietly emits 64 rows. docs/evap-leaks.md 0.1.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "run_yearID", "time": 0.0, "expected": 2020.0, "coords": { "run_rows": 1 } },
            { "variable": "run_monthID", "time": 0.0, "expected": 8.0, "coords": { "run_rows": 1 } },
            { "variable": "run_hourID", "time": 0.0, "expected": 7.0, "coords": { "run_rows": 1 } },
            { "variable": "run_sourceTypeID", "time": 0.0, "expected": 21.0, "coords": { "run_rows": 1 } },
            { "variable": "run_roadTypeID", "time": 0.0, "expected": 4.0, "coords": { "run_rows": 1 } },
            { "variable": "run_countyID", "time": 0.0, "expected": 26161.0, "coords": { "run_rows": 1 } },
            { "variable": "run_zoneID", "time": 0.0, "expected": 261610.0, "coords": { "run_rows": 1 } },
            { "variable": "run_stateID", "time": 0.0, "expected": 26.0, "coords": { "run_rows": 1 } },
            { "variable": "run_polProcessID", "time": 0.0, "expected": 113.0, "coords": { "run_rows": 1 } },
            { "variable": "run_pollutantID", "time": 0.0, "expected": 1.0, "coords": { "run_rows": 1 } },
            { "variable": "run_processID", "time": 0.0, "expected": 13.0, "coords": { "run_rows": 1 } }
          ]
        },
        {
          "id": "the_link_is_on_network_which_is_what_this_slice_rests_on",
          "description": "A10, allocation.rs:631-682: an on-network link takes SourceHours = SHO and the off-network one takes SHP. The link's road type is 4, so the indicator is 1 and the two activity relations are the same numbers row for row -- which makes E1's ratio EXACTLY 1 and the F12-blocked soak fractions enter at a computed zero. What breaks if this is wrong: on an off-network link the denominator would be `population x noOfRealDays - SHO`, 6,902,112.67 h against 594.23 h at hourDayID 72, so `fractionOfOperating` would be 8.6e-05 and every soak weight would come alive -- and this document does not compute SHP, so it emits not-a-number there rather than reusing SHO. docs/evap-leaks.md 0.3.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "run_linkRoadTypeID", "time": 0.0, "expected": 4.0, "coords": { "run_rows": 1 } },
            { "variable": "run_isOnNetworkLink", "time": 0.0, "expected": 1.0, "coords": { "run_rows": 1 } },
            { "variable": "run_baseYearIsAnalysisYear", "time": 0.0, "expected": 1.0, "coords": { "run_rows": 1 } }
          ]
        },
        {
          "id": "the_derived_axes_are_measured_and_the_declared_one_is_checked",
          "description": "The activity relation is n_agecategory x n_runspecday = 82 rows and the cohort relation n_agecategory x n_runspecsourcefueltype = 164, both from extents the runtime discovers; the ordinals below prove the block structure those sizes imply. The ONE declared number, `n_outputCohort` = 64, is checked here against `cohortSurvivorCount`, which counts the cohorts the chain itself keeps: C2's `stmyFraction > 0` and the presence of any rate row for the cohort's bin. What breaks if this is wrong: a chain that produced 63 or 65 survivors would emit 128 rows against a 126- or 130-row truth and the comparator would report it as missing and extra keys with no attribution. Asserting the count here makes the declaration a checked one, which is the difference between declaring a shape and transcribing an answer (docs/evap-leaks.md 7.5).",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "act_dayOrdinal", "time": 0.0, "expected": 1.0, "coords": { "activity_rows": 41 } },
            { "variable": "act_dayOrdinal", "time": 0.0, "expected": 2.0, "coords": { "activity_rows": 42 } },
            { "variable": "act_ageOrdinal", "time": 0.0, "expected": 41.0, "coords": { "activity_rows": 41 } },
            { "variable": "coh_fuelOrdinal", "time": 0.0, "expected": 3.0, "coords": { "cohort_rows": 101 } },
            { "variable": "coh_ageOrdinal", "time": 0.0, "expected": 19.0, "coords": { "cohort_rows": 101 } },
            { "variable": "cohortSurvivorCount", "time": 0.0, "expected": 64.0, "coords": { "run_rows": 1 } },
            { "variable": "outCohortRow", "time": 0.0, "expected": 41.0, "coords": { "output_rows": 41 } },
            { "variable": "outCohortRow", "time": 0.0, "expected": 101.0, "coords": { "output_rows": 60 } }
          ]
        },
        {
          "id": "the_activity_chain_reproduces_the_reference",
          "description": "A1 through A10 at the three ages docs/evap-leaks.md 6.0 tabulates, in both day types. The snapshot's own `sho` table -- which this document does not read -- stores 27.33, 2.43728, 260.057 and 23.1918 against the values pinned here; the differences are 6.7e-08 to 1.2e-06, which is that column's six-significant-figure storage (7.1). What breaks if this is wrong: every factor of A5 through A9 is in these four numbers. A6 as the harmonic mean instead of the arithmetic one is 24% and 58% low and A8 divides by it; omitting A7's weeksPerMonth divisor is 4.43x; normalising A3 over the run's source type instead of its HPMS group is 2.55x. The independent reproduction in 6.5 reaches the same four values to the last bit, from the same tables by a different route.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "run_travelGroupTotal", "time": 0.0, "expected": 182397687.37007642, "coords": { "run_rows": 1 } },
            { "variable": "act_averageSpeed", "time": 0.0, "expected": 67.0416879, "coords": { "activity_rows": 1 } },
            { "variable": "act_averageSpeed", "time": 0.0, "expected": 56.361205525, "coords": { "activity_rows": 42 } },
            { "variable": "act_sourceHours", "time": 0.0, "expected": 27.330001837636907, "coords": { "activity_rows": 1 } },
            { "variable": "act_sourceHours", "time": 0.0, "expected": 2.437278712884465, "coords": { "activity_rows": 41 } },
            { "variable": "act_sourceHours", "time": 0.0, "expected": 260.0573038920831, "coords": { "activity_rows": 42 } },
            { "variable": "act_sourceHours", "time": 0.0, "expected": 23.191807108971084, "coords": { "activity_rows": 82 } }
          ]
        },
        {
          "id": "the_operating_share_is_one_and_the_operating_mode_takes_it_all",
          "description": "E1, E2 and E3. `fractionOfOperating` is 1 on both day types -- exactly, because A10 makes the numerator and the denominator the same 41 numbers -- so the soak modes take `soakActivityFraction x (1 - 1)` and operating mode 300 takes the residual 1. The snapshot's `fractionofoperating` and `opmodedistributiontemp` tables agree, and this document reads neither. What breaks if this is wrong: the two soak fractions this fixture ingests are 0.00668717 and 0.993313 at hourDayID 72, so a document that took them at face value -- by writing the soak share as `soakActivityFraction` rather than `soakActivityFraction x (1 - fractionOfOperating)` -- would put 99.3% of the activity on a cold-soak rate of 0.235 g/h instead of the operating rate of 4.235, and the 1980 gasoline weekend cell would read 0.30 g instead of 4.92 g. The zero is COMPUTED here, which is why the soak fractions can be ingested at all without the F12-blocked recurrence behind them mattering.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "day_fractionOfOperating", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 1 } },
            { "variable": "day_fractionOfOperating", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 2 } },
            { "variable": "omd_soakActivityFraction", "time": 0.0, "expected": 0.00668717, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 1 } },
            { "variable": "omd_soakActivityFraction", "time": 0.0, "expected": 0.993313, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 2 } },
            { "variable": "omd_hasSoakRow", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 2 } },
            { "variable": "omd_opModeFraction", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 1, "evap_op_mode_rows": 3 } },
            { "variable": "omd_opModeFraction", "time": 0.0, "expected": 1.0, "coords": { "runspecday_rows": 2, "evap_op_mode_rows": 3 } },
            { "variable": "modeAssociationCount", "time": 0.0, "expected": 3.0, "coords": { "run_rows": 1 } }
          ]
        },
        {
          "id": "the_fuel_usage_rebase_moves_the_e85_cohort_by_a_factor_of_56",
          "description": "C3 against C4 on model year 2002, docs/evap-leaks.md 6.3. The raw stmyFractions are 0.985305968751 gasoline and 0.007914838927 E85; after the rebase, gasoline holds 0.9930794011657301 and E85 0.000141406512269782, because 0.982134 of E85-equipped activity is attributed to the gasoline it actually burns. What breaks if this is wrong: the two bins carry the SAME rate at this age group, 1.363 g/h, so the sum over the two fuels is invariant and only the split is wrong -- by a factor of 56 on the E85 cell. Measured end to end, using C3's raw fraction leaves the fixture's total THC unchanged to THIRTEEN significant figures (7.3). This assertion and the comparator's per-cell gate are the only things in the port that can see it.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "coh_stmyFraction", "time": 0.0, "expected": 0.985305968751, "coords": { "cohort_rows": 19 } },
            { "variable": "coh_usedFraction", "time": 0.0, "expected": 0.9930794011657301, "coords": { "cohort_rows": 19 } },
            { "variable": "coh_stmyFraction", "time": 0.0, "expected": 0.007914838927, "coords": { "cohort_rows": 101 } },
            { "variable": "coh_usedFraction", "time": 0.0, "expected": 0.000141406512269782, "coords": { "cohort_rows": 101 } },
            { "variable": "fuelUsageWildcardCount", "time": 0.0, "expected": 5.0, "coords": { "run_rows": 1 } },
            { "variable": "sourceBinZeroSlotCount", "time": 0.0, "expected": 80.0, "coords": { "run_rows": 1 } },
            { "variable": "evapFuelCount", "time": 0.0, "expected": 2.0, "coords": { "run_rows": 1 } }
          ]
        },
        {
          "id": "the_age_group_join_selects_one_rate_of_seven",
          "description": "L8 at operating mode 300 for the four cohorts docs/evap-leaks.md 6 works through. `emissionratebyage` carries seven age-group rates per (bin, mode) -- for the 2020 gasoline bin they are 0.1304 four times, then 0.3626, 1.1174 and 3.4536 -- and K12 picks the one whose group contains `runYear - modelYearID`. What breaks if this is wrong: dropping the age-group pair from the key sums all seven, 5.4552 instead of 0.1304, which is 41.83x on this cohort and 9.44x on the fixture total (7.2, measured by ablating the oracle). It is the largest single-factor error in the slice -- larger than the activity stage's 4.43x -- and every one of the seven candidates is a plausible emission rate.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "coh_ageGroupID", "time": 0.0, "expected": 3.0, "coords": { "cohort_rows": 1 } },
            { "variable": "coh_ageGroupID", "time": 0.0, "expected": 2099.0, "coords": { "cohort_rows": 41 } },
            { "variable": "cohortMode_rate", "time": 0.0, "expected": 0.12496777343169573, "coords": { "cohort_rows": 1, "evap_op_mode_rows": 3 } },
            { "variable": "cohortMode_rate", "time": 0.0, "expected": 1.35356722378889, "coords": { "cohort_rows": 19, "evap_op_mode_rows": 3 } },
            { "variable": "cohortMode_rate", "time": 0.0, "expected": 4.037349528467256, "coords": { "cohort_rows": 41, "evap_op_mode_rows": 3 } },
            { "variable": "cohortMode_rate", "time": 0.0, "expected": 0.00019273707622371287, "coords": { "cohort_rows": 101, "evap_op_mode_rows": 3 } }
          ]
        },
        {
          "id": "the_worked_examples_reach_movesoutput",
          "description": "L9 and O1 at the eight cells docs/evap-leaks.md 6.1 to 6.3 derive by hand, in both day types. The snapshot stores 1.70768, 8.43008, 4.92007, 0.00120038, 6.49975, 32.0866, 18.7267 and 0.00456889 against the values pinned here; the worst difference is 3.7e-06, which is the reference's six-significant-figure storage of its own intermediates and not accumulated error (7.1 attributes each residual to a specific stored column). What breaks if this is wrong: every factor of the whole chain is in these numbers. The independent reproduction in 6.5 reaches the same eight values to the last bit from the same tables by a different route, which is what makes a disagreement here attributable to the document rather than to the specification.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 1.7076847387668184, "coords": { "output_rows": 1 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 8.430099705651031, "coords": { "output_rows": 19 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 4.920073031103687, "coords": { "output_rows": 41 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 0.0012003783343641115, "coords": { "output_rows": 60 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 6.499756446408696, "coords": { "output_rows": 65 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 32.08648157460363, "coords": { "output_rows": 83 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 18.72668629914159, "coords": { "output_rows": 105 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 0.004568856674649851, "coords": { "output_rows": 124 } }
          ]
        },
        {
          "id": "the_output_row_carries_its_keys_and_leaves_the_absent_ones_absent",
          "description": "O1, O2 and O3 on the same eight rows' keys. The day type, fuel type and model year come from joins to the day and cohort relations on their ordinals, not from a literal; the SCC is computed as 22e8 + fuel x 1e6 + sourceType x 1e4 + roadType x 1e2 + process, giving 2201210413 for gasoline and 2205210413 for E85; and `regClassID` is absent, which the indicator reads as 1 while the same template on the present `emissionQuant` reads 0. What breaks if this is wrong: the SCC is COMPUTED and the `scc` table's 14,976 rows are read by nothing, so a hard-coded value would be right for the 82 gasoline rows and wrong for the 46 E85 ones -- and the comparator treats SCC as an identity column, so those 46 come back as 46 missing plus 46 extra keys rather than as a wrong number. Emitting 0 for `regClassID` would claim regulatory class zero; the absence cannot be pinned directly because `Assertion.expected` is a JSON number and a NaN actual fails every tolerance form, so the indicator is the assertion (docs/esm-conventions.md 18.2).",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "out_dayID", "time": 0.0, "expected": 2.0, "coords": { "output_rows": 41 } },
            { "variable": "out_dayID", "time": 0.0, "expected": 5.0, "coords": { "output_rows": 105 } },
            { "variable": "out_fuelTypeID", "time": 0.0, "expected": 1.0, "coords": { "output_rows": 41 } },
            { "variable": "out_fuelTypeID", "time": 0.0, "expected": 5.0, "coords": { "output_rows": 60 } },
            { "variable": "out_modelYearID", "time": 0.0, "expected": 1980.0, "coords": { "output_rows": 41 } },
            { "variable": "out_modelYearID", "time": 0.0, "expected": 2002.0, "coords": { "output_rows": 60 } },
            { "variable": "out_modelYearID", "time": 0.0, "expected": 2020.0, "coords": { "output_rows": 65 } },
            { "variable": "out_SCC", "time": 0.0, "expected": 2201210413.0, "coords": { "output_rows": 41 } },
            { "variable": "out_SCC", "time": 0.0, "expected": 2205210413.0, "coords": { "output_rows": 60 } },
            { "variable": "out_roadTypeID", "time": 0.0, "expected": 4.0, "coords": { "output_rows": 41 } },
            { "variable": "absentRegClassIndicator", "time": 0.0, "expected": 1.0, "coords": { "output_rows": 41 } },
            { "variable": "presentQuantIndicator", "time": 0.0, "expected": 0.0, "coords": { "output_rows": 41 } }
          ]
        },
        {
          "id": "the_im_blend_is_the_identity_because_the_program_table_is_empty",
          "description": "L1 and L9's trailing UPDATE. `imcoverage` has zero rows, so its discovered axis is zero-length, the aggregate over it reads the additive identity, and `im_blend` returns the unblended quantity -- which is the SQL's `a row with no matching cell keeps its value unchanged`, as a measured 0 rather than an assumption. What breaks if this is wrong: `pollutantprocessassoc` marks polProcessID 113 `isAffectedByEvapIM = 'Y'`, so this is an absent PROGRAM and not a structural exclusion, and a county with an evap I/M program would blend. The blend's argument order is unobservable at a zero fraction -- measured on the component, swapping the two rate arguments sends every non-probe row to exactly 0 rather than perturbing it -- so components/liquid_leaking_emissions.esm carries the probe row that pins the order, and this test pins only that the fraction really is zero and that the row count it comes from really is zero.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [
            { "variable": "imCoverageRowCount", "time": 0.0, "expected": 0.0, "coords": { "run_rows": 1 } },
            { "variable": "outEmissionQuantBase", "time": 0.0, "expected": 4.920073031103687, "coords": { "output_rows": 41 } },
            { "variable": "out_emissionQuant", "time": 0.0, "expected": 4.920073031103687, "coords": { "output_rows": 41 } }
          ]
        }
      ]
    }
  }
}
