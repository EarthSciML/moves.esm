              "variable": "Onroad.rt_shortModYrGroupID",
              "time": 0.0,
              "expected": 80.0,
              "coords": {
                "rate_rows": 41
              }
            },
            {
              "variable": "Onroad.rt_shortModYrGroupID",
              "time": 0.0,
