  "models": {
    "Fixture": {
      "subsystems": {
        "Onroad": {
          "ref": "../onroad/model.esm"
        }
      },
      "variables": {},
      "equations": [],
      "tests": [
        {
          "id": "the_run_scope_comes_from_the_execution_database",
          "description": "Year 2020, August, hour 7, source type 21, road type 4, county 26161, zone 261610. The RunSpec XML says month 7 and hour 6; the execution database says 8 and 7, and it is the authority (docs/mixed-onroad.md 0.1). 59.5 degF is the hour's temperature and its heat index -- the two columns are equal in every row of this snapshot and the document still reads them separately, because adjust.rs uses the first for the temperature adjustment and the second for the A/C term and the EV suppression. Source type 21 is pinned through its HPMS type, 25: the ingested `rst_sourceTypeID` is a data-fed parameter and not assertable (finding F43).",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "Onroad.run_yearID",
              "time": 0.0,
              "expected": 2020.0,
              "coords": {
                "runspecyear_rows": 1
              }
            },
            {
              "variable": "Onroad.run_monthID",
