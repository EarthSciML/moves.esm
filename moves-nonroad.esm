  },
  "metaparameters": {
    "n_equipmentPoint": {
      "type": "integer",
      "default": 6,
      "description": "THE FIRST DECLARED NUMBER IN THIS DOCUMENT: how many equipment points -- `nrsourceusetype` rows whose SCC the RunSpec selects and whose county population is positive -- the run has. It sizes the point axis and, times NONROAD's 51 age slots, the cohort grid. No table states it, so it is declared and CHECKED both ways: `run_equipmentPointsSelected` recomputes it and `run_equipmentPointsDropped` counts the points a short axis would lose. 6 is `nr-logging-county`'s value."
    },
    "n_outputCohort": {
      "type": "integer",
      "default": 36,
      "description": "THE SECOND DECLARED NUMBER: how many (SCC, model year) cohorts reach MOVESOutput. The output relation is that times the run's pollutant-processes -- a RECTANGLE, which every nonroad run here is, because each SCC's rate and deterioration rows cover every selected pollutant. `run_outputCohortCount` recomputes it. 36 is `nr-logging-county`'s value: 3, 29 and 4 model years for its three SCCs."
    },
    "n_outputPolProcess": {
      "type": "integer",
      "default": 4,
      "description": "THE THIRD DECLARED NUMBER: how many of the run's selected pollutant-processes NONROAD emits -- the ones whose pollutant has an output slot this model computes (`emitted_pp_rows`). `nr-pleasure-craft-state` selects seven and emits four. `run_outputPolProcessCount` recomputes it. 4 is `nr-logging-county`'s value."
    }
  },
  "models": {
    "Nonroad": {
      "ref": "./nonroad/model.esm",
      "bindings": {
        "n_equipmentPoint": "n_equipmentPoint",
        "n_outputCohort": "n_outputCohort",
        "n_outputPolProcess": "n_outputPolProcess"
      }
    }
  }
}
