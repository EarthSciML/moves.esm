      },
      "extent": {
        "metaparameter": "n_zonemonthhour"
      },
      "metadata": {
        "tags": [
          "meteorology"
        ],
        "note": "ZoneMonthHour, the national table: 930,816 rows, copied whole. Read for the daytime mean temperature, hours 6 to 18 of the run's month in the county's zone.",
        "esio_format": "parquet"
      }
    },
    "db_nrsourceusetype": {
      "kind": "static",
      "source": {
        "url_template": "./movesdb/nrSourceUseType.parquet"
