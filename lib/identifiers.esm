{
  "esm": "1.0.0",
  "metadata": {
    "name": "moves.identifiers",
    "description": "Template library: the arithmetic that MOVES/NONROAD performs ON its identifiers, as opposed to the identifiers themselves. `polProcessID` is a packed pair, and every SCC fallback ladder is a decimal truncation, so both are arithmetic — not lookup tables, and not values to be written out by hand at each of the two dozen sites that need them. The symbolic NAMES for identifier values live in each consuming component's `enums` block, because esm-spec §9.3 makes an `enums` block file-local and does NOT merge it across an `expression_template_imports` edge (see docs/esm-conventions.md §6, finding F3): a library that spelled `enum(\"pollutant\", \"NOx\")` in a body would fail to load in the importer with `unknown_enum`. Templates therefore take identifier VALUES as parameters, and the call site supplies them as `enum` ops.",
    "authors": ["EarthSciML Authors and Contributors"],
    "tags": ["moves", "nonroad", "identifiers", "template-library"]
  },
  "expression_templates": {
    "pol_process_id": {
      "params": ["pollutant_id", "process_id"],
      "body": {
        "op": "+",
        "args": [
          { "op": "*", "args": [100, "pollutant_id"] },
          "process_id"
        ]
      }
    },
    "scc_zero_tail": {
      "params": ["scc", "tail_scale"],
      "body": {
        "op": "*",
        "args": [
          { "op": "floor", "args": [{ "op": "/", "args": ["scc", "tail_scale"] }] },
          "tail_scale"
        ]
      }
    }
  }
}
