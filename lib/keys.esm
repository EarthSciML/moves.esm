{
  "esm": "1.0.0",
  "metadata": {
    "name": "moves.keys",
    "description": "Template library: the two RELATIONAL shapes of docs/nonroad-logging-county.md \u00a74.5 and \u00a74.6, reduced to the arithmetic half that a template can carry. Both are most-specific-match lookups, and neither is an equi-join by itself. The convention (docs/esm-conventions.md \u00a73) is to precompute an EFFECTIVE KEY column with these templates and then join on it with a plain `join.on`, so the run-time relational step stays a single equi-join and the precedence logic stays in one place. `presence` arguments are booleans a caller computes with a `max`-semiring aggregate over the target relation. Layered on moves.identifiers: both ladder templates invoke `scc_zero_tail` by reference (esm-spec \u00a79.7.3 registration-time body checking), so the truncation arithmetic exists once in the repository. Three later templates are not lookups at all: `flat_relation_major` / `flat_relation_minor` decode a FLAT row relation whose key is a product of two axes -- position `p` of a relation laid out in blocks of `block_size` is member `major` of the outer axis and `minor` of the inner one. That layout is finding F14's workaround made concrete: the port's output key sets are ragged, a `ragged` index set does not evaluate (F14), and a rectangular axis emits keys the snapshot does not have, so every such product is carried as a flat relation with the two coordinates as ordinary key COLUMNS. Both delegate the one floor division to `flat_relation_block_index`, so `minor` is defined as `position - block_size x major` in the only place `major` is computed and the two can never disagree about a boundary.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "moves",
      "nonroad",
      "joins",
      "template-library"
    ]
  },
  "expression_template_imports": [
    {
      "ref": "./identifiers.esm",
      "only": [
        "scc_zero_tail"
      ]
    }
  ],
  "expression_templates": {
    "scc_equipment_chain_key": {
      "params": [
        "scc",
        "has_exact",
        "has_zero3"
      ],
      "body": {
        "op": "ifelse",
        "args": [
          "has_exact",
          "scc",
          {
            "op": "ifelse",
            "args": [
              "has_zero3",
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "scc_zero_tail",
                "bindings": {
                  "scc": "scc",
                  "tail_scale": 1000
                }
              },
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "scc_zero_tail",
                "bindings": {
                  "scc": "scc",
                  "tail_scale": 1000000
                }
              }
            ]
          }
        ]
      }
    },
    "scc_lookup_ladder_key": {
      "params": [
        "scc",
        "has_exact",
        "has_zero2",
        "has_zero4"
      ],
      "body": {
        "op": "ifelse",
        "args": [
          "has_exact",
          "scc",
          {
            "op": "ifelse",
            "args": [
              "has_zero2",
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "scc_zero_tail",
                "bindings": {
                  "scc": "scc",
                  "tail_scale": 100
                }
              },
              {
                "op": "ifelse",
                "args": [
                  "has_zero4",
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "scc_zero_tail",
                    "bindings": {
                      "scc": "scc",
                      "tail_scale": 10000
                    }
                  },
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "scc_zero_tail",
                    "bindings": {
                      "scc": "scc",
                      "tail_scale": 1000000
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "latest_at_or_before_key": {
      "params": [
        "has_at_or_before",
        "latest_at_or_before",
        "earliest_after"
      ],
      "body": {
        "op": "ifelse",
        "args": [
          "has_at_or_before",
          "latest_at_or_before",
          "earliest_after"
        ]
      }
    },
    "state_default_precedence": {
      "params": [
        "has_state_row",
        "state_id",
        "default_state_id"
      ],
      "body": {
        "op": "ifelse",
        "args": [
          "has_state_row",
          "state_id",
          "default_state_id"
        ]
      }
    },
    "flat_relation_major": {
      "params": [
        "position",
        "block_size"
      ],
      "body": {
        "op": "+",
        "args": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "flat_relation_block_index",
            "bindings": {
              "position": "position",
              "block_size": "block_size"
            }
          },
          1
        ]
      }
    },
    "flat_relation_minor": {
      "params": [
        "position",
        "block_size"
      ],
      "body": {
        "op": "+",
        "args": [
          {
            "op": "-",
            "args": [
              {
                "op": "-",
                "args": [
                  "position",
                  1
                ]
              },
              {
                "op": "*",
                "args": [
                  "block_size",
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "flat_relation_block_index",
                    "bindings": {
                      "position": "position",
                      "block_size": "block_size"
                    }
                  }
                ]
              }
            ]
          },
          1
        ]
      }
    },
    "flat_relation_block_index": {
      "params": [
        "position",
        "block_size"
      ],
      "body": {
        "op": "floor",
        "args": [
          {
            "op": "/",
            "args": [
              {
                "op": "-",
                "args": [
                  "position",
                  1
                ]
              },
              "block_size"
            ]
          }
        ]
      }
    }
  }
}