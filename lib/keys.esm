{
  "esm": "1.0.0",
  "metadata": {
    "name": "moves.keys",
    "description": "Template library: the two RELATIONAL shapes of docs/nonroad-logging-county.md §4.5 and §4.6, reduced to the arithmetic half that a template can carry. Both are most-specific-match lookups, and neither is an equi-join by itself. The convention (docs/esm-conventions.md §3) is to precompute an EFFECTIVE KEY column with these templates and then join on it with a plain `join.on`, so the run-time relational step stays a single equi-join and the precedence logic stays in one place. `presence` arguments are booleans a caller computes with a `max`-semiring aggregate over the target relation. Layered on moves.identifiers: both ladder templates invoke `scc_zero_tail` by reference (esm-spec §9.7.3 registration-time body checking), so the truncation arithmetic exists once in the repository.",
    "authors": ["EarthSciML Authors and Contributors"],
    "tags": ["moves", "nonroad", "joins", "template-library"]
  },
  "expression_template_imports": [
    { "ref": "./identifiers.esm", "only": ["scc_zero_tail"] }
  ],
  "expression_templates": {
    "scc_equipment_chain_key": {
      "params": ["scc", "has_exact", "has_zero3"],
      "body": {
        "op": "ifelse",
        "args": [
          "has_exact",
          "scc",
          {
            "op": "ifelse",
            "args": [
              "has_zero3",
              { "op": "apply_expression_template", "args": [], "name": "scc_zero_tail",
                "bindings": { "scc": "scc", "tail_scale": 1000 } },
              { "op": "apply_expression_template", "args": [], "name": "scc_zero_tail",
                "bindings": { "scc": "scc", "tail_scale": 1000000 } }
            ]
          }
        ]
      }
    },
    "scc_lookup_ladder_key": {
      "params": ["scc", "has_exact", "has_zero2", "has_zero4"],
      "body": {
        "op": "ifelse",
        "args": [
          "has_exact",
          "scc",
          {
            "op": "ifelse",
            "args": [
              "has_zero2",
              { "op": "apply_expression_template", "args": [], "name": "scc_zero_tail",
                "bindings": { "scc": "scc", "tail_scale": 100 } },
              {
                "op": "ifelse",
                "args": [
                  "has_zero4",
                  { "op": "apply_expression_template", "args": [], "name": "scc_zero_tail",
                    "bindings": { "scc": "scc", "tail_scale": 10000 } },
                  { "op": "apply_expression_template", "args": [], "name": "scc_zero_tail",
                    "bindings": { "scc": "scc", "tail_scale": 1000000 } }
                ]
              }
            ]
          }
        ]
      }
    },
    "state_default_precedence": {
      "params": ["has_state_row", "state_id", "default_state_id"],
      "body": { "op": "ifelse", "args": ["has_state_row", "state_id", "default_state_id"] }
    }
  }
}
