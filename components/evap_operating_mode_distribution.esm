          }
        },
        {
          "lhs": "omd_opModeID",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              150,
              151,
              300,
              150,
              151,
              300,
              150,
              151,
              300,
              150,
              151,
              300
            ]
          }
        },
        {
          "lhs": "omd_hasSoakRow",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "bool_and_or",
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "opmode_dist_rows"
              },
              "s": {
                "from": "soak_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "omd_hourDayID",
                    "soak_hourDayID"
                  ],
                  [
                    "omd_opModeID",
                    "soak_opModeID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "soak_isAdmitted",
                "s"
              ]
            }
          }
        },
        {
          "lhs": "omd_soakValue",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "opmode_dist_rows"
              },
              "s": {
                "from": "soak_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "omd_hourDayID",
                    "soak_hourDayID"
                  ],
                  [
                    "omd_opModeID",
                    "soak_opModeID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "soak_opModeFraction",
                "s"
              ]
            }
          }
        },
        {
          "_comment": "K7. One key pair fewer than omd_soakValue, which is the whole difference between a row's own fraction and its group's total.",
          "lhs": "omd_soakSum",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "opmode_dist_rows"
              },
              "s": {
                "from": "soak_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "omd_hourDayID",
                    "soak_hourDayID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "soak_opModeFraction",
                "s"
              ]
            }
          }
        },
        {
          "_comment": "E3, :443 stage 3: the operating mode takes whatever the soak modes left, floored at 0. A RESIDUAL, not fractionOfOperating.",
          "lhs": "omd_opModeFraction",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  "omd_hasSoakRow",
                  0.0
                ]
              },
              "omd_soakValue",
              {
                "op": "max",
                "args": [
                  0.0,
                  {
                    "op": "-",
                    "args": [
                      1.0,
                      "omd_soakSum"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "the_operating_share_is_one_at_an_on_network_link",
          "description": "E1 on the fixture's two hour-days. The value is 1 EXACTLY, not approximately, because A10 makes SUM(SHO) and SUM(sourceHours) the same 41 numbers at an on-network link (allocation.rs:631-682) and a quotient of identical binary64 values is 1. What breaks if this is wrong: if A10 took the off-network SHP branch instead, the denominator for hourDay 72 would be population x noOfRealDays - SHO = 6,902,112.67 h against a numerator of 594.23 h, a ratio of 8.6e-05, and every soak weight in this chain would come alive -- which would make the whole slice depend on TankTemperatureGenerator's quarter-hour recurrence (finding F12). The exactness is the load-bearing part, so it is asserted at the model's rel 1e-12.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "act_fractionOfOperating",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "evap_activity_rows": 1
              }
            },
            {
              "variable": "act_fractionOfOperating",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "evap_activity_rows": 2
              }
            },
            {
              "variable": "omd_opModeFraction",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "opmode_dist_rows": 3
              }
            },
            {
              "variable": "omd_opModeFraction",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "opmode_dist_rows": 6
              }
            }
          ]
        },
        {
          "id": "mode_300_is_a_residual_and_not_the_operating_share",
          "description": "The probe row at hourDay 62, whose operating share is 300/500 = 0.6. The residual is greatest(0, 1 - 0.40000006800000004) = 0.599999932; `fractionOfOperating` is 0.6. They differ by 6.8e-08 because the snapshot's soak pair sums to 1.00000017 rather than to 1 -- six-significant-figure storage, not a modelling error. What breaks if this is wrong: nothing on this fixture, which is exactly the danger. A document that wrote `opModeFraction[300] = fractionOfOperating` agrees with the snapshot's six rows to the last bit and is wrong in general; this probe row is the only thing in the component that can tell the two apart, and at rel 1e-12 it does.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "act_fractionOfOperating",
              "time": 0.0,
              "expected": 0.6,
              "coords": {
                "evap_activity_rows": 3
              }
            },
            {
              "variable": "omd_soakSum",
              "time": 0.0,
              "expected": 0.40000006800000004,
              "coords": {
                "opmode_dist_rows": 9
              }
            },
            {
              "variable": "omd_opModeFraction",
              "time": 0.0,
              "expected": 0.599999932,
              "coords": {
                "opmode_dist_rows": 9
              }
            }
          ]
        },
        {
          "id": "the_soak_modes_carry_the_complement_of_the_operating_share",
          "description": "E2 on the same probe row: 0.00668717 x 0.4 = 0.0026748680000000004 for hot soaking and 0.993313 x 0.4 = 0.39732520000000005 for cold soaking. What breaks if this is wrong: writing `x fractionOfOperating` instead of `x (1 - fractionOfOperating)` gives 0.0040123020000000005 and 0.5959877999999999 -- a 1.5x error on the hot-soak mode and, through the residual, an opModeFraction[300] of 0.39999993200000003 instead of 0.599999932. Both arms are plausible numbers between 0 and 1, which is why the check is on a value and not on a bound. The two soak values are ZERO on the fixture's own rows (1, 2, 4, 5), so this probe row is the only place the sign of the complement is observable.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "soak_opModeFraction",
              "time": 0.0,
              "expected": 0.0026748680000000004,
              "coords": {
                "soak_rows": 3
              }
            },
            {
              "variable": "soak_opModeFraction",
              "time": 0.0,
              "expected": 0.39732520000000005,
              "coords": {
                "soak_rows": 7
              }
            },
            {
              "variable": "omd_soakValue",
              "time": 0.0,
              "expected": 0.0026748680000000004,
              "coords": {
                "opmode_dist_rows": 7
              }
            },
            {
              "variable": "omd_soakValue",
              "time": 0.0,
              "expected": 0.39732520000000005,
              "coords": {
                "opmode_dist_rows": 8
              }
            }
          ]
        },
        {
          "id": "the_operating_share_is_capped_at_one",
          "description": "The probe row at hourDay 65, whose raw ratio is 625/500 = 1.25. `least(1, .)` makes it 1, so the soak modes are 0 and the residual is 1. What breaks if this is wrong: without the cap the soak shares are 0.00668717 x (-0.25) = -0.0016717925 and -0.24832825, their sum is -0.2500000425, and the residual becomes greatest(0, 1.2500000425) = 1.2500000425 -- an operating-mode FRACTION above 1, which would then multiply an emission by 1.25. The assertion pins the capped 1 and the zero soak sum together, because the cap is only observable through what it prevents.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "act_fractionOfOperating",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "evap_activity_rows": 4
              }
            },
            {
              "variable": "omd_opModeFraction",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "opmode_dist_rows": 12
              }
            }
          ]
        },
        {
          "id": "a_mode_the_association_table_does_not_carry_contributes_nothing",
          "description": "K5 and K6's semi-join, exercised by a probe ROW rather than by a parameter override -- the technique docs/esm-conventions.md §16.4 established after finding F19 removed the other one. Row 9 of the soak relation carries operating mode 501 at hourDay 62 with a soakActivityFraction of 0.5, and opmodepolprocassoc lists 501 only at polProcessID -1. What breaks if this is wrong: the association table's other 24 rows are the DRIVE-CYCLE operating modes (0, 1, 11-40, 501), all at polProcessID -1. A join that ignored the pollutant-process would admit every one of them, and each would multiply a soak fraction it has no business touching. Here that mistake is visible as a number: omd_soakSum for hourDay 62 would be 0.6000000680000001 instead of 0.40000006800000004, and the mode-300 residual 0.399999932 instead of 0.599999932 -- a 33% under-emit on every row of that hour-day, with no NaN and no missing key to trace it by. The assertions pin the surviving sum and residual, and the 0.5 input beside them, so the exclusion is proved by what did NOT change.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "soak_soakActivityFraction",
              "time": 0.0,
              "expected": 0.5,
              "coords": {
                "soak_rows": 9
              }
            },
            {
              "variable": "soak_isAdmitted",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "soak_rows": 3
              }
            },
            {
              "variable": "omd_soakSum",
              "time": 0.0,
              "expected": 0.40000006800000004,
              "coords": {
                "opmode_dist_rows": 7
              }
            },
            {
              "variable": "omd_opModeFraction",
              "time": 0.0,
              "expected": 0.599999932,
              "coords": {
                "opmode_dist_rows": 9
              }
            }
          ]
        }
      ]
    }
  }
