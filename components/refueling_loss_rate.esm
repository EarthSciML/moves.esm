{
  "esm": "1.0.0",
  "metadata": {
    "name": "moves.refueling_loss_rate",
    "description": "RefuelingLossCalculator's rate stages -- REFEC-1 through REFEC-8 of RefuelingLossCalculator.sql, ported from crates/moves-calculators/src/calculators/refueling_loss_calculator.rs -- on five hand-checkable probe coefficient sets and three control-technology cases.\n\nThis component exists because of docs/esm-conventions.md 23. In the `process-refueling` snapshot four of these stages are checked at NO point of their input space: Washtenaw County's countyyear row carries both Stage II program adjustments as exactly 0, every refuelingcontroltechnology row the run reaches carries refuelingTechAdjustment 0 and controlledRefuelingRate 0, and gasoline's own refueling temperature never leaves the [45, 90] window or the [0, 20] tank-difference window. Perturbing any of those in the fixture moves no output cell, so an assertion written there would be decoration. The probe rows below put each of them on the live side of its clamp, at values chosen so both branches differ.\n\nWhat it does NOT contain is the REFEC-2 averageRVP aggregation and the REFEC-7 energy join, which are relational rather than arithmetic and are exercised against the real fuel supply in fixtures/process-refueling.esm.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "moves",
      "onroad",
      "refueling",
      "evaporative",
      "calculator"
    ]
  },
  "index_sets": {
    "factor_rows": {
      "kind": "interval",
      "size": 5
    },
    "control_rows": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "RefuelingLossRate": {
      "expression_template_imports": [
        {
          "ref": "../lib/refueling.esm",
          "only": [
            "refueling_temperature",
            "tank_temperature_dif",
            "displaced_vapor_rate",
            "floored_vapor_rate",
            "adjusted_vapor_rate",
            "adjusted_spill_rate",
            "refueling_emission_quantity"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-12
      },
      "variables": {
        "prb_temperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "The ambient hourly temperature each probe row is evaluated at, degF. Row 1 is the fixture's own 59.5; rows 3 and 5 sit outside gasoline's [45, 90] window on either side so the clamp is exercised in both directions; row 4 is a set with the window DISABLED, where the ambient temperature is used unchanged."
        },
        "prb_vaporTermA": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.vaporTermA -- the constant term of the displaced-vapour exponential."
        },
        "prb_vaporTermB": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.vaporTermB -- the tankTemperatureDif coefficient."
        },
        "prb_vaporTermC": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.vaporTermC -- the refuelingTemperature coefficient."
        },
        "prb_vaporTermD": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.vaporTermD -- the averageRVP coefficient."
        },
        "prb_vaporTermE": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.vaporTermE -- the refuelingTemperature coefficient of tankTemperatureDif."
        },
        "prb_vaporTermF": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.vaporTermF -- the constant term of tankTemperatureDif."
        },
        "prb_vaporLowTLimit": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.vaporLowTLimit. A (0, 0) PAIR disables the 2008 California study relation entirely -- rows 2 and 4 carry it, which is diesel's and electricity's real value in every snapshot, so the disabling arm is not a hypothetical."
        },
        "prb_vaporHighTLimit": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.vaporHighTLimit."
        },
        "prb_tankTDiffLimit": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.tankTDiffLimit -- the upper bound of tankTemperatureDif."
        },
        "prb_minimumRefuelingVaporLoss": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "refuelingfactors.minimumRefuelingVaporLoss. A value <= -1 is a SENTINEL meaning `floor the rate to zero`, not a floor of -1; row 2 carries diesel's -1 and row 4 carries a floor of 1.8 that actually binds, so the two arms are separated."
        },
        "prb_averageRVP": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "The market-share-weighted Reid vapour pressure of the (month, fuel type) supply, from REFEC-2."
        },
        "prb_refuelingTemperature": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "REFEC-1: the 2008 California study relation 20.30 + 0.81 t, with t clamped to [vaporLowTLimit, vaporHighTLimit] -- and the ambient temperature unchanged when both limits are zero."
        },
        "prb_tankTemperatureDif": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "REFEC-1: vaporTermE x refuelingTemperature + vaporTermF, clamped to [0, tankTDiffLimit]. Row 3 hits the upper clamp (raw 22.3576) and row 4 the lower (raw -4.06), so neither arm is inferred."
        },
        "prb_displacedVaporRateRaw": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "REFEC-2 before the floor: exp(A + B dif + C T + D rvp), grams of vapour per gallon."
        },
        "prb_displacedVaporRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "factor_rows"
          ],
          "description": "REFEC-2 after the floor."
        },
        "ctl_displacedVaporRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "The REFEC-2 rate the control-technology step adjusts. Rows 1 and 2 carry row 1 of the factor probe rounded to 3.0 so the adjustment arithmetic is checkable by hand."
        },
        "ctl_controlledRefuelingRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "refuelingcontroltechnology.controlledRefuelingRate -- the displaced-vapour rate of a FULLY controlled vehicle. Zero in every row of the process-refueling snapshot, so row 1's 0.5 is the only place this port sees the term at all."
        },
        "ctl_vaporProgramAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "countyyear.refuelingVaporProgramAdjust -- the Stage II vapour-recovery reduction P. It is EXACTLY ZERO in Washtenaw County in 2020, so row 1's 0.2 is the only exercise of the (1 - P) factor anywhere in this port (docs/process-refueling.md 7.2)."
        },
        "ctl_techAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "refuelingcontroltechnology.refuelingTechAdjustment -- the onboard-refueling-vapour-recovery penetration T, which blends the uncontrolled and controlled rates. Row 1's 0.5 is a half-penetrated fleet; the snapshot's own values are 0 for every model year the run emits."
        },
        "ctl_spillRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "refuelingfactors.refuelingSpillRate -- the unadjusted spillage base rate, grams per gallon."
        },
        "ctl_spillProgramAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "countyyear.refuelingSpillProgramAdjust as the spillage county-year fan-out delivers it. Zero in the snapshot; row 1's 0.3 is this port's only exercise of it."
        },
        "ctl_spillTechAdjust": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "sourcetypetechadjustment.refuelingTechAdjustment for process 19."
        },
        "ctl_energy": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "The Total Energy Consumption the refueling row chains off, in kilojoules -- BaseRateCalculator's MOVESWorkerOutput quantity before the output stage's kJ-to-MillionBTU rebase."
        },
        "ctl_energyContent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "The market-weighted fuel energy content, kJ per gram. Row 3 carries ELECTRICITY's 0: fuelsubtype.energyContent is NULL for subtype 90 and the SQL extract keeps only rows > 0."
        },
        "ctl_fuelDensity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "fueltype.fuelDensity, grams per gallon. Row 3 carries electricity's 0 for the same reason."
        },
        "ctl_hasFuelDivisor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "REFEC-7's INNER JOIN onto RefuelingFuelType: whether the (fuelType, month) cell survived `energyContent > 0 AND fuelDensity > 0`. Row 3 is the electricity miss, and it is why the energy chain emits 250 rows and the spillage block only 208."
        },
        "ctl_adjustedVaporRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "REFEC-3/4: displacedVaporRate (1-P)(1-T) + controlledRefuelingRate (1-P) T. One convex blend covering an uncontrolled fleet, a fully controlled one and everything between, with no branch."
        },
        "ctl_adjustedSpillRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "REFEC-5/6: (1 - Pspill) ((1 - T) refuelingSpillRate)."
        },
        "ctl_fuelVolumeDivisor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "energyContent x fuelDensity -- kJ per gallon, so energy divided by it is GALLONS and the loss rates are grams per gallon. Zero on the electricity row, which is what `refueling_emission_quantity` has to be guarded against."
        },
        "ctl_displacementQuantity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "REFEC-8 for process 18: adjustedVaporRate x energy / (energyContent x fuelDensity), grams of THC."
        },
        "ctl_spillageQuantity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "control_rows"
          ],
          "description": "REFEC-8 for process 19, the same product with the spillage rate."
        }
      },
