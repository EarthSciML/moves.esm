      "tests": [
        {
          "id": "the_california_relation_applies_only_when_both_limits_are_set",
          "description": "REFEC-1's first branch. With gasoline's (45, 90) window the refueling temperature is 20.30 + 0.81 t and the ambient 59.5 degF becomes 68.495; with a (0, 0) pair the relation is DISABLED and the ambient temperature is used unchanged. Get that branch backwards for diesel and its tank-temperature difference moves by 30 degF -- which is invisible in the process-refueling snapshot, because diesel's vapour terms are all zero and its rate is floored to 0 anyway.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "prb_refuelingTemperature",
              "time": 0.0,
              "coords": {
                "factor_rows": 1
              },
              "expected": 68.495
            },
            {
              "variable": "prb_refuelingTemperature",
              "time": 0.0,
              "coords": {
                "factor_rows": 2
              },
              "expected": 59.5
            },
            {
              "variable": "prb_refuelingTemperature",
              "time": 0.0,
              "coords": {
                "factor_rows": 4
              },
              "expected": 30.0
            }
          ]
        },
        {
          "id": "the_temperature_clamp_is_exercised_on_both_sides",
          "description": "t is clamped to [vaporLowTLimit, vaporHighTLimit] BEFORE the relation is applied, not after. At 95 degF the clamp gives 90 and 20.30 + 0.81 x 90 = 93.2; at 20 degF it gives 45 and 20.30 + 0.81 x 45 = 56.75. Clamping the RESULT instead would give 97.25 and 36.5.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "prb_refuelingTemperature",
              "time": 0.0,
              "coords": {
                "factor_rows": 3
              },
              "expected": 93.2
            },
            {
              "variable": "prb_refuelingTemperature",
              "time": 0.0,
              "coords": {
                "factor_rows": 5
              },
              "expected": 56.75
            }
          ]
        },
        {
          "id": "the_tank_temperature_difference_clamps_at_both_ends",
          "description": "0.418 T - 16.6 is 22.3576 at row 3's 93.2 degF and -4.06 at row 4's 30 degF, so the [0, tankTDiffLimit] clamp returns 20 and 0. Row 1 is the in-range case, 12.03091, which is what the process-refueling fixture actually uses. A port that dropped the clamp would be 12 % high on the vapour exponent at row 3 and would put a NEGATIVE difference into it at row 4.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
