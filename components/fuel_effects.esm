            0.1126, 0.1662, 0.1072,
            0.1126, 0.1662, 0.1072,
            0.00414744109342911, -0.0220495078142151, 0.00263653299169085,
            5.58244506624426e-05, -0.00195000368524374, -0.019529192370317] }
        },
        {
          "lhs": "fe_termCenter",
