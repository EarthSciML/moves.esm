{
  "esm": "1.2.0",
  "metadata": {
    "name": "UserTableRowMerge",
    "description": "The ROW MERGE of a table that a user input database and the default database both hold, reduced to its arithmetic (PLAN.md §7.3.82, docs/esm-conventions.md §93, §133). MasterLoop.java:206-250 merges every `<databaseselection>` and the domain database BEFORE the default database, and InputDataManager copies every table with INSERT IGNORE, so the first writer of a primary key wins: a user row SHADOWS the default row at its key, and a user row at a key the default lacks is ADDED. onroad/model.esm computes the shadow on the DEFAULT side's axis -- `erba_mergedMeanBaseRate` for emissionRateByAge, the table MOVES 5's LEV and NLEV tools build, and `zrt_mergedSHOAllocFactor` / `zn_merged*` for the county database's zone tables -- through lib/keys.esm's `input_row_or_default`, and counts the added rows instead (`run_inputRateByAgeRowsAdded`), because a relation on the default axis cannot hold them.\n\nThree default rows and two user rows, keyed (sourceBinID, ageGroupID) as a two-column stand-in for emissionRateByAge's four: the user's second row shares the default's second key (a LEV row), the user's first row has a key the default lacks (a hand-made row, which the LEV and NLEV tables never have).",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "moves",
      "onroad",
      "row-merge",
      "user-input-database",
      "lev"
    ]
  },
  "index_sets": {
    "default_rows": {
      "kind": "interval",
      "size": 3
    },
    "input_rows": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "UserTableRowMerge": {
      "expression_template_imports": [
        {
          "ref": "../lib/keys.esm",
          "only": [
            "row_is_present",
            "input_row_or_default"
          ]
        }
      ],
      "tolerance": {
        "rel": 1e-12
      },
      "variables": {
        "def_sourceBinID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "default_rows"
          ],
          "description": "The default table's first key column."
        },
        "def_ageGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "default_rows"
          ],
          "description": "The default table's second key column."
        },
        "def_rate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "default_rows"
          ],
          "description": "The default table's value (emissionRateByAge.meanBaseRate)."
        },
        "inp_sourceBinID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "input_rows"
          ],
          "description": "The user table's first key column."
        },
        "inp_ageGroupID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "input_rows"
          ],
          "description": "The user table's second key column."
        },
        "inp_rate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "input_rows"
          ],
          "description": "The user table's value."
        },
        "def_inputRowCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "default_rows"
          ],
          "description": "How many user rows share this default row's WHOLE key: 0 or 1 (the key is primary in both tables)."
        },
        "def_inputRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "default_rows"
          ],
          "description": "The shadowing user row's value, 0 where there is none."
        },
        "def_mergedRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "default_rows"
          ],
          "description": "THE ROW MERGE: the user value where a user row shares the key, the default's otherwise (`input_row_or_default`)."
        },
        "inputRowsAdded": {
          "type": "unknown",
          "units": "1",
          "description": "User rows at a key the default lacks: all user rows minus the matched pairs. A merge on the default axis cannot see them, so the model counts them as a refusal."
        }
      },
      "equations": [
        {
          "lhs": "def_sourceBinID",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  1
                ]
              ],
              [
                [
                  2,
                  2
                ]
              ],
              [
                [
                  3,
                  3
                ]
              ]
            ],
            "values": [
              1010120000.0,
              1010120000.0,
              1010130000.0
            ]
          }
        },
        {
          "lhs": "def_ageGroupID",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  1
                ]
              ],
              [
                [
                  2,
                  2
                ]
              ],
              [
                [
                  3,
                  3
                ]
              ]
            ],
            "values": [
              3.0,
              405.0,
              3.0
            ]
          }
        },
        {
          "lhs": "def_rate",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  1
                ]
              ],
              [
                [
                  2,
                  2
                ]
              ],
              [
                [
                  3,
                  3
                ]
              ]
            ],
            "values": [
              10.0,
              20.0,
              30.0
            ]
          }
        },
        {
          "lhs": "inp_sourceBinID",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  1
                ]
              ],
              [
                [
                  2,
                  2
                ]
              ]
            ],
            "values": [
              1010990000.0,
              1010120000.0
            ]
          }
        },
        {
          "lhs": "inp_ageGroupID",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  1
                ]
              ],
              [
                [
                  2,
                  2
                ]
              ]
            ],
            "values": [
              3.0,
              405.0
            ]
          }
        },
        {
          "lhs": "inp_rate",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  1
                ]
              ],
              [
                [
                  2,
                  2
                ]
              ]
            ],
            "values": [
              99.0,
              25.0
            ]
          }
        },
        {
          "lhs": "def_inputRowCount",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "d"
            ],
            "ranges": {
              "d": {
                "from": "default_rows"
              },
              "u": {
                "from": "input_rows"
              }
            },
            "expr": 1.0,
            "join": [
              {
                "on": [
                  [
                    "def_sourceBinID",
                    "inp_sourceBinID"
                  ],
                  [
                    "def_ageGroupID",
                    "inp_ageGroupID"
                  ]
                ]
              }
            ]
          }
        },
        {
          "lhs": "def_inputRate",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "d"
            ],
            "ranges": {
              "d": {
                "from": "default_rows"
              },
              "u": {
                "from": "input_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "inp_rate",
                "u"
              ]
            },
            "join": [
              {
                "on": [
                  [
                    "def_sourceBinID",
                    "inp_sourceBinID"
                  ],
                  [
                    "def_ageGroupID",
                    "inp_ageGroupID"
                  ]
                ]
              }
            ]
          }
        },
        {
          "lhs": "def_mergedRate",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "input_row_or_default",
            "bindings": {
              "match_count": "def_inputRowCount",
              "input_value": "def_inputRate",
              "default_value": "def_rate"
            }
          }
        },
        {
          "lhs": "inputRowsAdded",
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "faq",
                "args": [],
                "semiring": "sum_product",
                "output_idx": [],
                "ranges": {
                  "u": {
                    "from": "input_rows"
                  }
                },
                "expr": 1.0
              },
              {
                "op": "faq",
                "args": [],
                "semiring": "sum_product",
                "output_idx": [],
                "ranges": {
                  "d": {
                    "from": "default_rows"
                  },
                  "u": {
                    "from": "input_rows"
                  }
                },
                "expr": 1.0,
                "join": [
                  {
                    "on": [
                      [
                        "def_sourceBinID",
                        "inp_sourceBinID"
                      ],
                      [
                        "def_ageGroupID",
                        "inp_ageGroupID"
                      ]
