        }
      ],
      "tests": [
        {
          "id": "a_user_row_shadows_the_default_row_at_its_key",
          "description": "The user's second row shares the default's second key, (1010120000, 405): the merged value is the user's 25, not the default's 20. The other two default rows have no user row and keep 10 and 30 exactly -- which is every row of every run without a user database.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "def_inputRowCount",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "default_rows": 1
              }
            },
            {
              "variable": "def_inputRowCount",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "default_rows": 2
              }
            },
            {
              "variable": "def_mergedRate",
              "time": 0.0,
              "expected": 10.0,
              "coords": {
                "default_rows": 1
              }
            },
            {
              "variable": "def_mergedRate",
              "time": 0.0,
              "expected": 25.0,
              "coords": {
                "default_rows": 2
              }
            },
            {
              "variable": "def_mergedRate",
              "time": 0.0,
              "expected": 30.0,
              "coords": {
                "default_rows": 3
              }
            }
          ]
        },
        {
          "id": "a_user_row_at_a_new_key_is_counted_not_merged",
          "description": "The user's first row, (1010990000, 3), matches no default key: MOVES would ADD it, no default row takes its 99, and the count of added rows is 1.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "inputRowsAdded",
              "time": 0.0,
              "expected": 1.0
            },
            {
              "variable": "def_inputRate",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "default_rows": 1
              }
            },
            {
              "variable": "def_inputRate",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "default_rows": 3
              }
            }
          ]
        }
      ]
    }
  }
