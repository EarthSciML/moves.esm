                "rel": 1e-06
              }
            },
            {
              "variable": "tt_qhTankTemperature",
              "time": 0.0,
              "expected": 63.056595,
              "coords": {
                "tt_quarter_hour_rows": 5
              },
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "tt_qhTankTemperature",
              "time": 0.0,
              "expected": 62.837364,
              "coords": {
                "tt_quarter_hour_rows": 6
              },
              "tolerance": {
