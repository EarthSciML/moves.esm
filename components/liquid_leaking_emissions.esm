              "process_id": "out_processID"
            }
          }
        },
        {
          "_comment": "O3: NULL, not zero. lib/identifiers.esm's null_output_column is 0/0.",
          "lhs": "out_regClassID",
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "null_output_column",
                "bindings": {}
              },
              "out_polProcessID"
            ]
          }
        },
        {
          "_comment": "O1, K22: the GROUP BY that drops opModeID. Two rows sharing an output key add, and here that sum is over the three operating modes.",
          "lhs": "out_emissionQuant",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "o"
            ],
            "ranges": {
              "o": {
                "from": "leak_output_rows"
              },
              "r": {
                "from": "leak_emission_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "out_dayID",
                    "emis_dayID"
                  ],
                  [
                    "out_fuelTypeID",
                    "emis_fuelTypeID"
                  ],
                  [
                    "out_modelYearID",
                    "emis_modelYearID"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "emis_blendedQuant",
                "r"
              ]
            }
          }
        },
        {
          "_comment": "1 - [x>0] - [x<=0]: both comparisons are false for a NaN, so this is 1 exactly where the column is absent.",
          "lhs": "out_regClassIsAbsent",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "output_column_is_absent",
            "bindings": {
              "column": "out_regClassID"
            }
          }
        },
        {
          "lhs": "out_emissionQuantIsAbsent",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "output_column_is_absent",
            "bindings": {
              "column": "out_emissionQuant"
            }
          }
        }
      ],
      "tests": [
        {
          "id": "the_worked_examples_reach_movesoutput",
          "description": "L9 and O1 on the eight rows that are cells of the snapshot's MOVESOutput, against docs/evap-leaks.md 6.1 to 6.3. The reference stores 4.92007, 8.43008, 0.00120038, 1.70768, 18.7267, 32.0866, 0.00456889 and 6.49975; the values pinned here are the binary64 values of the specification's own expressions and sit between 1.0e-08 and 1.3e-06 from those prints, which is the snapshot's six-significant-figure column storage and not accumulated error (docs/evap-leaks.md 7.1, where each residual is attributed to a specific stored input). What breaks if this is wrong: every factor of the L9 product is in these numbers, so a wrong base rate, a wrong activity join, a wrong operating-mode fraction or a wrong divisor all land here -- which is why the attribution lives in the upstream components and this test is the end-to-end one.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 4.9200741505916,
              "coords": {
                "leak_output_rows": 1
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 8.43008094268985,
              "coords": {
                "leak_output_rows": 2
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 0.0012003802878350499,
              "coords": {
                "leak_output_rows": 3
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 1.7076849432719998,
              "coords": {
                "leak_output_rows": 4
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 18.7266749303634,
              "coords": {
                "leak_output_rows": 6
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 32.0865687916204,
              "coords": {
                "leak_output_rows": 7
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 0.0045688866979532,
              "coords": {
                "leak_output_rows": 8
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 6.49975006648352,
              "coords": {
                "leak_output_rows": 9
              }
            }
          ]
        },
        {
          "id": "real_days_divides_and_does_not_multiply",
          "description": "L9's divisor, on one cohort in both day types. The 1980 gasoline rows are 4.9200741505916 g on the weekend and 18.7266749303634 g on the weekday, a ratio of 3.80618. What breaks if this is wrong: A7 has already multiplied `noOfRealDays` in, by dividing the month's VMT by weeksPerMonth, so L9 must divide it out. Multiplying instead gives 4.037348315 x 23.1918 x 5 = 468.16687325908504 g for the weekday row, and omitting the factor entirely gives 93.63337465181701 g -- a factor of 5 on a row whose key set, pollutant and SCC are all correct. The ratio is also a check on the whole day-type chain: 3.80618 is dayVMTFraction (3.208) x hourVMTFraction (2.493) / noOfRealDays (2.5) x the speed ratio (1.18950), and no factor in that product is 1 (docs/evap-leaks.md 6.4).",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "emis_noOfRealDays",
              "time": 0.0,
              "expected": 2.0,
              "coords": {
                "leak_emission_rows": 1
              }
            },
            {
              "variable": "emis_noOfRealDays",
              "time": 0.0,
              "expected": 5.0,
              "coords": {
                "leak_emission_rows": 8
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 4.9200741505916,
              "coords": {
                "leak_output_rows": 1
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 18.7266749303634,
              "coords": {
                "leak_output_rows": 6
              }
            }
          ]
        },
        {
          "id": "the_zero_op_mode_fractions_contribute_nothing",
          "description": "O1 sums the three operating modes of the 1980 gasoline cohort, and two of them carry a real non-zero base rate -- 0.430904708 g/h hot-soaking and 0.22403231499999998 g/h cold-soaking, asserted here so that their zero contribution cannot be a missing input -- times an opModeFraction of exactly 0. So the weekend sum is the mode-300 term alone, 4.9200741505916 g. What breaks if this is wrong: summing the three rates without their fractions gives (4.037348315 + 0.430904708 + 0.22403231499999998) x 2.43728 / 2 = 5.7182066043003195 g, a 16.2% over-emit with the right key set, the right pollutant and no NaN to trace it by. The zero is COMPUTED by components/evap_operating_mode_distribution.esm from fractionOfOperating = 1, not assumed here; this test is what makes that zero load-bearing rather than decorative.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "emis_weightedMeanBaseRate",
              "time": 0.0,
              "expected": 0.430904708,
              "coords": {
                "leak_emission_rows": 2
              }
            },
            {
              "variable": "emis_weightedMeanBaseRate",
              "time": 0.0,
              "expected": 0.22403231499999998,
              "coords": {
                "leak_emission_rows": 3
              }
            },
            {
              "variable": "emis_emissionQuant",
              "time": 0.0,
              "expected": 4.9200741505916,
              "coords": {
                "leak_emission_rows": 1
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 4.9200741505916,
              "coords": {
                "leak_output_rows": 1
              }
            }
          ]
        },
        {
          "id": "the_im_blend_is_the_identity_where_no_program_covers_the_row",
          "description": "Both arms of L9's trailing UPDATE. On row 1 no IMCoverageMergedUngrouped cell matches, `emis_imAdjustFract` is 0, and `im_blend` returns the unblended 4.9200741505916 g -- which is the SQL's `a row with no matching cell keeps its value unchanged`, spelled as a zero rather than as a branch. On the probe rows the fraction is 0.3 and the blend moves the value: 0.2759 x 0.3 + 0.5518 x 0.7 = 0.46902999999999995 g. What breaks if this is wrong: lib/adjustments.esm's `im_blend` was authored in Phase 1 and has never been exercised, and its two rate arguments are the same shape and the same units. Swapping them was measured, by doing it: every one of the twelve non-probe rows goes to EXACTLY 0, because the blend then reads `q x 0 + 0 x 1` where the fraction is 0 -- so a swapped `im_blend` does not perturb this fixture, it silences it, and 0 is a legal emission quantity that flows through a sum without leaving a NaN to trace. The probe rows go to 0.35866999999999993 g and 1.3651560000000003 g. Fifteen of this file's thirty-seven assertions fail under that sabotage; without the probe the swap would be invisible in the argument ORDER and visible only as a total of zero.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "emis_blendedQuant",
              "time": 0.0,
              "expected": 4.9200741505916,
              "coords": {
                "leak_emission_rows": 1
              }
            },
            {
              "variable": "emis_imAdjustFract",
              "time": 0.0,
              "expected": 0.3,
              "coords": {
                "leak_emission_rows": 7
              }
            },
            {
              "variable": "emis_emissionQuant",
              "time": 0.0,
              "expected": 0.5518,
              "coords": {
                "leak_emission_rows": 7
              }
            },
            {
              "variable": "emis_emissionQuantIM",
              "time": 0.0,
              "expected": 0.2759,
              "coords": {
                "leak_emission_rows": 7
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 0.46902999999999995,
              "coords": {
                "leak_output_rows": 5
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 1.7852040000000002,
              "coords": {
                "leak_output_rows": 10
              }
            }
          ]
        },
        {
          "id": "the_scc_is_computed_from_four_columns",
          "description": "O2, engine.rs:1450-1477, by lib/onroad_activity.esm's `onroad_scc`: 22e8 + fuelTypeID x 1e6 + sourceTypeID x 1e4 + roadTypeID x 1e2 + processID. Gasoline gives 2201210413 and E85 2205210413, which is what MOVESOutput's two SCCs are. What breaks if this is wrong: the SCC is COMPUTED and not looked up -- the `scc` table's 14,976 rows agree with the formula and are read by nothing in this chain -- so a hard-coded value would be right for gasoline and wrong for the 46 E85 rows, and the comparator treats SCC as an identity column, so those 46 would come back as 46 missing plus 46 extra keys rather than as a wrong number. Exchanging the fuel and source-type slots gives 2221010413, which is still a ten-digit SCC. The pollutant and process columns are pinned beside it because `process_id_of` supplies the SCC's last two digits and the output row's processID from the same packed identifier, so a disagreement between them is impossible by construction and worth keeping that way.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "out_SCC",
              "time": 0.0,
              "expected": 2201210413.0,
              "coords": {
                "leak_output_rows": 1
              }
            },
            {
              "variable": "out_SCC",
              "time": 0.0,
              "expected": 2205210413.0,
              "coords": {
                "leak_output_rows": 3
              }
            },
            {
              "variable": "out_pollutantID",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "leak_output_rows": 1
              }
            },
            {
              "variable": "out_processID",
              "time": 0.0,
              "expected": 13.0,
              "coords": {
                "leak_output_rows": 1
              }
            },
            {
              "variable": "out_roadTypeID",
              "time": 0.0,
              "expected": 4.0,
              "coords": {
                "leak_output_rows": 1
              }
            }
          ]
        },
        {
          "id": "the_absent_output_column_is_absent_and_not_zero",
          "description": "O3, and both arms of it. `out_regClassID` is `null_output_column` -- 0/0 -- because MOVESOutput leaves regClassID NULL on all 128 rows of this run and emitting 0 would claim regulatory class zero; `out_regClassIsAbsent` is 1 on every row and `out_emissionQuantIsAbsent` is 0 on every row, which is the negative control. What breaks if this is wrong: the absence cannot be asserted directly. `Assertion.expected` is a JSON number, so NaN cannot be written down, and every tolerance form is a magnitude comparison that a NaN actual fails -- measured, `actual=NaN expected=0` reports FAIL, which is the correct verdict and the wrong polarity for a test that should pass. So the indicator is the assertion, and it uses only ops the format already has: IEEE makes both `x > 0` and `x <= 0` false for a NaN, so `1 - [x>0] - [x<=0]` separates absent from present. Measured on a three-row probe: 1 for 0/0, 0 for 4.25, 0 for -1.5. Without the negative control an indicator stuck at 1 would satisfy the first assertion, which is why both arms are here.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "out_regClassIsAbsent",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "leak_output_rows": 1
              }
            },
            {
              "variable": "out_regClassIsAbsent",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "leak_output_rows": 8
              }
            },
            {
              "variable": "out_emissionQuantIsAbsent",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "leak_output_rows": 1
              }
            },
            {
              "variable": "out_emissionQuantIsAbsent",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "leak_output_rows": 8
              }
            },
            {
              "variable": "out_emissionQuant",
              "time": 0.0,
              "expected": 4.9200741505916,
              "coords": {
                "leak_output_rows": 1
              }
            }
          ]
        },
        {
          "id": "the_activity_join_pairs_a_rate_with_its_own_age",
          "description": "K15, whose key is the derived `runYearID - modelYearID`. The 1980 cohort is age 40 and reads 2.43728 h on the weekend and 23.1918 h on the weekday; the 2020 cohort is age 0 and reads 27.33 h and 260.057 h. What breaks if this is wrong: components/evap_weighted_base_rate.esm's K12 uses the SAME subtraction to pick the rate, so if the two disagreed a cohort would get its own rate against another age's activity. For the 1980 gasoline row that is 4.037348315 g/h against age 0's 260.057 h instead of age 40's 23.1918 h -- 209.98813815079103 g instead of 18.7266749303634 g on the weekday, an 11.2-fold over-emit with the correct key set. moves.rs writes the subtraction at :767 and :935; this port writes it once and joins on the column.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "emis_effectiveAgeID",
              "time": 0.0,
              "expected": 40.0,
              "coords": {
                "leak_emission_rows": 1
              }
            },
            {
              "variable": "emis_sourceHours",
              "time": 0.0,
              "expected": 2.43728,
              "coords": {
                "leak_emission_rows": 1
              }
            },
            {
              "variable": "emis_sourceHours",
              "time": 0.0,
              "expected": 23.1918,
              "coords": {
                "leak_emission_rows": 8
              }
            },
            {
              "variable": "emis_effectiveAgeID",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "leak_emission_rows": 6
              }
            },
            {
              "variable": "emis_sourceHours",
              "time": 0.0,
              "expected": 260.057,
              "coords": {
                "leak_emission_rows": 13
              }
            }
          ]
        }
      ]
    }
  }
}
