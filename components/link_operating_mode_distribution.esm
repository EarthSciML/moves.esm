              "coords": {
                "lomd_mode_rows": 1
              },
              "tolerance": {
                "abs": 1e-15
              }
            },
            {
              "variable": "lomd_highFraction",
              "time": 0.0,
              "expected": 0.11404,
              "coords": {
                "lomd_mode_rows": 1
              },
              "tolerance": {
                "abs": 1e-15
              }
            },
            {
              "variable": "lomd_lowFraction",
              "time": 0.0,
              "expected": 0.23978,
              "coords": {
