                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "_comment": "The CASE, in its own order: stopped, then idle, then braking, then the rectangles.",
          "lhs": "lomd_assignedOpMode",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  "lomd_isStopped",
                  0.5
                ]
              },
              501.0,
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": ">",
                    "args": [
                      "lomd_isIdle",
                      0.5
                    ]
                  },
                  1.0,
                  {
                    "op": "ifelse",
                    "args": [
                      {
                        "op": ">",
                        "args": [
                          "lomd_isBraking",
                          0.5
                        ]
                      },
                      0.0,
                      "lomd_bandOpMode"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "the_case_is_ordered_and_each_of_its_arms_is_reached",
          "description": "FACES THE REFERENCE, through the counts the mode axis divides. Eight seconds of drive schedule 153, each taking a different arm of `buildOpModeClause`'s `CASE`. Second 198 is stopped (speed exactly 0) and takes arm 1. Second 452 is 0.4 mi/h and takes arm 2 -- and its accelerations are -1.5, -3.5 and -3.0, which satisfy the BRAKING disjunct comprehensively, so it is the assertion that pins the arm ORDER rather than the arm. Second 11 has At0 exactly -2.0 and brakes on the INCLUSIVE first disjunct; flip that `<=` to `<` and the whole 1,361-second sweep in the oracle moves. Second 22 has At0 -0.7 with At1 -1.2 and At2 -1.5, so it fails the three-second disjunct on its first term alone and coasts. What breaks if the order is wrong: second 452 becomes braking (mode 0) instead of idle (mode 1), which in the corpus moves 8 seconds between two modes whose emission rates differ by the whole of the deceleration fuel cut.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "lomd_assignedOpMode",
              "time": 0.0,
              "expected": 501.0,
              "coords": {
                "lomd_second_rows": 6
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_isStopped",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lomd_second_rows": 6
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_assignedOpMode",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lomd_second_rows": 8
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_isIdle",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lomd_second_rows": 8
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_isBraking",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lomd_second_rows": 8
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_assignedOpMode",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "lomd_second_rows": 3
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_at0",
              "time": 0.0,
              "expected": -2.0,
              "coords": {
                "lomd_second_rows": 3
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_isBraking",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lomd_second_rows": 3
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_isBraking",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "lomd_second_rows": 4
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_assignedOpMode",
              "time": 0.0,
              "expected": 11.0,
              "coords": {
                "lomd_second_rows": 4
              },
              "tolerance": {
                "abs": 1e-12
              }
            }
          ]
        },
        {
          "id": "the_first_second_has_no_predecessor_and_coalesces_to_zero",
          "description": "FACES THE REFERENCE. Second 0 of every drive schedule has no `secondID - 1` row, so the `LEFT JOIN` gives NULL, `(a.speed - b.speed) + grade` is NULL, and `coalesce(..., 0.0)` makes At0 zero. The VSP acceleration term coalesces separately and to a different expression -- no grade addend -- and is likewise zero, so the VSP is the road-load polynomial alone: 15.109952 * (0.156461 + 15.109952 * (0.00200193 + 0.000492646 * 15.109952)) / 1.4788 = 3.0570003101339895. Speed 33.8 is in [25, 50) and VSP in [3, 6), so mode 23. The Java's own `@algorithm` comment claims a forward difference here and the SQL beneath it has none; docs/link-operating-mode-distribution.md 8.4 measures that the corpus cannot tell the two apart, so this assertion pins the SQL's answer and the document says why it is the SQL's and not the corpus's.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "lomd_hasPrevSpeed",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "lomd_second_rows": 1
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_at0",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "lomd_second_rows": 1
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_accelerationMs",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "lomd_second_rows": 1
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_vsp",
              "time": 0.0,
              "expected": 3.0570003101339895,
              "coords": {
                "lomd_second_rows": 1
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "lomd_assignedOpMode",
              "time": 0.0,
              "expected": 23.0,
              "coords": {
                "lomd_second_rows": 1
              },
              "tolerance": {
                "abs": 1e-12
              }
            }
          ]
        },
        {
          "id": "an_absent_band_bound_does_not_exclude",
          "description": "FACES THE REFERENCE. Three of the 22 rectangles the `CASE` is built from have a NULL bound, and `buildOpModeClause` simply omits the term rather than supplying a default -- an absent bound is a bound that cannot exclude. Second 3 has VSP -4.26 and lands in mode 21, whose `VSPLower` is NULL; second 38 has VSP 12.05 and lands in mode 16, whose `VSPUpper` is NULL; second 309 is 55.7 mi/h and lands in mode 33, whose `speedUpper` is NULL. This file writes those bounds as -1e30 and 1e30 rather than NaN, because JSON has no NaN literal, and these three assertions are what makes the substitution exercised rather than assumed. What breaks if an absent bound is read as 0: second 3's VSP is negative, so mode 21 would be excluded and the second would fall through to no rectangle at all.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "lomd_assignedOpMode",
              "time": 0.0,
