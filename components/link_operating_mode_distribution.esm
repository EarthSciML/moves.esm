              "coords": {
                "lomd_mode_rows": 1
              },
              "tolerance": {
                "rel": 1e-15
              }
            },
            {
              "variable": "lomd_interpolatedFraction",
              "time": 0.0,
              "expected": 0.11252172616522213,
              "coords": {
                "lomd_mode_rows": 1
              },
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "lomd_interpolatedFraction",
              "time": 0.0,
              "expected": 0.09002825241933854,
              "coords": {
                "lomd_mode_rows": 3
              },
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "lomd_lowSecondCount",
              "time": 0.0,
              "expected": 0.0,
              "coords": {
                "lomd_mode_rows": 16
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_interpolatedFraction",
