              "time": 0.0,
              "expected": -4.262308318302009,
              "coords": {
                "lomd_second_rows": 2
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "lomd_assignedOpMode",
              "time": 0.0,
              "expected": 16.0,
              "coords": {
                "lomd_second_rows": 5
              },
              "tolerance": {
                "abs": 1e-12
              }
            },
            {
              "variable": "lomd_vsp",
              "time": 0.0,
              "expected": 12.052453000393367,
              "coords": {
                "lomd_second_rows": 5
              },
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "lomd_assignedOpMode",
              "time": 0.0,
              "expected": 33.0,
              "coords": {
                "lomd_second_rows": 7
              },
              "tolerance": {
