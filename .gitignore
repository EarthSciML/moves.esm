# The EarthSciAST CLI binary is kept here untracked (CLAUDE.md).
/esm

# Worktrees used by parallel implementation streams.
/.moves/

# Scratch.
/target/
*.tmp

# Python bytecode from tools/.
__pycache__/
*.pyc

# The fixture stage materializes each fixture with its snapshot path substituted.
/.fixtures-run/

# tools/clause-order-audit.py keeps every emitted CSV, so a run that moved can
# be diffed against the baseline afterwards rather than re-run to see what.
/.clause-order-run/
