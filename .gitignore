# The EarthSciAST CLI binary is kept here untracked (CLAUDE.md).
/esm

# Worktrees used by parallel implementation streams.
/.moves/

# Scratch.
/target/
*.tmp

# Python bytecode from tools/.
__pycache__/
*.pyc

# The fixture stage materializes each fixture with its snapshot path substituted.
/.fixtures-run/

# tools/clause-order-audit.py keeps every emitted CSV, so a run that moved can
# be diffed against the baseline afterwards rather than re-run to see what.
/.clause-order-run/

# Working artifacts of a corpus migration: the suite's own logs, and the
# per-fixture CSV/test captures a re-addressing pass diffs against. They are
# how the change was measured, not part of it -- three of them were committed
# by accident during the moves-snapshot/v2 migration before this rule existed.
*.log
/.v1emit/
/.v2emit/
/.v2tests/
