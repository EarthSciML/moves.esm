        ],
        "note": "1 row, monthID 0 -- PreAggYEAR.sql's SYNTHESIZED `Whole Year`. The RunSpec selects April and August (`db_aggregationmonth`).",
        "esio_format": "parquet"
      }
    },
    "db_aggregationmonth": {
      "kind": "static",
      "source": {
        "url_template": "./selections/scale-county-idle-adjust-year-month.parquet"
