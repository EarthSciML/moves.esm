      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "THE MONTHS THE RUNSPEC SELECTED, monthIDs 4 and 8, read out of the RunSpec XML by `tools/runspec-month-selection.py` into `runspecs/selections/scale-county-idle-adjust-year-month.parquet`: MOVES overwrites the month list with MonthOfAnyYear 0 after PreAggYEAR.sql has collapsed the month tables over these (ExecutionRunSpec.java:424-445). It overrides the default database catalogue's entry, every month of MonthOfAnyYear.",
        "esio_format": "parquet"
      }
    },
