    "db_runspecpollutantprocess": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/chain-so2-co2e-mechanism/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__runspecpollutantprocess.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecpollutantprocess"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "27 rows over 26 pollutants -- the widest selection in this repository. 101 THC and 9101 Total Energy are the two ROOTS (the first off `emissionratebyage`, the second off the age-independent `emissionrate`); 601 N2O is a third. The rest are chained, and 8801 NonHAPTOG, 9001 Atmospheric CO2 and 9801 CO2 Equivalent are chained by calculators that do NOT go through `runspecchainedto`.",
        "esio_format": "parquet"
      }
    },
    "db_runspecchainedto": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/chain-so2-co2e-mechanism/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__runspecchainedto.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecchainedto"
      },
      "metadata": {
        "tags": [
          "scope",
          "chain"
        ],
        "note": "21 rows, and what they do NOT contain is the point. Fifteen of them hang a toxic off VOC's 8701, three build the hydrocarbon ladder (101 to 7901 to 8001, and 501 off 101), one gives TOG its two parents -- 8601 from BOTH 501 and 8001, the fan-in this chain already handles -- and ONE hangs SO2's 3101 off Total Energy's 9101, which is the first chain edge in this corpus whose parent is not a hydrocarbon. NonHAPTOG, CO2 and CO2 Equivalent appear nowhere in it: their calculators read their inputs directly, which is why they are machinery and not another rung.",
        "esio_format": "parquet"
      }
    },
    "db_runspeccounty": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/chain-so2-co2e-mechanism/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__runspeccounty.parquet"
      },
      "extent": {
        "metaparameter": "n_runspeccounty"
