      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "5 rows, road types 1 to 5. The RunSpec selects 1 and 4; MOVES adds 2, 3 and 5 because off-network idle (running exhaust on road type 1) is computed from every road type (\"Off-Network Idle requires all roadtypes\").",
        "esio_format": "parquet"
      }
    },
