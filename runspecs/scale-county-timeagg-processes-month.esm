      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "4 rows, monthIDs 1, 4, 7 and 10 (`<month key=\"0\"/>` to `\"9\"` are 0-based).",
        "esio_format": "parquet"
      }
    },
    "db_runspechour": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-processes-month/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspechour.parquet"
      },
      "extent": {
        "metaparameter": "n_runspechour"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "1 row, hourID 0 -- the SYNTHESIZED `Entire Day`. The RunSpec selects all 24 hours.",
        "esio_format": "parquet"
      }
    },
    "db_aggregationhour": {
      "kind": "static",
      "source": {
        "url_template": "../movesdb/HourOfAnyDay.parquet"
      },
      "extent": {
