      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "THE 24 HOURS the run aggregates over: the default database's own `HourOfAnyDay` (PreAggDAY.sql).",
        "esio_format": "parquet"
      }
    },
    "db_runspecday": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-processes-month/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspechourday.parquet"
      },
