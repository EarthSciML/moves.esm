        ],
        "note": "1 row: THC at vapor venting (112). MOVES writes THC only at Rates scale.",
        "esio_format": "parquet"
      }
    },
    "db_runspecchainedto": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-venting/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__runspecchainedto.parquet"
