        "esio_format": "parquet"
      }
    },
    "db_aggregationhour": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/project-crankcase/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspechour.parquet"
