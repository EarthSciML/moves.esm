      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__runspechour.parquet"
      },
      "extent": {
        "metaparameter": "n_runspechour"
      },
