        ],
        "note": "1 row, hourID 7. `<beginhour key=\"6\">` is a 0-based index into the sorted hour list (docs/mixed-onroad.md 0.1).",
        "esio_format": "parquet"
      }
    },
    "db_aggregationhour": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-start/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__runspechour.parquet"
