        ],
        "note": "1 row, hourID 7. Six in the RunSpec XML, seven here: the XML's @key is a 0-based index into the sorted hour list (docs/mixed-onroad.md 0.1).",
        "esio_format": "parquet"
      }
    },
    "db_aggregationhour": {
      "kind": "static",
      "source": {
