    "db_runspecday": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/chain-nonhaptog/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__runspecday.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecday"
      },
