        ]
      },
      "metadata": {
        "tags": [
          "oracle",
          "expected-output",
          "output-time-step"
        ],
        "note": "The 3,521-row expected output at `<outputtimestep value=\"Year\"/>`, monthID, dayID and hourID NULL, the one Whole Year cell scaled by its 365/7 weeks; the model emits it from `mos_*` (`n_outputSumsDays` and `n_outputSumsMonths` 1). 23 pollutants at START exhaust only, every cohort of the seven source-fuel pairs, the same key set as `scale-county-start-species`.",
        "esio_format": "parquet"
      }
    },
    "db_runspecpollutantprocess": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-year-start-species/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspecpollutantprocess.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecpollutantprocess"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "23 rows, every one at start exhaust (process 2): THC, CH4, N2O, the six ATRatio toxics, NMHC, NMOG, TOG, VOC, Atmospheric CO2, Total Energy, CO2 Equivalent, PM10, PM2.5, OC, EC, sulfate, non-EC PM and aerosol water. MOVES adds no prerequisite beyond them.",
        "esio_format": "parquet"
      }
    },
    "db_runspecchainedto": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-year-start-species/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspecchainedto.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecchainedto"
      },
      "metadata": {
        "tags": [
          "scope",
          "chain"
        ],
        "note": "20 rows: CH4 and NMHC from THC, NMOG and VOC from NMHC, TOG from CH4 and NMOG, the six toxics from VOC, and the PM chain (PM10 from PM2.5, PM2.5 from EC and non-EC PM, OC and sulfate from non-EC PM, and the cyclic non-EC PM / sulfate / water edges SulfatePMCalculator splits and re-sums). Atmospheric CO2 and CO2 Equivalent are CO2AE edges MOVES keeps in Java (conventions §78).",
        "esio_format": "parquet"
      }
    },
    "db_runspeccounty": {
