      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "3 rows, sourceTypeIDs 21 (passenger car), 32 (light commercial truck) and 62 (combination long-haul truck, the only source type that hotels). Three source types is what makes PreAggDAY.sql's HourWeighting3 pick ONE of them, by `SourceTypeOrdering` (`met_weightingSourceType`): 21.",
        "esio_format": "parquet"
      }
    },
    "db_runspecroadtype": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-month/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspecroadtype.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecroadtype"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "5 rows, road types 1 to 5. The RunSpec selects 1 and 4; MOVES adds 2, 3 and 5 because off-network idle (running exhaust on road type 1) is computed from every road type (\"Off-Network Idle requires all roadtypes\").",
        "esio_format": "parquet"
      }
    },
    "db_runspecsourcefueltype": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-month/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspecsourcefueltype.parquet"
      },
      "extent": {
