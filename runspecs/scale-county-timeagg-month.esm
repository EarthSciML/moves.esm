      },
      "metadata": {
        "tags": [
          "oracle",
          "expected-output",
          "output-time-step"
        ],
        "note": "The 6,288-row expected output at `<outputtimestep value=\"Year\"/>`: monthID, dayID and hourID NULL, each row the four months' cells summed, each scaled by its weeksPerMonth (AggregationSQLGenerator's convertWeeks). The model emits it from `mos_*`, the output relation summed to the output time step (`n_outputSumsDays` and `n_outputSumsMonths` 1).",
        "esio_format": "parquet"
      }
    },
