      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "1 row, roadTypeID 4. J27: this is the join that suppresses every process-2 row, because start exhaust lives on the off-network road type 1 and the RunSpec does not select it (§0.2).",
        "esio_format": "parquet"
      }
    },
    "db_runspecsourcefueltype": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-project/tables/db__movesexecution__runspecsourcefueltype.parquet"
