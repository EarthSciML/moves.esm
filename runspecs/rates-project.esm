      "extent": {
        "metaparameter": "n_runspecsourcefueltype"
      },
      "metadata": {
        "tags": [
          "scope",
          "cohorts"
        ],
        "note": "4 rows: source type 21 with gasoline, diesel, E85 and electricity -- the RunSpec names gasoline alone and MOVES widens it.",
        "esio_format": "parquet"
      }
    },
    "db_runspecpollutantprocess": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-project/tables/db__movesexecution__runspecpollutantprocess.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecpollutantprocess"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "2 rows: 9101 (Total Energy x Running Exhaust) and 9102 (Total Energy x Start Exhaust). The RunSpec XML also names Fossil Fuel Energy, 93, which MOVES does not carry into the execution database; and 9102 writes its rates on the off-network road type, which the RunSpec does not select, so one block reaches MOVESOutput.",
        "esio_format": "parquet"
      }
    },
