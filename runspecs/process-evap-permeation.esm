        "metaparameter": "n_runspeccounty"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "1 row, countyID 26161 (Washtenaw, MI), zone 261610. It selects the ambient temperatures the thermal chain starts from and the fuel supply PC-3 weights. Its `GPAFract` is 0, so PC-3's GPA term contributes nothing. There is no I/M step at all: `EvaporativePermeationCalculator` reads neither `IMCoverage` nor `IMFactor` and polProcess 111 is `isAffectedByEvapIM = 'N'` (docs/evap-permeation.md §1).",
        "esio_format": "parquet"
      }
    }
