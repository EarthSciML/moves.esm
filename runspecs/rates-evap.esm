      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "16 rows: THC, TOG and VOC at permeation, vapor venting and leaks (111-113, 8611-8613, 8711-8713), THC and TOG at refueling displacement and spillage (118, 119, 8618, 8619), and the three Total Energy PREREQUISITES refueling adds -- running (9101), start (9102) and extended idle (9190) -- which the inventory strips and the Rates tables MOVES reads from BaseRateOutput keep. MOVES writes THC only to the Rates tables.",
        "esio_format": "parquet"
      }
    },
    "db_runspecchainedto": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-evap/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__runspecchainedto.parquet"
