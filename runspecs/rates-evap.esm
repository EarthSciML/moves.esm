        "esio_format": "parquet"
      }
    },
    "db_actday": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-evap/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__runspecday.parquet"
