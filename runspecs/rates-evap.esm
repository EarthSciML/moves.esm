    "db_runspecsourcefueltype": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-evap/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__runspecsourcefueltype.parquet"
