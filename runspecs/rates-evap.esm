      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "The day types the output day's ACTIVITY covers, and the source of `noOfRealDays` -- 5 here, the divisor that undoes the `1/weeksPerMonth` the month's VMT was put on. Applying it in both places, or in neither, is a factor of five on every row of this run.",
        "esio_format": "parquet"
      }
    },
    "db_runspecsourcetype": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-evap/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__runspecsourcetype.parquet"
