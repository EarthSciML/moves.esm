        ],
        "note": "1 row, dayID 5 (weekday). It narrows the sample vehicles as well as the output: TTG-4a walks only the weekday vehicle-days, which is what the execution database's 821-row `sampleVehicleDay` was.",
        "esio_format": "parquet"
      }
    },
