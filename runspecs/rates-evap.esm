        "tags": [
          "scope"
        ],
        "note": "1 row, sourceTypeID 21, Passenger Car. It selects the sample vehicles TTG-4a walks and, through `sourceTypeModelYearGroup`, the two tank-temperature groups they are walked as: 3 for model years 1996 and later and 5 before -- PC-6's gate.",
        "esio_format": "parquet"
      }
