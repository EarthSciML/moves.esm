      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/chain-so2-co2e-mechanism-control/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__runspecpollutantprocess.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecpollutantprocess"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "22 rows over 22 pollutants: the sibling's 27 without 3101 SO2, 8801 NonHAPTOG, 9001 Atmospheric CO2, 9801 CO2 Equivalent and 300001 NonHAPTOG Mechanism. 101 THC and 9101 Total Energy are still the two ROOTS and 601 N2O a third, but 9101 now has no child. The three calculators that chain WITHOUT going through `runspecchainedto` are exactly the three deselected here, so this table is the only thing that switches them off.",
        "esio_format": "parquet"
      }
    },
