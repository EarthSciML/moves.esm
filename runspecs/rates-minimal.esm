      }
    },
    "db_runspeccounty": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-minimal/tables/db__movesexecution1ccc0233_campuscluster_illinois_edu__runspeccounty.parquet"
      },
      "extent": {
