      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "1 row, countyID 26161, zone 261610: the zone the 16 links are synthesized in.",
        "esio_format": "parquet"
      }
    },
    "db_rateperdistance": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/rates-minimal/tables/db__out_rates_minimal__rateperdistance.parquet"
      },
      "reader_options": {
        "float_columns": [
          "ratePerDistance",
          "temperature",
          "relHumidity"
        ]
      },
      "metadata": {
        "tags": [
          "oracle",
          "expected-output"
        ],
        "note": "The 2000-row expected output, and it is NOT MOVESOutput, which a Rates run leaves empty: RatePerDistance, running Total Energy in Million BTU per mile for 125 (model year, fuel type) cohorts at each of 16 speed-bin links. DECLARED AND CONSUMED BY NOTHING; run-tests.sh reads the table name off this source, emits the model's `rpd_*` relation for it, and compare-output.py --table rateperdistance compares it under tolerance.toml's [oracle_table.rateperdistance].",
        "esio_format": "parquet"
      }
    }
  },
  "models": {
    "Onroad": {
      "ref": "../moves-onroad.esm",
      "bindings": {
        "n_outputRate": 125,
        "n_ratesScale": 1
      }
    }
  }
