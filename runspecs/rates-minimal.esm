      },
      "extent": {
        "metaparameter": "n_runspecpollutantprocess"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "2 rows: 9101 and 9102, Total Energy on running and start exhaust. The XML's Fossil Fuel Energy (93) rows are not in it. 9102 emits nothing: its rates are written on the unselected road type 1.",
        "esio_format": "parquet"
      }
    },
