      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "3 rows, sourceTypeIDs 21 (passenger car), 32 (light commercial truck) and 62 (combination long-haul truck, the only source type that hotels). Three source types is what makes PreAggDAY.sql's HourWeighting3 pick ONE of them, by `SourceTypeOrdering` (`met_weightingSourceType`): 21.",
        "esio_format": "parquet"
      }
    },
    "db_runspecroadtype": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-year/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspecroadtype.parquet"
