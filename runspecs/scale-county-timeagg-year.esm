      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-year/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspechour.parquet"
      },
      "extent": {
        "metaparameter": "n_runspechour"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "1 row, hourID 0 -- the SYNTHESIZED `Entire Day`. The RunSpec selects all 24 hours.",
        "esio_format": "parquet"
      }
    },
    "db_aggregationhour": {
      "kind": "static",
      "source": {
