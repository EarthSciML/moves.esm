      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-year/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspecyear.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecyear"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "1 row, yearID 2020. The scope comes from these tables and never from the RunSpec XML, whose @key attributes are 0-based indices into sorted ID lists (docs/mixed-onroad.md §0.1).",
        "esio_format": "parquet"
      }
    },
    "db_runspecmonth": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-year/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspecmonth.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecmonth"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "1 row, monthID 0 -- PreAggYEAR.sql's SYNTHESIZED `Whole Year`. The RunSpec selects January, April, July and October (`db_aggregationmonth`).",
        "esio_format": "parquet"
      }
    },
    "db_aggregationmonth": {
      "kind": "static",
      "source": {
        "url_template": "./selections/scale-county-timeagg-year-month.parquet"
      },
      "extent": {
        "metaparameter": "n_aggregationmonth"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "THE MONTHS THE RUNSPEC SELECTED, monthIDs 1, 4, 7 and 10, read out of the RunSpec XML by `tools/runspec-month-selection.py` into `runspecs/selections/scale-county-timeagg-year-month.parquet`: MOVES overwrites the month list with MonthOfAnyYear 0 after PreAggYEAR.sql has collapsed the month tables over these (ExecutionRunSpec.java:424-445). It overrides the default database catalogue's entry, every month of MonthOfAnyYear.",
        "esio_format": "parquet"
      }
    },
