    "db_runspecday": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-year/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspechourday.parquet"
