      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "2 rows, dayIDs 2 and 5: this run's own `runspecday`. PreAggDAY.sql does not touch the day types, so the selection survives in the execution database.",
        "esio_format": "parquet"
      }
    },
    "db_actday": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/scale-county-timeagg-processes-day/tables/db__movesexecution1ccc0236_campuscluster_illinois_edu__runspecday.parquet"
