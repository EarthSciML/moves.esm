        "tags": [
          "scope",
          "cohorts"
        ],
        "note": "11 rows: source types 21 and 32 with gasoline, diesel, E85 and electricity, 62 with diesel, CNG and electricity (MOVES adds every fuel the RunSpec does not name).",
        "esio_format": "parquet"
      }
    },
    "db_movesoutput": {
