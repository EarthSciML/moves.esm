    "db_runspecpollutantprocess": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/process-refueling/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__runspecpollutantprocess.parquet"
