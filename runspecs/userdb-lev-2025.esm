        ],
        "note": "1 row, yearID 2025: ages 0-40 are model years 1985-2025, so the run holds cohorts at LEV rates (1994-2017 and 2025) and at default rates (1985-1993, before any LEV program, and 2018-2024, where the LEV table has no row).",
        "esio_format": "parquet"
      }
    },
