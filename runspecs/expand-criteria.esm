    "db_runspecpollutantprocess": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/expand-criteria/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__runspecpollutantprocess.parquet"
      },
      "extent": {
        "metaparameter": "n_runspecpollutantprocess"
      },
      "metadata": {
        "tags": [
          "scope"
        ],
        "note": "8 rows: 101, 102, 201, 202, 301 and 302 -- THC, CO and NOx on running AND start exhaust -- plus 3101 and 3102, SO2 on both. THREE of the eight reach the output, and WHICH three is why this run is here. J27 suppresses every process-2 row, because start exhaust lives on road type 1 and this RunSpec selects road type 4; and SO2 has no `emissionRateByAge` row at all, because MOVES computes it from total energy in a calculator this chain does not have. The survivors are at positions 1, 3 and 5 of the selected list -- NOT a prefix -- which is the one run in this corpus that would discriminate a renumbering of the output blocks (conventions 60).",
        "esio_format": "parquet"
      }
    },
    "db_runspecchainedto": {
      "kind": "static",
      "source": {
        "url_template": "../../moves.rs/characterization/snapshots/expand-criteria/tables/db__movesexecution1ccc0232_campuscluster_illinois_edu__runspecchainedto.parquet"
