          "update": {
            "kind": "data",
            "source": "db_fuelformulation",
            "from": {
              "file_variable": "RVP"
            }
          }
        },
        "run_outputPolProcessCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "How many selected pollutant-processes NONROAD emits, recomputed; `n_outputPolProcess` is checked against it."
        },
        "run_mixSetsOffOne": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "How many populated cohorts have a listed technology mix whose sum misses 1 by more than `rdtech_moves.f`'s 0.002 -- the threshold at which NONROAD warns. 0 in every run: a second hp bin's set, or none, would count here."
        }
      },
      "equations": [
        {
          "lhs": "runCountyID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "k": {
                "from": "runspeccounty_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "rsc_countyID",
                "k"
              ]
            }
          }
        },
        {
          "lhs": "runStateID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "k": {
                "from": "runspecstate_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "rss_stateID",
                "k"
              ]
            }
          }
        },
        {
          "lhs": "runYearID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "k": {
                "from": "runspecyear_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "rsy_yearID",
                "k"
              ]
            }
          }
        },
        {
          "lhs": "runDayID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "k": {
                "from": "runspecday_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "rsd_dayID",
                "k"
              ]
            }
          }
        },
        {
          "lhs": "run_isCountyScale",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "runCountyID",
                      {
                        "op": "*",
                        "args": [
                          1000,
                          {
                            "op": "floor",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  "runCountyID",
                                  1000
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  0
                ]
              },
              1,
              0
            ]
          }
        },
        {
          "lhs": "run_isNationScale",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "==",
                "args": [
                  "runCountyID",
                  0
                ]
              },
              1,
              0
            ]
          }
        },
        {
          "lhs": "runBaseYearID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "max_product",
            "output_idx": [],
            "ranges": {
              "p": {
                "from": "nrbaseyearequippopulation_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "pop_NRBaseYearID",
                "p"
              ]
            }
          }
        },
        {
          "lhs": "run_extraScopeRows",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "n"
            ],
            "ranges": {
              "n": {
                "from": "run_scope_rows"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        "n_runspeccounty",
                        "n_runspecstate",
                        "n_runspecyear",
                        "n_runspecday",
                        "n_runspecmonth"
                      ]
                    },
                    5
                  ]
                },
                {
                  "op": "abs",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        {
                          "op": "+",
                          "args": [
                            {
                              "op": "-",
                              "args": [
                                "runYearID",
                                "runBaseYearID"
                              ]
                            },
                            1
                          ]
                        },
                        "n_foldYear"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "scc_isSectorFuelMatch",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "bool_and_or",
            "output_idx": [
              "s"
            ],
            "ranges": {
              "s": {
                "from": "nrscc_rows"
              },
              "e": {
                "from": "nrequipmenttype_rows"
              },
              "k": {
                "from": "runspecsector_rows"
              },
              "f": {
                "from": "runspecfueltype_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "scc_NREquipTypeID",
                    "eqt_NREquipTypeID"
                  ]
                ]
              },
              {
                "on": [
                  [
                    "eqt_sectorID",
                    "rssec_sectorID"
                  ]
                ]
              },
              {
                "on": [
                  [
                    "scc_fuelTypeID",
                    "rsf_fuelTypeID"
                  ]
                ]
              }
            ],
            "expr": 1.0
          }
        },
        {
          "lhs": "run_sectorFuelMatchCount",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "s": {
                "from": "nrscc_rows"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "scc_isSectorFuelMatch",
                "s"
              ]
            }
          }
        },
        {
          "lhs": "scc_isSelected",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "s"
            ],
            "ranges": {
              "s": {
                "from": "nrscc_rows"
              }
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">",
                  "args": [
                    "run_sectorFuelMatchCount",
                    0
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "scc_isSectorFuelMatch",
                    "s"
                  ]
                },
                1.0
              ]
            }
          }
        },
        {
          "lhs": "eqt_ordinal",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "e"
            ],
            "ranges": {
              "e": {
                "from": "nrequipmenttype_rows"
              }
            },
            "expr": "e"
          }
        },
        {
          "lhs": "point_ordinal",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "equipment_point_rows"
              }
            },
            "expr": "r"
          }
        },
        {
          "lhs": "point_sourceTypeID",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "equipment_point_rows"
              },
              "u": {
                "from": "nrsourceusetype_rows"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "sut_pointRank",
                    "point_ordinal"
                  ]
                ]
              }
            ],
            "expr": {
              "op": "index",
              "args": [
                "sut_sourceTypeID",
                "u"
              ]
            }
          }
        },
        {
          "_comment": "The point's SCC, READ from nrsourceusetype rather than declared. It used to be the `runSCC` parameter, which could hold only one; with six points the SCC is a property of the equipment, and the document now says so. One source type has exactly one row, so the sum_product contraction is a lookup.",
