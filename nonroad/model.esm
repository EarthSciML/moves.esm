                    "w",
                    1
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "slot_baseModelYearFraction",
                    "r",
                    1
                  ]
                },
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "fold_totalPopulation",
                        "r",
                        "w"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "point_statePopulation",
                        "r"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "THE FOLD (§2.2(e)), as esm-spec §4.3.1.1's causal self-reference. The body reads `index(fold_scrappedFraction, r, w - a)`: itself, strictly earlier along the fold-year axis, with the equipment-point axis an identity index. The 51-slot vector fold is reduced to this scalar recurrence on 31 residuals first -- every cell of the grown vector is a clamped base times an ASCENDING run of survival factors, so slot `a` of year `w` traces back `a` years to the residual of year `w - a`, or to the 1990 vector if the fold has not run that long. tools/verify-agedist-reduction.py checks that reduction cell by cell in float32 against the specification's own script, 0 of 1,581 cells differing, on all six of the snapshot's equipment points. Two orders are load-bearing and both were measured: the residual is `minuend - sum` with the cohorts summed ascending FIRST (folding the negated terms into the minuend one at a time moves the answer up to 1.1e-05 relative, because the residual is a catastrophic cancellation), and each cohort's factors multiply left to right starting FROM the base (precomputing the run product moves it up to 6.4e-06).",
          "lhs": "fold_scrappedFraction",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "r",
              "w"
            ],
            "reduce": "+",
            "ranges": {
              "r": {
                "from": "equipment_point_rows"
              },
              "w": {
                "from": "fold_year_rows"
              },
              "a": [
                1,
                50
              ]
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "w",
                    1
                  ]
                },
                0.0,
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "agedist_cohort_term",
                  "bindings": {
                    "equipment_point": "r",
                    "fold_year": "w",
                    "age_slot": "a",
                    "survival": "slot_survivalFraction",
                    "base_fraction": "slot_baseModelYearFraction",
                    "residual_minuend": "fold_residualMinuend",
                    "scrapped_sum": "fold_scrappedFraction"
                  }
                }
              ]
            }
          }
        },
        {
          "lhs": "fold_newestCohortResidual",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "r",
              "w"
            ],
            "ranges": {
              "r": {
                "from": "equipment_point_rows"
              },
              "w": {
                "from": "fold_year_rows"
              }
            },
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "fold_residualMinuend",
                    "r",
                    "w"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "fold_scrappedFraction",
                    "r",
                    "w"
                  ]
                }
              ]
            }
          }
        },
        {
