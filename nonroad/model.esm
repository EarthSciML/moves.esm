        },
        "slot_priorFractionLifeUsed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "The same for the age before it, floored at 0 so age 1's predecessor reads the curve's origin. Computed rather than read from the neighbouring row, because a relation cannot be joined to itself (docs/findings F11)."
        },
        "slot_percentScrapped": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "Cumulative percent scrapped at this age: the curve's value at the last breakpoint AT OR BELOW slot_fractionLifeUsed. find_scrappage_percent does NOT interpolate between breakpoints (output/find.rs:233-244), which is why all 197 points are read rather than a few around the answer."
        },
        "slot_priorPercentScrapped": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "The same at the previous age. scrptime works with both at once, which is what makes the year-over-year fraction a difference of cumulatives rather than a curve of its own."
        },
        "slot_yearScrapFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "yryrfrcscrp: the fraction of the cohort SURVIVING at the previous age that is scrapped during this one. Once the previous age is fully scrapped the entry is 0 rather than a division by zero (scrptime.rs:126-131)."
        },
        "slot_survivalFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "1 - yryrfrcscrp: the factor agedist.f applies when it shifts a cohort one year older. §7.3 LIVES HERE. For this equipment point age 3's cumulative scrappage is exactly 100%, so this is 100 x 0.265 / 26.5 subtracted from 1 -- exactly 0 in binary64 and 5.9604645e-08 in the binary32 this document declares. Thirty fold iterations later that residue is the whole of model year 2018, four MOVESOutput rows."
        },
        "point_equipmentLifeYears": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "nyrlif = 3: the first age at which cumulative scrappage reaches 100%, and so the number of model years this equipment point spans. Capped at MXAGYR for totality; the cap cannot bind, because the median life is itself capped at MXAGYR/2 and the curve reaches 100% at twice the median life."
        },
        "point_salesGrowth": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "The sales trend scrptime.rs:139-143 infers from ONE year's population growth -- grwfac(1990, 1991), not the growth over the whole projection."
        },
        "slot_survivingEquipment": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "The 1990 stock at this age: the sales of the year it was built, decayed by its cumulative scrappage (scrptime.rs:147-165). The cohort at age `a` was sold nyrlif - a sales-years after the curve's start, so the sales index is a subtraction rather than an array read. Ages beyond nyrlif carry 0."
        },
        "point_survivingEquipmentTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "The normalizing sum of slot_survivingEquipment, accumulated in ascending age order as scrptime accumulates it."
        },
        "point_grownModelYearFractionTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "totpopfrc: the grown fractions this point actually contributes, summed. agedist.f's residual is defined so that the whole 51-slot vector sums to totpop/baspop, and the slots the skip removes are the ones that carry nothing, so this must come back to the cumulative growth ratio the document derives from nrgrowthindex by a completely different route. It is the fold's only end-to-end self-check, and it is now made once per equipment point rather than once."
        },
        "slot_baseModelYearFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "modfrc before growth: the share of the 1990 population at this age, (0.8506725, 0.1493275, 0) for this point (§6.1 step 2). Sums to 1."
        },
        "fold_yearID": {
          "type": "unknown",
          "shape": [
            "fold_year_rows"
          ],
          "description": "The calendar year each fold row stands for: runBaseYearID + (row - 1), so row 1 is 1990 -- the base distribution before any growth -- and row 31 is 2020. Two equations index the last row as the literal 31; the assertion that this column's row 31 is 2020 is what guards that literal."
        },
        "fold_lowYearID": {
          "type": "unknown",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "getgrw.f, first half: the latest year at or below this fold year that this run's growth pattern is actually tabulated at. Pattern 2176 is tabulated at 1990 and then annually from 1999 to 2040, so for 1991..1998 this is 1990 and thereafter it is the fold year itself."
        },
        "fold_highYearID": {
          "type": "unknown",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "The earliest tabulated year at or above it: 1999 for 1991..1998, and equal to fold_lowYearID wherever the fold year is itself tabulated. EQUAL IS THE COMMON CASE and it is what the interpolation below has to be guarded against, not a corner."
        },
        "fold_lowIndicator": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "G at fold_lowYearID, truncated toward zero because canonical writes the /GROWTH/ packet with %20d (nonroad_loader.rs:1516). Selected by TWO RANGE PREDICATES rather than an equality: at or below the fold year and at or above the low year, which exactly one tabulated row satisfies. That keeps §3's rule -- a filter carries a genuine predicate -- without needing to join on a two-axis column."
        },
        "fold_highIndicator": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "G at fold_highYearID, the same way."
        },
        "fold_indicator": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "getgrw.f's indicator at this fold year: the tabulated value where the year is tabulated, and the two-point linear interpolation between the bracketing years where it is not. G(1990) = 321, G(1991) = 449.8889, G(2020) = 1508. WHAT THIS DOES NOT PORT: getgrw's two EXTRAPOLATION branches, for a query below the first tabulated year or above the last. They cannot fire here -- 1990 through 2020 lies inside pattern 2176's span 1990 to 2040 -- and components/growth_index.esm ports and tests both."
        },
        "fold_priorIndicator": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "The indicator one fold year earlier, which is the base of this row's one-year growth step. Row 1 reads ITSELF rather than an out-of-range row, which makes row 1's growth factor exactly 0 -- the value the base row needs, since the fold takes no step there."
        },
        "fold_annualGrowthFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "grwfac(year-1, year): the ANNUALIZED fractional change (g - b) / (b x span), not the cumulative ratio. This is the series agedist folds one year at a time, and it is where the /GROWTH/ truncation earns its keep -- the year-over-year changes sit near zero, so the truncation decides the SIGN of the factor and with it which model years survive the fold's clamp."
        },
        "point_popGrowthFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "grwfac(1990, 1991) = 0.401523, read out of fold_annualGrowthFactor at row 2. scrptime's sales curve is built from the FIRST year's rate alone (§2.2(c)); using the cumulative ratio here would compound a per-year rate as though it were a total."
        },
        "point_mixExactIsPresent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "Does nrengtechfraction have exhaust rows for this exact SCC in this hp bin?"
        },
        "point_mixZero3IsPresent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "Rung 2 of the equipment chain."
        },
        "point_mixEffectiveSCC": {
          "type": "unknown",
          "element_type": "Float64",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "2260007005: this SCC has its own .TECH rows. §6.2's SCCs fall back to 2265000000, which is what makes the walk load-bearing."
        },
        "point_mixBinLow": {
          "type": "unknown",
          "units": "hp",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "The lowest hpMin among the `.TECH` bins at `point_mixEffectiveSCC` that contain the point's hpAvg. The bins only ever TOUCH -- no two overlap, none share a lower bound, measured -- so this names one bin, the first NONROAD's lookup finds; a point on a boundary, like 2260004071's 3.0 hp between [1, 3] and [3, 6], would otherwise read the mix of both and sum it."
        },
        "tech_rateExactDistance": {
          "type": "unknown",
          "units": "hp",
          "shape": [
            "equipment_point_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "`fndefc.f`'s hp distance of the nearest bin at the point's own SCC for this (pollutant-process, technology): the least `hp_bin_distance` over the rows whose closed hp interval holds the point's hpAvg."
        },
        "tech_rateExactRow": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "The first `nremissionrate` row at the point's own SCC for this (pollutant-process, technology) among those whose closed hp interval holds the point's hpAvg AND sits at the nearest `hp_bin_distance` (`tech_rateExactDistance`), or +Inf if there is none. A tie takes the first row, which within one (SCC, technology, polProcess) is ascending hpMin -- measured over the national table -- as `fndefc.f` keeps the first match it meets."
        },
        "tech_rateZero3Distance": {
          "type": "unknown",
          "units": "hp",
          "shape": [
            "equipment_point_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "`fndefc.f`'s hp distance of the nearest bin at the equipment root for this (pollutant-process, technology): the least `hp_bin_distance` over the rows whose closed hp interval holds the point's hpAvg."
        },
        "tech_rateZero3Row": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "The first `nremissionrate` row at the equipment root `xxxxxxx000` for this (pollutant-process, technology) whose hp bin contains the point's hpAvg, or +Inf if there is none. FIRST by row, which within one (SCC, technology, polProcess) is ascending hpMin -- measured over the national table -- so a point on a bin boundary takes the LOWER bin, as moves.rs `hp_pick` does."
        },
        "tech_rateZero6Distance": {
          "type": "unknown",
          "units": "hp",
          "shape": [
            "equipment_point_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "`fndefc.f`'s hp distance of the nearest bin at the family root for this (pollutant-process, technology): the least `hp_bin_distance` over the rows whose closed hp interval holds the point's hpAvg."
        },
        "tech_rateZero6Row": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "The first `nremissionrate` row at the family root `xxxx000000` for this (pollutant-process, technology) whose hp bin contains the point's hpAvg, or +Inf if there is none. FIRST by row, which within one (SCC, technology, polProcess) is ascending hpMin -- measured over the national table -- so a point on a bin boundary takes the LOWER bin, as moves.rs `hp_pick` does."
        },
        "tech_rateRow": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "`fndefc.f`'s SCC chain, walked INDEPENDENTLY for every (pollutant-process, technology): the point's own SCC if it has a row, then the equipment root, then the family root. It was one chain per POINT in the fixture, which is right only while every technology of an SCC is rated at the same level -- `nr-logging-county`'s are -- and `nr-lawn-garden-county` has SCCs whose exact rows cover some technologies and not others (moves.rs `build_entries_from_mix`: diesel lawn and garden rates live at 2270004000 while their mix lives at 2270000000)."
        },
        "tech_ratedRate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "`nremissionrate.meanBaseRate` at `tech_rateRow`, 0 where the chain found no row. Unitless because the column is: it carries g/hp-hr for the four pollutants and lb/hp-hr for BSFC, and each reader applies its own unit."
        },
        "tech_engTechID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "engine_tech_rows"
          ],
          "description": "engineTech.engTechID: every engine technology MOVES knows, 130 of them. It was the window 100..199 in the fixture, which held every technology `nr-logging-county` uses and not the 200, 201, 1001-1013 and 2000-2007 the national `nrEngtechFraction` also carries. The joins below select what the tables carry, so the axis is a superset and not a transcription.",
          "update": {
            "kind": "data",
            "source": "db_enginetech",
            "from": {
              "file_variable": "engTechID"
            }
          }
        },
