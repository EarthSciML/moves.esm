        "scc_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrscc_rows"
          ],
          "description": "nrscc.fuelTypeID, in the NONROAD namespace, where gasoline is 1 and diesel is 23/24 (§5.4). MOVESOutput labels rows in the ONROAD namespace, so it is mapped rather than copied.",
          "update": {
