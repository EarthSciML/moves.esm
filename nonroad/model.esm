        },
        "point_medianLifePerYear": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "1 / medianLifeYears = 1.1104711: the life fraction one year of use consumes."
        },
        "slot_fractionLifeUsed": {
