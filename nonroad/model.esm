        {
          "_comment": "The tabulated value where the fold year is tabulated, the two-point line where it is not. The guard is `high > low`, not `high != low`: equality is the common case here -- 22 of 31 fold years are exact rows -- and interpolating on it would divide by zero.",
          "lhs": "fold_indicator",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "r",
              "w"
            ],
            "ranges": {
              "r": {
