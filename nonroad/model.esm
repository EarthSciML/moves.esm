          ],
          "description": "The run's nonroad fuel region: `regioncounty`'s, regionCodeID 2, at a real county; the state's own ID at a state's pseudo-county, which `PreAggSTATE.sql` makes a region of and no national table carries; 0 for the nation."
        },
        "run_countyFuelRegionID": {
          "type": "unknown",
          "shape": [
