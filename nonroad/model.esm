            "join": [
              {
                "on": [
                  [
                    "gi_growthPatternID",
                    "point_growthPatternID"
                  ]
                ]
              }
            ],
            "filter": {
              "op": "and",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "gi_yearID",
                        "i"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "fold_yearID",
                        "w"
                      ]
                    }
                  ]
                },
                {
                  "op": ">=",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "gi_yearID",
                        "i"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "fold_lowYearID",
                        "r",
                        "w"
                      ]
                    }
                  ]
                }
              ]
            },
            "expr": {
              "op": "apply_expression_template",
              "args": [],
              "name": "truncate_toward_zero",
              "bindings": {
                "value": {
                  "op": "index",
                  "args": [
                    "gi_growthIndex",
                    "i"
                  ]
                }
              }
            }
          }
        },
        {
