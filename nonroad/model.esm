  "enums": {
    "scrappage": {
      "FullyScrappedPercent": 100
    },
    "engine_fuel_kind": {
      "Gasoline2Stroke": 1,
      "Gasoline4Stroke": 2,
      "Diesel": 3,
      "LPG": 4,
      "CNG": 5
    },
    "moves_fuel_type": {
      "Gasoline": 1
    },
    "nonroad_fuel_type": {
      "Gasoline": 1,
      "NonroadDiesel": 23,
      "MarineDiesel": 24
    },
    "pollutant": {
      "TotalGaseousHydrocarbons": 1,
      "CarbonMonoxide": 2,
      "OxidesOfNitrogen": 3,
      "SulfurDioxide": 31,
      "BrakeSpecificFuelConsumption": 99,
      "PrimaryExhaustPM10Total": 100
    },
    "process": {
      "RunningExhaust": 1
    },
    "process_group": {
      "Exhaust": 1,
      "Evaporative": 2
    },
    "region_code": {
      "OnroadFuelRegion": 1,
      "NonroadFuelRegion": 2
    }
  },
  "models": {
    "Nonroad": {
      "expression_template_imports": [
        {
          "ref": "../lib/population.esm",
          "only": [
            "pop_file_rounding",
            "max_equipment_ages",
            "median_life_years",
            "year_over_year_scrap_fraction",
            "scrappage_sales_growth",
            "surviving_equipment",
            "truncate_toward_zero",
            "linear_series_interpolation",
            "annualized_growth_factor",
            "agedist_cohort_term"
          ]
        },
        {
          "ref": "../lib/identifiers.esm",
          "only": [
            "scc_zero_tail",
            "pol_process_id",
            "pollutant_id_of",
            "process_id_of",
            "null_output_column",
            "state_is_in_nation"
          ]
        },
        {
          "ref": "../lib/keys.esm",
          "only": [
            "latest_at_or_before_key",
            "scc_lookup_ladder_key",
            "scc_equipment_chain_key",
            "state_default_precedence",
            "flat_relation_major",
            "flat_relation_minor",
            "in_inclusive_range",
            "hp_bin_distance"
          ]
        },
        {
          "ref": "../lib/conversion.esm",
          "only": [
            "days_per_week",
            "default_month_fraction",
            "default_day_fraction",
            "unit_conversion",
            "emission_unit_g_per_hp_hr",
            "printed_decimal"
          ]
        },
        {
          "ref": "../lib/emission_factors.esm",
          "only": [
            "deterioration_age",
            "deterioration_factor"
          ]
        },
        {
          "ref": "../lib/adjustments.esm",
          "only": [
            "exhaust_temperature_adjustment",
            "oxygenate_adjustment"
          ]
        },
        {
          "ref": "../lib/fuel_effects.esm",
          "only": [
            "fuel_property_or_zero"
          ]
        }
      ],
      "variables": {
        "runCountyID": {
          "type": "unknown",
          "units": "1",
          "description": "The RunSpec's county FIPS, read from `runspeccounty`. It was a parameter in the fixture, whose RunSpec XML was the only place it was written; the execution database carries it too, and a document that serves more than one run has to read it. `run_extraScopeRows` asserts the run selects one."
        },
        "runStateID": {
          "type": "unknown",
          "units": "1",
          "description": "The RunSpec's state, read from `runspecstate`. It selects the base-year population rows NONROAD's `.POP` file carries (`prcsta.f` grows the age distribution on the STATE population and allocates afterwards), and the state row of every allocation and temporal ladder."
        },
        "runYearID": {
          "type": "unknown",
          "units": "1",
          "description": "The RunSpec's calendar year, read from `runspecyear`: the episode year NONROAD grows to, the surrogate year `getind.f` picks at or before, and the fuel year's key."
        },
        "runBaseYearID": {
          "type": "unknown",
          "units": "1",
          "description": "The base year the equipment population is stated in, read from `nrbaseyearequippopulation.NRBaseYearID` rather than declared. Every one of the 62,699 national rows carries 1990, so this is 1990; the fold grows from it and `growth_span_rows` reads the growth index at it. The fold's 31 years are `runYearID - runBaseYearID + 1`, which `run_extraScopeRows` checks against the declared axis."
        },
        "point_sourceTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "The point's `nrsourceusetype.sourceTypeID`, gathered through `sut_pointRank`. The fixture DECLARED six of these; here they are whatever the RunSpec's sector and fuel selection and the county's population leave, and for `nr-logging-county` that is the same six, 1059 and 1386 to 1390."
        },
        "point_ordinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "This point's 1-based position, which is what the cohort relation joins on."
        },
        "point_SCC": {
          "type": "unknown",
          "element_type": "Float64",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "This equipment point's SCC, and THE REASON THIS DOCUMENT NEEDS A PER-VARIABLE `element_type`. The document evaluates in `Float32` (see `domain`), because the reference is `real*4` throughout its floating-point quantities. Its keys are not: `2260007005` is 135x binary32's exact-integer limit of 2^24, and rounds to `2260006912` -- which is not a wrong last digit but a different equipment category, so every `join.on` over it matches nothing and the run emits zeros (docs/findings F18, measured end to end: 35 of 87 assertions, every emissionQuant exactly 0). `Float64` here is the Fortran's `INTEGER SCC` said in the only vocabulary the format has. Every SCC-valued variable in this document carries the same override, and nothing else does; the quantities the roll-up multiplies stay at the document's precision.\n\nThe six points carry three distinct SCCs -- 2260007005 once, 2265007010 three times, 2265007015 twice -- which is what makes the output relation a SUM over points rather than a relabelling of them."
        },
        "scc_SCC": {
          "type": "parameter",
          "element_type": "Float64",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrscc_rows"
          ],
          "description": "nrscc.SCC. utf8 in the file and a numeric key here: `float_columns` decodes the decimal text, and every SCC in these tables is below 2^53 so the decode is exact and joins on it are exact.",
          "update": {
            "kind": "data",
            "source": "db_nrscc",
            "from": {
              "file_variable": "SCC"
            }
          }
        },
        "scc_NREquipTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrscc_rows"
          ],
          "description": "nrscc.NREquipTypeID: the first hop of J1, from SCC to equipment type.",
          "update": {
            "kind": "data",
            "source": "db_nrscc",
            "from": {
              "file_variable": "NREquipTypeID"
            }
          }
        },
        "eqt_NREquipTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrequipmenttype_rows"
          ],
          "description": "nrequipmenttype.NREquipTypeID: J1's right-hand side.",
          "update": {
            "kind": "data",
            "source": "db_nrequipmenttype",
            "from": {
              "file_variable": "NREquipTypeID"
            }
          }
        },
        "eqt_surrogateID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrequipmenttype_rows"
          ],
          "description": "nrequipmenttype.surrogateID: the DB form of NONROAD's ALLOCATE.XRF. Surrogate 8, Timber Product Output, for all three logging equipment types.",
          "update": {
            "kind": "data",
            "source": "db_nrequipmenttype",
            "from": {
              "file_variable": "surrogateID"
            }
          }
        },
        "sut_SCC": {
          "type": "parameter",
          "element_type": "Float64",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "nrsourceusetype.SCC. One row per EQUIPMENT POINT -- an (SCC, hpAvg) pair -- which is the grain the whole chain runs at.",
          "update": {
            "kind": "data",
            "source": "db_nrsourceusetype",
            "from": {
              "file_variable": "SCC"
            }
          }
        },
        "sut_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "nrsourceusetype.sourceTypeID: J4's key into the base-year population.",
          "update": {
            "kind": "data",
            "source": "db_nrsourceusetype",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "pop_sourceTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrbaseyearequippopulation_rows"
          ],
          "description": "nrbaseyearequippopulation.sourceTypeID, over all 62,699 rows of the table.",
          "update": {
            "kind": "data",
            "source": "db_nrbaseyearequippopulation",
            "from": {
              "file_variable": "sourceTypeID"
            }
          }
        },
        "pop_stateID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrbaseyearequippopulation_rows"
          ],
          "description": "nrbaseyearequippopulation.stateID: J5's key. Every state is in this table, so without the join the population is the national one.",
          "update": {
