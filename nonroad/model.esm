        },
        "sup_regionActivity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrfuelsupply_rows"
          ],
          "description": "The start activity of the row's fuel region in the RUN's fuel year, gathered from the region's first zone. A row of another fuel year gets it too, and is out of the run's supply (`sup_isRunSupply`) either way."
        },
        "sup_regionShare": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrfuelsupply_rows"
          ],
          "description": "The weight of the row's market share in the run's supply: 1 off the nation, where one region's rows are the run's; at the nation the region's share of the nation's activity, `PreAggNATION.sql`'s `SurrogateRegionActivity`, and the run's supply is `sum(marketShare x actFract)` over every region."
        },
