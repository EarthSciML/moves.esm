              ]
            }
          }
        },
        {
          "_comment": "agedist.rs:133-136. A recurrence of lag 1: the MINGRWIND floor is applied to the RUNNING TOTAL before the year's factor and only when that factor is non-zero, and the clamp at zero is applied after. Either one the other way round is a different projection for a state with almost no equipment.",
          "lhs": "fold_totalPopulation",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "r",
              "w"
            ],
            "ranges": {
              "r": {
                "from": "equipment_point_rows"
              },
              "w": {
                "from": "fold_year_rows"
              }
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "w",
                    1
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "point_statePopulation",
                    "r"
                  ]
                },
                {
                  "op": "max",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "ifelse",
                          "args": [
                            {
                              "op": "!=",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "fold_annualGrowthFactor",
                                    "r",
                                    "w"
                                  ]
                                },
                                0.0
                              ]
                            },
                            {
                              "op": "max",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "fold_totalPopulation",
                                    "r",
                                    {
                                      "op": "-",
                                      "args": [
                                        "w",
                                        1
                                      ]
                                    }
                                  ]
                                },
                                "minimumGrowthPopulation"
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "fold_totalPopulation",
                                "r",
                                {
                                  "op": "-",
                                  "args": [
                                    "w",
                                    1
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "op": "+",
                          "args": [
                            1.0,
                            {
                              "op": "index",
                              "args": [
                                "fold_annualGrowthFactor",
                                "r",
                                "w"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    0.0
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "fold_residualMinuend",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "r",
              "w"
            ],
            "ranges": {
              "r": {
                "from": "equipment_point_rows"
              },
              "w": {
