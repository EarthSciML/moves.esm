            "run_scope_rows"
          ],
          "description": "How many rows the run's scope tables carry beyond one apiece, plus how far the declared fold is from `runYearID - runBaseYearID + 1`. Every scalar above reads ONE row -- NONROAD's master loop fires once per (county, year, month, day) and so does this document -- and a second county or month would be summed into a key rather than refused. Asserted 0 by tools/check-nonroad-shape.py."
        },
        "scc_isSectorFuelMatch": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrscc_rows"
          ],
          "description": "1 when the SCC's equipment type is in a selected sector AND its NONROAD fuel type is a selected fuel: canonical's `NonroadOptFileSqlHelper.getSCCs`, `SELECT SCC FROM nrscc WHERE fuelTypeID IN (fuels) AND NREquipTypeID IN (sectors' types)`."
        },
        "run_sectorFuelMatchCount": {
          "type": "unknown",
          "units": "1",
          "description": "How many SCCs the packet query returns. Zero is not an empty run: see `scc_isSelected`."
        },
        "scc_isSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrscc_rows"
          ],
          "description": "The SCCs NONROAD runs. An EMPTY `/SOURCE CATEGORY/` packet is read by the Fortran exactly like an absent one, which runs the ENTIRE inventory -- every sector, every fuel -- so a query that matches nothing selects everything. That is how a diesel-only RunSpec, whose onroad fuel ID 2 matches no `nrscc` row, produced every sector's SCCs in `nr-agriculture-state`, `nr-airport-support-county`, `nr-industrial-county` and `nr-railroad-support-nation` (moves.rs `nonroad_loader.rs::selected_sccs`, verified there against the canonical binary with an empty and an absent packet)."
        },
        "eqt_ordinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrequipmenttype_rows"
          ],
          "description": "The equipment type's row number, the key `surrogate_target_rows` is laid out against."
        },
        "rpp_polProcessID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "runspecpollutantprocess_rows"
          ],
          "description": "runspecpollutantprocess.polProcessID: 101, 201, 301, 10001. This is the fixture's pollutant axis AND J25's output gate, which is why it is read rather than declared -- CO2 (9001) is computed by the engine and never selected, so an axis written by hand would have to remember not to include it.",
          "update": {
            "kind": "data",
            "source": "db_runspecpollutantprocess",
            "from": {
              "file_variable": "polProcessID"
            }
          }
        },
