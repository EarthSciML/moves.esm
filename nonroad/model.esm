        {
          "_comment": "The indicator at each bracketing year. Selected by a PAIR of range predicates -- at or below the fold year, at or above the low year -- which exactly one tabulated row satisfies, so no equality filter and no join on a two-axis column is needed. The truncation toward zero is canonical's %20d packet write, and is a no-op on this snapshot's integral indices; it is written because it is control flow, not a decode artefact.",
          "lhs": "fold_lowIndicator",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "r",
              "w"
            ],
            "ranges": {
              "r": {
                "from": "equipment_point_rows"
              },
              "w": {
                "from": "fold_year_rows"
              },
              "i": {
                "from": "nrgrowthindex_rows"
