          "default": 0.0,
          "shape": [
            "nrstatesurrogate_rows"
          ],
          "description": "nrstatesurrogate.surrogateID, over all 62,821 rows -- the .ALO files.",
          "update": {
            "kind": "data",
            "source": "db_nrstatesurrogate",
            "from": {
              "file_variable": "surrogateID"
            }
          }
        },
        "sur_countyID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrstatesurrogate_rows"
          ],
          "description": "nrstatesurrogate.countyID. A state row carries the state FIPS in this same column, which is why the county and state quantities below are two rows of ONE relation and not two tables.",
          "update": {
            "kind": "data",
            "source": "db_nrstatesurrogate",
            "from": {
              "file_variable": "countyID"
            }
          }
        },
        "sur_surrogateYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrstatesurrogate_rows"
          ],
          "description": "nrstatesurrogate.surrogateYearID: what getind.f's `latest at or before, else earliest after` rule ranks on.",
          "update": {
            "kind": "data",
            "source": "db_nrstatesurrogate",
            "from": {
              "file_variable": "surrogateYearID"
            }
          }
        },
        "sur_surrogatequant": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrstatesurrogate_rows"
          ],
          "description": "nrstatesurrogate.surrogatequant, decimal text. Without float_columns the allocation fraction below would be a division of two strings.",
          "update": {
            "kind": "data",
            "source": "db_nrstatesurrogate",
            "from": {
              "file_variable": "surrogatequant"
            }
          }
        },
        "tgt_isCounty": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "Which of the two lookups this row is: 1 for the county, 0 for the state. The pair is one relation because alocty.f divides one row of nrstatesurrogate by another row of the same table, and F11 says a relation cannot be joined to itself."
        },
        "tgt_eqtOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "Which equipment type this allocation target serves: targets come in (county, state) pairs, one pair per `nrequipmenttype` row."
        },
        "tgt_countyID": {
          "type": "unknown",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "The FIPS each lookup keys on. The state row's is ARITHMETIC on the county's -- floor(county/1000) x 1000 (nonroad_loader.rs:1043) -- and not a second input."
        },
        "tgt_surrogateID": {
          "type": "unknown",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "The surrogate the target's equipment type allocates through, `nrequipmenttype.surrogateID` (J1's second hop)."
        },
        "tgt_yearAtOrBeforeCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "getind.f, first half: does this (surrogate, FIPS) have a row at or before the episode year? A counting semi-join. The (surrogateID, countyID) equality is a composite `join.on`; the year comparison is a genuine range predicate and stays in `filter`."
        },
        "tgt_latestYearAtOrBefore": {
          "type": "unknown",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "The latest such year, under the max semiring."
        },
        "tgt_earliestYearAfter": {
          "type": "unknown",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "getind.f's fallback: the earliest year AFTER the episode year, used only when nothing at or before exists."
        },
        "tgt_effectiveYearID": {
          "type": "unknown",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "`vallow` else `valhi`, reduced to a key so that the lookup below is a plain three-column equi-join."
        },
        "tgt_quant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "surrogate_target_rows"
          ],
          "description": "J6: the surrogate quantity for each lookup. County 26161 gets 1,512,186 and state 26000 gets 466,969,286, both at surrogateYearID 2002."
        },
        "eqt_allocationCountyQuant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrequipmenttype_rows"
          ],
          "description": "The county's surrogate quantity for the equipment type's surrogate, at `getind.f`'s year."
        },
        "eqt_allocationStateQuant": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrequipmenttype_rows"
          ],
          "description": "The state total row's surrogate quantity (countyID = stateID x 1000), at `getind.f`'s year."
        },
        "eqt_allocationFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrequipmenttype_rows"
          ],
          "description": "`alocty.f`: county quantity over state quantity, 0 where the state quantity is not positive. Computed once per equipment type rather than once per point, because the surrogate is the equipment type's and the point axis is not known until this is."
        },
        "sut_isSCCSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "1 when the row's SCC is one NONROAD runs (`scc_isSelected`)."
        },
        "sut_statePopulation": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "The population the .POP file carries for the run's state -- or the nation's -- `%17.1f`-rounded once, after the states are summed (`NonroadDataFileHelper.generatePopFile` writes the PreAgg'd row)."
        },
        "sut_runPopulation": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "The source type's base-year population over the run's states, before the .POP file rounds it: one state's row, or the nation's sum."
        },
        "sut_allocationFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "The state-to-county fraction of the row's equipment type (`eqt_allocationFraction`) at a real county, and 1 at a pseudo-county: moves.rs `load_source_units` allocates only when `county_fips % 1000 != 0`, and `prcsta.f` grows and reports the state population whole."
        },
        "sut_countyPopulation": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "State population times the allocation fraction: the population NONROAD sees for this point."
        },
        "sut_isPoint": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "1 when the row is an EQUIPMENT POINT of this run: its SCC is selected and its county population is positive. That is moves.rs `load_source_units`, whose `population <= 0` skip is also why a 0.0285-unit hp bin that rounds to 0.0 is not a point."
        },
        "sut_prefixPoint": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "How many points there are at or before this row: an inclusive prefix count over `sut_isPoint`."
        },
        "sut_pointRank": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsourceusetype_rows"
          ],
          "description": "The prefix count ZEROED on the rows that are not points, so every point has a dense 1..n_equipmentPoint in `nrsourceusetype` order -- which is sourceTypeID order, the file being sorted on it -- and every other row a 0 no `point_ordinal` can match (docs/esm-conventions.md §22)."
        },
        "point_allocationFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "`sut_allocationFraction` at the point's source-use-type row."
        },
        "point_statePopulation": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "`sut_statePopulation` at the point's source-use-type row."
        },
        "point_countyPopulation": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows"
          ],
          "description": "`sut_countyPopulation` at the point's source-use-type row."
        },
        "runDayID": {
          "type": "unknown",
          "units": "1",
          "description": "The RunSpec's day type, read from `runspecday`: 5 is a weekday, and it is the key into `nrdayallocation`."
        },
        "run_isCountyScale": {
          "type": "unknown",
          "units": "1",
          "description": "1 when the run's county is a real county, 0 when it is a state's pseudo-county (stateID x 1000) or the nation's (0). MOVES runs a state-level RunSpec at a county it BUILDS -- `PreAggSTATE.sql` writes zone stateID x 10000, county stateID x 1000 and fuel region stateID -- and NONROAD's `prcsta.f` then neither allocates nor reads a county's surrogate."
        },
        "run_isNationScale": {
          "type": "unknown",
          "units": "1",
          "description": "1 when the run is the nation's, county 0. `PreAggNATION.sql` then folds every state into a state 0 before NONROAD sees the tables -- population, growth pattern, month allocation, temperature and fuel supply -- and each fold is computed here from the national rows, leaving out Puerto Rico and the Virgin Islands as it does (`state_is_in_nation`)."
        },
        "nationalDefaultStateID": {
          "type": "parameter",
          "default": 0.0,
          "description": "stateID 0 in nrmonthallocation: the national default row a state-specific row outranks (§4.6)."
        },
        "daytimeHourFirst": {
          "type": "parameter",
          "default": 6.0,
          "description": "First hourID of the daytime averaging window emsadj.f takes the ambient temperature over."
        },
        "daytimeHourLast": {
          "type": "parameter",
          "default": 18.0,
          "description": "Last hourID of it, inclusive. Thirteen hours, not twelve."
        },
        "run_countyID": {
          "type": "unknown",
          "shape": [
            "run_scope_rows"
          ],
          "description": "The run's county, as a relation, so zone and regioncounty are reached by `join.on`."
