            "from": {
              "file_variable": "stateID"
            }
          }
        },
        "pop_runWeight": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrbaseyearequippopulation_rows"
          ],
          "description": "1 on a population row of the run's state -- at the nation, of any state but 72 and 78, which `PreAggNATION.sql` sums into one stateID 0 row per source type -- else 0."
        },
        "pop_NRBaseYearID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrbaseyearequippopulation_rows"
          ],
          "description": "nrbaseyearequippopulation.NRBaseYearID.",
          "update": {
            "kind": "data",
