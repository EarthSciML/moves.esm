        "sadj_isPacketRow": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "nrsulfuradjustment_rows"
          ],
          "description": "1 on a row the `/PM BASE SULFUR/` packet carries: a diesel one, `WHERE fueltypeid IN (23,24)`."
        },
        "tech_hasSulfurAlternate": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "engine_tech_rows"
          ],
          "description": "1 for a technology the packet names -- every diesel one -- whose alternates replace the fuel's defaults."
        },
        "tech_alternateSulfurBase": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "engine_tech_rows"
          ],
          "description": "The packet's base sulfur for the technology, weight percent."
        },
        "tech_alternateSulfateConversion": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "engine_tech_rows"
          ],
          "description": "The packet's sulfate conversion for the technology."
        },
        "rtd_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rated_pp_rows"
          ],
          "description": "The pollutant-processes NONROAD loads an emission-factor file for whatever the run selects -- THC, CO, NOx, PM and the BSFC carrier 9901 (moves.rs `build_entries_from_mix`'s slots 0, 1, 2, 5 and `bsfc`). SOx is not among them: `clcems.f` writes its factor from BSFC and THC, so both have to be looked up on a run like `nr-agriculture-state` that selects neither."
        },
        "epp_polProcessID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "emitted_pp_rows"
          ],
          "description": "The pollutant-processes a NONROAD run can put in MOVESOutput, and this model computes: moves.rs `SLOT_POLLUTANT`'s THC, CO, NOx, SO2 and PM10 -- every one stamped process 1, running exhaust. The sixth slot, CO2 (90), is not carried: a RunSpec selecting it misses those rows, and the comparator's key check says so."
        },
        "tech_listedFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows",
            "engine_tech_rows"
          ],
          "description": "J11: this cohort's LISTED share of each technology, from the .TECH row set the equipment chain and the hp bin selected at the cohort's mix year, as `nrengtechfraction` has it. Zero for every code the mix does not carry."
        },
        "tech_fractionTotal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "The listed mix's sum, which NONROAD divides every share by (`rdtech_moves.f`): 1 for most sets, 0.999 or 1.001 for 33 national ones. It is also the check that the hp bin and the processGroup filter admitted ONE bin's set -- two would sum to 2 -- which `run_mixSetsOffOne` makes a number."
        },
        "tech_fraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows",
            "engine_tech_rows"
          ],
          "description": "The share NONROAD uses: the listed share over the set's sum (`rdtech_moves.f` renormalizes unconditionally)."
        },
        "tech_meanBaseRate": {
          "type": "unknown",
          "units": "g/(hp*h)",
          "shape": [
            "equipment_point_rows",
            "runspecpollutantprocess_rows",
            "engine_tech_rows"
          ],
          "description": "J12: the zero-hour emission factor for each (point, selected pollutant process, technology), in g/hp-hr -- `tech_ratedRate` at the selected pollutant, and 0 for a selection NONROAD rates from something else (SOx). DECLARED `g/(hp*h)` here and not on the column, which also holds BSFC's lb/(hp*h) (conventions §58)."
        },
        "tech_ratedDeterioration": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows",
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "`emfclc.f`'s deterioration `1 + A * min(age, cap)^B` for each (cohort, RATED pollutant, technology), on the rated axis because SOx reads THC's. A pair `nrdeterioration` has no row for takes A = 0 and so a factor of 1 -- moves.rs's arrays default to 0.0 -- where the fixture multiplied by presence and gave 0; the exponent's guard keeps `0^0` out of it."
        },
        "tech_deteriorationFactor": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows",
            "runspecpollutantprocess_rows",
            "engine_tech_rows"
          ],
          "description": "`tech_ratedDeterioration` at the selected pollutant."
        },
        "tech_bsfc": {
          "type": "unknown",
          "units": "g/(hp*h)",
          "shape": [
            "cohort_rows",
            "engine_tech_rows"
          ],
          "description": "The technology's brake-specific fuel consumption at the cohort's point, lb/hp-hr as rated times `GRMLB` = 453.6 g/lb."
        },
        "tech_thcEmission": {
          "type": "unknown",
          "units": "g/h",
          "shape": [
            "cohort_rows",
            "engine_tech_rows"
          ],
          "description": "`clcems.f`'s `ems_thc`: the THC factor times the unit conversion times THC's deterioration, BEFORE any adjustment. SOx subtracts it, because the fuel's hydrogen and carbon that leave as unburnt hydrocarbon carry no sulfur out as SO2."
        },
        "tech_soxFactor": {
          "type": "unknown",
          "units": "g/h",
          "shape": [
            "cohort_rows",
            "engine_tech_rows"
          ],
          "description": "`clcems.f`'s SOx factor, which it WRITES rather than reads: `hp * load * (bsfc * (1 - soxcnv) - ems_thc / (hp * load)) * 0.01 * soxbas * 2` -- the fuel's sulfur at the base weight percent, less the sulfate share, as SO2 (twice sulfur's mass). No deterioration of its own. NOT carried: `nrSulfurAdjustment`'s per-technology conversion override, which applies to diesel only. The conversion is the technology's (`tech_soxConversion`): a T4 diesel converts 30% of its sulfur to sulfate."
        },
        "tech_sulfatePMScale": {
          "type": "unknown",
          "units": "g/h",
          "shape": [
            "cohort_rows",
            "engine_tech_rows"
          ],
          "description": "`clcems.f`'s `bsfval*453.6*hpval*faclod*7*soxcnv*0.01`: the sulfate PM a unit of base-minus-in-use sulfur is worth, per hour. 7 is the Fortran's sulfate-to-sulfur mass factor."
        },
        "tech_hourlyEmission": {
          "type": "unknown",
          "units": "g/h",
          "shape": [
            "cohort_rows",
            "runspecpollutantprocess_rows",
            "engine_tech_rows"
          ],
          "description": "`clcems.f`'s `emstmp` before the time adjustment: rate times unit conversion times deterioration, or the SOx factor for SOx, times the pollutant's adjustment. Factored out of `cell_emissionQuant` so the SOx branch is one ifelse; the product associates exactly as it did inline. A diesel point's PM then loses the sulfate its base sulfur carried and its fuel does not (`clcems.f` :267-302): `tech_sulfatePMScale x (sulbas x adjPM - soxbas x adjSOx)`, where adjSOx is the SOx sulfur correction. Nothing is subtracted from any other cell, and x - 0 is x. Then clamped at zero, because this is the term of ONE output record: NONROAD writes a record per (SCC, hp level, model year, technology) and `NonroadOutputDataLoader` loads `Math.max(0, value)` of each, so a technology whose sulfur correction exceeds its PM contributes 0 while its cohort's other technologies keep theirs."
        },
        "cell_emissionQuant": {
          "type": "unknown",
          "units": "g",
          "shape": [
            "cohort_rows",
            "runspecpollutantprocess_rows"
          ],
          "description": "GRAMS, and now DECLARED so: g/(hp*h) x hp x h and eight dimensionless factors (conventions §58). It was carried unitless while §11 said horsepower had no name in the registry. clcems.f's whole product for one (model year, pollutant process) cell, summed over the technologies the mix carries: the base rate, the deterioration factor at this cohort's age, the adjustment, the unit conversion, adjtime, the annual hours, the month-day factor, the allocated population, the grown model-year fraction and the technology's share. Grams, because the short-ton conversion and its inverse cancel exactly (§6.1 step 5)."
        },
        "out_cohortOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "Which of the 36 emitted (SCC, modelYearID) cohorts this output row belongs to. The output is a FLAT row relation with key COLUMNS, not a grid: the fixture's key set is ragged -- 3, 29 and 4 model years across three SCCs -- and a `ragged` axis is not usable (docs/findings F14). 144 is 36 x 4 and the 36 is `cohort_ownerRank` at the end of the cohort relation, so the axis SIZE is a claim the document checks rather than a count typed in from the snapshot."
        },
        "out_pointOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The equipment point that OWNS this row's cohort. It labels the row -- the fuel type comes through it -- and does not weight it: the quantity sums every point of the row's SCC, not just this one."
        },
        "out_ageSlot": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "The age slot, which with the SCC is what the quantity contracts on."
        },
        "out_ppOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "output_rows"
          ],
          "description": "Which selected pollutant process."
