            "output_rows"
          ],
          "description": "MOVESOutput.emissionQuant, in GRAMS and declared so: the cell above, flattened onto the output relation. This is the column compare-output.py diffs against the snapshot. Nothing is clamped here: `NonroadOutputDataLoader`'s `Math.max(0, value)` is per technology record, and `tech_hourlyEmission` carries it. A record clamped to zero is KEPT: MOVESOutput has the row, at 0."
        },
        "fold_totalPopulation": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "totpop: the projected population after this row's growth step, starting from point_statePopulation. A RECURRENCE in its own right, and the simplest in the document -- lag 1, one term."
        },
        "fold_residualMinuend": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "The number the newest-model-year slot is the residual OF: totpopfrc = totpop / statePopulation at every fold row but the first, and the base vector's own newest-cohort fraction at the first. Carrying the base case here rather than inside the recurrence is what lets `residual = minuend - scrapped sum` hold at EVERY row, so the recurrence can read a lag of any size with one expression and no second base case."
        },
        "fold_scrappedFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "frcsum: the sum over age slots 1..MXAGYR-1 of the cohorts that survived into this fold year, in ASCENDING slot order, which is the order agedist.f accumulates them in. THIS IS agedist.f's THIRTY-YEAR FOLD, spelled as esm-spec §4.3.1.1's causal self-reference: the body reads `index(fold_scrappedFraction, r, Y - a)` -- itself, strictly earlier along its own fold-year axis, once per age slot `a`, which is also the lag. Nothing is declared; the recurrence, its axis and its maximum lag of 50 are read off that one self-read. The equipment-point axis is an IDENTITY index, which §4.3.1.1 requires of a non-recurrence axis. Row 1 is 0 by a guard inside the body rather than by falling off the axis, because a self-read of an unpublished cell FAULTS rather than reading a zero ghost."
        },
        "fold_newestCohortResidual": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "fold_year_rows"
          ],
          "description": "mdyrfrc[0] at each fold row: the minuend less the scrapped sum, UNCLAMPED (§2.2(e) property 2). This is the quantity whose SIGN decides whether a model year exists -- when the truncated growth index dips year over year it goes negative, the next year's shift clamps it to zero, and prccty.f's `modfrc <= 0` skip drops the row. It is a column of its own so that the sign is assertable."
        },
        "slot_grownModelYearFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "modfrc after the fold: the last fold row's vector, read back. Slot 1 is the newest model year -- the unclamped residual -- and slot a+1 is the cohort shifted and scrapped a times."
        },
        "slot_isPopulated": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "prccty.f's skip, in the two halves the reference writes it in: the loop runs `for idx in range(nyrlif)` and inside it `if modfrc <= 0: continue`. BOTH halves are load-bearing and neither implies the other. The bound is not decoration -- agedist.f's vector keeps shifting cohorts past nyrlif and does not scrap them further, so 2260007005 has 5.9e-08 sitting in slots 4, 5 and 6 that the reference never reads and that would otherwise become 48 more model years. The `> 0` test is not decoration either: 44 cohorts across this fixture are EXACTLY zero and the skip is what removes them (§7.3 measured `modfrc < 0` and no skip at all: both over-emit by 44). Together they are what makes the 2265007010 model-year set gappy -- 1991, 2000-2002 and 2006-2010 absent -- which §6.3 calls the single most fragile behaviour in the chain."
        },
        "slot_detAge": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "equipment_point_rows",
            "age_slot_rows"
          ],
          "description": "The cohort's age in units of median life at full load, per point. The cap is applied INSIDE the power, not here (§4.1)."
        },
        "minimumGrowthPopulation": {
          "type": "parameter",
          "units": "1",
          "default": 0.0001,
          "description": "MINGRWIND (agedist.rs:135): a floor applied to the running population total ONCE PER YEAR, and only when that year's growth factor is non-zero, before the factor is applied. It cannot bind on any of this fixture's equipment points -- the smallest base population is 0.5 -- and it is carried because leaving it out would make the port agree by accident on this data and disagree on a state with almost no equipment."
        },
        "cohort_pointOrdinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "Which equipment point this cohort belongs to: the outer coordinate of the flat 6 x 51 product."
        },
        "cohort_ageSlot": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "Which age slot: the inner coordinate, 1 for the newest model year."
        },
        "cohort_SCC": {
          "type": "unknown",
          "element_type": "Float64",
          "shape": [
            "cohort_rows"
          ],
          "description": "The point's SCC, carried onto the cohort relation because the OUTPUT is keyed by SCC and not by point -- three points of 2265007010 sum into one output row, and two of 2265007015 do."
        },
        "cohort_hpAvg": {
          "type": "unknown",
          "units": "hp",
          "shape": [
            "cohort_rows"
          ],
          "description": "The point's average horsepower, which selects the hp bin of both the .TECH mix and the .EMF rates, and differs across the three points of 2265007010 (8.117, 12.62, 20.56) -- two of them in the same bin and one with a different median life."
        },
        "cohort_mixEffectiveSCC": {
          "type": "unknown",
          "element_type": "Float64",
          "shape": [
            "cohort_rows"
          ],
          "description": "The rung of the equipment chain the .TECH lookup stopped on, carried onto the cohort relation so the contraction against the 9,554-row table joins on a column of ITS OWN range. Reaching the same value through an extra equipment-point range instead costs a factor of six, because that range is not what drives the join."
        },
        "cohort_mixBinLow": {
          "type": "unknown",
          "units": "hp",
          "shape": [
            "cohort_rows"
          ],
          "description": "`point_mixBinLow` at the cohort's point."
        },
        "cohort_modelYearID": {
          "type": "unknown",
          "shape": [
            "cohort_rows"
          ],
          "description": "runYearID - (slot - 1)."
        },
        "cohort_grownModelYearFraction": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "modfrc for this cohort, out of agedist.f's fold."
        },
        "cohort_isPopulated": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "prccty.f's skip, lifted onto the cohort relation."
        },
        "cohort_isShadowed": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "1 when an EARLIER equipment point of the same SCC is already populated in this age slot. The output is keyed by (SCC, modelYearID) and three points share 2265007010, so without this the same model year would claim three output rows. A self-join of the cohort relation on itself, which the format admits as two ranges drawing one index set."
        },
        "cohort_isOwner": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "1 for exactly one cohort per emitted (SCC, modelYearID) pair. Summed over the relation it is the number of output rows divided by four, and this fixture's snapshot says that number is 36."
        },
        "cohort_ownerRank": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "How many owners there are at or before this position -- the inclusive prefix count that COMPACTS the mask. `cohort_ownerRank` at the last position is the owner total, which is the one number that decides whether the 144-row output relation is a bijection onto the emitted key set; the test pins it at 36."
        },
        "cohort_ordinal": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "The owner's 1-based output position, and 0 on every cohort that is not an owner. Zero rather than the prefix count, so that `out_cohortOrdinal` -- which runs 1..36 -- joins to exactly one cohort and a shadowed or unpopulated one is unmatchable. This is the whole of the ragged-key-set workaround: a rectangular grid, a mask, and a rank."
        },
        "cohort_mixYearID": {
          "type": "unknown",
          "shape": [
            "cohort_rows"
          ],
          "description": "The mix year this cohort takes. 2260007005 resolves to 2008 for all three of its cohorts; 2265007010's bin carries eleven mix years and its 29 cohorts spread across seven of them, down to the 1900 catch-all for model years before 1996, so the 'latest at or before' rule is genuinely exercised here rather than degenerate."
        },
        "cohort_earliestMixYear": {
          "type": "unknown",
          "shape": [
            "cohort_rows"
          ],
          "description": "The earliest mix year in the bin, for a cohort older than all of them."
        },
        "cohort_latestMixYearAtOrBefore": {
          "type": "unknown",
          "shape": [
            "cohort_rows"
          ],
          "description": "The latest of them."
        },
        "cohort_mixYearAtOrBeforeCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "How many mix years this cohort could take."
        },
        "cohort_detAge": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cohort_rows"
          ],
          "description": "The deterioration age of this cohort."
        },
        "det_isPresent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "1 where nrdeterioration has a row for this (pollutant process, technology). A technology the mix does not carry has no row, and its deterioration factor must then be 0 rather than 1 -- the same value an unmatched sum_product contraction produced when this join lived inside `tech_deteriorationFactor`."
        },
        "det_coefficient": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "DFCoefficient, A in 1 + A x min(age, cap)^B."
        },
        "det_ageCapValue": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "emissionCap, the age the power is capped at (§4.1)."
        },
        "det_ageExponent": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rated_pp_rows",
            "engine_tech_rows"
          ],
          "description": "DFAgeExponent, B, and 0 where nrdeterioration has no row for this (pollutant process, technology). `tech_deteriorationFactor` substitutes 1 there, so that `min(age, 0)^B` is a plain 0 rather than 0^0; it does the substitution rather than this equation doing it because the two index symbols are only BOUND inside an aggregate over them, and spelling it here left them free and silently zero (docs/findings F26)."
        },
        "run_equipmentPointsSelected": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "How many equipment points the run has, recomputed; `n_equipmentPoint` is checked against it."
        },
        "run_equipmentPointsDropped": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "The points ranked past `n_equipmentPoint`, which the point axis cannot hold. Asserted 0."
        },
        "run_outputCohortCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "How many (SCC, model year) cohorts own an output row, recomputed; `n_outputCohort` is checked against it."
        },
        "form_sulfurLevel": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "fuelformulation_rows"
          ],
          "description": "fuelformulation.sulfurLevel, ppm. NULL on two national rows (`fuel_property_or_zero`).",
          "update": {
            "kind": "data",
            "source": "db_fuelformulation",
            "from": {
              "file_variable": "sulfurLevel"
            }
          }
        },
        "sm_engineFuelKindID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sulfur_member_rows"
          ],
          "description": "Which engine-fuel kind's in-use sulfur the member feeds."
        },
        "sm_fuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "sulfur_member_rows"
          ],
          "description": "The NONROAD fuel type (`nrfuelsubtype.fuelTypeID`) whose supply feeds it: gasoline 1 for both gasoline kinds, nonroad diesel 23 for diesel, and CNG 3 and LPG 4 POOLED for each of CNG and LPG, which moves.rs `build_fuel_properties` does and the Fortran's single `/SULFUR/` value for the two gaseous fuels requires."
        },
        "zone_startAllocFactor": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "zone_rows"
          ],
          "description": "zone.startAllocFactor: the zone's share of its state's starts, which `PreAggSTATE.sql` weights a state's zones by.",
          "update": {
            "kind": "data",
            "source": "db_zone",
            "from": {
              "file_variable": "startAllocFactor"
            }
          }
        },
        "nft_fuelTypeID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrfueltype_rows"
          ],
          "description": "nrfueltype.fuelTypeID: gasoline 1, CNG 3, LPG 4, nonroad diesel 23, marine diesel 24.",
          "update": {
            "kind": "data",
            "source": "db_nrfueltype",
            "from": {
              "file_variable": "fuelTypeID"
            }
          }
        },
        "nft_defaultFormulationID": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "nrfueltype_rows"
          ],
