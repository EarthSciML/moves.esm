        "run_adjustmentTime": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "adjtime = 1/ndays. clcems.f divides the annual activity down to one typical day."
        },
        "run_daytimeHourCount": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "The daytime hours, 6 to 18 inclusive: 13. NOT the weight they carry. `PreAggSTATE.sql` writes the state's pseudo-zone as `Sum(temperature x actFract)` and NONROAD's `avg` then divides by its thirteen rows -- and the weights need not sum to 1, because each county's share is rounded to six decimals before it is divided: Michigan's 83 sum to 0.9999322. A weighted MEAN, dividing by that, is 0.0049 degF high, which moved every 4-stroke gasoline THC, CO and NOx cell of `nr-construction-state` by exactly the ratio its temperature coefficient predicts, and left PM, SO2 and every 2-stroke cell exact."
        },
        "run_daytimeTemperatureSum": {
          "type": "unknown",
          "units": "degF",
          "shape": [
            "run_scope_rows"
          ],
          "description": "The weighted sum of the daytime temperatures of the run's zones (`zone_runWeight`)."
        },
        "run_meanTemperature": {
          "type": "unknown",
          "units": "degF",
          "shape": [
            "run_scope_rows"
          ],
          "description": "tamb. 73.576924 for this county-month, which is BELOW emsadj.f's 75 degF branch point -- the cold coefficients apply.\n\nIT LIVES ON A ONE-ROW RELATION AND NOT ON THE EQUIPMENT-POINT ONE, and that is the shape rule this document follows throughout: a quantity goes on the axis it actually varies over. `tamb` is a property of the county, the month and the daytime hours, so the six points share it; putting it on the point axis would have been six identical contractions over a 930,816-row table, which is not wrong but is 14 of the document's 31 seconds and says the wrong thing about what depends on what. The converse mistake is the dangerous one and this document contains its counterexample -- `pp_adjustment` really does vary per point, because one point is two-stroke and five are four-stroke."
        },
        "run_fuelYearID": {
          "type": "unknown",
          "shape": [
            "run_scope_rows"
          ],
          "description": "J19: the fuel year for this calendar year."
        },
        "run_fuelRegionCodeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "regionCodeID 2, the NONROAD fuel region. It used to live on a separate one-row `fuel_scope_rows` relation whose only purpose was to carry a composite join key; with the run scope now six rows wide that relation would have had to be six rows too, so its two columns moved onto the point relation and the axis went away."
        },
        "run_fuelScopeFuelTypeID": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "run_scope_rows"
          ],
          "description": "MOVES fuel type 1, gasoline: which supply rows count towards `oxy` (§5.4's two namespaces -- this one is the ONROAD numbering, the one `fuelformulation` speaks)."
        },
        "run_monthID": {
          "type": "unknown",
          "shape": [
            "run_scope_rows"
          ],
          "description": "The run month, read from runspecmonth rather than from the RunSpec XML's zero-based key."
        },
        "run_fuelRegionID": {
          "type": "unknown",
          "units": "1",
          "shape": [
